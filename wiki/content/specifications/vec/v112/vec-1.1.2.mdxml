				<packagedElement xmi:type='uml:Class' xmi:id='EAID_CE42DF2F_1773_4aca_B7E7_163346FB9BC2' name='TopologySpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_CE42DF2F_1773_4aca_B7E7_163346FB9BC2Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specification for the definition of a topology. A topology consists of TopologyNodes, TopologySegments and Zones. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_CE42DF2F_1773_4aca_B7E7_163346FB9BC2'/>
