				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1443699906120_416287_2756' name='ConnectorHousingCapSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1443700140135_91624_2774' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the definition of cap&#39;s (backshells) of connectors. Different cap&#39;s can add additional wire length addons to a connector housing. &#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;A &#39;cap&#39; which already defines the number of cavities, coding etc. is in the&amp;#160;VEC&amp;#160;defined by &lt;i&gt;ConnectorHousingSpecification&lt;/i&gt; with &lt;i&gt;ModularSlots&lt;/i&gt; and not by a &lt;i&gt;ConnectorHousingCapSpecification&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1443699906120_416287_2756'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1443699906132_575974_2757' general='EAID_6AB9AD42_9295_4771_B673_98FDF80C9A65'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1443699932553_875281_2759' name='wireAddOn' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1443699991594_760467_2765' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the wire length add on needed for the cap.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1443699932553_875281_2759'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1443699949115_985100_2761'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
