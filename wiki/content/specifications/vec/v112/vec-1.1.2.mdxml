					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_F625189E_C4C3_42be_900E_F1A3EF51BAE0' name='type' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F625189E_C4C3_42be_900E_F1A3EF51BAE0Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the type of the conductor. This should be an enumeration of values defined in a conformance class (e.g. solid, meshwork). &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
