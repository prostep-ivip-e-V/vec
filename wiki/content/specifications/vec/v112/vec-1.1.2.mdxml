					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst3F5071_CB04_4621_8AD8_51AFEF9662C8' name='outlet' visibility='public' aggregation='composite' type='EAID_EDAD526C_99BC_4ff7_9CEA_82D6DAC2816C' association='EAID_D13F5071_CB04_4621_8AD8_51AFEF9662C8'>
