					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_2CD60F88_6194_4efc_A3C1_11387817CF83' name='cavityDiameter' visibility='public' type='EAID_CAF23CB7_00D0_48de_9B42_ADB340B9B4A8'>
