				<packagedElement xmi:type='uml:Class' xmi:id='EAID_3957B8FD_92FC_4c46_BA71_39A6A3A15166' name='HoleMountedFixingSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_3957B8FD_92FC_4c46_BA71_39A6A3A15166Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for fixings that are mounted with a hole. This means, the fixing itself has got a hole, which is mounted onto a bolt.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_3957B8FD_92FC_4c46_BA71_39A6A3A15166'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_12F6E9D6_75D4_4563_BF72_36B973E6C70E' isSubstitutable='false' general='EAID_9DF5B76D_45B3_499a_9057_93F33E3C1417'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_26A13CC8_7703_4c46_814E_8D612424F192' name='holeDiameter' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_26A13CC8_7703_4c46_814E_8D612424F192Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the diameter of the hole in which the fixing is mounted.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_26A13CC8_7703_4c46_814E_8D612424F192'/>
						</ownedComment>
