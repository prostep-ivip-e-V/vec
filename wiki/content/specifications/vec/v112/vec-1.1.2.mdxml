				<packagedElement xmi:type='uml:Association' xmi:id='EAID_ACEE55AE_2E4E_48d4_AEB0_5E29F1BF488B'>
					<memberEnd xmi:idref='EAID_dstEE55AE_2E4E_48d4_AEB0_5E29F1BF488B'/>
					<memberEnd xmi:idref='EAID_srcEE55AE_2E4E_48d4_AEB0_5E29F1BF488B'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_ACEE55AE_2E4E_48d4_AEB0_5E29F1BF488BDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;References the &lt;i&gt;UsageNode&lt;/i&gt; to which the &lt;i&gt;UsageConstraint&lt;/i&gt; applies. This means the described &lt;i&gt;PartVersion&lt;/i&gt; is allowed / denied in the referenced UsageConstraint.&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_ACEE55AE_2E4E_48d4_AEB0_5E29F1BF488B'/>
					</ownedComment>
