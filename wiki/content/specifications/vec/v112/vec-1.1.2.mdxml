						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001383_E2E4_45e4_943F_E02A517CB2AE'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001384_E2E4_45e4_943F_E02A517CB2AE' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
