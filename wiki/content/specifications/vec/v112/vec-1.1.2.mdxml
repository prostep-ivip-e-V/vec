				<packagedElement xmi:type='uml:Association' xmi:id='EAID_B3AA9510_6309_4807_89E8_D92A394E940C'>
					<memberEnd xmi:idref='EAID_dstAA9510_6309_4807_89E8_D92A394E940C'/>
					<memberEnd xmi:idref='EAID_srcAA9510_6309_4807_89E8_D92A394E940C'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B3AA9510_6309_4807_89E8_D92A394E940CDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the Zones that are part of the TopologySpecification.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_B3AA9510_6309_4807_89E8_D92A394E940C'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcAA9510_6309_4807_89E8_D92A394E940C' visibility='public' type='EAID_CE42DF2F_1773_4aca_B7E7_163346FB9BC2' association='EAID_B3AA9510_6309_4807_89E8_D92A394E940C'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002071__6309_4807_89E8_D92A394E940C'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002072__6309_4807_89E8_D92A394E940C' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_6F40A14B_A370_4784_9F9C_5824FFBDB937' name='Zone'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6F40A14B_A370_4784_9F9C_5824FFBDB937Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A Zone divides a topology in different sections / design spaces. A Zone may be subdivided in further zones.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_6F40A14B_A370_4784_9F9C_5824FFBDB937'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_B3016B34_B7DF_481d_ADCE_7ADA2E3AEAD1' isSubstitutable='false' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_3256CB28_10BD_4a70_9A49_AC32AA997EA2' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_3256CB28_10BD_4a70_9A49_AC32AA997EA2Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the Zone (normally the name). The identification is guaranteed to be unique within the TopologySpecification. Over all VEC-documents a Zone-instance can be trusted to be the same if the TopologySpecification-instance is the same (see TopologySpecification) and the identification of the Zone is the same.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_3256CB28_10BD_4a70_9A49_AC32AA997EA2'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002055_10BD_4a70_9A49_AC32AA997EA2' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002056_10BD_4a70_9A49_AC32AA997EA2' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_6FB21781_0050_431d_A326_1E7C9755A27D' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6FB21781_0050_431d_A326_1E7C9755A27DDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies additional, human readable information about the zone.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_6FB21781_0050_431d_A326_1E7C9755A27D'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002057_0050_431d_A326_1E7C9755A27D'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_854026d_1382705356991_156183_2812' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_59ED9D64_A6A5_407c_A16F_0283645798FD' name='ambientTemperature' visibility='public' type='EAID_4F6487F1_26BD_4c01_9D1B_0657A585F66C'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_59ED9D64_A6A5_407c_A16F_0283645798FDDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the ambient temperature that can occur in this zone. This can result in specific requirements for the used components.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_59ED9D64_A6A5_407c_A16F_0283645798FD'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002059_A6A5_407c_A16F_0283645798FD'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002060_A6A5_407c_A16F_0283645798FD' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_730EA5DE_A4B7_401b_95BB_08FF9FDF3C26' name='requiredRobustnessProperties' visibility='public' type='EAID_EB5FB7F3_67F4_4812_A5C6_267D4CE8F6F7'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_730EA5DE_A4B7_401b_95BB_08FF9FDF3C26Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the robustness properties that are required in this zone. This can result in specific requirements for the used components (e.g. the ability for sealing).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_730EA5DE_A4B7_401b_95BB_08FF9FDF3C26'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002061_A4B7_401b_95BB_08FF9FDF3C26'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002062_A4B7_401b_95BB_08FF9FDF3C26' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_DB80D9B2_B207_4a4b_B9ED_2455621B7B07' name='requiredSealingClass' visibility='public' type='EAID_87CA7D9A_F4E3_4284_AC2B_3B439E9513A5'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385547864319_966649_2862' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the &lt;i&gt;SealingClass&lt;/i&gt; that is required in this &lt;i&gt;Zone.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_DB80D9B2_B207_4a4b_B9ED_2455621B7B07'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002063_B207_4a4b_B9ED_2455621B7B07'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002064_B207_4a4b_B9ED_2455621B7B07' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst702126_C650_4705_ADA5_89D23142DC8F' name='subZone' visibility='public' aggregation='composite' type='EAID_6F40A14B_A370_4784_9F9C_5824FFBDB937' association='EAID_5F702126_C650_4705_ADA5_89D23142DC8F'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002065__C650_4705_ADA5_89D23142DC8F'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002066__C650_4705_ADA5_89D23142DC8F' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_5F702126_C650_4705_ADA5_89D23142DC8F'>
					<memberEnd xmi:idref='EAID_dst702126_C650_4705_ADA5_89D23142DC8F'/>
					<memberEnd xmi:idref='EAID_src702126_C650_4705_ADA5_89D23142DC8F'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_5F702126_C650_4705_ADA5_89D23142DC8FDocumentation' body='Specifies the sub Zones that are part the Zone. &#10;'>
						<annotatedElement xmi:idref='EAID_5F702126_C650_4705_ADA5_89D23142DC8F'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src702126_C650_4705_ADA5_89D23142DC8F' visibility='public' type='EAID_6F40A14B_A370_4784_9F9C_5824FFBDB937' association='EAID_5F702126_C650_4705_ADA5_89D23142DC8F'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002069__C650_4705_ADA5_89D23142DC8F'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002070__C650_4705_ADA5_89D23142DC8F' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
			</packagedElement>
			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_4A68852B_5CF3_495d_9EBD_C0B21EB487D6' name='usage_constraint'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_CECC8E6A_EEB3_4e8f_8C45_34091C73060C' name='UsageConstraint'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_CECC8E6A_EEB3_4e8f_8C45_34091C73060CDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies a constraint of the possible usages for PartVersion or PartUsages. UsageContraints are of part master data information. UsageConstraints specify general restrictions for the application of a PartVersion or PartUsage (e.g. a certain period of time in which the part is allowed to be used).&#10;&#10;(see KBLFRM-229)&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_CECC8E6A_EEB3_4e8f_8C45_34091C73060C'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_75183003_C02A_497a_92A5_D03ADBF575E1' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_DFFEA35F_A170_442a_973F_0786B7754895' name='type' visibility='public' type='EAID_1FD9FF86_D581_48eb_921B_D4E34EB2A7BF'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_DFFEA35F_A170_442a_973F_0786B7754895Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines if the usage constraint is positive (allowance) or negative (denial).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_DFFEA35F_A170_442a_973F_0786B7754895'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002073_A170_442a_973F_0786B7754895' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002074_A170_442a_973F_0786B7754895' value='1'/>
							</modelExtension>
						</xmi:Extension>
