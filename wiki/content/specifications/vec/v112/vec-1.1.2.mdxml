				<packagedElement xmi:type='uml:Class' xmi:id='EAID_479DAF86_322C_4dc9_8C35_C85DD80B6547' name='GeometrySegment' isAbstract='true'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_479DAF86_322C_4dc9_8C35_C85DD80B6547Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A GeometrySegment is the geometric representation of a TopologySegment. A TopologySegment may be represented by more than one GeometrySegment. A GeometrySegment is either a GeometrySegment2D or a GeometrySegment3D.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
