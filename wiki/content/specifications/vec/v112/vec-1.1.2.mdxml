						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002128_211B_495a_927E_BE9678FE7571' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_85F4B8AE_2AE2_44cc_9F0C_B9AB1F5B6E9F' name='codeType' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
