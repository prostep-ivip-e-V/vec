				<packagedElement xmi:type='uml:Class' xmi:id='EAID_FF38707A_7B84_48b7_B1D0_4E18C5F2130A' name='UsageConstraintSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_FF38707A_7B84_48b7_B1D0_4E18C5F2130ADocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specification for the definition of usage constraints. The associated UsageContraints are restricting the possible usages of the associated PartVersions and PartUsages. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_FF38707A_7B84_48b7_B1D0_4E18C5F2130A'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_87BB878C_3C1B_4287_AE4D_C34A879C608B' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst6D71D9_7A65_4621_8FA4_0843D874EFC5' name='partUsageConstraint' visibility='public' isOrdered='true' aggregation='composite' type='EAID_CECC8E6A_EEB3_4e8f_8C45_34091C73060C' association='EAID_866D71D9_7A65_4621_8FA4_0843D874EFC5'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002093__7A65_4621_8FA4_0843D874EFC5' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002094__7A65_4621_8FA4_0843D874EFC5' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstC3D65B_E0D4_447d_9DBB_C08C7AFFFE8D' name='constrainedParts' visibility='public' type='EAID_A784D820_0381_42ed_8168_0F1AE554D91B' association='EAID_C5C3D65B_E0D4_447d_9DBB_C08C7AFFFE8D'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002095__E0D4_447d_9DBB_C08C7AFFFE8D'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002096__E0D4_447d_9DBB_C08C7AFFFE8D' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='EAID_1FD9FF86_D581_48eb_921B_D4E34EB2A7BF' name='UsageConstraintType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_1FD9FF86_D581_48eb_921B_D4E34EB2A7BFDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Enumeration for the definition of the type of a UsageContstraint. Valid values are: allow, deny.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_1FD9FF86_D581_48eb_921B_D4E34EB2A7BF'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_5A8DE9AB_2A5A_49b5_92AA_B18F910FADDC' name='Allow'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_F02BEC7C_AE29_4127_BC93_7514D855626F' name='Deny'/>
				</packagedElement>
			</packagedElement>
			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_83CDB254_C294_48bb_A47F_41E15ABCF0F8' name='usage_node'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_A00422A0_ACAB_4468_88D8_19D6AAF1275D' name='UsageNode'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385548152000_702202_2874' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;UsageNode&lt;/i&gt; represents a position in an abstract vehicle. For example the &amp;quot;Head Light Left&amp;quot;. &lt;i&gt;UsageNodes&lt;/i&gt; belong to the master data and they are defined on some companywide level. They can be used to enforce consistent naming over different projects and different development streams (e.g. between Geometry and Electrologic).&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;A &lt;i&gt;UsageNode&lt;/i&gt; can be realized by different elements in the VEC (e.g. &lt;i&gt;NetworkNode, OccurrenceOrUsage, TopologyNode, ComponentNode&lt;/i&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_A00422A0_ACAB_4468_88D8_19D6AAF1275D'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_B664F345_EF63_4529_8180_DA3C08A896B3' isSubstitutable='false' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_934A0BBE_D495_47dc_9909_95FFF13D6BFD' name='abbreviation' visibility='public' type='EAID_6E33CD1B_63D7_4da8_BED4_828037944989'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385548340117_754520_2877' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies an abbreviation of the &lt;i&gt;UsageNode&lt;/i&gt;. Normally this a human readable short name.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_934A0BBE_D495_47dc_9909_95FFF13D6BFD'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002097_D495_47dc_9909_95FFF13D6BFD'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002098_D495_47dc_9909_95FFF13D6BFD' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_2BC4D01B_E5B6_46f2_8649_A3030DAA90A1' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385548212588_818042_2875' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique &lt;i&gt;identification&lt;/i&gt; of the &lt;i&gt;UsageNode&lt;/i&gt;. The &lt;i&gt;identification&lt;/i&gt; is guaranteed to be unique within the context. Over all VEC-documents a &lt;i&gt;UsageNode-instance&lt;/i&gt; can be trusted to be the same if the context-instance is the same and the &lt;i&gt;identification&lt;/i&gt; of the &lt;i&gt;UsageNode&lt;/i&gt; is the same.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_2BC4D01B_E5B6_46f2_8649_A3030DAA90A1'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002099_E5B6_46f2_8649_A3030DAA90A1' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002100_E5B6_46f2_8649_A3030DAA90A1' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_74125C4B_1E87_49bc_92AC_BEFD342B5CF1' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385548281311_135228_2876' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies additional, human readable information about the &lt;i&gt;UsageNode&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_74125C4B_1E87_49bc_92AC_BEFD342B5CF1'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002101_1E87_49bc_92AC_BEFD342B5CF1'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002102_1E87_49bc_92AC_BEFD342B5CF1' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_C96B6C33_73F6_4bf4_BF8D_7811C35274D2' name='usageNodeType' visibility='public' type='EAID_DBF5EB5C_0837_4e70_B1B2_CAC35BAD9007'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_C96B6C33_73F6_4bf4_BF8D_7811C35274D2Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Defines the type of the UsageNode. The type determines how the UsageNode is handled in the latter processes.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_C96B6C33_73F6_4bf4_BF8D_7811C35274D2'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002103_73F6_4bf4_BF8D_7811C35274D2'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002104_73F6_4bf4_BF8D_7811C35274D2' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstC49408_5FE1_4551_BCDA_6169F299353D' name='usedInProject' visibility='public' type='EAID_71EA4408_1F82_434c_B15C_B85E191B99B7' association='EAID_21C49408_5FE1_4551_BCDA_6169F299353D'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002107__5FE1_4551_BCDA_6169F299353D'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002108__5FE1_4551_BCDA_6169F299353D' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstA647B4_2E6D_4c59_913D_D58E76D042FA' name='subUsageNodes' visibility='public' aggregation='composite' type='EAID_A00422A0_ACAB_4468_88D8_19D6AAF1275D' association='EAID_B3A647B4_2E6D_4c59_913D_D58E76D042FA'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002109__2E6D_4c59_913D_D58E76D042FA'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002110__2E6D_4c59_913D_D58E76D042FA' value='*'/>
					</ownedAttribute>
