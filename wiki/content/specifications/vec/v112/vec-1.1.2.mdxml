					<memberEnd xmi:idref='EAID_dstD24473_91AB_48f7_88BA_F924DF0DBC62'/>
					<memberEnd xmi:idref='EAID_srcD24473_91AB_48f7_88BA_F924DF0DBC62'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_90D24473_91AB_48f7_88BA_F924DF0DBC62Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&amp;#160;References the &lt;i&gt;TerminalSpecification&lt;/i&gt; that is instanced by this &lt;i&gt;TerminalRole.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_90D24473_91AB_48f7_88BA_F924DF0DBC62'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcD24473_91AB_48f7_88BA_F924DF0DBC62' visibility='public' type='EAID_FFF01D9D_C445_4f17_BA49_ED1A7E4EA42B' association='EAID_90D24473_91AB_48f7_88BA_F924DF0DBC62'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000655__91AB_48f7_88BA_F924DF0DBC62'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000656__91AB_48f7_88BA_F924DF0DBC62' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_A632D277_1F80_40e0_83B7_2FDEC62DAA16' name='TerminalType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A632D277_1F80_40e0_83B7_2FDEC62DAA16Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Defines the type of a terminal. The type is specified by a combination of a name for and an optional nominalSize. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_A632D277_1F80_40e0_83B7_2FDEC62DAA16'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_B974A9C9_A20A_43e5_A6D9_E0C69C6AB91B' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_06F77294_4107_4d93_B9D9_E7136BD5F538' name='name' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_06F77294_4107_4d93_B9D9_E7136BD5F538Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the type of the cavity (e.g. MQS, DFK, ...).&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_06F77294_4107_4d93_B9D9_E7136BD5F538'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000659_4107_4d93_B9D9_E7136BD5F538' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000660_4107_4d93_B9D9_E7136BD5F538' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_0C05B36C_8F14_4c6b_87DE_D9CAD9BDB404' name='nominalSize' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_0C05B36C_8F14_4c6b_87DE_D9CAD9BDB404Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the nominal size of terminals that fit into the cavity. (e.g. 2x4). &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_0C05B36C_8F14_4c6b_87DE_D9CAD9BDB404'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000661_8F14_4c6b_87DE_D9CAD9BDB404'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000662_8F14_4c6b_87DE_D9CAD9BDB404' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_B96A595D_1A89_45c6_B78D_5D307E761194' name='WireElement'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1384771669076_59708_2741' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;WireElement &lt;/i&gt;specifies a &lt;i&gt;WireElementSpecification&lt;/i&gt; in the context of a &lt;i&gt;WireSpecification&lt;/i&gt;. This is necessary to define a unique &lt;i&gt;identification&lt;/i&gt; of a &lt;i&gt;WireElementSpecification &lt;/i&gt;in the context of a &lt;i&gt;WireSpecification. &lt;/i&gt;Additionally the &lt;i&gt;WireElement&lt;/i&gt; serves as anchor for the instancing of a wire (&lt;i&gt;WireElementReference&lt;/i&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_B96A595D_1A89_45c6_B78D_5D307E761194'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_C74691C2_D6AD_43e6_8764_D511495A683F' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_E8CE384B_7CCC_4311_AB17_C69A06641DC3' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E8CE384B_7CCC_4311_AB17_C69A06641DC3Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The identification of the WireElement. The identification is guaranteed to be unique within a wire and immutable. The identification is guaranteed to be the same for the same WireElement over different VEC documents.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_E8CE384B_7CCC_4311_AB17_C69A06641DC3'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000665_7CCC_4311_AB17_C69A06641DC3' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000666_7CCC_4311_AB17_C69A06641DC3' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst04AA4D_7AB5_4398_A90D_B4F4C8F6A4D4' name='wireElementSpecification' visibility='public' type='EAID_6391ADC0_2FF5_43d5_8C0D_FEFA1B61062B' association='EAID_8E04AA4D_7AB5_4398_A90D_B4F4C8F6A4D4'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000667__7AB5_4398_A90D_B4F4C8F6A4D4' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000668__7AB5_4398_A90D_B4F4C8F6A4D4' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_8E04AA4D_7AB5_4398_A90D_B4F4C8F6A4D4'>
					<memberEnd xmi:idref='EAID_dst04AA4D_7AB5_4398_A90D_B4F4C8F6A4D4'/>
					<memberEnd xmi:idref='EAID_src04AA4D_7AB5_4398_A90D_B4F4C8F6A4D4'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_8E04AA4D_7AB5_4398_A90D_B4F4C8F6A4D4Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Reference the &lt;i&gt;WireElementSpecification &lt;/i&gt;that is represented by the &lt;i&gt;WireElement.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_8E04AA4D_7AB5_4398_A90D_B4F4C8F6A4D4'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src04AA4D_7AB5_4398_A90D_B4F4C8F6A4D4' visibility='public' type='EAID_B96A595D_1A89_45c6_B78D_5D307E761194' association='EAID_8E04AA4D_7AB5_4398_A90D_B4F4C8F6A4D4'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000699__7AB5_4398_A90D_B4F4C8F6A4D4'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000700__7AB5_4398_A90D_B4F4C8F6A4D4' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_85C472FC_3250_421d_9064_6E9CD90CD730'>
					<memberEnd xmi:idref='EAID_dstC472FC_3250_421d_9064_6E9CD90CD730'/>
					<memberEnd xmi:idref='EAID_srcC472FC_3250_421d_9064_6E9CD90CD730'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_85C472FC_3250_421d_9064_6E9CD90CD730Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the WireElements that are available in the &lt;i&gt;WireSpecification&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_85C472FC_3250_421d_9064_6E9CD90CD730'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcC472FC_3250_421d_9064_6E9CD90CD730' visibility='public' type='EAID_CE3C9D13_8E62_4ef8_A553_37D7F6E1CA0C' association='EAID_85C472FC_3250_421d_9064_6E9CD90CD730'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000669__3250_421d_9064_6E9CD90CD730'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000670__3250_421d_9064_6E9CD90CD730' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_879BF440_CC49_421a_BFD9_322A279791D4'>
					<memberEnd xmi:idref='EAID_dst9BF440_CC49_421a_BFD9_322A279791D4'/>
					<memberEnd xmi:idref='EAID_src9BF440_CC49_421a_BFD9_322A279791D4'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_879BF440_CC49_421a_BFD9_322A279791D4Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the WireElement that is represented by the WireElementReference.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_879BF440_CC49_421a_BFD9_322A279791D4'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src9BF440_CC49_421a_BFD9_322A279791D4' visibility='public' type='EAID_D461D8CC_28EC_41c5_82DE_148EA9C7C468' association='EAID_879BF440_CC49_421a_BFD9_322A279791D4'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000671__CC49_421a_BFD9_322A279791D4'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000672__CC49_421a_BFD9_322A279791D4' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_6391ADC0_2FF5_43d5_8C0D_FEFA1B61062B' name='WireElementSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6391ADC0_2FF5_43d5_8C0D_FEFA1B61062BDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A WireElementSpecification is the basic element to describe a wire in the VEC. A WireElementSpecification can be atomic or composed recursively out of other WireElementSpecifications. A WireElementSpecification can reference an InsulationSpecification, if it has an insulation, a CoreSpecification, if it has a core or a WireGroupSpecification if it is a grouping of other WireElementSpecifications in the Wire (e.g. a multi-core wire with twisted pairs).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_6391ADC0_2FF5_43d5_8C0D_FEFA1B61062B'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_7AAEDE1B_661F_45f9_88CD_5E6B82921A25' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_9BE340AF_67FA_4618_9F93_FF529BDBC1CF' name='type' visibility='public' type='EAID_ACBE4C96_FE6E_46d2_96BB_0E9237996505'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9BE340AF_67FA_4618_9F93_FF529BDBC1CFDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the type of the wire. A wire must not have more than one type. This attribute allows more than one value for the reason, that the same type can be expressed in multiple reference systems.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_9BE340AF_67FA_4618_9F93_FF529BDBC1CF'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000673_67FA_4618_9F93_FF529BDBC1CF'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000674_67FA_4618_9F93_FF529BDBC1CF' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_BB51D9F8_7673_412a_9D33_A9BAC38F70EB' name='minBendRadiusDynamic' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_BB51D9F8_7673_412a_9D33_A9BAC38F70EBDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the minimum bend radius for wire element, if it is used in a dynamic environment, where it is bended repeatedly (e.g in grommet of the back door). &#10;(see KLBFRM-311)&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_BB51D9F8_7673_412a_9D33_A9BAC38F70EB'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000675_7673_412a_9D33_A9BAC38F70EB'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000676_7673_412a_9D33_A9BAC38F70EB' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_4595BF1E_A149_4cec_94B6_9752801D293F' name='minBendRadiusStatic' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_4595BF1E_A149_4cec_94B6_9752801D293FDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the minimum bend radius for wire element, if it is used in a static environment, where it is bended once during installation. After that it remains unchanged in its bended position during usage. &#10;(see KLBFRM-311)&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_4595BF1E_A149_4cec_94B6_9752801D293F'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000677_A149_4cec_94B6_9752801D293F'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000678_A149_4cec_94B6_9752801D293F' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_5649B809_A012_4350_A9B1_43E976C42A0C' name='outsideDiameter' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_5649B809_A012_4350_A9B1_43E976C42A0CDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the outside diameter of the WireElement. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_5649B809_A012_4350_A9B1_43E976C42A0C'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000679_A012_4350_A9B1_43E976C42A0C'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000680_A012_4350_A9B1_43E976C42A0C' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_9A3E4801_AF21_4bb0_8C38_3DE631C82379' name='suitedForDynamicUse' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9A3E4801_AF21_4bb0_8C38_3DE631C82379Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies if it is allowed to use the WireElement in a dynamic environment. &#10;(see KBLFRM-311)&#10;&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_9A3E4801_AF21_4bb0_8C38_3DE631C82379'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000681_AF21_4bb0_8C38_3DE631C82379'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000682_AF21_4bb0_8C38_3DE631C82379' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_9058E4B7_47DF_40db_8864_66B80B355F4C' name='impedance' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
