					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_47EE0609_1371_4446_AB72_9FBE283BB171' name='specialRoutedComment' visibility='public' type='EAID_6E33CD1B_63D7_4da8_BED4_828037944989'>
