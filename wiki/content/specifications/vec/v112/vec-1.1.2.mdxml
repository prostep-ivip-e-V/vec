				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1383052235680_223463_2351' name='PinComponentBehavior'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1384426315509_778945_2752' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;PinComponentBehavior&lt;/i&gt; specifies the electrical behavior of a &lt;i&gt;PinComponent.&lt;/i&gt; Since the behavior of a pin is configuration dependent (e.g. the software deployed on an ECU) the &lt;i&gt;PinComponentBehavior &lt;/i&gt;inherits from &lt;i&gt;ConfigurableElement.&lt;/i&gt; Therefore a &lt;i&gt;PinComponent&lt;/i&gt; can specify multiple &lt;i&gt;PinComponentBehavior.&lt;/i&gt;  &#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1383052235680_223463_2351'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1383052570465_109778_2533' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_A50492EE_0719_4d30_A5E2_EB0BD8285D6B' name='signalDirection' visibility='public' type='EAID_D1B0ADD5_D992_48b1_BEF5_A6BF23446F1D'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A50492EE_0719_4d30_A5E2_EB0BD8285D6BDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;The direction of the signal on this pin.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_A50492EE_0719_4d30_A5E2_EB0BD8285D6B'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000497_0719_4d30_A5E2_EB0BD8285D6B'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000498_0719_4d30_A5E2_EB0BD8285D6B' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_51B0A82C_3FDB_4415_99F7_E5373BC229D6' name='pinType' visibility='public' type='EAID_19934AD8_10CF_49a3_865F_F84B457A6727'>
