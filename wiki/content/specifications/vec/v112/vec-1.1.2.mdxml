						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001473__9251_40d8_8459_CC795038D3AA' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001474__9251_40d8_8459_CC795038D3AA' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_0CB72B38_59D3_46eb_BBAB_5078A9FA00BE' name='PartOccurrence'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_0CB72B38_59D3_46eb_BBAB_5078A9FA00BEDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;A PartOccurrence is an instance of a component with a specified part number (PartVersion).&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_0CB72B38_59D3_46eb_BBAB_5078A9FA00BE'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_491492E2_2A31_4d10_9C1A_D3941F82842A' isSubstitutable='false' general='EAID_390D7DAD_7DD0_4cd2_894B_631C0B049B90'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_F32E8512_4512_4c28_A504_500000A17258' name='isSecondaryAlternative' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F32E8512_4512_4c28_A504_500000A17258Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;If a PartUsage is realized by more than one PartOccurrence it is possible to specify which one is the preferred. &#10;&#10;(see KBLFRM-264)&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_F32E8512_4512_4c28_A504_500000A17258'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001453_4512_4c28_A504_500000A17258'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001454_4512_4c28_A504_500000A17258' value='1'/>
