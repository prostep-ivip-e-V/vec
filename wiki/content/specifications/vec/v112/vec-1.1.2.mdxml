						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000009__A674_4531_9AC2_8887D60E1997'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000010__A674_4531_9AC2_8887D60E1997' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst9D3934_3719_466d_98F1_837D58CB7EB5' name='terminalSpecification' visibility='public' type='EAID_5D9F928A_6E6D_4895_A1B1_1FE6E28AAC51' association='EAID_809D3934_3719_466d_98F1_837D58CB7EB5'>
