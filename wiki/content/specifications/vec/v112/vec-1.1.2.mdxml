					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstC22BE7_7811_4080_9327_69A3A379C2FF' name='cavity' visibility='public' aggregation='composite' type='EAID_7E29FD06_9E00_4fef_B794_54B3BBECF441' association='EAID_7AC22BE7_7811_4080_9327_69A3A379C2FF'>
