					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1385739622551_17731_3131' name='aliasId' visibility='public' type='EAID_0BE66F11_D6D4_4aef_B63F_2D85865F9B68'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385739622566_899875_3133' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies identifiers for the &lt;i&gt;Person&lt;/i&gt; in different contexts.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
