				<packagedElement xmi:type='uml:Class' xmi:id='EAID_9DF5B76D_45B3_499a_9057_93F33E3C1417' name='FixingSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9DF5B76D_45B3_499a_9057_93F33E3C1417Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the definition of fixings. A fixing is used to fix the harness in a certain position (e.g. at the car body, a seat, an ECU etc.). The FixingSpecification describes how the fixing is attached to the &amp;quot;non-harness&amp;quot; element. The attachment to harness is described by a PlaceableElementSpecification.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_9DF5B76D_45B3_499a_9057_93F33E3C1417'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_ECD8516C_9EF5_422b_B6A6_0272D775F6FB' isSubstitutable='false' general='EAID_6AB9AD42_9295_4771_B673_98FDF80C9A65'/>
