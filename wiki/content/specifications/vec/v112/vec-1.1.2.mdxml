						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000719__06D2_4d1c_BF27_1AE6251E15B5'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000720__06D2_4d1c_BF27_1AE6251E15B5' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_667A59DB_C6EB_417d_B96F_9F12C28DC687' name='WireReceptionSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_667A59DB_C6EB_417d_B96F_9F12C28DC687Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the definition of wire receptions. A WireReception is the area of a terminal where the contacting with a (e.g. by crimping) takes place.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_667A59DB_C6EB_417d_B96F_9F12C28DC687'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_5FDC7380_A5B8_4aed_B287_9ACA0782BCB1' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_96040A34_7859_48d4_BD47_035D1571CEFD' name='coreCrossSectionArea' visibility='public' type='EAID_CAF23CB7_00D0_48de_9B42_ADB340B9B4A8'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_96040A34_7859_48d4_BD47_035D1571CEFDDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a value range for valid cross section areas a core must have to fit to the wire reception.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_96040A34_7859_48d4_BD47_035D1571CEFD'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000723_7859_48d4_BD47_035D1571CEFD'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000724_7859_48d4_BD47_035D1571CEFD' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_34C993B6_BC27_4ef1_898A_AED3D77E527D' name='insulationDisplacementLength' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_34C993B6_BC27_4ef1_898A_AED3D77E527DDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the length of the insulation which must be stripped off to fit to this wire reception. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_34C993B6_BC27_4ef1_898A_AED3D77E527D'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000725_BC27_4ef1_898A_AED3D77E527D'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000726_BC27_4ef1_898A_AED3D77E527D' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_7565EA22_64D6_4be5_8C74_2ACADD62F3D5' name='multiContact' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7565EA22_64D6_4be5_8C74_2ACADD62F3D5Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies if it is possible to contact more than core at the wire reception. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_7565EA22_64D6_4be5_8C74_2ACADD62F3D5'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000727_64D6_4be5_8C74_2ACADD62F3D5'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000728_64D6_4be5_8C74_2ACADD62F3D5' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_3BA6E749_E356_4843_8028_BAF54917B7BE' name='wireReceptionType' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_3BA6E749_E356_4843_8028_BAF54917B7BEDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the type of the wire reception. This should be an enumeration of values defined in a conformance class.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_3BA6E749_E356_4843_8028_BAF54917B7BE'/>
