				<packagedElement xmi:type='uml:Class' xmi:id='EAID_DF025C3E_1ED9_44e9_91FF_1FBBC2CF2BAB' name='OtherUnit'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_DF025C3E_1ED9_44e9_91FF_1FBBC2CF2BABDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;The OtherUnit class can be used to define a unit, which is necessary in the context of data exchange but not contained in the standard systems (e.g. Piece). &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_DF025C3E_1ED9_44e9_91FF_1FBBC2CF2BAB'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_DC8EB05C_3E52_4449_8686_34F97C9498A4' isSubstitutable='false' general='EAID_E9E6E5D1_05CC_427c_9FD0_4C45AAAA1066'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_F3EC0A11_A89F_429b_AA44_820FEE3FBCF3' name='otherUnitName' visibility='public' type='EAID_978EB899_828F_48da_86B6_F4D035ED1CA3'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385545651064_946390_2709' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the name of the unit.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_F3EC0A11_A89F_429b_AA44_820FEE3FBCF3'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001643_A89F_429b_AA44_820FEE3FBCF3' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001644_A89F_429b_AA44_820FEE3FBCF3' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='EAID_978EB899_828F_48da_86B6_F4D035ED1CA3' name='OtherUnitName'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385546077793_559990_2710' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Enumeration for the definition of other unit names.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_978EB899_828F_48da_86B6_F4D035ED1CA3'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_6841D644_AC86_4ed0_B141_63E28B66EC71' name='Pi'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_4E00CC45_A1AF_4ceb_BB4E_F5B028870A67' name='Piece'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_EB5FB7F3_67F4_4812_A5C6_267D4CE8F6F7' name='RobustnessProperties'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_EB5FB7F3_67F4_4812_A5C6_267D4CE8F6F7Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Allows the definition of robustness properties. Robustness of component is specified as a level of robustness against a specific influence (e.g. oil, water, UV-light). The influence is specified by the &lt;i&gt;class&lt;/i&gt; and the level is specified by the &lt;i&gt;classKey&lt;/i&gt;. Valid robustness classes and keys are specified by the reference system. Attributes of the type RobustnessProperties normally have the multiplicity [0..*]. This means that such an attribute can have RobustnessProperties entries for different &lt;i&gt;classReferenceSystems&lt;/i&gt; and &lt;i&gt;classes&lt;/i&gt;. It must not have multiple entries for the same &lt;i&gt;class&lt;/i&gt; and &lt;i&gt;classReferenceSystem&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_EB5FB7F3_67F4_4812_A5C6_267D4CE8F6F7'/>
					</ownedComment>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_694528E5_1231_4d6f_A10E_09B708B8DD2B' name='class' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_694528E5_1231_4d6f_A10E_09B708B8DD2BDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the identifier of a robustness class defined by the robustness class reference system. Robustness classes are for example: oil, petrol, UV, water.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_694528E5_1231_4d6f_A10E_09B708B8DD2B'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001645_1231_4d6f_A10E_09B708B8DD2B' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001646_1231_4d6f_A10E_09B708B8DD2B' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_F862BDD1_A6F8_48fd_8C20_BFB626694045' name='classKey' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F862BDD1_A6F8_48fd_8C20_BFB626694045Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a key for the robustness level defined in the specified robustness class (e.g. A, B, C).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_F862BDD1_A6F8_48fd_8C20_BFB626694045'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001647_A6F8_48fd_8C20_BFB626694045'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001648_A6F8_48fd_8C20_BFB626694045' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_451F02B2_B7F0_412d_B451_1C9AA68AEFA8' name='classReferenceSystem' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_451F02B2_B7F0_412d_B451_1C9AA68AEFA8Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The identification of the robustness class reference system, which is defining possible values and the semantic of robustness classes and robustness class keys.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_451F02B2_B7F0_412d_B451_1C9AA68AEFA8'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001649_B7F0_412d_B451_1C9AA68AEFA8' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001650_B7F0_412d_B451_1C9AA68AEFA8' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_9BA7E60E_0DA9_4a41_8CD8_FA5A1B1CE2A0' name='hasRobustness' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9BA7E60E_0DA9_4a41_8CD8_FA5A1B1CE2A0Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies if the described element has a robustness in the specified robustness class.&#10;(see KBLFRM-260)&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_9BA7E60E_0DA9_4a41_8CD8_FA5A1B1CE2A0'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001651_0DA9_4a41_8CD8_FA5A1B1CE2A0' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001652_0DA9_4a41_8CD8_FA5A1B1CE2A0' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_98082388_8A16_4bba_9218_60B80CE65A8D' name='description' visibility='public' type='EAID_6E33CD1B_63D7_4da8_BED4_828037944989'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_98082388_8A16_4bba_9218_60B80CE65A8DDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;On optional human readable description of the robustnes (e.g. the name). &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_98082388_8A16_4bba_9218_60B80CE65A8D'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001653_8A16_4bba_9218_60B80CE65A8D'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001654_8A16_4bba_9218_60B80CE65A8D' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_66060FC8_2D9B_4998_8072_D11281BCFB21' name='SIUnit'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_66060FC8_2D9B_4998_8072_D11281BCFB21Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The SIUnit class can define quantities in the terms of the SI-Unit-System by specifying the corresponding SI prefix (optional) and a SI unit name. The usage of SI units must be the preferred way of expressing units, since these units can be easily translated into other SI units.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_66060FC8_2D9B_4998_8072_D11281BCFB21'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_D2E5A4C0_0723_4ab1_A7E1_5619B347FFC6' isSubstitutable='false' general='EAID_E9E6E5D1_05CC_427c_9FD0_4C45AAAA1066'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_D3F2460D_3F0F_49d0_BC81_ED675FB374F6' name='siUnitName' visibility='public' type='EAID_5C445750_7C2A_4c96_9FCF_896E8E433302'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_D3F2460D_3F0F_49d0_BC81_ED675FB374F6Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the name of SI unit (e.g. metre, second,...)&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_D3F2460D_3F0F_49d0_BC81_ED675FB374F6'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001655_3F0F_49d0_BC81_ED675FB374F6' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001656_3F0F_49d0_BC81_ED675FB374F6' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_01A832A7_863D_43bf_8BA5_0FAA9314D8BC' name='siPrefix' visibility='public' type='EAID_4391418A_98AB_4ae8_8A47_65D14C6AC612'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_01A832A7_863D_43bf_8BA5_0FAA9314D8BCDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the prefix of the SI unit (e.g. milli, centi, mirco,...)&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_01A832A7_863D_43bf_8BA5_0FAA9314D8BC'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001657_863D_43bf_8BA5_0FAA9314D8BC'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001658_863D_43bf_8BA5_0FAA9314D8BC' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_87CA7D9A_F4E3_4284_AC2B_3B439E9513A5' name='SealingClass'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_87CA7D9A_F4E3_4284_AC2B_3B439E9513A5Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Allows the definition of a sealing class. The sealing class of a component is specified as a level of sealing against a specific influence. The influence is specified by the sealingClass and the level is specified by the sealingClassKey. Valid sealing classes and keys are specified by the reference system.&#10;Attributes of the type SealingClass normally have the multiplicity [0..*]. This means that such an attribute can have SealingClass entries for different sealingClassReferenceSystems and sealingClasses. It must not have multiple entries for the same sealing class and reference system. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_87CA7D9A_F4E3_4284_AC2B_3B439E9513A5'/>
					</ownedComment>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_E18E3B42_0F45_4ba3_8128_3125DD3B0399' name='class' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E18E3B42_0F45_4ba3_8128_3125DD3B0399Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the identifier of a sealing class defined by the sealing class reference system.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_E18E3B42_0F45_4ba3_8128_3125DD3B0399'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001659_0F45_4ba3_8128_3125DD3B0399' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001660_0F45_4ba3_8128_3125DD3B0399' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_54BF804D_A896_444a_9666_53767912814C' name='classKey' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_54BF804D_A896_444a_9666_53767912814CDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a key for the sealing level defined in the specified sealing class (e.g. A, B, C).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_54BF804D_A896_444a_9666_53767912814C'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001661_A896_444a_9666_53767912814C' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001662_A896_444a_9666_53767912814C' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_7509836A_731F_45f3_AC3D_98DF1A21431A' name='classReferenceSystem' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7509836A_731F_45f3_AC3D_98DF1A21431ADocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The identification of the sealing class reference system, which is defining possible values and the semantic of sealing classes and sealing class keys.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_7509836A_731F_45f3_AC3D_98DF1A21431A'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001663_731F_45f3_AC3D_98DF1A21431A' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001664_731F_45f3_AC3D_98DF1A21431A' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_BA99F14C_D717_4c59_9076_91394DF84E12' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_BA99F14C_D717_4c59_9076_91394DF84E12Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;On optional human readable description of the sealing class (e.g. the name). &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_BA99F14C_D717_4c59_9076_91394DF84E12'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001665_D717_4c59_9076_91394DF84E12'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001666_D717_4c59_9076_91394DF84E12' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='EAID_4391418A_98AB_4ae8_8A47_65D14C6AC612' name='SiPrefix'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_4391418A_98AB_4ae8_8A47_65D14C6AC612Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Enumeration for the definition of SI unit prefixes.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
