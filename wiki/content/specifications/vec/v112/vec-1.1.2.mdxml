							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst6678D4_83E5_409c_9879_0CDFB512C279' name='dimensionAnchor' visibility='public' type='EAID_E9F62F83_46DB_441f_8646_40DF71DF0A54' association='EAID_B96678D4_83E5_409c_9879_0CDFB512C279'>
