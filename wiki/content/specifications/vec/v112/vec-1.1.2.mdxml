				<packagedElement xmi:type='uml:Association' xmi:id='EAID_8AE1E521_E121_49fb_B6C9_63B6D85F9E58'>
					<memberEnd xmi:idref='EAID_dstE1E521_E121_49fb_B6C9_63B6D85F9E58'/>
					<memberEnd xmi:idref='EAID_srcE1E521_E121_49fb_B6C9_63B6D85F9E58'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_8AE1E521_E121_49fb_B6C9_63B6D85F9E58Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the PartOcurrences that are an alternative for this PartOccurrence.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_8AE1E521_E121_49fb_B6C9_63B6D85F9E58'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcE1E521_E121_49fb_B6C9_63B6D85F9E58' visibility='public' type='EAID_0CB72B38_59D3_46eb_BBAB_5078A9FA00BE' association='EAID_8AE1E521_E121_49fb_B6C9_63B6D85F9E58'>
