					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_7297CA20_1F83_446d_B691_95294BD072B8' name='outsideDimension' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7297CA20_1F83_446d_B691_95294BD072B8Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the diameter of the circle around the center of the bolt which passes through the farthest outside point of the contact surface of the ring terminal.&#10;(see KBLFRM-311)&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_7297CA20_1F83_446d_B691_95294BD072B8'/>
