				<packagedElement xmi:type='uml:Class' xmi:id='EAID_79870F6A_0494_420b_9305_6869540647B7' name='MatingPoint'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_79870F6A_0494_420b_9305_6869540647B7Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;A MatingPoint defines the Mating of two terminals. This normally occurs when two inliners are connected. Then terminals of one side (female) are mated with terminals of the other side (male). &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_79870F6A_0494_420b_9305_6869540647B7'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_863D3C34_C74A_4b99_9576_ED4D86908C92' isSubstitutable='false' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_85B05668_B12D_4349_B51A_38B5DFFBA5A4' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_85B05668_B12D_4349_B51A_38B5DFFBA5A4Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the MatingPoint. The identification is guaranteed to be unique within the MatingSpecification.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_85B05668_B12D_4349_B51A_38B5DFFBA5A4'/>
