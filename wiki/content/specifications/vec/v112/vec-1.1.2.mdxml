								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001576__E02A_41d2_989D_5138A6DF8580' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_F4242FED_CDA4_496a_80E8_F922CE497D97' name='ChangeDescription'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F4242FED_CDA4_496a_80E8_F922CE497D97Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A ChangeDescription describes the implemented issues that are reason for the aggregating ItemVersion to be either an initial or successor version. A ChangeDescription can optionally define the person who has approved the change.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_F4242FED_CDA4_496a_80E8_F922CE497D97'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_CF3643F2_7336_4c3f_ABC8_533E54FE35A1' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_DAAA6B43_34FB_42d7_9B1A_92C60DE35059' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_DAAA6B43_34FB_42d7_9B1A_92C60DE35059Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies an identifier for the ChangeDescription. This can be the ID of a changeOrder or an ID which indicates model upgrading.&#10;(see KBLFRM-249)&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_DAAA6B43_34FB_42d7_9B1A_92C60DE35059'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001511_34FB_42d7_9B1A_92C60DE35059'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001512_34FB_42d7_9B1A_92C60DE35059' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_0DA93248_2086_4b6e_B5B1_AF40D3594351' name='label' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_0DA93248_2086_4b6e_B5B1_AF40D3594351Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the label of the change on a drawing for example. If more than one change is issued with one ItemVersion (e.g. change 0001, 0002), in some cases the different changes are labeled on the drawing (e.g. A, B, C).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_0DA93248_2086_4b6e_B5B1_AF40D3594351'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001513_2086_4b6e_B5B1_AF40D3594351'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001514_2086_4b6e_B5B1_AF40D3594351' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_9201435B_52AE_42d1_8953_B1A72C4E894E' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9201435B_52AE_42d1_8953_B1A72C4E894EDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies additional, human readable, information about the ChangeDescription.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_9201435B_52AE_42d1_8953_B1A72C4E894E'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001515_52AE_42d1_8953_B1A72C4E894E'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001516_52AE_42d1_8953_B1A72C4E894E' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_ABBA7779_ADA8_4b23_95D7_42F4F5020489' name='approver' visibility='public' type='EAID_5D8F100A_1350_4aff_B20E_089D64C76887'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_ABBA7779_ADA8_4b23_95D7_42F4F5020489Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the person who has approved the change.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_ABBA7779_ADA8_4b23_95D7_42F4F5020489'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001517_ADA8_4b23_95D7_42F4F5020489'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001518_ADA8_4b23_95D7_42F4F5020489' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_C4BB48CA_2882_43c0_AFF7_1BCFD1CC981F' name='changeDate' visibility='public' type='EAJava_Date'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_C4BB48CA_2882_43c0_AFF7_1BCFD1CC981FDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the date when the change was performed.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_C4BB48CA_2882_43c0_AFF7_1BCFD1CC981F'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001519_2882_43c0_AFF7_1BCFD1CC981F'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001520_2882_43c0_AFF7_1BCFD1CC981F' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_9648942D_FC66_4807_A145_854B3D87D163' name='responsibleDesigner' visibility='public' type='EAID_5D8F100A_1350_4aff_B20E_089D64C76887'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9648942D_FC66_4807_A145_854B3D87D163Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the design engineer who is/was responsible to perform the change.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_9648942D_FC66_4807_A145_854B3D87D163'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001521_FC66_4807_A145_854B3D87D163' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001522_FC66_4807_A145_854B3D87D163' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_7298A3E3_3FF2_4961_A7D8_231EAC5A27D9' name='relatedChangeRequest' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7298A3E3_3FF2_4961_A7D8_231EAC5A27D9Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the identification of a corresponding changeRequest. (see KBLFRM-249)&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_7298A3E3_3FF2_4961_A7D8_231EAC5A27D9'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001523_3FF2_4961_A7D8_231EAC5A27D9'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001524_3FF2_4961_A7D8_231EAC5A27D9' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_CBA68BA5_E0A2_46b4_B2EF_D0EA257C6839' name='Contract'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_CBA68BA5_E0A2_46b4_B2EF_D0EA257C6839Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A Contract-instance describes the relationship between an ItemVersion-instance and a Company-instance additionally defining the role the company takes in reference to the ItemVersion.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_CBA68BA5_E0A2_46b4_B2EF_D0EA257C6839'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_61A16D13_62C2_4580_8C24_7E5B9C29AE84' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_1370C167_E4B5_4860_8B5A_0C5296DFF05C' name='companyName' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_1370C167_E4B5_4860_8B5A_0C5296DFF05CDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the company which acts in the specified Role in the Contract Relationship.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_1370C167_E4B5_4860_8B5A_0C5296DFF05C'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001527_E4B5_4860_8B5A_0C5296DFF05C' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001528_E4B5_4860_8B5A_0C5296DFF05C' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_6FF8123A_2B85_4dc3_A095_9311B87C5A8F' name='contractRole' visibility='public' type='EAID_9BEA0EE6_AB07_42c1_B73D_BFF9AEF39507'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6FF8123A_2B85_4dc3_A095_9311B87C5A8FDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The role the company takes in reference to the associated ItemVersion. Predefined are the values: Oem, Supplier and Manufacturer.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_6FF8123A_2B85_4dc3_A095_9311B87C5A8F'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001529_2B85_4dc3_A095_9311B87C5A8F' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001530_2B85_4dc3_A095_9311B87C5A8F' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='EAID_9BEA0EE6_AB07_42c1_B73D_BFF9AEF39507' name='ContractRole'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9BEA0EE6_AB07_42c1_B73D_BFF9AEF39507Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Enumeration for the definition of roles a contractor has in a contract.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_9BEA0EE6_AB07_42c1_B73D_BFF9AEF39507'/>
