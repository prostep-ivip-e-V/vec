								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000065__2A38_41f6_A403_AAAC2F7EC344' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000066__2A38_41f6_A403_AAAC2F7EC344' value='*'/>
