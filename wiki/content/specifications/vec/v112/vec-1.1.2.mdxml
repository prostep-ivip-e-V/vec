				<packagedElement xmi:type='uml:Class' xmi:id='EAID_B9672B89_1709_467a_97EC_731DBF20CA19' name='VariantConfiguration'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B9672B89_1709_467a_97EC_731DBF20CA19Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;A variant configuration defines a condition with which it is possible to express the inclusion or exclusion of ConfigurableElements in different variants of a product. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_B9672B89_1709_467a_97EC_731DBF20CA19'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_461E03AC_FD4C_4021_AAAF_FD785AD2CFC4' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_F6EA42F2_6A46_4864_A4B5_4B40C155ACB3' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F6EA42F2_6A46_4864_A4B5_4B40C155ACB3Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the variant configuration. The identification is guaranteed to be unique within the specification and does not change over the time.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_F6EA42F2_6A46_4864_A4B5_4B40C155ACB3'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002139_6A46_4864_A4B5_4B40C155ACB3'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002140_6A46_4864_A4B5_4B40C155ACB3' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_22CFF3FF_0792_4922_9CA8_EFAC84037DA8' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
