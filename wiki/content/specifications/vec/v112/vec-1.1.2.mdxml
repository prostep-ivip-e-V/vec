				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1434108801485_353034_3926' name='InternalComponentConnection'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444988261369_20902_3107' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An &lt;i&gt;InternalComponentConnection&lt;/i&gt; defines a conductive connection between a number of &lt;i&gt;PinComponents &lt;/i&gt;within an &lt;i&gt;EEComponent&lt;/i&gt;. Such a connection can be statically permanent or dynamically switch (e.g. by a relais). This behaviour can be defined with a &lt;i&gt;SwitchingState&lt;/i&gt;.&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;The electrical behaviour of an &lt;i&gt;InternalComponentConnection &lt;/i&gt;can be further specified by a referenced &lt;i&gt;ConductorSpecification.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1434108801485_353034_3926'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1434108843938_185356_3980' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1434109277148_596646_4136' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444989788813_886500_3108' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Identification of the &lt;i&gt;InternalComponentConnection&lt;/i&gt;, which must be distinct for all &lt;i&gt;InternalComponentConnection&lt;/i&gt; of an &lt;i&gt;EEComponent&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1434109277148_596646_4136'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1434109301054_953590_4138' value='1'/>
