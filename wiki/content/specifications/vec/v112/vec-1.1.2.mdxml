							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_C0E8CA2A_FA82_4cf9_B43D_F25A8A1D8F88' name='plateThickness' visibility='public' type='EAID_CAF23CB7_00D0_48de_9B42_ADB340B9B4A8'>
