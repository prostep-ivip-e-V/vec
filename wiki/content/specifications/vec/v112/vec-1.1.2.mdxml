				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1443690144890_967120_2716'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1443690144890_731931_2717'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1443690144890_868482_2718'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1443690144890_868482_2718' visibility='private' type='EAID_EC964F6C_2381_4cc0_BCB0_BA106C57F4E3' association='_17_0_2_4_854026d_1443690144890_967120_2716'/>
				</packagedElement>
			</packagedElement>
			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_4EEE909F_386F_46c7_85F7_0E689527F763' name='pdm'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_5911BBEB_08F9_4594_AD35_1C9BBFA509DC' name='Approval'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_5911BBEB_08F9_4594_AD35_1C9BBFA509DCDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the approval of an ItemVersion. This consists of the StatusOfApproval and the Permissions issued for the approval.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_5911BBEB_08F9_4594_AD35_1C9BBFA509DC'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_1C569130_FEF5_4338_9F78_48F2CCB81E04' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_7F2C6EB0_E84F_4fb6_A3A9_048B76101F5C' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7F2C6EB0_E84F_4fb6_A3A9_048B76101F5CDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the approval. The identification is guaranteed to be unique over all VEC-documents. Normally this would reference to a company specific approval number or something similar. KBLFRM-349&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_7F2C6EB0_E84F_4fb6_A3A9_048B76101F5C'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001495_E84F_4fb6_A3A9_048B76101F5C'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001496_E84F_4fb6_A3A9_048B76101F5C' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_49FB2EC1_D4AC_4048_83D3_BF86366C1194' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_49FB2EC1_D4AC_4048_83D3_BF86366C1194Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Room for additional information about the item.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_49FB2EC1_D4AC_4048_83D3_BF86366C1194'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001497_D4AC_4048_83D3_BF86366C1194'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001498_D4AC_4048_83D3_BF86366C1194' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_06835B9D_0CC4_4595_86D4_6AB7E8AD0F28' name='companyInScope' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_06835B9D_0CC4_4595_86D4_6AB7E8AD0F28Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Room to specify for which companies the Approval is valid. It might be e.g. that an approved Item may only be delivered by some specific company.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_06835B9D_0CC4_4595_86D4_6AB7E8AD0F28'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001499_0CC4_4595_86D4_6AB7E8AD0F28'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001500_0CC4_4595_86D4_6AB7E8AD0F28' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_A5B42EBE_BA14_4c83_ADE5_AD848D314298' name='status' visibility='public' type='EAID_30559659_C213_47f6_8220_2A0C7F9B4F9F'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A5B42EBE_BA14_4c83_ADE5_AD848D314298Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;The approval level concerning approval status. Predefined are the values: NotYetApproved, Approved and Withdrawn. KBLFRM-349&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_A5B42EBE_BA14_4c83_ADE5_AD848D314298'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001501_BA14_4c83_ADE5_AD848D314298' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001502_BA14_4c83_ADE5_AD848D314298' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_A83B83B4_89FB_4a6a_97B1_9321ED4DEA79' name='levelOfApproval' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A83B83B4_89FB_4a6a_97B1_9321ED4DEA79Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Describes activities that can be started after release for example building pilot tools or production tools.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_A83B83B4_89FB_4a6a_97B1_9321ED4DEA79'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001503_89FB_4a6a_97B1_9321ED4DEA79'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001504_89FB_4a6a_97B1_9321ED4DEA79' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst376008_E02A_41d2_989D_5138A6DF8580' name='permission' visibility='public' aggregation='composite' type='EAID_0A28AF5D_CB4B_4401_8F80_774E9CC4F9F5' association='EAID_6B376008_E02A_41d2_989D_5138A6DF8580'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001507__E02A_41d2_989D_5138A6DF8580'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001508__E02A_41d2_989D_5138A6DF8580' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_6B376008_E02A_41d2_989D_5138A6DF8580'>
					<memberEnd xmi:idref='EAID_dst376008_E02A_41d2_989D_5138A6DF8580'/>
					<memberEnd xmi:idref='EAID_src376008_E02A_41d2_989D_5138A6DF8580'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6B376008_E02A_41d2_989D_5138A6DF8580Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the permission issued with the approval.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_6B376008_E02A_41d2_989D_5138A6DF8580'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src376008_E02A_41d2_989D_5138A6DF8580' visibility='public' type='EAID_5911BBEB_08F9_4594_AD35_1C9BBFA509DC' association='EAID_6B376008_E02A_41d2_989D_5138A6DF8580'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001575__E02A_41d2_989D_5138A6DF8580' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
