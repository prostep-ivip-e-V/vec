							<annotatedElement xmi:idref='EAID_C0E8CA2A_FA82_4cf9_B43D_F25A8A1D8F88'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001403_FA82_4cf9_B43D_F25A8A1D8F88'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001404_FA82_4cf9_B43D_F25A8A1D8F88' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
