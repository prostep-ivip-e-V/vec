					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_C5F0A682_F098_413c_AFDB_84591CCFD583' name='abbreviation' visibility='public' type='EAID_6E33CD1B_63D7_4da8_BED4_828037944989'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1384782492206_434991_2782' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies an abbreviation of the &lt;i&gt;OccurrenceOrUsage&lt;/i&gt;. Normally this a human readable short name.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
