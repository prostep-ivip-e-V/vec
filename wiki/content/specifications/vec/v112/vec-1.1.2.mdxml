						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7C8F2946_CA07_40aa_BE00_3E4BFC3226B6Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies processing instructions for the TopologySegment.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_7C8F2946_CA07_40aa_BE00_3E4BFC3226B6'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002025_CA07_40aa_BE00_3E4BFC3226B6'/>
