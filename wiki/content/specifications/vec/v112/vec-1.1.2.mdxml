					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_3744C1AC_3985_493f_A956_47EB8EAFBF69' name='dateOfCreation' visibility='public' type='EAJava_Date'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_3744C1AC_3985_493f_A956_47EB8EAFBF69Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the date of creation of the VEC-file. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
