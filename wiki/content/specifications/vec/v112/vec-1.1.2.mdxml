				<packagedElement xmi:type='uml:Class' xmi:id='EAID_148F0717_1113_493f_B011_1792CE051D96' name='PlacementSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_148F0717_1113_493f_B011_1792CE051D96Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the description of placements. &lt;i&gt;Placements&lt;/i&gt; are used to connect &lt;i&gt;OccurrenceOrUsages&lt;/i&gt; with a topology.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
