					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_4CAFDFA8_F2F6_4697_9962_710C93A17710' name='sealable' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_4CAFDFA8_F2F6_4697_9962_710C93A17710Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies if the wire reception can be sealed. &#10;(see KBLFRM-311)&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
