				<packagedElement xmi:type='uml:Association' xmi:id='EAID_79CCA066_BC3C_4dcd_86C6_33B4CBC23700'>
					<memberEnd xmi:idref='EAID_dstCCA066_BC3C_4dcd_86C6_33B4CBC23700'/>
