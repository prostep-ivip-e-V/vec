						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000745__B882_4284_8597_64855C1B612E'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000746__B882_4284_8597_64855C1B612E' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_ACBE4C96_FE6E_46d2_96BB_0E9237996505' name='WireType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_ACBE4C96_FE6E_46d2_96BB_0E9237996505Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a wire type. A wire type is always defined by a key value. What wire type is meant by this key value is defined by a standard reference system.&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_ACBE4C96_FE6E_46d2_96BB_0E9237996505'/>
					</ownedComment>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_253779BD_2A16_4fc1_AF5A_6D4CD29A4FB7' name='type' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_253779BD_2A16_4fc1_AF5A_6D4CD29A4FB7Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the type of the wire (e.g. FLRY, NYFAZw). Valid values are defined by the wireTypeReferenceSystem. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_253779BD_2A16_4fc1_AF5A_6D4CD29A4FB7'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000747_2A16_4fc1_AF5A_6D4CD29A4FB7' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000748_2A16_4fc1_AF5A_6D4CD29A4FB7' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_AB47DD72_BEA0_42d8_9988_B27C54158D8A' name='referenceSystem' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
