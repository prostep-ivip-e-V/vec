				<packagedElement xmi:type='uml:Association' xmi:id='EAID_802D342C_F545_423a_8EAF_FBD1F48269A0'>
					<memberEnd xmi:idref='EAID_dst2D342C_F545_423a_8EAF_FBD1F48269A0'/>
					<memberEnd xmi:idref='EAID_src2D342C_F545_423a_8EAF_FBD1F48269A0'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_802D342C_F545_423a_8EAF_FBD1F48269A0Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the PartOcurrence for which this PartOccurrence is an accessory.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_802D342C_F545_423a_8EAF_FBD1F48269A0'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src2D342C_F545_423a_8EAF_FBD1F48269A0' visibility='public' type='EAID_0CB72B38_59D3_46eb_BBAB_5078A9FA00BE' association='EAID_802D342C_F545_423a_8EAF_FBD1F48269A0'>
