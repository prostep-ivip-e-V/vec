					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_8F0DAB87_0F6B_496d_826F_D2AF65DA23F9' name='copyrightNote' visibility='public' type='EAID_6E33CD1B_63D7_4da8_BED4_828037944989'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_8F0DAB87_0F6B_496d_826F_D2AF65DA23F9Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An informal text which specifies copyright information.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_8F0DAB87_0F6B_496d_826F_D2AF65DA23F9'/>
