				<packagedElement xmi:type='uml:Association' xmi:id='EAID_F8D52733_402A_4222_B2F3_A83FAB2D2869'>
					<memberEnd xmi:idref='EAID_dstD52733_402A_4222_B2F3_A83FAB2D2869'/>
					<memberEnd xmi:idref='EAID_srcD52733_402A_4222_B2F3_A83FAB2D2869'/>
