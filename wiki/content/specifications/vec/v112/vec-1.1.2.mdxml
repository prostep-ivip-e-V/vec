				<packagedElement xmi:type='uml:Association' xmi:id='EAID_7FB38A4F_B266_43da_B106_C9F6136886D1'>
					<memberEnd xmi:idref='EAID_dstB38A4F_B266_43da_B106_C9F6136886D1'/>
					<memberEnd xmi:idref='EAID_srcB38A4F_B266_43da_B106_C9F6136886D1'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7FB38A4F_B266_43da_B106_C9F6136886D1Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the PartOccurrence which is instantiated by the PartOccurrence. This reference is for example needed in the case of usage of assemblies.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_7FB38A4F_B266_43da_B106_C9F6136886D1'/>
