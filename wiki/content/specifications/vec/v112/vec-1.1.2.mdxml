			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_6DC3A7F7_86E5_4224_9EED_CD38FAE842C8' name='electrical_parts'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_C11EF09C_60BA_4ce7_A080_7795CD7CDEC3' name='AbstractSlot' isAbstract='true'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_C11EF09C_60BA_4ce7_A080_7795CD7CDEC3Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An &lt;i&gt;AbstractSlot&lt;/i&gt; is a geometrical place in a connector housing, which can contain / group cavities. This can be either direct, if it is &lt;i&gt;Slot&lt;/i&gt; and indirect if it is a &lt;i&gt;ModularSlot&lt;/i&gt;.&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;If it is a &lt;i&gt;Slot&lt;/i&gt;, than it is an inseparable part of the connector housing, which means it is created during the manufacturing process of the connector housing.&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;If it is a &lt;i&gt;ModularSlot&lt;/i&gt; it is a place where one or more other connector housing can be place during the assembly.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_C11EF09C_60BA_4ce7_A080_7795CD7CDEC3'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_A415FC66_86AE_454c_A9C7_1491A92C83BF' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_2B542149_2BCA_46cb_80C3_681AD3494F33' name='slotNumber' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_2B542149_2BCA_46cb_80C3_681AD3494F33Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the number of the slot. This must be unique within a ConnectorHousingSpecification. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_2B542149_2BCA_46cb_80C3_681AD3494F33'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000263_2BCA_46cb_80C3_681AD3494F33'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
