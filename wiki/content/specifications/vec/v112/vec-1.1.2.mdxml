						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002144_B431_44b4_9039_B40A7C29BD32' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_1774E987_1C8C_4334_8D75_57EFF9E72378' name='logisticControlExpression' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
