					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_8EDAD54F_B3BF_41d5_80E5_8AF55F7C0303' name='platingMaterial' visibility='public' type='EAID_349A4B4C_CCF4_4206_8013_AD19345723A4'>
