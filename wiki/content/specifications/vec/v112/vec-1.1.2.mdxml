				<packagedElement xmi:type='uml:Class' xmi:id='EAID_23ED67F2_C97C_4653_A98D_D7CC409DEEB7' name='CartesianPoint3D'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_23ED67F2_C97C_4653_A98D_D7CC409DEEB7Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A CartesianPoint3D is a point that is defined by its coordinates in a rectangular three-dimensional Cartesian coordinate system.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_23ED67F2_C97C_4653_A98D_D7CC409DEEB7'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_B9B1021C_EF1D_4c98_B875_EFF46875D957' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_46D52858_2BBA_4cdb_8AAF_F22D3BAA2401' name='x' visibility='public' type='EAJava_double'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_46D52858_2BBA_4cdb_8AAF_F22D3BAA2401Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the value of x-coordinate of the Cartesian point. The unit of this value is the baseUnit of containing BuildingBlockSpecification3D.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_46D52858_2BBA_4cdb_8AAF_F22D3BAA2401'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000885_2BBA_4cdb_8AAF_F22D3BAA2401' value='1'/>
