					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1385737316867_509358_3055' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385737316869_869742_3057' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies additional, human readable information about the &lt;i&gt;PinComponent&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1385737316867_509358_3055'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1385737316870_403825_3058'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1385737316869_533287_3056' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1437128608593_548569_2886' name='pinComponentType' visibility='public' type='_17_0_2_4_854026d_1436269670117_230322_2829'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444992100929_356593_3187' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the type of a &lt;i&gt;PinComponent&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1437128608593_548569_2886'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1437128627702_735558_2889'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1437128627702_613213_2890' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_1E526CD9_6274_4771_97A1_737F9F9DD6E9'>
					<memberEnd xmi:idref='EAID_dst526CD9_6274_4771_97A1_737F9F9DD6E9'/>
					<memberEnd xmi:idref='EAID_src526CD9_6274_4771_97A1_737F9F9DD6E9'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_1E526CD9_6274_4771_97A1_737F9F9DD6E9Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the current information of the &lt;i&gt;PinComponent&lt;/i&gt; in this &lt;i&gt;PinComponentBehavior&lt;/i&gt;. Since the current values of a pin can be defined for different types and times it is possible to define multiple &lt;i&gt;PinCurrentInformations&lt;/i&gt; for a &lt;i&gt;PinComponentBehavior&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_1E526CD9_6274_4771_97A1_737F9F9DD6E9'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src526CD9_6274_4771_97A1_737F9F9DD6E9' visibility='public' type='_17_0_2_4_854026d_1383052235680_223463_2351' association='EAID_1E526CD9_6274_4771_97A1_737F9F9DD6E9'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000525__6274_4771_97A1_737F9F9DD6E9' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000526__6274_4771_97A1_737F9F9DD6E9' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_3D3F997B_B371_478f_81D7_40879721B8BC'>
					<memberEnd xmi:idref='EAID_dst3F997B_B371_478f_81D7_40879721B8BC'/>
					<memberEnd xmi:idref='EAID_src3F997B_B371_478f_81D7_40879721B8BC'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_3D3F997B_B371_478f_81D7_40879721B8BCDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the optical information of the pin, if it has the type optical.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_3D3F997B_B371_478f_81D7_40879721B8BC'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src3F997B_B371_478f_81D7_40879721B8BC' visibility='public' type='_17_0_2_4_854026d_1383052235680_223463_2351' association='EAID_3D3F997B_B371_478f_81D7_40879721B8BC'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000531__B371_478f_81D7_40879721B8BC' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000532__B371_478f_81D7_40879721B8BC' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_41138F21_717D_4f04_8359_1316736CD5C4'>
					<memberEnd xmi:idref='EAID_dst138F21_717D_4f04_8359_1316736CD5C4'/>
					<memberEnd xmi:idref='EAID_src138F21_717D_4f04_8359_1316736CD5C4'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_41138F21_717D_4f04_8359_1316736CD5C4Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the voltage information of the &lt;i&gt;PinComponent&lt;/i&gt; in this &lt;i&gt;PinComponentBehavior&lt;/i&gt;. Since the voltage values of a pin can be defined for different types and times it is possible to define multiple &lt;i&gt;PinVoltageInformations&lt;/i&gt; for a &lt;i&gt;PinComponentBehavior&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_41138F21_717D_4f04_8359_1316736CD5C4'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src138F21_717D_4f04_8359_1316736CD5C4' visibility='public' type='_17_0_2_4_854026d_1383052235680_223463_2351' association='EAID_41138F21_717D_4f04_8359_1316736CD5C4'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000547__717D_4f04_8359_1316736CD5C4' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000548__717D_4f04_8359_1316736CD5C4' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
