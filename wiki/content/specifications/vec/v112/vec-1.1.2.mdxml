						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000394_BE0B_417a_84C6_BFFC2505030D' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_B703065F_33BB_4c73_BBA6_138998135C78' name='voltageRange' visibility='public' type='EAID_CAF23CB7_00D0_48de_9B42_ADB340B9B4A8'>
