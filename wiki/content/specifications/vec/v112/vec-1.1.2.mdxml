						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000012__3719_466d_98F1_837D58CB7EB5' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstD3C6AF_06CD_4ee3_89BB_EE2C43CA9E6E' name='cavitySpecification' visibility='public' type='EAID_917F4E6E_2925_42b5_AF27_837F3351C949' association='EAID_97D3C6AF_06CD_4ee3_89BB_EE2C43CA9E6E'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000013__06CD_4ee3_89BB_EE2C43CA9E6E'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000014__06CD_4ee3_89BB_EE2C43CA9E6E' value='*'/>
