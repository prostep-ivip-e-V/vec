			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_4872FE2F_C808_48f2_8EB3_9A2AB84E3E69' name='instancing_electrical_parts'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_0D7F6EA5_CDA8_418c_8AAA_DC9011AFFAE1' name='AbstractSlotReference' isAbstract='true'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_0D7F6EA5_CDA8_418c_8AAA_DC9011AFFAE1Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An &lt;i&gt;AbstractSlotReference&lt;/i&gt; represents the usage of an AbstractSlot in the context of PartUsage or PartOccurrence.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_0D7F6EA5_CDA8_418c_8AAA_DC9011AFFAE1'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1383138126980_881535_2420' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_9E1CF203_E917_491a_8B18_C8C50C0BC38E' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9E1CF203_E917_491a_8B18_C8C50C0BC38EDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the SlotReference. The identification is guaranteed to be unique within the ConnectorHousingRole. The cavity &amp;amp; slot number is defined by the associated cavity and slot.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_9E1CF203_E917_491a_8B18_C8C50C0BC38E'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001021_E917_491a_8B18_C8C50C0BC38E'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001022_E917_491a_8B18_C8C50C0BC38E' value='1'/>
