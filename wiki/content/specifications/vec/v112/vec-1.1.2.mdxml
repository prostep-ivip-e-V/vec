							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_EC10FFBC_4190_4162_BC12_8DBDC7CC7012' name='permitter' visibility='public' type='EAID_5D8F100A_1350_4aff_B20E_089D64C76887'>
