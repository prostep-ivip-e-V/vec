					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1422888506782_285407_3010' name='valueComponent' visibility='public' type='EAJava_double'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444991549470_871779_3165' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the value of the dimension. This value can be null, if it shall be calculated and only a tolerance shall be defined. &#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1422888506782_285407_3010'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1422888526913_296387_3012'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1422888526913_149286_3013' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1422888815884_793189_3018' name='tolerance' visibility='public' aggregation='composite' type='EAID_7457DD90_7E8E_4045_9E17_882CA3FA1A36' association='_17_0_2_4_854026d_1422888815884_714233_3017'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1422888827884_870598_3046'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1422888827884_953964_3047' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1422888922764_387698_3062' name='valueCalculated' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444991604766_534558_3166' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines if the value of the &lt;i&gt;Dimension&lt;/i&gt; was calculated (e.g. the sum of segment lengths in the topology) or if it was defined manually. &#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1422888922764_387698_3062'/>
