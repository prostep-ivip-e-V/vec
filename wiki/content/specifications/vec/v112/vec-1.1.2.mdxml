					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src088B07_4873_41a7_A57C_1A6320FDCB37' visibility='public' type='EAID_10F5B908_0529_483d_98C5_0BF17B111DE3' association='EAID_8E088B07_4873_41a7_A57C_1A6320FDCB37'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002053__4873_41a7_A57C_1A6320FDCB37'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002054__4873_41a7_A57C_1A6320FDCB37' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_97733D04_1F62_47fb_8ED2_0448659C560D' name='TopologyNode'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_97733D04_1F62_47fb_8ED2_0448659C560DDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;A TopologyNode is a point in the Topology where TopologySegments are starting and ending. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_97733D04_1F62_47fb_8ED2_0448659C560D'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_40D6D544_EA41_4c7c_B8A2_9EB27051380F' isSubstitutable='false' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_7B658009_3D02_4846_8FD3_7843A9DE92A6' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7B658009_3D02_4846_8FD3_7843A9DE92A6Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the TopologyNode. The identification is guaranteed to be unique within the TopologySpecification. Over all VEC-documents a TopologyNode-instance can be trusted to be the same if the TopologySpecification-instance is the same (see TopologySpecification) and the identification of the TopologyNode is the same.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_7B658009_3D02_4846_8FD3_7843A9DE92A6'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001995_3D02_4846_8FD3_7843A9DE92A6' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001996_3D02_4846_8FD3_7843A9DE92A6' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_76C8A3D5_DE51_4c58_9A80_0F84B07F79B2' name='aliasId' visibility='public' type='EAID_0BE66F11_D6D4_4aef_B63F_2D85865F9B68'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_76C8A3D5_DE51_4c58_9A80_0F84B07F79B2Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies additional identifiers for the TopologyNode.&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;Example: TopologyNode Ids may vary from one CAD system export to another. Therefore the CAD system Id is improper for identification attribute. The identification shall have a value which is unique within the Topology. AliasId may be used for the CAD system Id.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_76C8A3D5_DE51_4c58_9A80_0F84B07F79B2'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001997_DE51_4c58_9A80_0F84B07F79B2'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001998_DE51_4c58_9A80_0F84B07F79B2' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_6D422A07_18E1_4d7f_9259_988980FE3D57' name='matchingPointId' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6D422A07_18E1_4d7f_9259_988980FE3D57Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies an identification of a TopologyNode which be used for matching nodes that belong to different TopologySpecifications and that are actually representing the same node. Example: There are two TopologySpecifications, each specifying the topology of a certain zone of the car. If the zones are adjacent, it is possible that there are TopologyNodes where the two topologies are connected. These &amp;quot;connection-nodes&amp;quot; would carry the same matchingPointId.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_6D422A07_18E1_4d7f_9259_988980FE3D57'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001999_18E1_4d7f_9259_988980FE3D57'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002000_18E1_4d7f_9259_988980FE3D57' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_22DD09E4_6796_4dc0_927B_98945B9768E9' name='processingInstruction' visibility='public' type='EAID_6E33CD1B_63D7_4da8_BED4_828037944989'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_22DD09E4_6796_4dc0_927B_98945B9768E9Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies processing instructions for the TopologyNode.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_22DD09E4_6796_4dc0_927B_98945B9768E9'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002001_6796_4dc0_927B_98945B9768E9'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002002_6796_4dc0_927B_98945B9768E9' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_49F6E305_0F55_493e_B2E4_9AF3DC4AFFE8' name='nodeType' visibility='public' type='EAID_0A237E73_8407_4f02_BBC7_2F0786A7BDEC'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_49F6E305_0F55_493e_B2E4_9AF3DC4AFFE8Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the type of the TopologyNode. A Node can either be an EndNode, a Junction or an Inliner. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_49F6E305_0F55_493e_B2E4_9AF3DC4AFFE8'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002003_0F55_493e_B2E4_9AF3DC4AFFE8'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002004_0F55_493e_B2E4_9AF3DC4AFFE8' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstBC804F_C873_4645_BBEE_0FE41880D44F' name='realizedUsageNode' visibility='public' type='EAID_A00422A0_ACAB_4468_88D8_19D6AAF1275D' association='EAID_25BC804F_C873_4645_BBEE_0FE41880D44F'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002005__C873_4645_BBEE_0FE41880D44F'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002006__C873_4645_BBEE_0FE41880D44F' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_25BC804F_C873_4645_BBEE_0FE41880D44F' name='realizes'>
					<memberEnd xmi:idref='EAID_dstBC804F_C873_4645_BBEE_0FE41880D44F'/>
					<memberEnd xmi:idref='EAID_srcBC804F_C873_4645_BBEE_0FE41880D44F'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_25BC804F_C873_4645_BBEE_0FE41880D44FDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;UsageNode&lt;/i&gt; that is realized by this &lt;i&gt;TopologyNode&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_25BC804F_C873_4645_BBEE_0FE41880D44F'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcBC804F_C873_4645_BBEE_0FE41880D44F' visibility='public' type='EAID_97733D04_1F62_47fb_8ED2_0448659C560D' association='EAID_25BC804F_C873_4645_BBEE_0FE41880D44F'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002117__C873_4645_BBEE_0FE41880D44F'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002118__C873_4645_BBEE_0FE41880D44F' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_9E4A1F76_3CF3_45de_A731_C042DD86BD54'>
