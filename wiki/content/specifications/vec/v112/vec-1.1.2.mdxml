				<packagedElement xmi:type='uml:Class' xmi:id='EAID_EBC20AF8_C07E_4928_B268_1CD743B74C4A' name='PartUsageSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_EBC20AF8_C07E_4928_B268_1CD743B74C4ADocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specification for the definition of PartUsages. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_EBC20AF8_C07E_4928_B268_1CD743B74C4A'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_EF830A6E_8A8B_442d_9B38_42DA40F5C5EA' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst59B3E6_5773_4f8a_BA12_8A2D6394B177' name='partUsage' visibility='public' aggregation='composite' type='EAID_EC964F6C_2381_4cc0_BCB0_BA106C57F4E3' association='EAID_2059B3E6_5773_4f8a_BA12_8A2D6394B177'>
