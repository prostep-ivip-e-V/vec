				<packagedElement xmi:type='uml:Class' xmi:id='EAID_CE3C9D13_8E62_4ef8_A553_37D7F6E1CA0C' name='WireSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_CE3C9D13_8E62_4ef8_A553_37D7F6E1CA0CDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the definition of a wire. This can either be a complex multicore wire or a normal single core. In the VEC a wire is defined by one WireElement, which may be composed from other WireElements.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_CE3C9D13_8E62_4ef8_A553_37D7F6E1CA0C'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_B7601623_38FE_487f_969B_F3671A619696' isSubstitutable='false' general='EAID_6AB9AD42_9295_4771_B673_98FDF80C9A65'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstC472FC_3250_421d_9064_6E9CD90CD730' name='wireElement' visibility='public' aggregation='composite' type='EAID_B96A595D_1A89_45c6_B78D_5D307E761194' association='EAID_85C472FC_3250_421d_9064_6E9CD90CD730'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000739__3250_421d_9064_6E9CD90CD730' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000740__3250_421d_9064_6E9CD90CD730' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst78EDCD_E254_4e46_A58A_A2B1C8862B3A' name='wireElementSpecification' visibility='public' type='EAID_6391ADC0_2FF5_43d5_8C0D_FEFA1B61062B' association='EAID_AB78EDCD_E254_4e46_A58A_A2B1C8862B3A'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000741__E254_4e46_A58A_A2B1C8862B3A' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000742__E254_4e46_A58A_A2B1C8862B3A' value='1'/>
