				<packagedElement xmi:type='uml:Class' xmi:id='EAID_01CF64D9_404E_40ec_9991_1640BD88488F' name='CavityReference'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_01CF64D9_404E_40ec_9991_1640BD88488FDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A CavityReference represents the usage of a Cavity in the context of PartUsage or PartOccurrence.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_01CF64D9_404E_40ec_9991_1640BD88488F'/>
