				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_B2DE484C_D392_4086_86A9_2F4CB1146E72'>
					<memberEnd xmi:idref='EAID_dstDE484C_D392_4086_86A9_2F4CB1146E72'/>
					<memberEnd xmi:idref='EAID_srcDE484C_D392_4086_86A9_2F4CB1146E72'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B2DE484C_D392_4086_86A9_2F4CB1146E72Documentation' body='Specifies the InternalTerminalConnections of the terminal. &#10;'>
