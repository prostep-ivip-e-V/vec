					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_FF8CB6C2_530E_481b_A2F4_54A1FB31E1A7' name='nominalSize' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_FF8CB6C2_530E_481b_A2F4_54A1FB31E1A7Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the nominal size of a tube. The nominal size is a name for the size of the tube that is somehow related to the inner diameter of the tube. However it is not the inner diameter (e.g. &amp;quot;10.5&amp;quot;).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_FF8CB6C2_530E_481b_A2F4_54A1FB31E1A7'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001441_530E_481b_A2F4_54A1FB31E1A7'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
