				<packagedElement xmi:type='uml:Association' xmi:id='EAID_AB0BAC4E_140A_4bbe_A103_FA49B8B5D726'>
					<memberEnd xmi:idref='EAID_dst0BAC4E_140A_4bbe_A103_FA49B8B5D726'/>
					<memberEnd xmi:idref='EAID_src0BAC4E_140A_4bbe_A103_FA49B8B5D726'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_AB0BAC4E_140A_4bbe_A103_FA49B8B5D726Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the location that is used as reference point for the dimensioning (e.g. the location of a fixing as this relates to a fixpoint of the body in white).&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;See KBLFRM-329 and KBLFRM-391.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_AB0BAC4E_140A_4bbe_A103_FA49B8B5D726'/>
					</ownedComment>
