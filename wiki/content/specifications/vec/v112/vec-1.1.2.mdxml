				<packagedElement xmi:type='uml:Association' xmi:id='EAID_F21D571F_04E1_4627_885C_68ABA23C190B'>
					<memberEnd xmi:idref='EAID_dst1D571F_04E1_4627_885C_68ABA23C190B'/>
					<memberEnd xmi:idref='EAID_src1D571F_04E1_4627_885C_68ABA23C190B'/>
