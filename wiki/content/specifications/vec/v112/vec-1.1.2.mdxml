					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_D639E05D_6FCA_41a9_A260_071F9C538059' name='boltType' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_D639E05D_6FCA_41a9_A260_071F9C538059Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the type of the bolt. This should be an enumeration of values defined in a conformance class.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_D639E05D_6FCA_41a9_A260_071F9C538059'/>
