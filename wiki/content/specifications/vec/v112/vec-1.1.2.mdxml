					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_47007741_FE5F_4e45_91DB_3CBE5FE53878' name='outerDiameter' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_47007741_FE5F_4e45_91DB_3CBE5FE53878Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the outer diameter of the tube. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
