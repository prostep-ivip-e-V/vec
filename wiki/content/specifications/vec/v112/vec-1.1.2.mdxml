				<packagedElement xmi:type='uml:Class' xmi:id='EAID_B4BA9927_24FD_4a91_8D98_944B8F392F1E' name='Role' isAbstract='true'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B4BA9927_24FD_4a91_8D98_944B8F392F1EDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A Role is the corresponding mechanism for OccurrenceOrUsages to the PartOrUsageRelatedSpecifcations for PartVersions or PartUsages. The PartOrUsageRelatedSpecifcations are describing a certain aspect of the master data of a part. A Role describes the corresponding properties and relationships for instances of a part (e.g. the usage specific properties of a wire occurrence like the length or the contacting).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_B4BA9927_24FD_4a91_8D98_944B8F392F1E'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_32582C4A_AF7D_4344_9C91_B5E22805569D' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_F23ED184_97C4_492b_AE53_8C50559BAB91' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F23ED184_97C4_492b_AE53_8C50559BAB91Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies a unique identification of the Role. The identification is guaranteed to be unqiue within the OccurrenceOrUsage.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_F23ED184_97C4_492b_AE53_8C50559BAB91'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000993_97C4_492b_AE53_8C50559BAB91'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000994_97C4_492b_AE53_8C50559BAB91' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_DD988C0F_CB88_4006_8203_D3B8AC2F10B3' name='SpecificRole'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_DD988C0F_CB88_4006_8203_D3B8AC2F10B3Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A SpecificRole is the possibility to define instance specific properties with custom properties (see ExtendableElement). This is necessary, if the part is described by custom properties of a PartOrUsageRelatedSpecification.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_DD988C0F_CB88_4006_8203_D3B8AC2F10B3'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_619D5738_7F5F_4f4a_932C_23A7C4E2E891' isSubstitutable='false' general='EAID_B4BA9927_24FD_4a91_8D98_944B8F392F1E'/>
