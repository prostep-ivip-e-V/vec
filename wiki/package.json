{
  "name": "ecad-wiki",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "ECAD-WIKI (VEC & KBL) built with Hugo and the HugoBlox Kit",
  "scripts": {
    "dev": "${HUGO:-hugo} server --disableFastRender",
    "build": "${HUGO:-hugo} --minify && pnpm run pagefind",
    "pagefind": "pagefind --site public",
    "search:dev": "${HUGO:-hugo} --minify -d .pagefind-build && pagefind --site .pagefind-build --output-path static/pagefind && rm -rf .pagefind-build"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.10",
    "pagefind": "^1.4.0",
    "preact": "^10.27.2",
    "tailwindcss": "^4.1.12"
  }
}
