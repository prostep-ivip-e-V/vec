				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1434102900071_785352_3105'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1434102900071_643322_3106'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1434102900071_463319_3107'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444985675904_857202_2881' body='Specifies the change history of the SheetOrChapter.'>
