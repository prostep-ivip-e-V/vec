							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000754__39CF_4819_99D5_3F08E07B44A8' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_29CF5F17_BAD8_450c_9F0F_997B7B168B39'>
					<memberEnd xmi:idref='EAID_dstCF5F17_BAD8_450c_9F0F_997B7B168B39'/>
					<memberEnd xmi:idref='EAID_srcCF5F17_BAD8_450c_9F0F_997B7B168B39'/>
