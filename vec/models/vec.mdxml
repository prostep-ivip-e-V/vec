						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637842151445_738555_6318' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1676478858503_431572_6212' name='placedNodeViewItems' visibility='public' aggregation='composite' type='_19_0_2_854026d_1676478858467_137724_6210' association='_19_0_2_854026d_1676478858503_402048_6211'>
