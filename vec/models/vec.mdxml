					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst138F21_717D_4f04_8359_1316736CD5C4' name='voltageInformation' visibility='public' aggregation='composite' type='EAID_8FACD74F_822F_4352_B855_91862C3A2554' association='EAID_41138F21_717D_4f04_8359_1316736CD5C4'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000509__717D_4f04_8359_1316736CD5C4'/>
