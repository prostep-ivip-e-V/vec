				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1434102659333_873069_2642'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1434102659333_10441_2643'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1434102659333_282230_2644'/>
