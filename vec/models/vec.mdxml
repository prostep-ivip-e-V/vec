					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_A8C0D7FD_6ED1_4238_A031_B2019084A04C' name='type' visibility='public' type='EAID_EE1405E2_6E7F_4600_B37B_1E0685900E23'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A8C0D7FD_6ED1_4238_A031_B2019084A04CDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the type of the harness geometry. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_A8C0D7FD_6ED1_4238_A031_B2019084A04C'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000925_6ED1_4238_A031_B2019084A04C' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000926_6ED1_4238_A031_B2019084A04C' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst59F7F9_C481_498a_B9B7_D6E1AB72F77B' name='buildingBlockPositionings' visibility='public' aggregation='composite' type='EAID_01DC0D50_DF57_4bd3_AF3F_78E2742BA879' association='EAID_2E59F7F9_C481_498a_B9B7_D6E1AB72F77B'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000927__C481_498a_B9B7_D6E1AB72F77B'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000928__C481_498a_B9B7_D6E1AB72F77B' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst012ADE_694B_4d24_9234_9B21655B8933' name='geometryType' visibility='public' type='EAID_EE1405E2_6E7F_4600_B37B_1E0685900E23' association='EAID_75012ADE_694B_4d24_9234_9B21655B8933'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000929__694B_4d24_9234_9B21655B8933'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000930__694B_4d24_9234_9B21655B8933' value='1'/>
