						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002137__409E_4dff_A889_ECCBD7B723BB'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002138__409E_4dff_A889_ECCBD7B723BB' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_B9672B89_1709_467a_97EC_731DBF20CA19' name='VariantConfiguration'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B9672B89_1709_467a_97EC_731DBF20CA19Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A variant configuration defines a condition with which it is possible to express the inclusion or exclusion of ConfigurableElements in different variants of a product.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;A &lt;i&gt;VariantConfiguration &lt;/i&gt;can reference another &lt;i&gt;VariantConfiguration&lt;/i&gt; as &lt;i&gt;baseInclusion&lt;/i&gt;. In this case, a &lt;i&gt;VariantConfiguration&lt;/i&gt; can only be satisfied if its &lt;i&gt;baseInclusion &lt;/i&gt;is also satisfied.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_B9672B89_1709_467a_97EC_731DBF20CA19'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_461E03AC_FD4C_4021_AAAF_FD785AD2CFC4' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_F6EA42F2_6A46_4864_A4B5_4B40C155ACB3' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F6EA42F2_6A46_4864_A4B5_4B40C155ACB3Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the variant configuration. The identification is guaranteed to be unique within the specification and does not change over the time.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_F6EA42F2_6A46_4864_A4B5_4B40C155ACB3'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002139_6A46_4864_A4B5_4B40C155ACB3'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002140_6A46_4864_A4B5_4B40C155ACB3' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_22CFF3FF_0792_4922_9CA8_EFAC84037DA8' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_22CFF3FF_0792_4922_9CA8_EFAC84037DA8Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;On optional human readable description of the variant configuration.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_22CFF3FF_0792_4922_9CA8_EFAC84037DA8'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002141_0792_4922_9CA8_EFAC84037DA8'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002142_0792_4922_9CA8_EFAC84037DA8' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_239F5A45_B431_44b4_9039_B40A7C29BD32' name='logisticControlString' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_239F5A45_B431_44b4_9039_B40A7C29BD32Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a logisticControlString which can be used if the variant management is not done by boolean logic.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_239F5A45_B431_44b4_9039_B40A7C29BD32'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002143_B431_44b4_9039_B40A7C29BD32'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002144_B431_44b4_9039_B40A7C29BD32' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_1774E987_1C8C_4334_8D75_57EFF9E72378' name='logisticControlExpression' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_1774E987_1C8C_4334_8D75_57EFF9E72378Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a logisticControlExpression expressed as boolean term.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_1774E987_1C8C_4334_8D75_57EFF9E72378'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002145_1C8C_4334_8D75_57EFF9E72378'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002146_1C8C_4334_8D75_57EFF9E72378' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_1237886F_C824_4473_A1A8_857A4C151B26' name='configurationType' visibility='public' type='_19_0_2_854026d_1637586658654_399296_6479'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_1237886F_C824_4473_A1A8_857A4C151B26Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Allows the classification of a VariantConfiguration.&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;(see KBLFRM-250, KBLFRM-314, KBLFRM-290)&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_1237886F_C824_4473_A1A8_857A4C151B26'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002147_C824_4473_A1A8_857A4C151B26'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002148_C824_4473_A1A8_857A4C151B26' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1552385794322_992389_8660' name='baseInclusion' visibility='public' type='EAID_B9672B89_1709_467a_97EC_731DBF20CA19' association='_18_5_2_854026d_1552385794321_221515_8659'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1552385806957_264862_8676'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
