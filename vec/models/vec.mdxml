						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000753__39CF_4819_99D5_3F08E07B44A8' value='1'/>
							</modelExtension>
						</xmi:Extension>
