						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000595_CAB1_4bd9_811E_D373572E6390'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
