					<memberEnd xmi:idref='_2022x_1_854026d_1703760720427_335531_4899'/>
					<memberEnd xmi:idref='_2022x_1_854026d_1703760720428_926979_4900'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1704702396341_473077_1891' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;ConfigurableElement&lt;/i&gt; that is represented by a &lt;i&gt;SignalGraphNode.&lt;/i&gt; This is expected to be some physical element of the vehicle network, that participates in signal transmission. In many cases this will be an &lt;i&gt;OccurrenceOrUsage&lt;/i&gt;, however in some cases sub elements of the &lt;i&gt;OccurrenceOrUsage &lt;/i&gt;might be relevant, e.g. a &lt;i&gt;PinComponentReference&lt;/i&gt; or a &lt;i&gt;WireElementReference.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_2022x_1_854026d_1703760720427_953402_4898'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1703760720428_926979_4900' visibility='private' type='_2022x_1_854026d_1703760511489_657786_4789' association='_2022x_1_854026d_1703760720427_953402_4898'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_2022x_1_854026d_1703760879793_676761_4942'>
					<memberEnd xmi:idref='_2022x_1_854026d_1703760879793_451857_4943'/>
					<memberEnd xmi:idref='_2022x_1_854026d_1703760879793_996679_4944'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1703760879793_996679_4944' visibility='private' type='_2022x_1_854026d_1703760514777_880636_4823' association='_2022x_1_854026d_1703760879793_676761_4942'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1703844915368_739211_5063'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1703844915368_174786_5064' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_2022x_1_854026d_1703853261457_46614_1764' name='SignalGraphRelation'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703854046660_810386_2014' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;A &lt;i&gt;SignalGraphRelation&lt;/i&gt; represents a directed association between two &lt;i&gt;SignalGraphs&lt;/i&gt;. The direction of the relationship is defined as &amp;quot;&lt;i&gt;from&amp;quot; --&amp;gt; &amp;quot;to&amp;quot;&lt;/i&gt; and the semantic is defined by the &lt;i&gt;type.&lt;/i&gt;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_2022x_1_854026d_1703853261457_46614_1764'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1703853288350_829933_1787' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1703853323115_643839_1788' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703853323119_993639_1792' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique &lt;i&gt;identification&lt;/i&gt; of the &lt;i&gt;SignalGraphRelation&lt;/i&gt;. The &lt;i&gt;identification&lt;/i&gt; is guaranteed to be unique within the &lt;i&gt;SignalGraphSpecification&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1703853323115_643839_1788'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1703853323119_156045_1793' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1703853323118_34300_1791' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1703853323117_544149_1789' name='aliasId' visibility='public' type='EAID_0BE66F11_D6D4_4aef_B63F_2D85865F9B68'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703853323119_373012_1795' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines additional identifiers for the &lt;i&gt;SignalGraphRelation&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1703853323117_544149_1789'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1703853323119_979967_1796'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1703853323119_796642_1794' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1703853323118_921996_1790' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703853323119_644114_1798' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies additional, human readable information about the &lt;i&gt;SignalGraphRelation&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1703853323118_921996_1790'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1703853323120_786864_1799'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1703853323119_422712_1797' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1703853392488_886716_1823' name='type' visibility='public' type='_2022x_1_854026d_1703853358091_307379_1804'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703853858741_732464_1916' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Defines the semantic of the relationship between the &lt;i&gt;&amp;quot;from&amp;quot;- &lt;/i&gt;and &lt;i&gt;&amp;quot;to&amp;quot;-SignalGraph.&lt;/i&gt;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1703853392488_886716_1823'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1703853411470_717886_1825' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1703853411470_34152_1826' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
