					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_E11CF25B_CD94_43c2_8A6C_25CB52AD01A9' name='HarnessDrawingSpecification2D'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E11CF25B_CD94_43c2_8A6C_25CB52AD01A9Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The HarnessDrawingSpecification2D specifies a two-dimensional drawing of a harness. A harness drawing is composed of one or more BuildingBlockSpecifaction2D which are placed on the drawing.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_E11CF25B_CD94_43c2_8A6C_25CB52AD01A9'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_1B08A60F_1E2D_4f5e_B39C_A63A0B9D0537' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst072CF0_9B5C_476e_A9C1_D972897E6C28' name='buildingBlockPositionings' visibility='public' aggregation='composite' type='EAID_4F827F73_D4A0_4aeb_B3DD_E9617F6506F6' association='EAID_D8072CF0_9B5C_476e_A9C1_D972897E6C28'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000827__9B5C_476e_A9C1_D972897E6C28' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000828__9B5C_476e_A9C1_D972897E6C28' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_0D722B52_1853_47b7_9F03_251267179AB8' name='OccurrenceOrUsageViewItem2D'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_0D722B52_1853_47b7_9F03_251267179AB8Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An OccurrenceOrUsageViewItem2D specifies the representation of an OccurrenceOrUsage in a 2DDrawing.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_0D722B52_1853_47b7_9F03_251267179AB8'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_99A6B3B1_15B0_4d85_BFBD_46FF293E0FFE' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_43A5CA02_0C8C_414f_A5FB_0C993AC95E1B' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_43A5CA02_0C8C_414f_A5FB_0C993AC95E1BDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the OccurrenceOrUsageViewItem2D. The identification is guaranteed to be unique within the BuildingBlockSpecification2D.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_43A5CA02_0C8C_414f_A5FB_0C993AC95E1B'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000829_0C8C_414f_A5FB_0C993AC95E1B' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000830_0C8C_414f_A5FB_0C993AC95E1B' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_3F8D95BA_9469_460d_A860_678D45B9B719' name='aliasId' visibility='public' type='EAID_0BE66F11_D6D4_4aef_B63F_2D85865F9B68'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_3F8D95BA_9469_460d_A860_678D45B9B719Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies additional identifiers for the OccurrenceOrUsageViewItem2D.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_3F8D95BA_9469_460d_A860_678D45B9B719'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000831_9469_460d_A860_678D45B9B719'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000832_9469_460d_A860_678D45B9B719' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_4A64E359_8240_4af5_80E6_21D0E1222990' name='gridSquare' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_4A64E359_8240_4af5_80E6_21D0E1222990Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the grid square in which the OccurrenceOrUsageViewItem2D is placed (e.g. E/40).&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
