					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_86E842CA_0418_4592_BEE0_085885434C30' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_86E842CA_0418_4592_BEE0_085885434C30Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the Location. The identification is guaranteed to be unique within the PlacementSpecification.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_86E842CA_0418_4592_BEE0_085885434C30'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001747_0418_4592_BEE0_085885434C30' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001748_0418_4592_BEE0_085885434C30' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_8619A996_3E1F_4799_AE43_82EC3E90A6A5' name='matchingId' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_8619A996_3E1F_4799_AE43_82EC3E90A6A5Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies an identification for matching the location with a reference point of component (e.g. a cable channel). &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
