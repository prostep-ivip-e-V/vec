			</packagedElement>
			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_4EEE909F_386F_46c7_85F7_0E689527F763' name='pdm'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_5911BBEB_08F9_4594_AD35_1C9BBFA509DC' name='Approval'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_5911BBEB_08F9_4594_AD35_1C9BBFA509DCDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the approval of an ItemVersion. This consists of the StatusOfApproval and the Permissions issued for the approval.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_5911BBEB_08F9_4594_AD35_1C9BBFA509DC'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_1C569130_FEF5_4338_9F78_48F2CCB81E04' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_7F2C6EB0_E84F_4fb6_A3A9_048B76101F5C' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7F2C6EB0_E84F_4fb6_A3A9_048B76101F5CDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the approval. The identification is guaranteed to be unique over all VEC-documents. Normally this would reference to a company specific approval number or something similar. KBLFRM-349&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_7F2C6EB0_E84F_4fb6_A3A9_048B76101F5C'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001495_E84F_4fb6_A3A9_048B76101F5C'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001496_E84F_4fb6_A3A9_048B76101F5C' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_49FB2EC1_D4AC_4048_83D3_BF86366C1194' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_49FB2EC1_D4AC_4048_83D3_BF86366C1194Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Room for additional information about the item.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_49FB2EC1_D4AC_4048_83D3_BF86366C1194'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001497_D4AC_4048_83D3_BF86366C1194'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001498_D4AC_4048_83D3_BF86366C1194' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_06835B9D_0CC4_4595_86D4_6AB7E8AD0F28' name='companyInScope' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_06835B9D_0CC4_4595_86D4_6AB7E8AD0F28Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Room to specify for which companies the Approval is valid. It might be e.g. that an approved Item may only be delivered by some specific company.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_06835B9D_0CC4_4595_86D4_6AB7E8AD0F28'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001499_0CC4_4595_86D4_6AB7E8AD0F28'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001500_0CC4_4595_86D4_6AB7E8AD0F28' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_A5B42EBE_BA14_4c83_ADE5_AD848D314298' name='status' visibility='public' type='EAID_30559659_C213_47f6_8220_2A0C7F9B4F9F'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A5B42EBE_BA14_4c83_ADE5_AD848D314298Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The approval level concerning approval status. Predefined are the values: NotYetApproved, Approved and Withdrawn. The status refers to the status of the &lt;i&gt;Approval&lt;/i&gt;, not the status of the &lt;i&gt;ItemVersion. &lt;/i&gt;So, e.g. withdrawn means the approval (with its corresponding level) has been withdrawn, not the &lt;i&gt;ItemVersion&lt;/i&gt; itself.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_A5B42EBE_BA14_4c83_ADE5_AD848D314298'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001501_BA14_4c83_ADE5_AD848D314298' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001502_BA14_4c83_ADE5_AD848D314298' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_A83B83B4_89FB_4a6a_97B1_9321ED4DEA79' name='levelOfApproval' visibility='public' type='_19_0_2_854026d_1576070593497_890699_5805'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A83B83B4_89FB_4a6a_97B1_9321ED4DEA79Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Relates to activities that are allowed with the ItemVersion after release for example building pilot tools or production tools. The levelOfApproval applies to the &lt;i&gt;ItemVersion &lt;/i&gt;itself without further detailing or additional context. So, for example &amp;quot;Free&amp;quot; means, that from a component&#39;s perspective the corresponding &lt;i&gt;PartVersion&lt;/i&gt; has satisfied all qualification procedures and can be used within its specified limits without restriction.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;The levels &lt;i&gt;Planned&lt;/i&gt;, &lt;i&gt;Free&lt;/i&gt;, &lt;i&gt;Invalid&lt;/i&gt; refer to a single approval level. The levels &lt;i&gt;Develop&lt;/i&gt; and &lt;i&gt;Restricted&lt;/i&gt; refer to a category of approval levels in the lifecycle of an &lt;i&gt;ItemVersion&lt;/i&gt; that all belong to the same phase but are highly company specific. For example, &lt;i&gt;Develop&lt;/i&gt; approvals might be a &amp;quot;a start of construction approval&amp;quot; or a &amp;quot;building of prototypes or tools allowed approval&amp;quot;. &amp;quot;Restricted&amp;quot; approvals might be &amp;quot;only for special purpose vehicles&amp;quot;, &amp;quot;spare part only&amp;quot; or &amp;quot;residual parts may be used up&amp;quot;.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;In these cases, the &lt;i&gt;additionalLevelInformation&lt;/i&gt; can be used to provide further information (e.g. a company specific approval level).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_A83B83B4_89FB_4a6a_97B1_9321ED4DEA79'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001503_89FB_4a6a_97B1_9321ED4DEA79'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576070798419_726423_5825' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst376008_E02A_41d2_989D_5138A6DF8580' name='permission' visibility='public' aggregation='composite' type='EAID_0A28AF5D_CB4B_4401_8F80_774E9CC4F9F5' association='EAID_6B376008_E02A_41d2_989D_5138A6DF8580'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001507__E02A_41d2_989D_5138A6DF8580'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001508__E02A_41d2_989D_5138A6DF8580' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576071885243_607476_5837' name='additionalLevelInformation' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576072316557_936826_5841' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Additional potentially company specific information about the level of approval (e.g. further detailing of a &amp;quot;Restricted&amp;quot; approval.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1576071885243_607476_5837'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576071909448_487574_5839'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576071909448_81058_5840' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_6B376008_E02A_41d2_989D_5138A6DF8580'>
					<memberEnd xmi:idref='EAID_dst376008_E02A_41d2_989D_5138A6DF8580'/>
					<memberEnd xmi:idref='EAID_src376008_E02A_41d2_989D_5138A6DF8580'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6B376008_E02A_41d2_989D_5138A6DF8580Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the permission issued with the approval.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_6B376008_E02A_41d2_989D_5138A6DF8580'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src376008_E02A_41d2_989D_5138A6DF8580' visibility='public' type='EAID_5911BBEB_08F9_4594_AD35_1C9BBFA509DC' association='EAID_6B376008_E02A_41d2_989D_5138A6DF8580'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001575__E02A_41d2_989D_5138A6DF8580' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001576__E02A_41d2_989D_5138A6DF8580' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_F4242FED_CDA4_496a_80E8_F922CE497D97' name='ChangeDescription'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F4242FED_CDA4_496a_80E8_F922CE497D97Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A ChangeDescription describes the implemented issues that are reason for the aggregating ItemVersion to be either an initial or successor version. A ChangeDescription can optionally define the person who has approved the change.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_F4242FED_CDA4_496a_80E8_F922CE497D97'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_CF3643F2_7336_4c3f_ABC8_533E54FE35A1' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_DAAA6B43_34FB_42d7_9B1A_92C60DE35059' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_DAAA6B43_34FB_42d7_9B1A_92C60DE35059Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies an identifier for the ChangeDescription. This can be the ID of a change order or an ID which indicates model upgrading. (see KBLFRM-249)&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_DAAA6B43_34FB_42d7_9B1A_92C60DE35059'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001511_34FB_42d7_9B1A_92C60DE35059'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001512_34FB_42d7_9B1A_92C60DE35059' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_0DA93248_2086_4b6e_B5B1_AF40D3594351' name='label' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_0DA93248_2086_4b6e_B5B1_AF40D3594351Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the label of the change on a drawing for example. If more than one change is issued with one ItemVersion (e.g. change 0001, 0002), in some cases the different changes are labelled on the drawing (e.g. A, B, C).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_0DA93248_2086_4b6e_B5B1_AF40D3594351'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001513_2086_4b6e_B5B1_AF40D3594351'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001514_2086_4b6e_B5B1_AF40D3594351' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_9201435B_52AE_42d1_8953_B1A72C4E894E' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9201435B_52AE_42d1_8953_B1A72C4E894EDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies additional, human readable, information about the ChangeDescription.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_9201435B_52AE_42d1_8953_B1A72C4E894E'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001515_52AE_42d1_8953_B1A72C4E894E'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001516_52AE_42d1_8953_B1A72C4E894E' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_ABBA7779_ADA8_4b23_95D7_42F4F5020489' name='approver' visibility='public' type='EAID_5D8F100A_1350_4aff_B20E_089D64C76887'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_ABBA7779_ADA8_4b23_95D7_42F4F5020489Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the person who has approved the change.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_ABBA7779_ADA8_4b23_95D7_42F4F5020489'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001517_ADA8_4b23_95D7_42F4F5020489'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001518_ADA8_4b23_95D7_42F4F5020489' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_C4BB48CA_2882_43c0_AFF7_1BCFD1CC981F' name='changeDate' visibility='public' type='EAJava_Date'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_C4BB48CA_2882_43c0_AFF7_1BCFD1CC981FDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the date when the change was performed.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_C4BB48CA_2882_43c0_AFF7_1BCFD1CC981F'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001519_2882_43c0_AFF7_1BCFD1CC981F'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001520_2882_43c0_AFF7_1BCFD1CC981F' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_9648942D_FC66_4807_A145_854B3D87D163' name='responsibleDesigner' visibility='public' type='EAID_5D8F100A_1350_4aff_B20E_089D64C76887'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9648942D_FC66_4807_A145_854B3D87D163Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the design engineer who is/was responsible to perform the change.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_9648942D_FC66_4807_A145_854B3D87D163'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001521_FC66_4807_A145_854B3D87D163'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1500463672759_325668_2621' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_7298A3E3_3FF2_4961_A7D8_231EAC5A27D9' name='relatedChangeRequest' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7298A3E3_3FF2_4961_A7D8_231EAC5A27D9Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the identification of a corresponding change request. (see KBLFRM-249)&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_7298A3E3_3FF2_4961_A7D8_231EAC5A27D9'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001523_3FF2_4961_A7D8_231EAC5A27D9'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001524_3FF2_4961_A7D8_231EAC5A27D9' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_CBA68BA5_E0A2_46b4_B2EF_D0EA257C6839' name='Contract'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_CBA68BA5_E0A2_46b4_B2EF_D0EA257C6839Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A Contract-instance describes the relationship between an ItemVersion-instance and a Company-instance additionally defining the role the company takes in reference to the ItemVersion.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_CBA68BA5_E0A2_46b4_B2EF_D0EA257C6839'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_61A16D13_62C2_4580_8C24_7E5B9C29AE84' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_1370C167_E4B5_4860_8B5A_0C5296DFF05C' name='companyName' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_1370C167_E4B5_4860_8B5A_0C5296DFF05CDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the company which acts in the specified Role in the Contract Relationship.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_1370C167_E4B5_4860_8B5A_0C5296DFF05C'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001527_E4B5_4860_8B5A_0C5296DFF05C' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001528_E4B5_4860_8B5A_0C5296DFF05C' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_6FF8123A_2B85_4dc3_A095_9311B87C5A8F' name='contractRole' visibility='public' type='EAID_9BEA0EE6_AB07_42c1_B73D_BFF9AEF39507'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6FF8123A_2B85_4dc3_A095_9311B87C5A8FDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The role the company takes in reference to the associated ItemVersion. Predefined are the values: OEM, Supplier and Manufacturer.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_6FF8123A_2B85_4dc3_A095_9311B87C5A8F'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001529_2B85_4dc3_A095_9311B87C5A8F' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001530_2B85_4dc3_A095_9311B87C5A8F' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='EAID_9BEA0EE6_AB07_42c1_B73D_BFF9AEF39507' name='ContractRole'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9BEA0EE6_AB07_42c1_B73D_BFF9AEF39507Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Enumeration for the definition of roles a contractor has in a contract.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_9BEA0EE6_AB07_42c1_B73D_BFF9AEF39507'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_36FC0964_5CDF_444a_AB7E_79335BE13727' name='Oem'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_63D76EAA_8D9E_4b29_AAC7_307A4F0DAD13' name='Supplier'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_03CAF247_CED2_411c_9CF3_65B9EAADB3CE' name='Manufacturer'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_F14ECF2E_70FE_4b82_B2A5_303093345609' name='CopyrightInformation'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F14ECF2E_70FE_4b82_B2A5_303093345609Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A CopyrightInformation-instance specifies copyright information for one or more Items.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_F14ECF2E_70FE_4b82_B2A5_303093345609'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_926D7D67_3E74_41d5_9C62_7789DEA89802' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_8F0DAB87_0F6B_496d_826F_D2AF65DA23F9' name='copyrightNote' visibility='public' type='EAID_6E33CD1B_63D7_4da8_BED4_828037944989'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_8F0DAB87_0F6B_496d_826F_D2AF65DA23F9Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An informal text which specifies copyright information.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_8F0DAB87_0F6B_496d_826F_D2AF65DA23F9'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001537_0F6B_496d_826F_D2AF65DA23F9' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481105215094_694638_3166' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_33FD2A54_5899_4e5c_8191_8D440CBECAC7' name='Creation'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_33FD2A54_5899_4e5c_8191_8D440CBECAC7Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;A Creation-instance provides additional information to the owning ItemVersion stating personal information on the creator and the creation date.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_33FD2A54_5899_4e5c_8191_8D440CBECAC7'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_1754B2FF_31C9_4832_B2D7_85E3FFC2856F' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_A5366E29_D8A0_4bd4_9EA2_B740AA459AE5' name='creationDate' visibility='public' type='EAJava_Date'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A5366E29_D8A0_4bd4_9EA2_B740AA459AE5Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the date when the associated ItemVersion was created.&#10;(see KBLFRM-241)&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_A5366E29_D8A0_4bd4_9EA2_B740AA459AE5'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001543_D8A0_4bd4_9EA2_B740AA459AE5' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001544_D8A0_4bd4_9EA2_B740AA459AE5' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_B1A29D04_E544_4ebf_9286_4BA6DE864C0A' name='creator' visibility='public' type='EAID_5D8F100A_1350_4aff_B20E_089D64C76887'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B1A29D04_E544_4ebf_9286_4BA6DE864C0ADocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the person who has created the Item.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_B1A29D04_E544_4ebf_9286_4BA6DE864C0A'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001545_E544_4ebf_9286_4BA6DE864C0A'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001546_E544_4ebf_9286_4BA6DE864C0A' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_1FD497E0_F4BE_486e_8D32_11E528BA954C' name='responsibleDesigner' visibility='public' type='EAID_5D8F100A_1350_4aff_B20E_089D64C76887'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_1FD497E0_F4BE_486e_8D32_11E528BA954CDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the person, which is the responsible designer for the ItemVersion at the point of creation.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_1FD497E0_F4BE_486e_8D32_11E528BA954C'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001547_F4BE_486e_8D32_11E528BA954C'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001548_F4BE_486e_8D32_11E528BA954C' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='EAID_FDDE36EE_AD4F_4a62_B34E_A1DCCF0A3F21' name='HistoryEntryType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_FDDE36EE_AD4F_4a62_B34E_A1DCCF0A3F21Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Enumeration for the definition of the type of relationship represented by an ItemHistoryEntry. (see KBLFRM-271)&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_FDDE36EE_AD4F_4a62_B34E_A1DCCF0A3F21'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_5FA767B9_3BF1_474d_BE0C_1F235DDF2129' name='Derivation'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_2EBB5061_A645_4f33_A571_90A521B71E48' name='Sequence'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_53FAD1D4_D466_42d7_B6DC_062AED806D4A' name='ItemEquivalence'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_53FAD1D4_D466_42d7_B6DC_062AED806D4ADocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines two or more ItemVersions to be equivalent out of the view of a certain company. The ItemEquivalence class will most likely be used by a company to express which PartNumber a certain PartVersion has in the context of other companies (same applies to &lt;i&gt;DocumentVersions&lt;/i&gt;). However, for every other company separate ItemEquivalences are needed as the statement of equivalence can be very subjective.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_53FAD1D4_D466_42d7_B6DC_062AED806D4A'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_FC641444_39EE_4d26_9854_61C998B84B52' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_992984E8_4FAF_4bd2_A76E_AEE7A42DA94D' name='companyName' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_992984E8_4FAF_4bd2_A76E_AEE7A42DA94DDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the company which states the ItemEquivalence.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_992984E8_4FAF_4bd2_A76E_AEE7A42DA94D'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001551_4FAF_4bd2_A76E_AEE7A42DA94D' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001552_4FAF_4bd2_A76E_AEE7A42DA94D' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst9F9839_D460_4d4e_A5D8_68F4B836C672' name='item' visibility='public' type='EAID_32C19FD5_E9AC_4356_94A9_0A621DB4874C' association='EAID_F19F9839_D460_4d4e_A5D8_68F4B836C672'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001555__D460_4d4e_A5D8_68F4B836C672' value='2'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001556__D460_4d4e_A5D8_68F4B836C672' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_67A61EC6_F3DE_4eb2_9D72_20AB55936296' name='ItemHistoryEntry'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_67A61EC6_F3DE_4eb2_9D72_20AB55936296Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;An ItemHistroyEntry defines the direct relationship between ItemVersions in the terms of predecessor and successor. There are two possible types of relationships between ItemVersions, derivation and sequence.&#10;Derivation means for example for parts, that the successor version is a new part developed on the base of the predecessor version. Sequence means the successor version is an improvement of the predecessor version. &#10;By the combination of more than one ItemHistoryEntry a linear sequence of ItemVersions can be represented. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_67A61EC6_F3DE_4eb2_9D72_20AB55936296'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_741CEC96_4B86_4a9c_998F_EE0883D31B0C' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_B14F0CC1_A27B_493a_83B0_BAEA936A0FA3' name='type' visibility='public' type='EAID_FDDE36EE_AD4F_4a62_B34E_A1DCCF0A3F21'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B14F0CC1_A27B_493a_83B0_BAEA936A0FA3Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the type of relationship between the ItemVersions.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_B14F0CC1_A27B_493a_83B0_BAEA936A0FA3'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001557_A27B_493a_83B0_BAEA936A0FA3' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001558_A27B_493a_83B0_BAEA936A0FA3' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst2ECFA4_C83B_45b0_934C_C03D6ABBCE87' name='predecessorVersion' visibility='public' type='EAID_32C19FD5_E9AC_4356_94A9_0A621DB4874C' association='EAID_3F2ECFA4_C83B_45b0_934C_C03D6ABBCE87'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001561__C83B_45b0_934C_C03D6ABBCE87' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001562__C83B_45b0_934C_C03D6ABBCE87' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstB849F0_35D2_4310_8D27_D9AA9D3ACC67' name='successorVersion' visibility='public' type='EAID_32C19FD5_E9AC_4356_94A9_0A621DB4874C' association='EAID_EDB849F0_35D2_4310_8D27_D9AA9D3ACC67'>
