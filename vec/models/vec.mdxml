				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1383653159551_93186_6779'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1383653159551_121832_6780'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1383653159551_782489_6781'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1384789485953_826075_2865' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;PlacementPointReference &lt;/i&gt;that is placed by this location.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
