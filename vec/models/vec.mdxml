					<memberEnd xmi:idref='_19_0_2_854026d_1575890595928_505059_5367'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1575890767632_714876_5412' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;If this &lt;i&gt;TopologyNode&lt;/i&gt; is an instance of another &lt;i&gt;To&lt;/i&gt;&lt;i&gt;pologyNode &lt;/i&gt;that is defined elsewhere (e.g. the topology of an assembly), then the instantiated may be referenced here.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1575890595926_888535_5365'/>
