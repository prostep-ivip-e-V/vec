						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1572949666581_502655_5361' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Room for a human readable short name, title etc. of the VariantGroup.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1572949666578_453739_5359'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1572949666581_523546_5362'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
