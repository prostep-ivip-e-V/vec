				<packagedElement xmi:type='uml:Class' xmi:id='EAID_4264371B_C788_4b51_BF25_109E482A6571' name='SlotSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_4264371B_C788_4b51_BF25_109E482A6571Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specification for the definition of slots.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
