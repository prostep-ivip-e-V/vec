					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637841797595_200730_6032' visibility='private' type='_19_0_2_854026d_1637841797589_945570_6008' association='_19_0_2_854026d_1637841797592_803368_6012'>
