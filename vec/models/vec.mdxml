						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1522919479001_797678_7532' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;If this attribute is &lt;i&gt;true&lt;/i&gt;, the &lt;i&gt;WireElementReference&lt;/i&gt; is not connected (unused) on purpose. This can be the case for example if a multi core is used, but not all cores are necessary in a specific situation.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;However, for all &lt;i&gt;WireElements&lt;/i&gt; defined in the &lt;i&gt;WireSpecification&lt;/i&gt; a corresponding &lt;i&gt;WireElementReference&lt;/i&gt; shall exist. This attribute can be used to mark these unused cores explicitly.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1522919394954_595787_7527'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1522919423816_435528_7529'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1522919423816_324508_7530' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<defaultValue xmi:type='uml:LiteralBoolean' xmi:id='_18_5_2_854026d_1522919434768_540641_7531'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1559921462081_46272_7515' name='connectionGroup' visibility='public' type='EAID_AB4FE7A9_D417_43b4_8D6D_EC1070903C34' association='_18_5_2_854026d_1559921462078_605645_7514'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1559921465452_42635_7531'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1559921465453_822263_7532' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1638191738468_500017_5491' name='labelValue' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1638191865651_742943_5495' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Specifies the value of label, if this &lt;i&gt;WireElementReference&lt;/i&gt; is labled.&lt;/body&gt;&#10;&lt;/html&gt;'>
