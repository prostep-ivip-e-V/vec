						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000129__7098_4fd7_8AAF_836DB97695C4'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000130__7098_4fd7_8AAF_836DB97695C4' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1528363075439_507037_6510' name='referencedExternalDocuments' visibility='public' type='EAID_5633EDF6_2E97_4d20_A4A5_B4F9F9662F77' association='_18_5_2_854026d_1528363075437_527110_6509'>
