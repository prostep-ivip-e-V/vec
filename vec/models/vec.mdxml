					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_B91FD1E9_8E5B_4027_AFED_B567C4F1FFE5' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B91FD1E9_8E5B_4027_AFED_B567C4F1FFE5Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Room for additional, human readable information about the NetworkPort.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_B91FD1E9_8E5B_4027_AFED_B567C4F1FFE5'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001327_8E5B_4027_AFED_B567C4F1FFE5'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_854026d_1382705336888_543919_2810' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_EEDCF23A_0C82_4d1d_B9C5_A26901B94092'>
					<memberEnd xmi:idref='EAID_dstDCF23A_0C82_4d1d_B9C5_A26901B94092'/>
					<memberEnd xmi:idref='EAID_srcDCF23A_0C82_4d1d_B9C5_A26901B94092'/>
