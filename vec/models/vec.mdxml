					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstCCA066_BC3C_4dcd_86C6_33B4CBC23700' name='placementPoint' visibility='public' type='EAID_1C710815_9E4A_4f20_A982_B2B4373EC80C' association='EAID_79CCA066_BC3C_4dcd_86C6_33B4CBC23700'>
