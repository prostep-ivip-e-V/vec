				<packagedElement xmi:type='uml:Enumeration' xmi:id='_19_0_2_854026d_1637586658654_399296_6479' name='VariantConfigurationType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637586767377_973652_6503' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Defines an OpenEnumeration for VariantConfigurationTypes. The configuration type defines in which &amp;quot;variant code universe&amp;quot; the logistic control expression is defined. &lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637586658654_399296_6479'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1637586713989_705885_6499' name='Logistic'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637586887827_600277_6504' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;The &lt;i&gt;VariantConfiguration&lt;/i&gt; is a concrete logistic key (e.g. within a vehicle project) that used for example in order /&amp;#160;delivery systems.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1637586713989_705885_6499'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1637586741400_704557_6501' name='Technical'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637587045982_694958_6505' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;The &lt;i&gt;VariantConfiguration&lt;/i&gt; is a technical (feature or function oriented) key normally used in a building block set. In a concrete vehicle project those keys are mapped to specific logistic keys within the project.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1637586741400_704557_6501'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
			</packagedElement>
			<packagedElement xmi:type='uml:PrimitiveType' xmi:id='EAJava_Date' name='Date'>
				<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1386068098570_63958_3047' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Primitive type for attributes with date and time values. During schema generation this is translated to &lt;i&gt;xs:dateTime&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
					<annotatedElement xmi:idref='EAJava_Date'/>
