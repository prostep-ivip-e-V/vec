				<packagedElement xmi:type='uml:Enumeration' xmi:id='EAID_DD60A4A1_E76A_487e_95BD_8A6EC83DEC49' name='ImperialUnitName'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385546088698_674177_2711' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Enumeration for the definition of imperial unit names.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_DD60A4A1_E76A_487e_95BD_8A6EC83DEC49'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_EFC5FF37_F9A1_420d_BC89_C218C0001DC3' name='Thou'/>
