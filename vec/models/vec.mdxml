							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000073__148C_47d4_BD76_D1BF99FEC8F9' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000074__148C_47d4_BD76_D1BF99FEC8F9' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst150999_7CEF_4f91_B246_03404B30FA25' name='contactedWireReception' visibility='public' type='EAID_EA68DAC2_F465_4d3e_9580_B7E2E595B2B8' association='EAID_A5150999_7CEF_4f91_B246_03404B30FA25'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000075__7CEF_4f91_B246_03404B30FA25' value='1'/>
							</modelExtension>
