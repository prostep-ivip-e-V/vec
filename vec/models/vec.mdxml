					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_75012ADE_694B_4d24_9234_9B21655B8933Documentation' body='Specifies the type of geometry. Valid values are Dmu, Formboard.&#10;'>
						<annotatedElement xmi:idref='EAID_75012ADE_694B_4d24_9234_9B21655B8933'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src012ADE_694B_4d24_9234_9B21655B8933' visibility='public' type='EAID_E25461E0_44ED_4a3c_8F3E_8A5AB08AA53D' association='EAID_75012ADE_694B_4d24_9234_9B21655B8933'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_E25461E0_44ED_4a3c_8F3E_8A5AB08AA53D' name='HarnessGeometrySpecification3D'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E25461E0_44ED_4a3c_8F3E_8A5AB08AA53DDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The HarnessGeometrieSpecification3D specifies a three-dimensional model of a harness. A harness model is composed of one or more BuildingBlockSpecifaction3D which are placed in the model.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_E25461E0_44ED_4a3c_8F3E_8A5AB08AA53D'/>
					</ownedComment>
