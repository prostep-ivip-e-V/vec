				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_0EAC9B4D_4631_46ec_8465_4932EC3C01C4' name='ExternalMappingSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1384781973990_823269_2768' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An&lt;i&gt; ExternalMappingSpecification &lt;/i&gt;is used to define a mapping between an external data source (represented by the referenced &lt;i&gt;mappedDocument&lt;/i&gt;) and the content of a VEC file.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_0EAC9B4D_4631_46ec_8465_4932EC3C01C4'/>
					</ownedComment>
