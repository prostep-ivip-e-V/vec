				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1474961922875_708404_2899' name='ComponentConnector'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1474962329592_978556_2996' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;ComponentConnector&lt;/i&gt; is a grouping of &lt;i&gt;ComponentPorts&lt;/i&gt; and represents a logical abstraction of a connector of an &lt;i&gt;EEComponent&lt;/i&gt;. When the &lt;i&gt;ComponentNode&lt;/i&gt; is realized by an &lt;i&gt;EEComponentRole&lt;/i&gt; the &lt;i&gt;ComponentConnector&lt;/i&gt; will result in a &lt;i&gt;HousingComponent.&lt;/i&gt; &#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;It is permitted that a &lt;i&gt;ComponentConnector&lt;/i&gt; is a 150% definition of connector.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1474961922875_708404_2899'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1474961995910_424745_2945' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst13901F_0860_4049_8413_F276D1491AD9' name='componentPort' visibility='public' aggregation='composite' type='EAID_0958CE37_2D47_4de5_A271_FBA12B648821' association='EAID_3A13901F_0860_4049_8413_F276D1491AD9'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension/>
						</xmi:Extension>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001847__0860_4049_8413_F276D1491AD9'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001848__0860_4049_8413_F276D1491AD9' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1474962005363_380999_2947' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension/>
						</xmi:Extension>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1474962081583_392804_2951' body='Specifies a unique identification of the ComponentConnector. The identification is guaranteed to be unique within the ComponentNode.'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474962005363_380999_2947'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1474962027635_372122_2949' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1474962027635_512061_2950' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1474962093469_184753_2952' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension/>
						</xmi:Extension>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1474962121563_489577_2954'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1474962121563_808934_2955' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1474962242671_836226_2959'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1474962242671_552744_2960'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1474962242671_33083_2961'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1474962296553_663959_2995' body='Specifies the ComponentConnectors of a ComponentNode.'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1474962242671_836226_2959'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1474962242671_33083_2961' visibility='private' type='EAID_2366C143_0118_4513_A322_B90CA1259619' association='_17_0_2_4_854026d_1474962242671_836226_2959'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1474962248709_425772_2983' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1474962248709_49068_2984' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1474965338391_585781_3273' name='ComponentNodeType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1474965338395_608810_3285' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the common agreed values for the types of a ComponentNode.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965338391_585781_3273'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965338393_586872_3274' name='ECU'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583769878558_19441_5453' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Electronic Control Unit. An electronic control unit (ECU) is any embedded system in automotive electronics that controls one or more of the electrical systems or subsystems in a vehicle.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965338393_586872_3274'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965338393_76107_3275' name='Sensor'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583769893629_395395_5454' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A sensor is a device that detects changes to the environment and sends them as information to other devices (e.g. an ECU).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965338393_76107_3275'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965338394_993762_3276' name='Actuator'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583769913219_964392_5455' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An actuator is a device that is responsible for controlling or moving a mechanism.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965338394_993762_3276'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965338394_425337_3277' name='CouplingDevice'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583769931671_981755_5456' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A CouplingDevice is the (virtual) device that separates / connects two or more wiring harnesses. &amp;quot;Virtual&amp;quot; because it can be interpreted as a device / interface definition between the harnesses, where one harness behaves like an E/E component form the point of view of the other harness.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965338394_425337_3277'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965338394_337890_3278' name='EnergyStorage'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583769942650_63318_5457' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A device that stores energy in some kind of way (e.g. a battery).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965338394_337890_3278'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965338394_338340_3279' name='Generator'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583769956024_85859_5458' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A device that can generate energy.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965338394_338340_3279'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965338395_436719_3280' name='PowerDistribution'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583769972326_371029_5459' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A device that distributes power to other devices (e.g. a fuse box).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965338395_436719_3280'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965338395_407023_3281' name='Switch'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583769987494_377048_5460' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &amp;quot;Switch&amp;quot; is a device that can change its internal connectivity in reaction to some external action (e.g. connect /&amp;#160;disconnect&amp;#160;some pins). A switch has no &amp;quot;active&amp;quot; logic (in contrast to an ECU).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965338395_407023_3281'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965338395_777437_3282' name='Lamp'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1571403331233_766535_6430' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965338395_777437_3282'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965338395_59158_3283' name='Relay'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1571403477324_231167_6431' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965338395_59158_3283'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965338395_817995_3284' name='Fuse'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1571403548916_11344_6432' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965338395_817995_3284'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965431594_887212_3319' name='Ground'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1474965445267_903474_3323' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines that this ComponentNode is a grounding point.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965431594_887212_3319'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1535553982023_876585_8081' name='OpenEnd'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1535554005593_646297_8083' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines that this ComponentNode is the end point for some unconnected connections that require wires and routings in the resulting harness (e.g. an antenna). A component node of this type is used whenever connections shall not be connected (on one side), regardless if it is an individual wire or a core of a multi core wire.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1535553982023_876585_8081'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965434795_191743_3321' name='OpenLink'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1474965464620_173794_3324' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines that this ComponentNode is an OpenLink. In the description of partial systems, it can be necessary to reference a ComponentNode that is not defined in the scope of the partial system (e.g. vehicle infrastructure like power, ground, bus systems). OpenLinks must be resolved and replaced by a determined ComponentNode when a partial system is integrated into a vehicle system.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965434795_191743_3321'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1637074414360_952380_5427' name='PotentialDistributor'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637074428858_915540_5429' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A passive device that distributes one or more potentials. Splits a network into different Connections with the same Signal.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1637074414360_952380_5427'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_18_5_2_854026d_1539593767598_738645_6177' name='ConnectionGroupType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1539593872138_997295_6198' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the type of physical realization that is expressed by a &lt;i&gt;ConnectionGroup.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1539593767598_738645_6177'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1539593928972_612516_6199' name='Twisted'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1539593939016_339621_6201' name='Shielded'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1539593952788_185978_6203' name='Coaxial'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_18_5_2_854026d_1571402630146_160334_6137' name='ComponentNodeSubType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1571403617352_117761_6452' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines agreed values for &lt;i&gt;ComponentNodeSubTypes&lt;/i&gt;. Not all combinations of &lt;i&gt;ComponentNodeSubTypes&lt;/i&gt; and &lt;i&gt;ComponentNodeTypes&lt;/i&gt; are semantically correct (e.g.&amp;#160;Lamp, Microphone, Speaker, Motor are all Actuators).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1571402630146_160334_6137'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1571403601438_931663_6434' name='Lamp'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1571403601438_115432_6435' name='Relay'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1571403601438_820107_6436' name='Fuse'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1571403601438_153570_6437' name='Microphone'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1571403601438_430445_6438' name='Speaker'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1571403601438_237015_6439' name='Motor'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_19_0_2_854026d_1637077664662_843106_5540' name='ConnectionEndGender'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637077664662_423679_5544' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the gender of a connetion end.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637077664662_843106_5540'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1637077664662_170854_5541' name='Male'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1637077664662_414867_5542' name='Female'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1637077664662_54924_5543' name='Unspecified'>
