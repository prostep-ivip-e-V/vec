											<binaryObject streamContentID='BINARY-7394ed23-aff7-4fc0-9cbb-a5a8070413b8' xmi:id='_-kdrsj_XEeOszYsTzsOQxg' xsi:type='binary:StreamIdentityBinaryObject'/>
