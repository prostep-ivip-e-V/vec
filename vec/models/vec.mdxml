					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_8242DAE2_570D_404b_9473_1058BBCF26DB' name='Yard'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_FBC384BB_7466_4169_A061_0206948F61F7' name='Chain'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_BDE6E507_94D7_4497_A2D2_716A154E086B' name='Furlong'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_E7B32236_61A0_47c1_9503_2CC12513012D' name='Mile'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_790B96EF_D604_40c4_AD92_BB67AA70A71E' name='League'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_C18A3062_4D48_471e_B0A7_3721C5222378' name='FluidOunce'/>
