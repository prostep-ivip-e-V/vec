						<annotatedElement xmi:idref='EAID_67F1CAA8_11FC_4898_8B80_9418376B91D9'/>
					</ownedComment>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_DDF9FCE2_BA0A_445b_8579_4CBE1EE5C530' name='propertyType' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
