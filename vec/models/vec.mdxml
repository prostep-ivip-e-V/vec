					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_74D8AD9D_1092_404c_9C96_BAB48E0E546D' name='layoutType' visibility='public' type='_19_0_2_854026d_1637570254562_983094_6140'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_74D8AD9D_1092_404c_9C96_BAB48E0E546DDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the layout of the slot from a mechanical /&amp;#160;geometrical point of view. &#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_74D8AD9D_1092_404c_9C96_BAB48E0E546D'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000599_1092_404c_9C96_BAB48E0E546D'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000600_1092_404c_9C96_BAB48E0E546D' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_E7C7DF11_8E2F_4ca8_A008_8F57ABAA3354' name='secondaryLocking' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E7C7DF11_8E2F_4ca8_A008_8F57ABAA3354Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies whether the slot supports &amp;quot;secondary locking&amp;quot;, which refers to a locking or a lock reinforcement of the terminals in the connector, in addition to the primary locking of terminal itself (e.g. lances on the terminal). This is also often referred to as TPA&amp;#160;(Terminal Position Assurance).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_E7C7DF11_8E2F_4ca8_A008_8F57ABAA3354'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000601_8E2F_4ca8_A008_8F57ABAA3354'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000602_8E2F_4ca8_A008_8F57ABAA3354' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_F8E8A9D1_088F_4960_9516_749179F3944C' name='slotLayout' visibility='public' aggregation='composite' type='EAID_820DD5A1_6B3E_4b9b_BF59_1A353CC1E1B1' association='_17_0_2_4_854026d_1383139660433_234273_2823'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F8E8A9D1_088F_4960_9516_749179F3944CDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the layout of a slot. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_F8E8A9D1_088F_4960_9516_749179F3944C'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000603_088F_4960_9516_749179F3944C'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000604_088F_4960_9516_749179F3944C' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1703146860916_992151_2752' name='secondaryLockingType' visibility='public' type='_2022x_1_854026d_1703145317673_582605_2635'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703146895397_576872_2756' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Defines the type of the secondary locking, if the slot features a secondary locking (&lt;i&gt;secondaryLocking=true)&lt;/i&gt;.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1703146860916_992151_2752'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1703146879535_403959_2754'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1703146879535_742804_2755' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_A060DDEB_C8B0_4542_8800_1E98AB3997C8' name='numberOfCavities' visibility='public' type='_17_0_2_854026d_1382698667677_845864_2388'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A060DDEB_C8B0_4542_8800_1E98AB3997C8Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;The possible number of cavities in the layout defined by the SlotSpecification. This includes all cavities in the layout. The actual Slot can define specific cavities in the layout as &quot;not available&quot;. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_A060DDEB_C8B0_4542_8800_1E98AB3997C8'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000605_C8B0_4542_8800_1E98AB3997C8' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000606_C8B0_4542_8800_1E98AB3997C8' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_4A2C1733_C494_4489_BE37_F26C073462E2' name='SpliceTerminalSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_4A2C1733_C494_4489_BE37_F26C073462E2Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specification for the definition of splice terminals.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_4A2C1733_C494_4489_BE37_F26C073462E2'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_B382A83C_BAE1_419c_AAD8_42CD858DDB0F' isSubstitutable='false' general='EAID_5D9F928A_6E6D_4895_A1B1_1FE6E28AAC51'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_450AAFDC_0CF9_49b4_8791_518DD9DABA92' name='TerminalCurrentInformation'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_450AAFDC_0CF9_49b4_8791_518DD9DABA92Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Allows the definition of valid current ranges for a terminal. A current range is always defined for a coreCrossSectionArea and a nominal voltage. Attributes of the type CurrentRangeInformation normally have the multiplicity [0..*]. This means that such an attribute can have CurrentRangeInformation entries for different coreCrossSectionAreas, nominalVoltages, environmentTemperature and mating terminals. It must not have multiple entries for the same values.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_450AAFDC_0CF9_49b4_8791_518DD9DABA92'/>
					</ownedComment>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_19F89FDA_2A1D_4690_8B37_99E2AEA6A21A' name='currentRange' visibility='public' type='EAID_CAF23CB7_00D0_48de_9B42_ADB340B9B4A8'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_19F89FDA_2A1D_4690_8B37_99E2AEA6A21ADocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the valid current range for the terminal. It is defined as a value range, because there are terminals where minimum current is needed to avoid corrosion.  &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_19F89FDA_2A1D_4690_8B37_99E2AEA6A21A'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000609_2A1D_4690_8B37_99E2AEA6A21A' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000610_2A1D_4690_8B37_99E2AEA6A21A' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_1F74C8D4_6AC6_4082_BE3E_6E3191F7FC0C' name='nominalVoltage' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_1F74C8D4_6AC6_4082_BE3E_6E3191F7FC0CDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the nominalVoltage for which the CurrentRangeInformation is valid. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_1F74C8D4_6AC6_4082_BE3E_6E3191F7FC0C'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000611_6AC6_4082_BE3E_6E3191F7FC0C'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1750079397035_8994_2361' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_9FB99D01_A0F6_4fc1_8D70_FE28DC92860A' name='coreCrossSectionArea' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9FB99D01_A0F6_4fc1_8D70_FE28DC92860ADocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the coreCrossSectionArea for which the CurrentRangeInformation is valid. The coreCrossSectionArea is a relevant information, because the thermal absorption of the core depends on the cross-section area and thus is an influence factor for the valid current range.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_9FB99D01_A0F6_4fc1_8D70_FE28DC92860A'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000613_A0F6_4fc1_8D70_FE28DC92860A' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000614_A0F6_4fc1_8D70_FE28DC92860A' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1750079476152_835846_2362' name='environmentTemperature' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1750079476156_23123_2364' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;The environment temperature for which this maximum current value is applicable. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1750079476152_835846_2362'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1750079476157_104012_2365'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1750079491054_842350_2367' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1750079694663_571541_2403' name='validForMatingTerminal' visibility='public' type='EAID_A784D820_0381_42ed_8168_0F1AE554D91B' association='_2022x_1_854026d_1750079694662_386845_2402'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1750079697986_121575_2411'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1750079697986_891756_2412' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_BE391CD2_D0D6_4a46_AC9B_E86449A36F8B' name='TerminalReception'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_BE391CD2_D0D6_4a46_AC9B_E86449A36F8BDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A TerminalReception is the area of a terminal where the contacting with another terminal (e.g. between a connector housing and a control unit) takes place. Normally the terminal reception is placed in a cavity of a connector housing.&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;This class represents such an area on the terminal.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_BE391CD2_D0D6_4a46_AC9B_E86449A36F8B'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_0A65D03D_76A2_4ade_B62E_2309701977D5' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_C1F43D42_3741_44c2_B1B2_6B1CCC1A780E' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_C1F43D42_3741_44c2_B1B2_6B1CCC1A780EDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the TerminalReception. The identification is guaranteed to be unique within the TerminalSpecification (this might be for example a reception number).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_C1F43D42_3741_44c2_B1B2_6B1CCC1A780E'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000615_3741_44c2_B1B2_6B1CCC1A780E' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000616_3741_44c2_B1B2_6B1CCC1A780E' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_EF4A6065_5B87_4009_BF37_6B4B24CE24D7' name='gender' visibility='public' type='_19_0_2_854026d_1664783268746_635559_5564'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_EF4A6065_5B87_4009_BF37_6B4B24CE24D7Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the gender of the TerminalReception. The gender is included in the TerminalReception class in order to be able to refer the same TerminalReceptionSpecification gender independent.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_EF4A6065_5B87_4009_BF37_6B4B24CE24D7'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000617_5B87_4009_BF37_6B4B24CE24D7'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000618_5B87_4009_BF37_6B4B24CE24D7' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst6012DD_14C7_4480_9569_FC41C510826D' name='terminalReceptionSpecification' visibility='public' type='EAID_F7878663_C249_4db7_A60F_15CAC078A550' association='EAID_616012DD_14C7_4480_9569_FC41C510826D'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000619__14C7_4480_9569_FC41C510826D'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000620__14C7_4480_9569_FC41C510826D' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_616012DD_14C7_4480_9569_FC41C510826D'>
					<memberEnd xmi:idref='EAID_dst6012DD_14C7_4480_9569_FC41C510826D'/>
					<memberEnd xmi:idref='EAID_src6012DD_14C7_4480_9569_FC41C510826D'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_616012DD_14C7_4480_9569_FC41C510826DDocumentation' body='References the TerminalReceptionSpecification that specifies the TerminalReception.&#10;'>
						<annotatedElement xmi:idref='EAID_616012DD_14C7_4480_9569_FC41C510826D'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src6012DD_14C7_4480_9569_FC41C510826D' visibility='public' type='EAID_BE391CD2_D0D6_4a46_AC9B_E86449A36F8B' association='EAID_616012DD_14C7_4480_9569_FC41C510826D'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000637__14C7_4480_9569_FC41C510826D'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000638__14C7_4480_9569_FC41C510826D' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_24ED0015_9AA6_449b_B087_621DAF5E7491'>
					<memberEnd xmi:idref='EAID_dstED0015_9AA6_449b_B087_621DAF5E7491'/>
					<memberEnd xmi:idref='EAID_srcED0015_9AA6_449b_B087_621DAF5E7491'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_24ED0015_9AA6_449b_B087_621DAF5E7491Documentation' body='Specifies the TerminalReceptions of the terminal described by the TerminalSpecification.&#10;'>
						<annotatedElement xmi:idref='EAID_24ED0015_9AA6_449b_B087_621DAF5E7491'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcED0015_9AA6_449b_B087_621DAF5E7491' visibility='public' type='EAID_5D9F928A_6E6D_4895_A1B1_1FE6E28AAC51' association='EAID_24ED0015_9AA6_449b_B087_621DAF5E7491'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000621__9AA6_449b_B087_621DAF5E7491' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000622__9AA6_449b_B087_621DAF5E7491' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_A15112A9_841C_4e1a_A69E_2A10DFE89EC5'>
					<memberEnd xmi:idref='EAID_dst5112A9_841C_4e1a_A69E_2A10DFE89EC5'/>
					<memberEnd xmi:idref='EAID_src5112A9_841C_4e1a_A69E_2A10DFE89EC5'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A15112A9_841C_4e1a_A69E_2A10DFE89EC5Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;TerminalReception&lt;/i&gt; that is instanced by this &lt;i&gt;TerminalReceptionReference.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_A15112A9_841C_4e1a_A69E_2A10DFE89EC5'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src5112A9_841C_4e1a_A69E_2A10DFE89EC5' visibility='public' type='EAID_511A6C32_5F48_4d32_BD82_5DD9DDA08EF7' association='EAID_A15112A9_841C_4e1a_A69E_2A10DFE89EC5'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000625__841C_4e1a_A69E_2A10DFE89EC5'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000626__841C_4e1a_A69E_2A10DFE89EC5' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_F7878663_C249_4db7_A60F_15CAC078A550' name='TerminalReceptionSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F7878663_C249_4db7_A60F_15CAC078A550Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the definition of terminal receptions. A TerminalReception is the area of a terminal where the contacting with another terminal (e.g. between a connector housing and a control unit) takes place. Normally the terminal reception is placed in a cavity of a connector housing.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_F7878663_C249_4db7_A60F_15CAC078A550'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_10A4BF66_8D20_4986_85A6_15856CF6BF1D' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_3C6DD0B8_F206_4189_9031_D976BD3AC66D' name='cavityDesign' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_3C6DD0B8_F206_4189_9031_D976BD3AC66DDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_3C6DD0B8_F206_4189_9031_D976BD3AC66D'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000627_F206_4189_9031_D976BD3AC66D'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000628_F206_4189_9031_D976BD3AC66D' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_76BCAAC7_16EF_491c_B6AD_28970C36F129' name='platingMaterial' visibility='public' type='EAID_349A4B4C_CCF4_4206_8013_AD19345723A4'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_76BCAAC7_16EF_491c_B6AD_28970C36F129Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the plating material of the terminal reception.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_76BCAAC7_16EF_491c_B6AD_28970C36F129'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000629_16EF_491c_B6AD_28970C36F129'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000630_16EF_491c_B6AD_28970C36F129' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_400AEE14_B2A1_4f2f_A9F7_878303CB0777' name='primaryLockingType' visibility='public' type='_17_0_2_4_854026d_1481282124809_543496_3294'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_400AEE14_B2A1_4f2f_A9F7_878303CB0777Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies if the terminal reception has a primary locking and of what type it is.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
