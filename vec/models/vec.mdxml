						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000757__BAD8_450c_9F0F_997B7B168B39'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000758__BAD8_450c_9F0F_997B7B168B39' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst22B3EC_EE76_4e80_8EEE_6E6DA7B60E7F' name='mappedDocument' visibility='public' type='EAID_5633EDF6_2E97_4d20_A4A5_B4F9F9662F77' association='EAID_E622B3EC_EE76_4e80_8EEE_6E6DA7B60E7F'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000759__EE76_4e80_8EEE_6E6DA7B60E7F' value='1'/>
							</modelExtension>
