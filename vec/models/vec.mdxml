					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_7971C6D6_4438_4e7d_A03A_3759612058D0' name='Drachm'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_F9AB0D6B_F8E1_43ce_9B15_0C0B3102818E' name='Ounce'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_144C37AB_B957_4bf1_B42B_F26D3A345308' name='Pound'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_7D4420EC_CC82_49b0_854E_A8FDF7D91BC4' name='Stone'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_2364723A_AA8F_40bc_B72C_252FF63334C3' name='Quarter'/>
