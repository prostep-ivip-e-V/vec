					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1575890595927_358961_5366' name='instantiatedNode' visibility='public' type='EAID_97733D04_1F62_47fb_8ED2_0448659C560D' association='_19_0_2_854026d_1575890595926_888535_5365'>
