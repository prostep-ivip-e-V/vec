						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1465909334442_609177_2640' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1465909309920_568132_2635' name='tensioningStrength' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1465909339409_911024_2641'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1465909339409_283362_2642' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1481194754221_891785_3831' name='TubeShape'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481196175247_604588_3950' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines valid shapes of the cross section of a tube.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481194754221_891785_3831'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481194855465_235935_3853' name='Circular'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481196190799_425618_3951' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The tube has circular cross section.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481194855465_235935_3853'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481194860402_94475_3855' name='NonCircular'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481196215881_942517_3952' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The tube has a cross section that is not circular.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481194860402_94475_3855'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1481194740393_896553_3812' name='TubeSlitStyle'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481195775891_347530_3946' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines valid types / styles of a slitted tube.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481194740393_896553_3812'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481194870714_550133_3857' name='Slit'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481195749033_794258_3945' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The tube has just a simple slit.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481194870714_550133_3857'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481194894676_518864_3859' name='SelfClosing'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481195732892_402782_3944' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The slit of the tube is self-closing.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481194894676_518864_3859'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481194903098_334720_3861' name='Closable'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481195692890_82785_3943' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The slit can be closed manually.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481194903098_334720_3861'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481194910814_858978_3863' name='Overlapping'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481195667878_377390_3942' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The edges of the slit are overlapping.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481194910814_858978_3863'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481194918305_140092_3865' name='TwoParts'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481195631656_476309_3941' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Two-parted tubes consist of inner tube and an outer tube (normally defined as one &lt;i&gt;PartNumber)&lt;/i&gt;. Both tubes are slit and are combined into each other during assembly, thus creating one closed tube.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481194918305_140092_3865'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1576054140076_759420_5752' name='CableLeadThroughSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576065849067_71584_5369' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;CableLeadThrough&lt;/i&gt; specifies a hole in the grommet through which wires can pass through the grommet. The &lt;i&gt;CableLeadThroughSpecification &lt;/i&gt;defines the technical properties of a &lt;i&gt;CableLeadThrough&lt;/i&gt; (or a set of similar ones).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1576054140076_759420_5752'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_2_854026d_1576054167090_492082_5775' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576054429626_270895_5812' name='type' visibility='public' type='_19_0_2_854026d_1576054359408_485110_5792'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576065994255_176393_5370' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the type of a cable lead through. Standardized values are defined in an &lt;i&gt;OpenEnumeration&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1576054429626_270895_5812'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576054455827_905991_5814'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576054455827_159962_5815' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576058831033_396495_5816' name='geometry' visibility='public' type='_19_0_2_854026d_1576066177923_513512_5371'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576058831037_150366_5822' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the geometry of a cable lead through in the sealing area. Standardized values are defined in an &lt;i&gt;OpenEnumeration&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1576058831033_396495_5816'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576058831037_716690_5823'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
