				<packagedElement xmi:type='uml:Association' xmi:id='EAID_65424818_8208_405e_AA89_CBFC17A79C1A' name='satisfies'>
					<memberEnd xmi:idref='EAID_dst424818_8208_405e_AA89_CBFC17A79C1A'/>
					<memberEnd xmi:idref='EAID_src424818_8208_405e_AA89_CBFC17A79C1A'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_65424818_8208_405e_AA89_CBFC17A79C1ADocumentation' body='References the ConnectorHousingSpecification that is describing the connector interface of the HousingComponent (e.g. Slots, Cavities, Design, Coding).&#10;'>
						<annotatedElement xmi:idref='EAID_65424818_8208_405e_AA89_CBFC17A79C1A'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src424818_8208_405e_AA89_CBFC17A79C1A' visibility='public' type='EAID_C26B3FD7_361C_485f_97C6_49E8216952D8' association='EAID_65424818_8208_405e_AA89_CBFC17A79C1A'>
