					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1572952076961_760965_5503' name='aliasId' visibility='public' type='EAID_0BE66F11_D6D4_4aef_B63F_2D85865F9B68'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1572952142836_466023_5508' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Room to specify additional identifiers for the VariantGroup.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
