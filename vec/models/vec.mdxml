						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000134_50FB_4858_AE38_C63A6DB8D937' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_0E3A2683_AB34_4eb4_A35B_0385A7EFC8E0' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
