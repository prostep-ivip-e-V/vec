				<packagedElement xmi:type='uml:Class' xmi:id='EAID_E5D349C3_720C_414c_9042_F255A66B116D' name='MeasurementPointReference'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1384789530809_593068_2866' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;MeasurementPointReference&lt;/i&gt; is the instance of a &lt;i&gt;MeasurementPoint&lt;/i&gt; in the context of an &lt;i&gt;OccurrenceOrUsage&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_E5D349C3_720C_414c_9042_F255A66B116D'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_2372492C_A13D_437b_BB91_C1387BD9F954' isSubstitutable='false' general='EAID_E9F62F83_46DB_441f_8646_40DF71DF0A54'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_C31C7F25_F9A2_4cfa_944A_9B9059276B77' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_C31C7F25_F9A2_4cfa_944A_9B9059276B77Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the MeasurementPointReference. The identification is guaranteed to be unique within the containing PlaceableElementRole.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
