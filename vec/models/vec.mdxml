						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000634_BD9D_4cca_ACA6_8C10A257469B' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst2AD3C3_479C_4519_BD63_816C2E271DF3' name='terminalType' visibility='public' aggregation='composite' type='EAID_A632D277_1F80_40e0_83B7_2FDEC62DAA16' association='EAID_8D2AD3C3_479C_4519_BD63_816C2E271DF3'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000635__479C_4519_BD63_816C2E271DF3'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000636__479C_4519_BD63_816C2E271DF3' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1694418314566_136410_2394' name='testingPullOutForce' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1694418354936_240794_2398' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The force that must be applied when the terminal is pulled back out of the housing (without further movement) in order to be able to assume that the terminal is securely latched in the housing (check that the terminal is correctly seated in the connector) and that an insertion process was successful.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1694418314566_136410_2394'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1694418330363_122032_2396'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1694418330363_684010_2397' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1638197492329_921075_5947' name='contactRangeLength' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1638197518893_659413_5952' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the length of the contact area (see diagram &amp;quot;Terminal Dimensions&amp;quot;).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
