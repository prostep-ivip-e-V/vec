				</packagedElement>
			</packagedElement>
			<packagedElement xmi:type='uml:Package' xmi:id='_19_0_2_854026d_1575038730850_323067_5440' name='pin_wire_mapping'>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1575038605272_73660_5377' name='PinWireMappingSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1575046045314_234162_5544' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;PinWireMappingSpecification&lt;/i&gt; can be used create &lt;b&gt;variance free &lt;/b&gt;mappings between a wire (represented by the contact point) and the pin of an E/E component. This is a possibility to create a shortcut in the model between a wire and its connected E/E-component (e.g. a fuse) that might be only indirectly connected to a wire (e.g. via a fuse and relay carrier). This is a relevant information for e.g. the validation of fusing. See the Pin Wire Mapping Diagram for more details.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1575038605272_73660_5377'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_2_854026d_1575038686240_469068_5424' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1575038694942_243555_5431' name='pinWireMappingPoint' visibility='public' aggregation='composite' type='_19_0_2_854026d_1575038694931_263428_5429' association='_19_0_2_854026d_1575038694942_718827_5430'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1661417162956_819409_5589'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1661417162956_237941_5590' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1575038694931_263428_5429' name='PinWireMappingPoint'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1575045954555_491813_5543' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;PinWireMappingPoint &lt;/i&gt;creates a single variance free mapping between a &lt;i&gt;ContactPoint&lt;/i&gt; and a &lt;i&gt;PinComponentReference &lt;/i&gt;within a &lt;i&gt;PinWireMappingSpecification&lt;/i&gt; (more details there)&lt;i&gt;.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1575038694931_263428_5429'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1690457322118_842497_3376' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1575038859774_322413_5502' name='pinComponentReference' visibility='public' type='EAID_F34C6B9F_C5D9_451c_8D86_8FE0309577EE' association='_19_0_2_854026d_1575038859774_671511_5501'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1575038875718_952874_5527' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1575038875719_963016_5528' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1575038864490_852465_5515' name='contactPoint' visibility='public' type='EAID_8B3836D2_4EC8_4e4e_BF3A_A728CDD854C3' association='_19_0_2_854026d_1575038864490_336348_5514'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1575038870017_158795_5523' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1575038870017_18649_5524' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1575038859774_671511_5501'>
					<memberEnd xmi:idref='_19_0_2_854026d_1575038859774_322413_5502'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1575038859774_175188_5503'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1575038859774_175188_5503' visibility='private' type='_19_0_2_854026d_1575038694931_263428_5429' association='_19_0_2_854026d_1575038859774_671511_5501'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1575038864490_336348_5514'>
					<memberEnd xmi:idref='_19_0_2_854026d_1575038864490_852465_5515'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1575038864491_155248_5516'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1575038864491_155248_5516' visibility='private' type='_19_0_2_854026d_1575038694931_263428_5429' association='_19_0_2_854026d_1575038864490_336348_5514'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1575038694942_718827_5430'>
					<memberEnd xmi:idref='_19_0_2_854026d_1575038694942_243555_5431'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1575038694942_769454_5432'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1575038694942_769454_5432' visibility='private' type='_19_0_2_854026d_1575038605272_73660_5377' association='_19_0_2_854026d_1575038694942_718827_5430'/>
				</packagedElement>
			</packagedElement>
			<packagedElement xmi:type='uml:Package' xmi:id='_19_0_2_854026d_1576163290743_352773_5604' name='assignment_groups'>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1576162837321_134089_5503' name='AssignmentGroup'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576169434842_888466_5914' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An &lt;i&gt;AssignmentGroup&lt;/i&gt; is a concept that allows the clustering of arbitrary elements in ways that are orthogonal to hierarchical and semantic structure of the VEC.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1576162837321_134089_5503'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_2_854026d_1576163066684_756285_5559' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576163155181_243073_5581' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576163155182_424476_5584' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the AssignmentGroup. The identification is guaranteed to be unique within the specification.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1576163155181_243073_5581'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576163155182_386182_5585' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576163155181_46362_5583' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576163155181_255353_5582' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576163155182_511865_5587' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies additional, human readable information about the &lt;i&gt;AssignmentGroup&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1576163155181_255353_5582'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576163155182_427305_5588'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576163155182_280828_5586' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1576162803090_897586_5496' name='AssignmentGroupSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576167830228_259292_5912' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification that contains &lt;i&gt;AssignmentGroups&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1576162803090_897586_5496'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_2_854026d_1576162803102_2005_5497' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576162837336_878246_5505' name='assignmentGroup' visibility='public' aggregation='composite' type='_19_0_2_854026d_1576162837321_134089_5503' association='_19_0_2_854026d_1576162837336_210795_5504'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576163229477_282896_5594'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576163229478_719444_5595' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1576162837336_210795_5504'>
					<memberEnd xmi:idref='_19_0_2_854026d_1576162837336_878246_5505'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1576162837336_796542_5506'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576167877226_17505_5913' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Contains the AssignmentGroups that are defined by this AssignmentGroupSpecification.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1576162837336_210795_5504'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576162837336_796542_5506' visibility='private' type='_19_0_2_854026d_1576162803090_897586_5496' association='_19_0_2_854026d_1576162837336_210795_5504'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576163233298_295000_5598' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576163233298_49527_5599' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1576163395650_458968_5606' name='DocumentRelatedAssignmentGroup'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576171033010_127988_5918' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A DocumentRelatedAssignmentGroup allows the creation of traceability links to elements in a &lt;i&gt;DocumentVersion&lt;/i&gt; for a set of VEC&amp;#160;objects. The semantic of the traceability link is defined by the &lt;i&gt;DocumentRelationType.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1576163395650_458968_5606'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_2_854026d_1576163457861_729843_5651' general='_19_0_2_854026d_1576162837321_134089_5503'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576163598868_65692_5767' name='relatedDocumentVersion' visibility='public' type='EAID_5633EDF6_2E97_4d20_A4A5_B4F9F9662F77' association='_19_0_2_854026d_1576163598868_150049_5766'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576163612577_815920_5788' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576163612577_320819_5789' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576163603642_393640_5780' name='relatedSheetOrChapter' visibility='public' type='EAID_BF3A3386_BA07_4b88_BF56_74D6B871F76F' association='_19_0_2_854026d_1576163603642_518907_5779'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576163615277_904544_5792'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576163615277_950602_5793' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576163752996_483455_5812' name='type' visibility='public' type='_19_0_2_854026d_1576163773293_826757_5817'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576163871116_866127_5841'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576163871117_789563_5842' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576163698942_973933_5808' name='relatedIdentification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576171213697_809727_5919' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;If this group relates to a specific element in the &lt;i&gt;relatedDocumentVersion&lt;/i&gt; the identifier of the element is defined in this attribute (e.g. a requirements number).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1576163698942_973933_5808'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576163734764_335598_5810'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576163734765_93962_5811' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1576163398643_824290_5628' name='FunctionalAssignmentGroup'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576171290662_218432_5920' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;FunctionalAssignmentGroup &lt;/i&gt;clusters elements that contribute to a specific function or a functional aspect. With such a group, certain functional requirements can be associated.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1576163398643_824290_5628'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_2_854026d_1576163462691_393631_5654' general='_19_0_2_854026d_1576162837321_134089_5503'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576167137499_263451_5865' name='functionalRequirements' visibility='public' type='_19_0_2_854026d_1576163910075_715533_5844'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576171381105_807540_5921' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Functional requirements that apply to the members of this group.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1576167137499_263451_5865'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576171440422_206338_5922'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576171440423_582413_5923' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1576163598868_150049_5766'>
					<memberEnd xmi:idref='_19_0_2_854026d_1576163598868_65692_5767'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1576163598868_640522_5768'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576170907610_643159_5916' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;DocumentVersion&lt;/i&gt; to which this group relates.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1576163598868_150049_5766'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576163598868_640522_5768' visibility='private' type='_19_0_2_854026d_1576163395650_458968_5606' association='_19_0_2_854026d_1576163598868_150049_5766'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576163644390_205372_5798'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576163644390_332911_5799' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1576163603642_518907_5779'>
					<memberEnd xmi:idref='_19_0_2_854026d_1576163603642_393640_5780'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1576163603642_806275_5781'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576170943094_787811_5917' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Allows a more specific relationship to a &lt;i&gt;SheetOrChapter&lt;/i&gt; within the &lt;i&gt;relatedDocumentVersion.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&lt;i&gt;&amp;#160;&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1576163603642_518907_5779'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576163603642_806275_5781' visibility='private' type='_19_0_2_854026d_1576163395650_458968_5606' association='_19_0_2_854026d_1576163603642_518907_5779'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576163663062_358464_5804'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576163663062_638326_5805' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_19_0_2_854026d_1576163773293_826757_5817' name='DocumentRelationType'>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1576163806254_357083_5837' name='ResponsibilityLink'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1576163824335_532778_5839' name='RequirementsLink'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1576163910075_715533_5844' name='FunctionalRequirement'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576171470879_601291_5924' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Allows the definition of functional requirements in an enumerable way (e.g. conformance to a certain ASIL&amp;#160;level). Attributes of this type have the multiplicity of [0..*].&amp;#160;The following restrictions apply:&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;ul&gt;&#10;      &lt;li&gt;&#10;For a combination of type &amp;amp;&amp;#160;referenceSystem only a single value is allowed. For single type&#10;&#10;      &lt;/li&gt;&#10;      &lt;li&gt;&#10;For a specific type and different references systems, multiple values are allowed.&amp;#160;However, they must express the same semantic value.&#10;&#10;      &lt;/li&gt;&#10;      &lt;li&gt;&#10;For different types multiple values are allowed.&#10;&#10;      &lt;/li&gt;&#10;    &lt;/ul&gt;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1576163910075_715533_5844'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1690456998575_750723_3252' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576167247357_46162_5867' name='type' type='_19_0_2_854026d_1576167261006_479265_5870'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576171675386_404402_5925' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The type defines to which category a requirement belongs (e.g. &amp;#160;Functional&amp;#160;Safety).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1576167247357_46162_5867'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576167327865_970423_5890'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576167327865_313684_5891' value='1'/>
							</modelExtension>
						</xmi:Extension>
