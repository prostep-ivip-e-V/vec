					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1474966874841_86319_3515' name='netType' visibility='public' type='_17_0_2_4_854026d_1474966527558_14590_3371' association='_17_0_2_4_854026d_1474966874841_71777_3514'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1474966881911_107659_3532'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1474966881911_718348_3533' value='1'/>
							</modelExtension>
