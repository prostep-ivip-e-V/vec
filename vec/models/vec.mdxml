							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_79CCA066_BC3C_4dcd_86C6_33B4CBC23700'>
					<memberEnd xmi:idref='EAID_dstCCA066_BC3C_4dcd_86C6_33B4CBC23700'/>
					<memberEnd xmi:idref='EAID_srcCCA066_BC3C_4dcd_86C6_33B4CBC23700'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_79CCA066_BC3C_4dcd_86C6_33B4CBC23700Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the &lt;i&gt;PlacementPoint&lt;/i&gt; that represents this &lt;i&gt;FittingOutlet&lt;/i&gt; in a PlaceableElementSpecification.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_79CCA066_BC3C_4dcd_86C6_33B4CBC23700'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcCCA066_BC3C_4dcd_86C6_33B4CBC23700' visibility='public' type='EAID_EDAD526C_99BC_4ff7_9CEA_82D6DAC2816C' association='EAID_79CCA066_BC3C_4dcd_86C6_33B4CBC23700'>
