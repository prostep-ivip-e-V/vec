					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481558210845_322270_2981' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;CavityAccessoryRole&lt;/i&gt; defines the instance specific properties and relationships of a cavity accessory.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481558144998_39651_2920'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1481558174751_701084_2940' general='_2022x_1_854026d_1690991494841_600836_2388'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481558179432_559172_2946' name='cavityAccessorySpecification' visibility='public' type='_17_0_2_4_854026d_1481557795285_418054_2862' association='_17_0_2_4_854026d_1481558179432_27262_2945'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481558195024_6704_2969' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481558195025_823833_2970' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1481558179432_27262_2945'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1481558179432_559172_2946'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1481558179432_706621_2947'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481558179432_706621_2947' visibility='private' type='_17_0_2_4_854026d_1481558144998_39651_2920' association='_17_0_2_4_854026d_1481558179432_27262_2945'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481558198445_971622_2975'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481558198445_597336_2976' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_18_5_2_854026d_1522918746032_239938_7356' name='BoltTerminalRole'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1522918746032_484682_7357' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;BoltTerminalRole&lt;/i&gt; defines the instance specific properties and relationships of a bolt terminal.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1522918746032_239938_7356'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_18_5_2_854026d_1522918746032_628274_7358' isSubstitutable='false' general='EAID_FFF01D9D_C445_4f17_BA49_ED1A7E4EA42B'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_18_5_2_854026d_1528108108340_111530_6192' name='WireLengthType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528108241212_136100_6212' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies possible values for the &lt;i&gt;lengthType &lt;/i&gt;of &lt;i&gt;WireLength&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1528108108340_111530_6192'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1528108295717_371317_6213' name='DMU'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528108333265_809323_6221' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The length of the wire is calculated from the sum of the lengths of the neutral axes of the corresponding segments in the DMU model.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1528108295717_371317_6213'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1528108301652_827227_6215' name='Drawing'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528108363029_39299_6222' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The length is rounded length from the DMU model (shown on the drawing), without any add-ons&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1528108301652_827227_6215'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1528108310338_96776_6217' name='Contract'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528108374212_30024_6223' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The agreed length for any negotiations and calculations.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1528108310338_96776_6217'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1528108318608_98560_6219' name='Production'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528108387862_605331_6224' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The cutting length for the used in production environments.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1528108318608_98560_6219'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1691071747440_767392_2407' name='Functional'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1691071764915_348256_2409' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;Functional&lt;/i&gt; length is a length specification which must be precisely adhered to in production and which results from the design, for example due to signal/wave characteristics. This is in contrast to the &lt;i&gt;DMU&lt;/i&gt; / &lt;i&gt;Drawing Length&lt;/i&gt; which only specifies the length of the routed neutral phase.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1691071747440_767392_2407'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_18_5_2_854026d_1535553865779_580262_7572' name='OpenWireEndTerminalRole'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1535553908360_645744_7597' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An OpenWireEndTerminalRole defines the instance specific properties and relationships of an open wire end.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1535553865779_580262_7572'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_18_5_2_854026d_1535553886762_379531_7596' general='EAID_FFF01D9D_C445_4f17_BA49_ED1A7E4EA42B'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_18_5_2_854026d_1556527803793_165017_7662'>
					<memberEnd xmi:idref='_18_5_2_854026d_1556527803793_754145_7663'/>
					<memberEnd xmi:idref='_18_5_2_854026d_1556527803794_719720_7664'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1556527898266_232019_7697' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Contains the terminal role if the cavity has an integrated terminal (e.g. an IDC).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1556527803793_165017_7662'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1556527803794_719720_7664' visibility='private' type='EAID_01CF64D9_404E_40ec_9991_1640BD88488F' association='_18_5_2_854026d_1556527803793_165017_7662'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1556527813728_599329_7685'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1556527813728_541575_7686' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_18_5_2_854026d_1559921462078_605645_7514'>
					<memberEnd xmi:idref='_18_5_2_854026d_1559921462081_46272_7515'/>
					<memberEnd xmi:idref='_18_5_2_854026d_1559921462082_92157_7516'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1559921486062_106406_7543' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;ConnectionGroup&lt;/i&gt; that is realized by this &lt;i&gt;WireElementReference.&lt;/i&gt; This applies normally to &lt;i&gt;WireElementReference &lt;/i&gt;that have &lt;i&gt;subWireElements&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1559921462078_605645_7514'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1559921462082_92157_7516' visibility='private' type='EAID_D461D8CC_28EC_41c5_82DE_148EA9C7C468' association='_18_5_2_854026d_1559921462078_605645_7514'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_18_5_2_854026d_1559921611875_628243_7699'>
					<memberEnd xmi:idref='_18_5_2_854026d_1559921611875_901616_7700'/>
					<memberEnd xmi:idref='_18_5_2_854026d_1559921611875_56194_7701'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1559921638659_423320_7728' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;ConnectionGroup&lt;/i&gt; that is realized by this &lt;i&gt;WireGrouping.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1559921611875_628243_7699'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1559921611875_56194_7701' visibility='private' type='EAID_6B9233F7_B7DB_436c_84CF_8C46FCF122D6' association='_18_5_2_854026d_1559921611875_628243_7699'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1575914838363_1962_5365'>
					<memberEnd xmi:idref='_19_0_2_854026d_1575914838363_702761_5366'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1575914838365_34857_5367'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1575914909619_466495_5389' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;WireGroupings&lt;/i&gt; that are contained in this &lt;i&gt;WireGrouping&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1575914838363_1962_5365'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1575914838365_34857_5367' visibility='private' type='EAID_6B9233F7_B7DB_436c_84CF_8C46FCF122D6' association='_19_0_2_854026d_1575914838363_1962_5365'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1575914869759_721131_5380'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1575914869759_133536_5381' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1576226468370_648079_5438' name='BridgeTerminalRole'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576226525348_890182_5462' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;BridgeTerminalRole&lt;/i&gt; defines the instance specific properties and relationships of a bridge terminal (see BridgeTerminalSpecification).&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;A bridge terminal is a part that behaves like terminal but has no &lt;i&gt;WireReceptions.&lt;/i&gt; It is used to create short circuit between different pins in a connector. In its use, it can realize a schematic connection on its own and independently of other components.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1576226468370_648079_5438'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_2_854026d_1576226482286_111312_5461' general='EAID_FFF01D9D_C445_4f17_BA49_ED1A7E4EA42B'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576226698125_59725_5501' name='connection' visibility='public' type='EAID_FBD4281A_CD4C_4139_BE40_E1ADD62AE2E9' association='_19_0_2_854026d_1576226698124_596199_5500'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1589387074460_31351_5407' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1576226698125_59725_5501'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576226725084_719091_5511'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576226725085_213623_5512' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1576226698124_596199_5500'>
					<memberEnd xmi:idref='_19_0_2_854026d_1576226698125_59725_5501'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1576226698125_510745_5502'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576226733073_915950_5519' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;Connection&lt;/i&gt; that is realized by this &lt;i&gt;BridgeTerminalRole.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1576226698124_596199_5500'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576226698125_510745_5502' visibility='private' type='_19_0_2_854026d_1576226468370_648079_5438' association='_19_0_2_854026d_1576226698124_596199_5500'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576226730025_553310_5515'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576226730025_438166_5516' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1607528331482_641995_5499'>
					<memberEnd xmi:idref='_19_0_2_854026d_1607528331483_195941_5500'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1607528331483_471692_5501'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1607528385429_26930_5518' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;This is the relationship of the supplementary parts actually used in this &lt;i&gt;SlotReference.&lt;/i&gt; This is the actual selection of the potential supplementary parts defined in the corresponding &lt;i&gt;Slot.supplementaryParts&lt;/i&gt; association.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1607528331482_641995_5499'/>
					</ownedComment>
