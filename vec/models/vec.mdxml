					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='EAID_6D696FEC_3EAE_4532_AB0F_C203C1A27BAB' name='AnchorType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6D696FEC_3EAE_4532_AB0F_C203C1A27BABDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Enumeration for the definition of AnchorType of the SegmentLocation.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_6D696FEC_3EAE_4532_AB0F_C203C1A27BAB'/>
					</ownedComment>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_FBFD739B_CCF7_48aa_9D55_4D1D3BAE3301' name='anchor' visibility='public' type='EAID_6D696FEC_3EAE_4532_AB0F_C203C1A27BAB'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_FBFD739B_CCF7_48aa_9D55_4D1D3BAE3301Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies if the location on the TopologySegment is defined as on offset relative to the startNode of the TopologySegment or the endNode.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_FBFD739B_CCF7_48aa_9D55_4D1D3BAE3301'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001815_CCF7_48aa_9D55_4D1D3BAE3301' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001816_CCF7_48aa_9D55_4D1D3BAE3301' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_F2347161_6EA9_4dd3_8FEC_C5779667A699' name='FromStartNode'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F2347161_6EA9_4dd3_8FEC_C5779667A699Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The offset of the location is measured from the startNode of the TopologySegment.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_F2347161_6EA9_4dd3_8FEC_C5779667A699'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_E02E39E3_E8A6_404e_A3EA_082165BB5E06' name='FromEndNode'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E02E39E3_E8A6_404e_A3EA_082165BB5E06Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The offset of the location is measured from the endNode of the TopologySegment.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_E02E39E3_E8A6_404e_A3EA_082165BB5E06'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_E17413AD_31F5_4623_8D7B_FDC92E437341' name='SegmentLocation'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E17413AD_31F5_4623_8D7B_FDC92E437341Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies a point on a TopologySegment as a Location.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_E17413AD_31F5_4623_8D7B_FDC92E437341'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_F9EBB25D_99CF_41e0_91C8_2A81318F6C86' isSubstitutable='false' general='EAID_1F2FCC66_9C3D_45ca_96DF_6158D08B3A75'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_00C60E8C_61D4_4e8f_85AC_51BA1E5C33AD' name='offset' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_00C60E8C_61D4_4e8f_85AC_51BA1E5C33ADDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the offset / distance of the Location to the anchor of the location. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_00C60E8C_61D4_4e8f_85AC_51BA1E5C33AD'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001813_61D4_4e8f_85AC_51BA1E5C33AD' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001814_61D4_4e8f_85AC_51BA1E5C33AD' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst80CC9F_6968_4d37_8417_D9C1BC73B144' name='referencedSegment' visibility='public' type='EAID_0A544C53_306B_4fd6_85BF_FF10223E18E9' association='EAID_AF80CC9F_6968_4d37_8417_D9C1BC73B144'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001817__6968_4d37_8417_D9C1BC73B144' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001818__6968_4d37_8417_D9C1BC73B144' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1385546959332_327477_2771' name='anchor' visibility='public' type='EAID_6D696FEC_3EAE_4532_AB0F_C203C1A27BAB'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385546986616_454119_2775' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies if the location on the &lt;i&gt;TopologySegment&lt;/i&gt; is defined as on offset relative to the startNode of the TopologySegment or the endNode.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1385546959332_327477_2771'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1385546975228_3799_2773' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1385546975228_915305_2774' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1576491326023_794441_5887' name='TopologyBendingRestrictionSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576492966884_686333_5988' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;TopologyBendingRestrictionSpecification &lt;/i&gt;can be used to define &lt;i&gt;TopologyBendingRestrictions.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1576491326023_794441_5887'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_2_854026d_1576491539694_200190_5977' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576491423956_516900_5958' name='topologyBendingRestriction' visibility='public' aggregation='composite' type='_19_0_2_854026d_1576491328211_380923_5909' association='_19_0_2_854026d_1576491423956_601375_5957'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576491431023_427726_5970'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576491431023_953739_5971' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1576491328211_380923_5909' name='TopologyBendingRestriction'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576493025996_617637_5989' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;As the name implies, a &lt;i&gt;TopologyBendingRestriction&lt;/i&gt; defines restrictions on the bendability a path in the &lt;i&gt;Topology.&lt;/i&gt; There are multiple reasons, why such restrictions exist, for example:&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;ul&gt;&#10;      &lt;li&gt;&#10;There is a bending restriction for a wire in the segment.&#10;&#10;      &lt;/li&gt;&#10;      &lt;li&gt;&#10;The number of wires and the segment diameter is such, that excessive bending causes intolerable torsion forces on wires in the segment.&#10;&#10;      &lt;/li&gt;&#10;      &lt;li&gt;&#10;Other technical reasons&#10;&#10;      &lt;/li&gt;&#10;    &lt;/ul&gt;&#10;    &lt;p&gt;&#10;Since these restrictions can be determined using a variety of methods the VEC provides a concept to store this information for later use. This makes the information available in the downstream processes, without detailed knowledge of the determination procedure (e.g. during form board design, packaging or installation).&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;The restriction applies to a path of segments as this can cover different case:&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;ul&gt;&#10;      &lt;li&gt;&#10;a single segment&#10;&#10;      &lt;/li&gt;&#10;      &lt;li&gt;&#10;two adjacent segments at a node&#10;&#10;      &lt;/li&gt;&#10;      &lt;li&gt;&#10;the complete path of a wire&#10;&#10;      &lt;/li&gt;&#10;    &lt;/ul&gt;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1576491328211_380923_5909'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1690457626294_899481_3383' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576491371283_961215_5935' name='restrictedPath' visibility='public' aggregation='composite' type='EAID_FFD1AA95_301C_4c9f_BFDC_10B2781572D1' association='_19_0_2_854026d_1576491371283_322499_5934'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576491397820_393481_5943' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576491397820_144319_5944' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576491626135_830479_5978' name='minBendRadiusDynamic' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576491626138_480652_5981' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the minimum bend radius for the restricted path, if it is used in a dynamic environment, where it is bended repeatedly (e.g. in the grommet of the back door).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1576491626135_830479_5978'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576491626138_662582_5982'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576491626138_313995_5980' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576491626137_700824_5979' name='minBendRadiusStatic' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576491626138_876691_5984' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the minimum bend radius for the restricted path, if it is used in a static environment, where it is bended once during installation. After that it remains unchanged in its bended position during usage.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1576491626137_700824_5979'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576491626138_734559_5985'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576491626138_933444_5983' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1576491371283_322499_5934'>
					<memberEnd xmi:idref='_19_0_2_854026d_1576491371283_961215_5935'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1576491371284_324403_5936'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576493758413_48541_5990' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The path that defines the restricted way in the topology.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1576491371283_322499_5934'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576491371284_324403_5936' visibility='private' type='_19_0_2_854026d_1576491328211_380923_5909' association='_19_0_2_854026d_1576491371283_322499_5934'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576491412365_709954_5949'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576491412365_307053_5950' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1576491423956_601375_5957'>
					<memberEnd xmi:idref='_19_0_2_854026d_1576491423956_516900_5958'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1576491423957_91558_5959'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576491423957_91558_5959' visibility='private' type='_19_0_2_854026d_1576491326023_794441_5887' association='_19_0_2_854026d_1576491423956_601375_5957'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576491428234_694310_5966' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576491428234_492352_5967' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
			</packagedElement>
			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_4A68852B_5CF3_495d_9EBD_C0B21EB487D6' name='usage_constraint'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_CECC8E6A_EEB3_4e8f_8C45_34091C73060C' name='UsageConstraint'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_CECC8E6A_EEB3_4e8f_8C45_34091C73060CDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a constraint of the possible usages for PartVersion or PartUsages. UsageConstraints are of part master data information. UsageConstraints specify general restrictions for the application of a PartVersion or PartUsage (e.g. a certain period of time in which the part is allowed to be used). (see KBLFRM-229)&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_CECC8E6A_EEB3_4e8f_8C45_34091C73060C'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_75183003_C02A_497a_92A5_D03ADBF575E1' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_DFFEA35F_A170_442a_973F_0786B7754895' name='type' visibility='public' type='EAID_1FD9FF86_D581_48eb_921B_D4E34EB2A7BF'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_DFFEA35F_A170_442a_973F_0786B7754895Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines if the usage constraint is positive (allowance) or negative (denial).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_DFFEA35F_A170_442a_973F_0786B7754895'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002073_A170_442a_973F_0786B7754895' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002074_A170_442a_973F_0786B7754895' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_63D23C97_27B0_4d9f_BE28_0F4B017024AA' name='fromDate' visibility='public' type='EAJava_Date'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_63D23C97_27B0_4d9f_BE28_0F4B017024AADocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the lower bound of the time period to which the usage constraint applies.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_63D23C97_27B0_4d9f_BE28_0F4B017024AA'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002075_27B0_4d9f_BE28_0F4B017024AA'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002076_27B0_4d9f_BE28_0F4B017024AA' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_11866705_0020_46a8_BDE2_97D56E9262DB' name='toDate' visibility='public' type='EAJava_Date'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_11866705_0020_46a8_BDE2_97D56E9262DBDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the upper bound of the time period to which the usage constraint applies.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_11866705_0020_46a8_BDE2_97D56E9262DB'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002077_0020_46a8_BDE2_97D56E9262DB'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002078_0020_46a8_BDE2_97D56E9262DB' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_7152CDF0_A8DA_4a25_B693_3F52D83EE6A8' name='fromSerialNumber' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7152CDF0_A8DA_4a25_B693_3F52D83EE6A8Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the lower bound of a serial number range to which the usage constraint applies.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_7152CDF0_A8DA_4a25_B693_3F52D83EE6A8'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002079_A8DA_4a25_B693_3F52D83EE6A8'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002080_A8DA_4a25_B693_3F52D83EE6A8' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_61300EC9_EC0F_4c81_B756_394E76412E05' name='toSerialNumber' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_61300EC9_EC0F_4c81_B756_394E76412E05Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the upper bound of a serial number range to which the usage constraint applies.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_61300EC9_EC0F_4c81_B756_394E76412E05'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002081_EC0F_4c81_B756_394E76412E05'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002082_EC0F_4c81_B756_394E76412E05' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_932251FC_0670_44d7_8D26_61B58A6DAF79' name='projectPhase' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_932251FC_0670_44d7_8D26_61B58A6DAF79Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the project phases to which the usage constraint applies.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_932251FC_0670_44d7_8D26_61B58A6DAF79'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002083_0670_44d7_8D26_61B58A6DAF79'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002084_0670_44d7_8D26_61B58A6DAF79' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstEE55AE_2E4E_48d4_AEB0_5E29F1BF488B' name='usageNode' visibility='public' type='EAID_A00422A0_ACAB_4468_88D8_19D6AAF1275D' association='EAID_ACEE55AE_2E4E_48d4_AEB0_5E29F1BF488B'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002085__2E4E_48d4_AEB0_5E29F1BF488B'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002086__2E4E_48d4_AEB0_5E29F1BF488B' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst63B403_3A77_434c_8503_5819501E23FA' name='project' visibility='public' type='EAID_71EA4408_1F82_434c_B15C_B85E191B99B7' association='EAID_F763B403_3A77_434c_8503_5819501E23FA'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002089__3A77_434c_8503_5819501E23FA'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002090__3A77_434c_8503_5819501E23FA' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1623330670068_986403_5447' name='fromEffectivityControlKey' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1623330817562_149364_5455' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;In the production logistics of complex products (like vehicles), the control of operation and cancellation dates of changes, features, components or the like is usually not carried out via concrete dates but via &amp;quot;date keys&amp;quot;. These keys are then mapped in planning systems with concrete time specifications for certain plants or production steps. In the VEC&amp;#160;these keys are called &lt;i&gt;EffectivityControlKey.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;With the &lt;i&gt;FromEffectivityControlKey&lt;/i&gt; and &lt;i&gt;To&lt;/i&gt;&lt;i&gt;EffectivityControlKey &lt;/i&gt;a validity interval can be defined. If one of the two values is defined and the other is omitted, the meaning shall be &amp;quot;unbounded&amp;quot;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1623330670068_986403_5447'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1623330773733_52720_5449'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1623330773733_478516_5450' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1623330777003_514801_5451' name='toEffectivityControlKey' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1623331441123_222753_5456' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;See &lt;i&gt;FromEffectivityControlKey.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1623330777003_514801_5451'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1623330795073_275626_5453'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1623330795073_146313_5454' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_ACEE55AE_2E4E_48d4_AEB0_5E29F1BF488B'>
					<memberEnd xmi:idref='EAID_dstEE55AE_2E4E_48d4_AEB0_5E29F1BF488B'/>
					<memberEnd xmi:idref='EAID_srcEE55AE_2E4E_48d4_AEB0_5E29F1BF488B'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_ACEE55AE_2E4E_48d4_AEB0_5E29F1BF488BDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;UsageNode&lt;/i&gt; to which the &lt;i&gt;UsageConstraint&lt;/i&gt; applies. This means the described &lt;i&gt;PartVersion&lt;/i&gt; is allowed / denied in the referenced UsageNode.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_ACEE55AE_2E4E_48d4_AEB0_5E29F1BF488B'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcEE55AE_2E4E_48d4_AEB0_5E29F1BF488B' visibility='public' type='EAID_CECC8E6A_EEB3_4e8f_8C45_34091C73060C' association='EAID_ACEE55AE_2E4E_48d4_AEB0_5E29F1BF488B'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002121__2E4E_48d4_AEB0_5E29F1BF488B'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002122__2E4E_48d4_AEB0_5E29F1BF488B' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_866D71D9_7A65_4621_8FA4_0843D874EFC5'>
					<memberEnd xmi:idref='EAID_dst6D71D9_7A65_4621_8FA4_0843D874EFC5'/>
					<memberEnd xmi:idref='EAID_src6D71D9_7A65_4621_8FA4_0843D874EFC5'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_866D71D9_7A65_4621_8FA4_0843D874EFC5Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the UsageConstraints that apply to the PartVersion or PartUsages described by the UsageConstraintSpecification. The ordering of this association is relevant. The elements shall arranged in the order of ascending priority.&amp;#160;That means, elements further back in the collection have a higher priority.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_866D71D9_7A65_4621_8FA4_0843D874EFC5'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src6D71D9_7A65_4621_8FA4_0843D874EFC5' visibility='public' type='EAID_FF38707A_7B84_48b7_B1D0_4E18C5F2130A' association='EAID_866D71D9_7A65_4621_8FA4_0843D874EFC5'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002091__7A65_4621_8FA4_0843D874EFC5' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002092__7A65_4621_8FA4_0843D874EFC5' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_FF38707A_7B84_48b7_B1D0_4E18C5F2130A' name='UsageConstraintSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_FF38707A_7B84_48b7_B1D0_4E18C5F2130ADocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the definition of usage constraints. The associated UsageConstraints are restricting the possible usages of the associated PartVersions and PartUsages.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_FF38707A_7B84_48b7_B1D0_4E18C5F2130A'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_87BB878C_3C1B_4287_AE4D_C34A879C608B' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst6D71D9_7A65_4621_8FA4_0843D874EFC5' name='partUsageConstraint' visibility='public' isOrdered='true' aggregation='composite' type='EAID_CECC8E6A_EEB3_4e8f_8C45_34091C73060C' association='EAID_866D71D9_7A65_4621_8FA4_0843D874EFC5'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002093__7A65_4621_8FA4_0843D874EFC5' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002094__7A65_4621_8FA4_0843D874EFC5' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstC3D65B_E0D4_447d_9DBB_C08C7AFFFE8D' name='constrainedParts' visibility='public' type='EAID_A784D820_0381_42ed_8168_0F1AE554D91B' association='EAID_C5C3D65B_E0D4_447d_9DBB_C08C7AFFFE8D'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002095__E0D4_447d_9DBB_C08C7AFFFE8D'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002096__E0D4_447d_9DBB_C08C7AFFFE8D' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='EAID_1FD9FF86_D581_48eb_921B_D4E34EB2A7BF' name='UsageConstraintType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_1FD9FF86_D581_48eb_921B_D4E34EB2A7BFDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Enumeration for the definition of the type of a UsageConstraint. Valid values are allow and deny.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_1FD9FF86_D581_48eb_921B_D4E34EB2A7BF'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_5A8DE9AB_2A5A_49b5_92AA_B18F910FADDC' name='Allow'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_F02BEC7C_AE29_4127_BC93_7514D855626F' name='Deny'/>
				</packagedElement>
			</packagedElement>
			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_83CDB254_C294_48bb_A47F_41E15ABCF0F8' name='usage_node'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_A00422A0_ACAB_4468_88D8_19D6AAF1275D' name='UsageNode'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385548152000_702202_2874' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;UsageNode&lt;/i&gt; represents a position in an abstract vehicle. For example, the &amp;quot;Head Light Left&amp;quot;. &lt;i&gt;UsageNodes&lt;/i&gt; belong to the master data and they are defined on some companywide level. They can be used to enforce consistent naming over different projects and different development streams (e.g. between Geometry and Electrologic).&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;A &lt;i&gt;UsageNode&lt;/i&gt; can be realized by different elements in the VEC (e.g. &lt;i&gt;NetworkNode, OccurrenceOrUsage, TopologyNode, ComponentNode&lt;/i&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_A00422A0_ACAB_4468_88D8_19D6AAF1275D'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_B664F345_EF63_4529_8180_DA3C08A896B3' isSubstitutable='false' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_934A0BBE_D495_47dc_9909_95FFF13D6BFD' name='abbreviation' visibility='public' type='EAID_6E33CD1B_63D7_4da8_BED4_828037944989'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385548340117_754520_2877' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies an abbreviation of the &lt;i&gt;UsageNode&lt;/i&gt;. Normally this a human readable short name.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_934A0BBE_D495_47dc_9909_95FFF13D6BFD'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002097_D495_47dc_9909_95FFF13D6BFD'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002098_D495_47dc_9909_95FFF13D6BFD' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_2BC4D01B_E5B6_46f2_8649_A3030DAA90A1' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385548212588_818042_2875' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique &lt;i&gt;identification&lt;/i&gt; of the &lt;i&gt;UsageNode&lt;/i&gt;. The &lt;i&gt;identification&lt;/i&gt; is guaranteed to be unique within the context. For all VEC-documents a &lt;i&gt;UsageNode-instance&lt;/i&gt; can be trusted to be the same if the context-instance is the same and the &lt;i&gt;identification&lt;/i&gt; of the &lt;i&gt;UsageNode&lt;/i&gt; is the same.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_2BC4D01B_E5B6_46f2_8649_A3030DAA90A1'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002099_E5B6_46f2_8649_A3030DAA90A1' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002100_E5B6_46f2_8649_A3030DAA90A1' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_74125C4B_1E87_49bc_92AC_BEFD342B5CF1' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385548281311_135228_2876' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies additional, human readable information about the &lt;i&gt;UsageNode&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_74125C4B_1E87_49bc_92AC_BEFD342B5CF1'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002101_1E87_49bc_92AC_BEFD342B5CF1'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002102_1E87_49bc_92AC_BEFD342B5CF1' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_C96B6C33_73F6_4bf4_BF8D_7811C35274D2' name='usageNodeType' visibility='public' type='EAID_DBF5EB5C_0837_4e70_B1B2_CAC35BAD9007'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_C96B6C33_73F6_4bf4_BF8D_7811C35274D2Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Defines the type of the UsageNode. The type determines how the UsageNode is handled in the latter processes.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_C96B6C33_73F6_4bf4_BF8D_7811C35274D2'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002103_73F6_4bf4_BF8D_7811C35274D2'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002104_73F6_4bf4_BF8D_7811C35274D2' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstC49408_5FE1_4551_BCDA_6169F299353D' name='usedInProject' visibility='public' type='EAID_71EA4408_1F82_434c_B15C_B85E191B99B7' association='EAID_21C49408_5FE1_4551_BCDA_6169F299353D'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002107__5FE1_4551_BCDA_6169F299353D'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002108__5FE1_4551_BCDA_6169F299353D' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstA647B4_2E6D_4c59_913D_D58E76D042FA' name='subUsageNodes' visibility='public' aggregation='composite' type='EAID_A00422A0_ACAB_4468_88D8_19D6AAF1275D' association='EAID_B3A647B4_2E6D_4c59_913D_D58E76D042FA'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002109__2E6D_4c59_913D_D58E76D042FA'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002110__2E6D_4c59_913D_D58E76D042FA' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_B3A647B4_2E6D_4c59_913D_D58E76D042FA'>
					<memberEnd xmi:idref='EAID_dstA647B4_2E6D_4c59_913D_D58E76D042FA'/>
					<memberEnd xmi:idref='EAID_srcA647B4_2E6D_4c59_913D_D58E76D042FA'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B3A647B4_2E6D_4c59_913D_D58E76D042FADocumentation'>
						<annotatedElement xmi:idref='EAID_B3A647B4_2E6D_4c59_913D_D58E76D042FA'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcA647B4_2E6D_4c59_913D_D58E76D042FA' visibility='public' type='EAID_A00422A0_ACAB_4468_88D8_19D6AAF1275D' association='EAID_B3A647B4_2E6D_4c59_913D_D58E76D042FA'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002123__2E6D_4c59_913D_D58E76D042FA'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002124__2E6D_4c59_913D_D58E76D042FA' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_EDA8DF91_1009_4aa8_A169_3AC5D4AAB293'>
					<memberEnd xmi:idref='EAID_dstA8DF91_1009_4aa8_A169_3AC5D4AAB293'/>
					<memberEnd xmi:idref='EAID_srcA8DF91_1009_4aa8_A169_3AC5D4AAB293'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_EDA8DF91_1009_4aa8_A169_3AC5D4AAB293Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the &lt;i&gt;UsageNodes&lt;/i&gt; defined by this &lt;i&gt;UsageNodeSpecification.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_EDA8DF91_1009_4aa8_A169_3AC5D4AAB293'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_dstA8DF91_1009_4aa8_A169_3AC5D4AAB293' visibility='public' type='EAID_F525E056_3556_4267_AB86_0725BA2E4F81' association='EAID_EDA8DF91_1009_4aa8_A169_3AC5D4AAB293'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002111__1009_4aa8_A169_3AC5D4AAB293'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002112__1009_4aa8_A169_3AC5D4AAB293' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_F525E056_3556_4267_AB86_0725BA2E4F81' name='UsageNodeSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385548097761_141079_2873' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;UsageNodeSpecification &lt;/i&gt;is a container for the specification of &lt;i&gt;UsageNodes.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_F525E056_3556_4267_AB86_0725BA2E4F81'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_6F5D851B_EF51_4075_900F_C032323AE7B6' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_srcA8DF91_1009_4aa8_A169_3AC5D4AAB293' name='usageNodes' visibility='public' aggregation='composite' type='EAID_A00422A0_ACAB_4468_88D8_19D6AAF1275D' association='EAID_EDA8DF91_1009_4aa8_A169_3AC5D4AAB293'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002125__1009_4aa8_A169_3AC5D4AAB293'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002126__1009_4aa8_A169_3AC5D4AAB293' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='EAID_DBF5EB5C_0837_4e70_B1B2_CAC35BAD9007' name='UsageNodeType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385548455214_916822_2878' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Enumeration for the different types of &lt;i&gt;UsageNodes.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_DBF5EB5C_0837_4e70_B1B2_CAC35BAD9007'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474966126400_532107_3343' name='ECU'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474966126400_458014_3344' name='Sensor'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474966126400_196834_3345' name='Actuator'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474966126400_650457_3346' name='CouplingDevice'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474966126400_784444_3347' name='EnergyStorage'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474966126400_151217_3348' name='Generator'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474966126416_630449_3349' name='PowerDistribution'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474966126416_621004_3350' name='Switch'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474966126416_574958_3351' name='Lamp'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474966126416_493559_3352' name='Relay'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474966126416_607788_3353' name='Fuse'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474966126416_420625_3354' name='Ground'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1474966126416_312368_3355' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines that this ComponentNode is a grounding point.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474966126416_420625_3354'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_6CB4AEC2_116C_45a2_BC4F_2707F449838E' name='Splice'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_8CAB6477_B092_4fbc_A0B2_5086E9596354' name='Protection'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_68C01E59_AC6A_477c_B62E_E4AE01DA8085' name='Fixing'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_E8F84AD1_D9E0_4928_BE59_9133595744CC' name='Grommet'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474966206862_738272_3368' name='CableDuct'/>
				</packagedElement>
			</packagedElement>
			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_ABBB5BEA_D805_4552_8B91_6C7291781266' name='variants'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_924B935F_5A05_424d_966F_2833D391619B' name='VariantCode'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_924B935F_5A05_424d_966F_2833D391619BDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;VariantCodes are defining the literals on which VariantConfiguration are stated. Possible VariantCodes might be different for steering types, optional equipment, engine-power class.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_924B935F_5A05_424d_966F_2833D391619B'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_AF59BFFA_BC30_45e4_AE64_38E429BCC751' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_E07DD476_211B_495a_927E_BE9678FE7571' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E07DD476_211B_495a_927E_BE9678FE7571Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the variant code. This is also the literal value for the VariantCode, which shall be used in the logisticControlExpressions of VariantConfigurations.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_E07DD476_211B_495a_927E_BE9678FE7571'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002127_211B_495a_927E_BE9678FE7571' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002128_211B_495a_927E_BE9678FE7571' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1572952166833_914306_5509' name='aliasId' visibility='public' type='EAID_0BE66F11_D6D4_4aef_B63F_2D85865F9B68'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1572952166834_444834_5511' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Room to specify additional identifiers for the VariantCode.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1572952166833_914306_5509'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1572952166834_737687_5512'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1572952166834_220585_5510' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1572947877896_886422_5354' name='abbreviation' visibility='public' type='EAID_6E33CD1B_63D7_4da8_BED4_828037944989'>
