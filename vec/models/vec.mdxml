					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_DFB66C26_CAB1_4bd9_811E_D373572E6390' name='emvProtectionRequired' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
