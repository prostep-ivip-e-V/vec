					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_2291CEC6_473D_4eb4_A866_DEE726C06D1A' name='torsionProtection' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
