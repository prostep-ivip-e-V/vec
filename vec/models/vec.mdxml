					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_D12F0E3C_BD9D_4cca_ACA6_8C10A257469B' name='pullOutForce' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_D12F0E3C_BD9D_4cca_ACA6_8C10A257469BDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The force that the terminal can withstand when being pulled out of the housing. Above that force, the terminal should be expected to be pulled out of the housing (destructive).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_D12F0E3C_BD9D_4cca_ACA6_8C10A257469B'/>
