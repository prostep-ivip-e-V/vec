					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1638193184674_566572_5704' name='labelType' visibility='public' type='_19_0_2_854026d_1634218915438_445212_5461'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1638193202654_925044_5706'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
