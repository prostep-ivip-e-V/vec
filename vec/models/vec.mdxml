							</xmi:Extension>
							<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1559804749940_832429_6042' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The centre line of a &lt;i&gt;GeometrySegment3D&lt;/i&gt; is defined by one or more &lt;i&gt;Curve3D&lt;/i&gt;. This abstract class is designed to be an extension point for different curve implementations. At the moment the only curve implementation that is supported by the VEC&amp;#160;are &lt;i&gt;NURBSCurves. &lt;/i&gt;The details are described in the documentation of the individual classes.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
								<annotatedElement xmi:idref='_18_5_2_854026d_1559748928075_721123_6375'/>
							</ownedComment>
						</ownedDiagram>
