				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1637327565797_862580_5874'>
					<memberEnd xmi:idref='_19_0_2_854026d_1637327565797_312020_5875'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1637327565798_348411_5876'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637328588591_632018_6129' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the &lt;i&gt;SegmentConnectionPoints &lt;/i&gt;the &lt;i&gt;HousingComponent&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637327565797_862580_5874'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637327565798_348411_5876' visibility='private' type='EAID_C26B3FD7_361C_485f_97C6_49E8216952D8' association='_19_0_2_854026d_1637327565797_862580_5874'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637327626104_145568_5890' value='1'/>
							</modelExtension>
