							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1637841797594_557561_6022'>
					<memberEnd xmi:idref='_19_0_2_854026d_1637841797595_979264_6031'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1637841797595_957722_6038'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637841797595_772088_6039' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies all &lt;i&gt;ComponentPortViewItems&lt;/i&gt; that are displayed on this &lt;i&gt;ComponentNodeViewItem&lt;/i&gt;&lt;i&gt;.&lt;/i&gt; The order of this association defines the clockwise arrangement of the ports on the node. As each &lt;i&gt;ComponentPortViewItem &lt;/i&gt;can also define the side on which it is placed, side definitions take precedence over order.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&lt;i&gt;&amp;#160;&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&lt;b&gt;Caution: &lt;/b&gt;This association is &lt;u&gt;ordered&lt;/u&gt;!&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&lt;i&gt;&amp;#160;&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637841797594_557561_6022'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637841797595_957722_6038' visibility='private' type='_19_0_2_854026d_1637841797592_536694_6011' association='_19_0_2_854026d_1637841797594_557561_6022'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637841797596_694603_6060' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637841797596_635771_6059' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
