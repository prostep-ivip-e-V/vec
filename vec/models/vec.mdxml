							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481277371351_807723_3085' name='integratedTerminalSpecification' visibility='public' type='EAID_5D9F928A_6E6D_4895_A1B1_1FE6E28AAC51' association='_17_0_2_4_854026d_1481277371351_684222_3084'>
