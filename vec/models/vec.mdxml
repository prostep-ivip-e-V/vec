					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_C2D32990_F62D_4458_B9ED_98D62BF6DAAFDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;A placement defines the placement of a PlaceableElementRole onto a Topology. For the definition of the place on the Topology, Locations are used.&#10;A Placement can either be a placement on discrete points (OnPointPlacement) or on an area of the topology (OnWayPlacement). &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_C2D32990_F62D_4458_B9ED_98D62BF6DAAF'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_09CC283D_0249_4bbf_B1E9_05C1DE837939' isSubstitutable='false' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_31ED62B5_CC68_470a_93F4_C0B05653B99A' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_31ED62B5_CC68_470a_93F4_C0B05653B99ADocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the Location. The identification is guaranteed to be unique within the PlacementSpecification.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_31ED62B5_CC68_470a_93F4_C0B05653B99A'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001791_CC68_470a_93F4_C0B05653B99A' value='1'/>
							</modelExtension>
						</xmi:Extension>
