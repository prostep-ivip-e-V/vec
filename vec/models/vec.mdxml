			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_5A1ECB60_0517_433a_A9C7_5D5436F5A5F3' name='instructions'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_57624064_55AE_43fb_840C_ACDDA2ABE43A' name='DocumentBasedInstruction'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_57624064_55AE_43fb_840C_ACDDA2ABE43ADocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;A DocumentBasedInstruction is an Instruction to a SheetOrChapter in a DocumentVersion or to a complete DocumentVersion.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_57624064_55AE_43fb_840C_ACDDA2ABE43A'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_1BB7920B_8CF5_4781_80DD_FCFB7185AE84' isSubstitutable='false' general='EAID_1D72C26E_3B15_4040_AB04_CF636DFD48EE'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstDCB3D9_2D7F_4886_821F_6C4E08AACD43' name='referencedSheetOrChapter' visibility='public' type='EAID_BF3A3386_BA07_4b88_BF56_74D6B871F76F' association='EAID_06DCB3D9_2D7F_4886_821F_6C4E08AACD43'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001193__2D7F_4886_821F_6C4E08AACD43'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001194__2D7F_4886_821F_6C4E08AACD43' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstA7642D_0D4A_4447_9A99_2A96FD0D6682' name='referencedDocument' visibility='public' type='EAID_5633EDF6_2E97_4d20_A4A5_B4F9F9662F77' association='EAID_CCA7642D_0D4A_4447_9A99_2A96FD0D6682'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001195__0D4A_4447_9A99_2A96FD0D6682' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001196__0D4A_4447_9A99_2A96FD0D6682' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_18D5FCF1_F89A_4354_B112_C74AA745A383' name='FileBasedInstruction'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_18D5FCF1_F89A_4354_B112_C74AA745A383Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A FileBasedInstruction is an Instruction that references a file packaged (VEC-Package) together with a VEC-file. Such a file can be for example an image.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_18D5FCF1_F89A_4354_B112_C74AA745A383'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_DFCBF100_B294_4788_AA70_E823B3F2DB6D' isSubstitutable='false' general='EAID_1D72C26E_3B15_4040_AB04_CF636DFD48EE'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_B4CCEBED_96FC_488a_9ECA_AF195AA96875' name='fileName' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B4CCEBED_96FC_488a_9ECA_AF195AA96875Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The name of the file as it appears in the VEC-Package, including the folder structure (fully qualified name) that contains this &lt;i&gt;FileBasedInstruction&lt;/i&gt;. The usage of this attribute is only valid, if the original document is distributed along with the VEC-file in a VEC-Package. It must not point to any file location which is not part of the VEC-Package (e.g. a file on a central server file share). The &lt;i&gt;fileName&lt;/i&gt; is relative to the VEC-Package root. It MUST&amp;#160;NOT contain a drive or device letter, or a leading slash. All slashes MUST&amp;#160;be forward slashes &#39;/&#39; (UNIX-style).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_B4CCEBED_96FC_488a_9ECA_AF195AA96875'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001197_96FC_488a_9ECA_AF195AA96875' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001198_96FC_488a_9ECA_AF195AA96875' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_DB024F4E_C8AD_46ac_8FB9_6F3CD75B9417' name='lastModified' visibility='public' type='EAJava_Date'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_DB024F4E_C8AD_46ac_8FB9_6F3CD75B9417Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;The last modified timestamp of the file. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_DB024F4E_C8AD_46ac_8FB9_6F3CD75B9417'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001199_C8AD_46ac_8FB9_6F3CD75B9417'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001200_C8AD_46ac_8FB9_6F3CD75B9417' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_264315B2_A267_428e_8326_0EE62E160DB1' name='dataFormat' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_264315B2_A267_428e_8326_0EE62E160DB1Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The dataFormat specifies the format of the FileReference. The dataFormat has to be a valid &amp;quot;Internet Media Type&amp;quot; (see &lt;a href=&quot;https://www.iana.org/assignments/media-types/media-types.xhtml&quot;&gt;https://www.iana.org/assignments/media-types/media-types.xhtml&lt;/a&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_264315B2_A267_428e_8326_0EE62E160DB1'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001201_A267_428e_8326_0EE62E160DB1'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001202_A267_428e_8326_0EE62E160DB1' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
