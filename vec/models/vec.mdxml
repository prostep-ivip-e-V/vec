						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000194__BE02_412b_BF66_BCCC31C47C2A' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_90582B18_33FC_4890_AEBC_1A487D935A03'>
					<memberEnd xmi:idref='EAID_dst582B18_33FC_4890_AEBC_1A487D935A03'/>
					<memberEnd xmi:idref='EAID_src582B18_33FC_4890_AEBC_1A487D935A03'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_90582B18_33FC_4890_AEBC_1A487D935A03Documentation' body='Specifies the PartVersions contained in the VEC-file. &#10;'>
						<annotatedElement xmi:idref='EAID_90582B18_33FC_4890_AEBC_1A487D935A03'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src582B18_33FC_4890_AEBC_1A487D935A03' visibility='public' type='EAID_3295EA5F_664B_4c33_B427_B10B02F14455' association='EAID_90582B18_33FC_4890_AEBC_1A487D935A03'>
