				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1583765504808_485120_5441' name='FunctionalStructureNode'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583765945550_92082_5624' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;FunctionalStructureNodes&lt;/i&gt; can be used to define a hierarchical structure on &lt;i&gt;FunctionalAssignmentGroups&lt;/i&gt;. Every &lt;i&gt;FunctionalStructureNode&lt;/i&gt; can reference &lt;i&gt;FunctionalAssignmentGroups&lt;/i&gt; and &lt;i&gt;FunctionalStructureNodes&lt;/i&gt; as children.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
