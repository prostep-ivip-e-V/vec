				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1637938576198_931495_7264' name='WireTupleTermination'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637938931347_945056_7356' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;WireTupleTermination&lt;/i&gt; is to define the handling of wire ends in a tuple (group). This is mostly relevant for twisted pairs&amp;#160;/&amp;#160;triple / tuple to define the handling of untwisting.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637938576198_931495_7264'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1690457683848_57399_3386' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637938630505_769041_7306' name='wireTupleSpecification' visibility='public' type='_19_0_2_854026d_1637931645433_144180_6948' association='_19_0_2_854026d_1637938630505_214198_7305'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637938638932_267781_7316'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637938638932_801378_7317' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637938651358_386949_7325' name='associatedWireEnds' visibility='public' type='EAID_9DF96CEB_901A_43e8_9D2E_CDFF8A9F5664' association='_19_0_2_854026d_1637938651358_429241_7324'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637938653855_957267_7333'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637938653855_931906_7334' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637938675576_932433_7343' name='fixation' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637938974466_938681_7358' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Defines whether a fixation to prevent untwisting must be applied to &lt;i&gt;associatedWireEnds &lt;/i&gt;of this &lt;i&gt;WireTupleTermination&lt;/i&gt;.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1637938675576_932433_7343'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637938686583_375015_7345'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637938686583_407942_7346' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637938694252_700664_7347' name='fixationOffset' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637939006056_506344_7359' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Specifies the offset of the fixation.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1637938694252_700664_7347'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637938714328_542780_7349'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
