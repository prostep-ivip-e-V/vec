					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_46C27C79_41A1_4fe8_AD2E_8082C4866C1FDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;CableLeadThrough&lt;/i&gt; specifies a hole in the grommet through which wires can pass through the grommet. There can be different technical realizations of a lead through, e.g. it can be realized with a shrinking material or an additional seal. The properties of a &lt;i&gt;CableLeadThrough&lt;/i&gt; are defined in the referenced &lt;i&gt;CableLeadThroughSpecification&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;For a precise placement in topology, a &lt;i&gt;CableLeadThrough&lt;/i&gt; specifies outlets.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_46C27C79_41A1_4fe8_AD2E_8082C4866C1F'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_1D3AE65C_EBBC_4694_9D62_9988841F0BCD' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_29E88A3A_6C6A_48a8_B6B2_55AA534689A8' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_29E88A3A_6C6A_48a8_B6B2_55AA534689A8Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the identification of the CableLeadThrough. This must be unique within a GrommetSpecification. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_29E88A3A_6C6A_48a8_B6B2_55AA534689A8'/>
