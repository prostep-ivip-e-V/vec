					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src904E71_3879_4706_8F0E_32D6D2C95730' visibility='public' type='EAID_03AF63D5_DC1E_4745_9B0B_184938A1D41E' association='EAID_B1904E71_3879_4706_8F0E_32D6D2C95730'>
