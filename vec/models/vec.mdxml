							<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1581700271172_81505_5407' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;A multi-fuse is a metal structure that &lt;span lang=&quot;EN-US&quot;&gt;combines several fuses with a common power feed in a fixed layout. It is used to distribute a power supply to different fuse paths.&lt;/span&gt;&lt;/body&gt;&#10;&lt;/html&gt;'>
								<annotatedElement xmi:idref='_17_0_2_4_854026d_1464782731985_905117_2839'/>
							</ownedComment>
