				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1574670589883_846399_5873'>
					<memberEnd xmi:idref='_19_0_2_854026d_1574670589883_405589_5874'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1574670589883_975983_5875'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1574670636863_89381_5888' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;Unit&lt;/i&gt; in which all coordinates (e.g. cartesian points)&amp;#160;are defined. Shall be a unit of length&amp;#160;(e.g. millimetre).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
