						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000467_094E_439d_A36F_76E704393413'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000468_094E_439d_A36F_76E704393413' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637942170184_683301_7500' name='labelingTechnology' visibility='public' type='_19_0_2_854026d_1634885611084_456946_5490'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637942256163_755312_7511' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Specifies used labeling technology if the label is already defined in this specification.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1637942170184_683301_7500'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637942201969_518068_7503'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637942201969_941501_7504' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637942217492_888054_7505' name='allowedLabelingTechnology' visibility='public' type='_19_0_2_854026d_1634885611084_456946_5490'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637942292335_488887_7512' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Specifies the allowed labeling technologies if the insulation is not yet labeled, but support labeling in its usage.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1637942217492_888054_7505'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637942237622_682265_7509'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637942237622_711955_7510' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_AB768951_7792_43bb_9C52_D6726AD6B701'>
					<memberEnd xmi:idref='EAID_dst768951_7792_43bb_9C52_D6726AD6B701'/>
					<memberEnd xmi:idref='EAID_src768951_7792_43bb_9C52_D6726AD6B701'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_AB768951_7792_43bb_9C52_D6726AD6B701Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines a recommended Specification for the insulation (e.g. the color) that implements this signal.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_AB768951_7792_43bb_9C52_D6726AD6B701'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src768951_7792_43bb_9C52_D6726AD6B701' visibility='public' type='EAID_B9A2403E_EE6C_48cb_96D3_D6C4F52CDFD0' association='EAID_AB768951_7792_43bb_9C52_D6726AD6B701'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_E5C24B3D_ED64_4183_B13E_D00CD9208676'>
					<memberEnd xmi:idref='EAID_dstC24B3D_ED64_4183_B13E_D00CD9208676'/>
					<memberEnd xmi:idref='EAID_srcC24B3D_ED64_4183_B13E_D00CD9208676'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E5C24B3D_ED64_4183_B13E_D00CD9208676Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;If the &lt;i&gt;WireElement&lt;/i&gt; has an insulation then the specification of the insulation is referenced here.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_E5C24B3D_ED64_4183_B13E_D00CD9208676'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcC24B3D_ED64_4183_B13E_D00CD9208676' visibility='public' type='EAID_6391ADC0_2FF5_43d5_8C0D_FEFA1B61062B' association='EAID_E5C24B3D_ED64_4183_B13E_D00CD9208676'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000469__ED64_4183_B13E_D00CD9208676'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000470__ED64_4183_B13E_D00CD9208676' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_59F4A289_FBC1_4523_973C_DDB246A1F893' name='InternalTerminalConnection'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_59F4A289_FBC1_4523_973C_DDB246A1F893Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An InternalTerminalConnection represents an electrical connection within a terminal. For standard terminals all receptions (wire- and terminal-receptions) have an electrical connection. For non-standard terminals (e.g. coax) only some receptions have an electrical connection. The InternalTerminalConnection is modelled as a separate class and not as relationship between wire- and terminal-reception, since it is possible that a terminal has only one kind of reception (e.g. a parallel connector, a cavity bridge). (see KBLFRM-302)&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_59F4A289_FBC1_4523_973C_DDB246A1F893'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_14EEAE06_4E65_4e64_AFD4_BAFCA62BD588' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_9D3CDB6B_3872_4e10_A910_75ED08CDC1BF' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9D3CDB6B_3872_4e10_A910_75ED08CDC1BFDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the InternalTerminalConnection. The identification is guaranteed to be unique within the TerminalSpecification (this might be for example an internal connection number).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_9D3CDB6B_3872_4e10_A910_75ED08CDC1BF'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000471_3872_4e10_A910_75ED08CDC1BF' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000472_3872_4e10_A910_75ED08CDC1BF' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst7FA29E_27BE_4002_886A_7F0754062F37' name='terminalReception' visibility='public' type='EAID_BE391CD2_D0D6_4a46_AC9B_E86449A36F8B' association='EAID_757FA29E_27BE_4002_886A_7F0754062F37'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000473__27BE_4002_886A_7F0754062F37'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000474__27BE_4002_886A_7F0754062F37' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstAA5C4C_03AB_40d4_8FBC_0AA2B2C731B2' name='wireReception' visibility='public' type='EAID_8FAC45EE_C74E_430c_BEC6_44F16C3C3104' association='EAID_E6AA5C4C_03AB_40d4_8FBC_0AA2B2C731B2'>
