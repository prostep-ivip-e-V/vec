						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000466_751F_424c_AE27_BA6DD92AF463' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_487A5175_094E_439d_A36F_76E704393413' name='thickness' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_487A5175_094E_439d_A36F_76E704393413Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the thickness of the insulation.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
