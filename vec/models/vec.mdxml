					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_7E6DF8FC_5475_4521_BA78_B1010DD7BAEE' name='a33' visibility='public' type='EAJava_double'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000957_5475_4521_BA78_B1010DD7BAEE' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000958_5475_4521_BA78_B1010DD7BAEE' value='1'/>
							</modelExtension>
