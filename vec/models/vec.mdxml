						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002117__C873_4645_BBEE_0FE41880D44F'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002118__C873_4645_BBEE_0FE41880D44F' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_9E4A1F76_3CF3_45de_A731_C042DD86BD54'>
					<memberEnd xmi:idref='EAID_dst4A1F76_3CF3_45de_A731_C042DD86BD54'/>
					<memberEnd xmi:idref='EAID_src4A1F76_3CF3_45de_A731_C042DD86BD54'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9E4A1F76_3CF3_45de_A731_C042DD86BD54Documentation' body='Specifies the TopologyNodes defined by the TopologySpecification.&#10;'>
