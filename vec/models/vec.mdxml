					<ownedEnd xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1695903572918_293790_3264' visibility='private' type='EAID_6D710382_E25E_47f6_ACED_FF8BB4265A39' association='_2022x_1_854026d_1695903572917_865744_3262'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1695903612039_792084_3277'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1695903612040_278227_3278' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_2022x_1_854026d_1695903695677_36608_3334' name='CrimpDetail' isAbstract='true'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1695912039057_565029_3926' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Abstract base class for the definition of &lt;i&gt;CrimpDetail-&lt;/i&gt;information. See &lt;i&gt;CoreCrimpDetail&lt;/i&gt; &amp;amp;&amp;#160;&lt;i&gt;InsulationCrimpDetail&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_2022x_1_854026d_1695903695677_36608_3334'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1695903779260_782471_3382' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1695891648639_102405_2379' name='size' visibility='public' type='EAID_B1908A48_B6CF_477c_8CA7_E6AA9A584B07'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1695891648643_572485_2382' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the expected size of the crimp. The &lt;i&gt;height&lt;/i&gt; is measured in direction of the crimp opening. The &lt;i&gt;width&lt;/i&gt; is measured in orthogonal to the &lt;i&gt;height&lt;/i&gt; and orthogonal to main axis of the terminal (&lt;i&gt;TerminalSpecification.OverallLength&lt;/i&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1695891648639_102405_2379'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1695891648643_879182_2383'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1695891648642_924833_2381' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1695903850127_69374_3397' name='manualCrimpTool' visibility='public' type='_2022x_1_854026d_1695898919674_979452_2452' association='_2022x_1_854026d_1695903850127_346645_3396'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1695903854947_311038_3405'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1695903854948_891053_3406' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1695903873575_756673_3420' name='machineCrimpTool' visibility='public' type='_2022x_1_854026d_1695898919674_979452_2452' association='_2022x_1_854026d_1695903873575_392703_3419'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1695903885209_4004_3430'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1695903885210_945708_3431' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_2022x_1_854026d_1695903850127_346645_3396'>
					<memberEnd xmi:idref='_2022x_1_854026d_1695903850127_69374_3397'/>
					<memberEnd xmi:idref='_2022x_1_854026d_1695903850128_713953_3398'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1695912021408_53730_3873' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A list of tools that are permitted for manual crimping processes.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_2022x_1_854026d_1695903850127_346645_3396'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1695903850128_713953_3398' visibility='private' type='_2022x_1_854026d_1695903695677_36608_3334' association='_2022x_1_854026d_1695903850127_346645_3396'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1695903868352_685005_3411'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1695903868352_692133_3412' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_2022x_1_854026d_1695903873575_392703_3419'>
					<memberEnd xmi:idref='_2022x_1_854026d_1695903873575_756673_3420'/>
					<memberEnd xmi:idref='_2022x_1_854026d_1695903873576_991419_3421'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1695911973260_107215_3872' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A list of tools that are permitted for machine crimping processes.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_2022x_1_854026d_1695903873575_392703_3419'/>
					</ownedComment>
