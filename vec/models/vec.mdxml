						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000597_C1F0_4b64_912F_F168AE5FD503'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
