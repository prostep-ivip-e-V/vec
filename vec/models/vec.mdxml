					<memberEnd xmi:idref='EAID_dst913251_4F65_4047_B1DD_C0EA6FDE28B1'/>
					<memberEnd xmi:idref='EAID_src913251_4F65_4047_B1DD_C0EA6FDE28B1'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_06913251_4F65_4047_B1DD_C0EA6FDE28B1Documentation' body='Defines the mounting to a cavity of the terminal associated with the ContactPoint. &#10;The cardinality is 0..* in order to allow a variant dependant cavity mounting. In such a scenario a cavity mounting is valid in a configuration if all addressed cavities and therefore the associated connector housing is available. &#10;'>
						<annotatedElement xmi:idref='EAID_06913251_4F65_4047_B1DD_C0EA6FDE28B1'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src913251_4F65_4047_B1DD_C0EA6FDE28B1' visibility='public' type='EAID_8B3836D2_4EC8_4e4e_BF3A_A728CDD854C3' association='EAID_06913251_4F65_4047_B1DD_C0EA6FDE28B1'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
