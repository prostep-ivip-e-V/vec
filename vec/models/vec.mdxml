						<annotatedElement xmi:idref='_19_0_2_854026d_1576235833244_317_5579'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576235833244_553403_5581' visibility='private' type='EAID_79870F6A_0494_420b_9305_6869540647B7' association='_19_0_2_854026d_1576235833244_317_5579'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576235877484_892065_5609'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576235877484_758685_5610' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1576235867537_596559_5596'>
					<memberEnd xmi:idref='_19_0_2_854026d_1576235867537_116706_5597'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1576235867537_695254_5598'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576236366180_637296_5622' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;Connection&lt;/i&gt; that is realized by this &lt;i&gt;MatingPointDetail&lt;/i&gt;&lt;i&gt;.&lt;/i&gt; For example, when a connection is realized by directly plugging or screwing two E/E components together.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;The definition at level of the &lt;i&gt;MatingDetail &lt;/i&gt;might be required if the &lt;i&gt;TerminalRole &lt;/i&gt;of the MatingPoint carries multiple different potentials (e.g. Coax).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1576235867537_596559_5596'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576235867537_695254_5598' visibility='private' type='EAID_F4B49980_7936_48de_B3B3_D17A3F3A88AD' association='_19_0_2_854026d_1576235867537_596559_5596'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576235881308_51824_5613'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576235881308_237537_5614' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1444990075638_600397_3119' name='Legend'>
					<ownedRule xmi:type='uml:Constraint' xmi:id='_17_0_2_4_854026d_1444990147238_906995_3137_migrated' name='Coupling' visibility='private'>
						<constrainedElement xmi:idref='EAID_D71D1DEA_69BD_425d_9ECF_967CA7AE269A'/>
						<constrainedElement xmi:idref='_17_0_2_4_854026d_1434105778046_688852_3172'/>
						<constrainedElement xmi:idref='_17_0_2_4_854026d_1434106222276_897831_3446'/>
						<constrainedElement xmi:idref='_17_0_2_4_854026d_1434106385450_587527_3492'/>
						<specification xmi:type='uml:OpaqueExpression' xmi:id='_18_5_2_854026d_1522916277129_473234_5262'/>
					</ownedRule>
					<ownedRule xmi:type='uml:Constraint' xmi:id='_17_0_2_4_854026d_1444990100121_691390_3123_migrated' name='Connector' visibility='private'>
						<constrainedElement xmi:idref='EAID_01CF64D9_404E_40ec_9991_1640BD88488F'/>
						<constrainedElement xmi:idref='EAID_54FBEF2D_862E_4e84_868E_0A76DEE45D1B'/>
						<constrainedElement xmi:idref='EAID_0D7F6EA5_CDA8_418c_8AAA_DC9011AFFAE1'/>
						<constrainedElement xmi:idref='EAID_DA77A4A8_A449_48b9_9A17_764C0AB099A8'/>
						<specification xmi:type='uml:OpaqueExpression' xmi:id='_18_5_2_854026d_1522916277113_561717_5240'/>
					</ownedRule>
					<ownedRule xmi:type='uml:Constraint' xmi:id='_17_0_2_4_854026d_1444990128372_291457_3131_migrated' name='Mating' visibility='private'>
						<constrainedElement xmi:idref='EAID_79870F6A_0494_420b_9305_6869540647B7'/>
						<constrainedElement xmi:idref='EAID_F4B49980_7936_48de_B3B3_D17A3F3A88AD'/>
						<specification xmi:type='uml:OpaqueExpression' xmi:id='_18_5_2_854026d_1522916277113_229090_5252'/>
					</ownedRule>
				</packagedElement>
			</packagedElement>
			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_6D564AB6_5C85_40d8_9356_DDBF23D432D1' name='modules'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_FB82C05E_449C_4630_9749_C2D137C995AA' name='ModuleFamily'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_FB82C05E_449C_4630_9749_C2D137C995AADocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A ModuleFamily is a mechanism to group mutually exclusive modules. This could be for example something like &amp;quot;audio equipment&amp;quot;, &amp;quot;diesel engine&amp;quot;.&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;In other words, a module family groups different variants of the same basic feature. In a real car configuration only one member of the family can participate. For the example module family &amp;quot;audio equipment&amp;quot; the members may be named: &amp;quot;Basic Audio Equipment&amp;quot;, &amp;quot;Standard Audio Equipment&amp;quot;, &amp;quot;Premium / High End Audio Equipment&amp;quot;.&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_FB82C05E_449C_4630_9749_C2D137C995AA'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_FA7112A5_8B71_4227_95D0_FBD0F033739E' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1728375242268_573692_1732' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_CD771B8F_A5C3_49c1_911E_4EE6AD803CA4' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_CD771B8F_A5C3_49c1_911E_4EE6AD803CA4Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the ModuleFamily. The identification is guaranteed to be unique within the ModuleFamilySpecification. For all VEC-documents a ModuleFamily-instance can be trusted to be the same if the ModuleFamilySpecification-instance is the same and the identification of the ModuleFamily is the same.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_CD771B8F_A5C3_49c1_911E_4EE6AD803CA4'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001253_A5C3_49c1_911E_4EE6AD803CA4'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001254_A5C3_49c1_911E_4EE6AD803CA4' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_32157DF7_34E9_4d47_8B40_2EE1BC4668ED' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_32157DF7_34E9_4d47_8B40_2EE1BC4668EDDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Room for additional, human readable information about the ModuleFamily.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_32157DF7_34E9_4d47_8B40_2EE1BC4668ED'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001255_34E9_4d47_8B40_2EE1BC4668ED'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001256_34E9_4d47_8B40_2EE1BC4668ED' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstCFADD9_BEE5_45a1_A110_59E81358373B' name='moduleInFamily' visibility='public' type='EAID_104AB000_90BB_483a_B07D_1AC6DC445AD0' association='EAID_94CFADD9_BEE5_45a1_A110_59E81358373B'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001257__BEE5_45a1_A110_59E81358373B' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001258__BEE5_45a1_A110_59E81358373B' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1728383029377_310619_1787' name='mandatory' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1728383054435_851624_1791' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;If &#39;&lt;i&gt;mandatory=true&lt;/i&gt;&#39; applies, then exactly one &lt;i&gt;PartWithSubComponentsRole&lt;/i&gt; from the &lt;i&gt;ModuleFamily&lt;/i&gt; the must be contained in a valid vehicle configuration, provided that the &lt;i&gt;ModuleFamily&lt;/i&gt; itself is valid for the vehicle configuration. This is implied by the fact that the &lt;i&gt;ModuleFamily&lt;/i&gt; itself is a &lt;i&gt;ConfigurableElement&lt;/i&gt;. If this attribute is false or not defined, then at most one &lt;i&gt;PartWithSubComponentsRole&lt;/i&gt; can be choosen from the &lt;i&gt;ModuleFamily.&lt;/i&gt;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1728383029377_310619_1787'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1728383047327_911209_1789'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1728383047328_512586_1790' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_E3F067F7_BAC3_4536_BB4F_1255F052792D'>
					<memberEnd xmi:idref='EAID_dstF067F7_BAC3_4536_BB4F_1255F052792D'/>
					<memberEnd xmi:idref='EAID_srcF067F7_BAC3_4536_BB4F_1255F052792D'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E3F067F7_BAC3_4536_BB4F_1255F052792DDocumentation' body='Specifies the ModuleFamilies defined in the ModuleFamilySpecification.&#10;'>
						<annotatedElement xmi:idref='EAID_E3F067F7_BAC3_4536_BB4F_1255F052792D'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcF067F7_BAC3_4536_BB4F_1255F052792D' visibility='public' type='EAID_50009885_0156_4905_B733_783AD3BA94AA' association='EAID_E3F067F7_BAC3_4536_BB4F_1255F052792D'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001259__BAC3_4536_BB4F_1255F052792D' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001260__BAC3_4536_BB4F_1255F052792D' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_50009885_0156_4905_B733_783AD3BA94AA' name='ModuleFamilySpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_50009885_0156_4905_B733_783AD3BA94AADocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specification for the description of module families (see ModuleFamily). &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_50009885_0156_4905_B733_783AD3BA94AA'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_3EDBAC26_E13F_4155_B963_BB9189C07FC6' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstF067F7_BAC3_4536_BB4F_1255F052792D' name='moduleFamily' visibility='public' aggregation='composite' type='EAID_FB82C05E_449C_4630_9749_C2D137C995AA' association='EAID_E3F067F7_BAC3_4536_BB4F_1255F052792D'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001261__BAC3_4536_BB4F_1255F052792D' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001262__BAC3_4536_BB4F_1255F052792D' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_B5E1D4FC_8AC0_4434_A9F3_06ECD0D6373D' name='ModuleList'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B5E1D4FC_8AC0_4434_A9F3_06ECD0D6373DDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A ModuleList is a mechanism to control additional / completion PartOccurrences. This means for a car configuration, if at least one of the modules in the list participates in the configuration, the &amp;quot;completionComponent&amp;quot; participates, too.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_B5E1D4FC_8AC0_4434_A9F3_06ECD0D6373D'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_C7AABEF5_3AAF_4d0f_BF7C_797B867FC2F2' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1728375246206_696708_1735' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_09572DFE_6FB1_4128_9EEB_B5F9028BF909' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_09572DFE_6FB1_4128_9EEB_B5F9028BF909Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the ModuleList. The identification is guaranteed to be unique within the ModuleListSpecification. For all VEC-documents a ModuleList-instance can be trusted to be the same if the ModuleListSpecification-instance is the same and the identification of the ModuleList is the same.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_09572DFE_6FB1_4128_9EEB_B5F9028BF909'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001263_6FB1_4128_9EEB_B5F9028BF909'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001264_6FB1_4128_9EEB_B5F9028BF909' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_808B9B5E_9DD1_4557_AB09_373BD60540D0' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_808B9B5E_9DD1_4557_AB09_373BD60540D0Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Room for additional, human readable information about the ModuleList.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_808B9B5E_9DD1_4557_AB09_373BD60540D0'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001265_9DD1_4557_AB09_373BD60540D0'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001266_9DD1_4557_AB09_373BD60540D0' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst43F4C2_F4F6_4197_8A54_8530AA8DA205' name='moduleInList' visibility='public' type='EAID_104AB000_90BB_483a_B07D_1AC6DC445AD0' association='EAID_8A43F4C2_F4F6_4197_8A54_8530AA8DA205'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001267__F4F6_4197_8A54_8530AA8DA205' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001268__F4F6_4197_8A54_8530AA8DA205' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst4360AE_A946_4908_82D2_CF52B6FC1278' name='completionComponents' visibility='public' type='EAID_390D7DAD_7DD0_4cd2_894B_631C0B049B90' association='EAID_D34360AE_A946_4908_82D2_CF52B6FC1278'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001269__A946_4908_82D2_CF52B6FC1278' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001270__A946_4908_82D2_CF52B6FC1278' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_D34360AE_A946_4908_82D2_CF52B6FC1278'>
					<memberEnd xmi:idref='EAID_dst4360AE_A946_4908_82D2_CF52B6FC1278'/>
					<memberEnd xmi:idref='EAID_src4360AE_A946_4908_82D2_CF52B6FC1278'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_D34360AE_A946_4908_82D2_CF52B6FC1278Documentation' body='References the components that are used as completion, if any of the Modules in the ModuleList appears in a configuration. &#10;'>
						<annotatedElement xmi:idref='EAID_D34360AE_A946_4908_82D2_CF52B6FC1278'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src4360AE_A946_4908_82D2_CF52B6FC1278' visibility='public' type='EAID_B5E1D4FC_8AC0_4434_A9F3_06ECD0D6373D' association='EAID_D34360AE_A946_4908_82D2_CF52B6FC1278'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001475__A946_4908_82D2_CF52B6FC1278'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001476__A946_4908_82D2_CF52B6FC1278' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_345A9709_94BF_4aa5_8308_EE6B22B933BF'>
