					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst526CD9_6274_4771_97A1_737F9F9DD6E9' name='currentInformation' visibility='public' aggregation='composite' type='EAID_D41B1D31_D5F9_4478_84F9_866DFE462B88' association='EAID_1E526CD9_6274_4771_97A1_737F9F9DD6E9'>
