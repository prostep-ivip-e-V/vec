					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_9B5B4E61_51B9_42b8_86BC_0BFC59B6314C' name='hardness' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9B5B4E61_51B9_42b8_86BC_0BFC59B6314CDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the hardness of the grommet. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_9B5B4E61_51B9_42b8_86BC_0BFC59B6314C'/>
