				<packagedElement xmi:type='uml:Association' xmi:id='_2022x_1_854026d_1704705869838_515961_2258'>
					<memberEnd xmi:idref='_2022x_1_854026d_1704705869838_563165_2259'/>
					<memberEnd xmi:idref='_2022x_1_854026d_1704705869838_356661_2260'/>
