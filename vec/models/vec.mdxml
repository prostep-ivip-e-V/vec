						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1728487131353_38863_2469' name='MultiaxialShieldCrimp'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1728547859173_306210_1766' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;A crimping method for coaxial shields, where the crimping process is performed in the directions of a of multiple axis.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1728487131353_38863_2469'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1728544087854_276598_2578' name='CrimpAndSoldering'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1728547664252_424717_1764' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;A crimp connection with subsequent soldering of the joining area.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1728544087854_276598_2578'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1481190065080_972924_3645' name='SlotSealingType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481190239469_16911_3664' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the possible sealing types for a slot, if the slot shall be sealed in its usage.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481190065080_972924_3645'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481190279422_427478_3665' name='None'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481190380676_170890_3700' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;Slot &lt;/i&gt;cannot be sealed at all.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481190279422_427478_3665'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481190298627_213088_3667' name='SingleSealing'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481190402646_343419_3701' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;Slot&lt;/i&gt; is sealed with a single &lt;i&gt;Seal &lt;/i&gt;per &lt;i&gt;Cavity&lt;/i&gt; e.g. a &lt;i&gt;CavitySeal &lt;/i&gt;or a &lt;i&gt;CavityPlug.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481190298627_213088_3667'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481190322793_261403_3669' name='MultiSealing'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481190501770_532821_3702' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;Slot &lt;/i&gt;is sealed with a more complex sealing variant, typically sealing multiple cavities with a single seal (e.g. a &lt;i&gt;MultiCavityPlug &lt;/i&gt;or a combination of those).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481190322793_261403_3669'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481190328829_971536_3671' name='Moulded'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481190614544_682054_3703' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;Slot&lt;/i&gt; is sealed by moulding it with some sort of sealing compound.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481190328829_971536_3671'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1481192183117_252869_3719' name='ConnectorOutletDirection'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481192436376_537408_3810' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the &lt;i&gt;OutletDirection&lt;/i&gt; of a connector for wires.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481192183117_252869_3719'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481192239712_284549_3738' name='Straight'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481192244015_197254_3740' name='Angled'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1481196507451_930853_3954' name='ConductorMaterial'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481196639673_774266_4011' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;ConductorMaterial&lt;/i&gt; is a helper class to specify &lt;i&gt;validConductorMaterials. &lt;/i&gt;This is necessary, since all attributes of the type &lt;i&gt;Material&lt;/i&gt; have a multiplicity of * with the semantics that it always defines &lt;u&gt;one&lt;/u&gt; &lt;i&gt;Material&lt;/i&gt; with the possibility to define it in different reference systems.&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;Since a wire reception can have more than one &lt;i&gt;validConductorMaterial&lt;/i&gt; this container class is necessary to keep the semantics clear.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481196507451_930853_3954'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1690456921107_541239_3195' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481196559038_128474_3975' name='material' visibility='public' type='EAID_349A4B4C_CCF4_4206_8013_AD19345723A4'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481197286357_656908_4020' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the material.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481196559038_128474_3975'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481196737211_628888_4012' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481196737211_150377_4013' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1481196577256_781279_3980'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1481196577256_331193_3981'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1481196577257_734868_3982'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481196589253_99493_4010' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the materials of a conductor, that are valid to use with this &lt;i&gt;WireReceptionSpecification&lt;/i&gt;. This material shall be matched against the &lt;i&gt;ConductorSpecification.material.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481196577256_781279_3980'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481196577257_734868_3982' visibility='private' type='EAID_667A59DB_C6EB_417d_B96F_9F12C28DC687' association='_17_0_2_4_854026d_1481196577256_781279_3980'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481196585942_559584_4004' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481196585942_550269_4005' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1481207239760_854280_2609' name='CavityPartSpecification' isAbstract='true'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481207405460_964553_2632' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;CavityPartSpecification&lt;/i&gt; is an abstract class for common properties of non-electrical parts that are used in &lt;i&gt;Cavities&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481207239760_854280_2609'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1481207279818_47241_2629' general='EAID_6AB9AD42_9295_4771_B673_98FDF80C9A65'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_6A587977_9252_4264_BD5C_5392F65CE441' name='cavityDimension' visibility='public' type='EAID_B1908A48_B6CF_477c_8CA7_E6AA9A584B07'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6A587977_9252_4264_BD5C_5392F65CE441Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a valid cavity dimensions to which the cavity part fits. The dimension defines the size of the sealing area of the cavity (crimp end), not in the contacting area (box end).&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;Note: CavityDimension is of type Size which is defined as x &amp;amp;&amp;#160;y with type NumericalValue. NumericalValue can define tolerances. So, a cavity dimension is not necessarily a single fixed value.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_6A587977_9252_4264_BD5C_5392F65CE441'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000321_9252_4264_BD5C_5392F65CE441'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1573061176914_773414_5632' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_4F98A202_91AE_4d08_9A78_5689DA555C36' name='hardness' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_4F98A202_91AE_4d08_9A78_5689DA555C36Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the hardness of the cavity seal. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_4F98A202_91AE_4d08_9A78_5689DA555C36'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000323_91AE_4d08_9A78_5689DA555C36'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000324_91AE_4d08_9A78_5689DA555C36' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481207617241_295504_2950' name='geometry' visibility='public' type='_17_0_2_4_854026d_1481207575625_525166_2904'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481207645665_159923_2954' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the geometry of the cavity sealing. &#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;This attribute is defined as an OpenEnumeration.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481207617241_295504_2950'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481207641813_965384_2952'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481207641814_379856_2953' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_84CFA483_F800_4b8e_8A3E_CFE0CFE072B0' name='compatibleTerminalType' visibility='public' type='EAID_A632D277_1F80_40e0_83B7_2FDEC62DAA16'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_84CFA483_F800_4b8e_8A3E_CFE0CFE072B0Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines a list of terminal types that are compatible to this CavitySealSpecification. This defines as well the compatible cavities, since a plug is normally used when no terminals are present.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_84CFA483_F800_4b8e_8A3E_CFE0CFE072B0'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000331_F800_4b8e_8A3E_CFE0CFE072B0'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000332_F800_4b8e_8A3E_CFE0CFE072B0' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1573061826682_867958_5666' name='compatibleCavityGeometry' visibility='public' type='_19_0_2_854026d_1573061349973_463007_5634'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1573061878702_223221_5670' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines a list of &lt;i&gt;CavityGeometries&lt;/i&gt; that are compatible with this cavity part.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1573061826682_867958_5666'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1573061853976_992844_5668'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1573061853976_893368_5669' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1481207575625_525166_2904' name='SealingGeometry'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481208267082_650606_2965' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines valid values of the geometry of a cavity sealing. It defines the cross-section geometry.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481207575625_525166_2904'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481207687622_627417_2955' name='Circular'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481208067192_733396_2957' name='Oval'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481208070776_35925_2959' name='Square'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481208139901_983003_2961' name='Segmented'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481208144026_931853_2963' name='Sectored'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1481277371351_684222_3084'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1481277371351_807723_3085'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1481277371351_306660_3086'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481277397171_217877_3114' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the terminal, if the cavity has an integrated terminal (e.g. an IDC).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481277371351_684222_3084'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481277371351_306660_3086' visibility='private' type='EAID_7E29FD06_9E00_4fef_B794_54B3BBECF441' association='_17_0_2_4_854026d_1481277371351_684222_3084'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1481278529372_480251_3121' name='TerminalSealingType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481278775286_756530_3170' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the possible sealing types for a terminal, if the terminal shall be sealed in its usage.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481278529372_480251_3121'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481278819511_662318_3173' name='None'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481278829909_552793_3177' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The Terminal cannot be sealed by itself (e.g. a CavitySeal)&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481278819511_662318_3173'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481278824942_991697_3175' name='Sealed'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481278909428_916880_3178' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The Terminal can be sealed and can only be used together with a cavity seal. It is not allowed to be used unsealed.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481278824942_991697_3175'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481279049382_761367_3179' name='Neutral'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481279059849_780066_3181' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The terminal can be sealed (with a cavity seal), but a seal is not mandatory for this terminal.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481279049382_761367_3179'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481279181759_719182_3182' name='Moulded'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481279200829_487754_3184' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The terminal can be used in a moulded slot.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481279181759_719182_3182'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1481281042279_871211_3200' name='FlatCoreSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481281084568_137782_3219' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the properties of a flat (rectangular)&amp;#160;conductor which are specific for them.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481281042279_871211_3200'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1481281194914_635968_3231' general='EAID_58B1BEDB_9393_4275_87CB_E943E3F5D823'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481281121102_909512_3220' name='size' visibility='public' type='EAID_B1908A48_B6CF_477c_8CA7_E6AA9A584B07'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481281157461_15785_3228' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the size (width &amp;amp;&amp;#160;height) of the flat core.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481281121102_909512_3220'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481281143933_53264_3224'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481281143933_62272_3225' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1481281630655_738921_3235' name='WireElementShape'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481281691411_7853_3260' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the shape of a wire element.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481281630655_738921_3235'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481281666135_341430_3254' name='Circular'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481281669710_788168_3256' name='Flat'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481281682363_767422_3258' name='Elliptical'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1481282124809_543496_3294' name='PrimaryLockingType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481282182707_175420_3313' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the valid primary locking types for terminals.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481282124809_543496_3294'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481282216234_686638_3314' name='Lance'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703145967615_254714_2654' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Lance specifies, that the terminal has a lance or lances (syn. tang) to lock itself in the cavity. &lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481282216234_686638_3314'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1703146530730_782059_2701' name='Lanceless'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703146671919_629505_2704' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Lanceless specifies, that the terminal itself has &lt;b&gt;no&lt;/b&gt; lance (syn. tang) to lock itself in the cavity. However, it is locked in the cavity by some mechanical feature of the cavity (e.g. a lance). &lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1703146530730_782059_2701'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481282219826_592855_3316' name='None'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1481282586444_937140_3423' name='PluggableTerminalType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481282738129_597183_3445' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines valid values for the type of PluggableTerminals. The type defines constraints about the numbers of wire and&amp;#160;terminal receptions and their relations.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481282586444_937140_3423'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481282779247_530152_3446' name='Standard'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481282782044_589485_3448' name='Coax'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481282784452_213961_3450' name='MultiContact'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481282801242_549388_3452' name='Bridge'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481282803567_531291_3454' name='PiggyBack'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1481540109945_141315_2970' name='WireEndAccessorySpecification'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481540218019_288481_3029' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;WireEndAccessorySpecifications &lt;/i&gt;are describing parts that are used for a treatment of a wire end before the actual terminal is attached to the &lt;i&gt;WireEnd&lt;/i&gt; (e.g. a ferrule).&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;The actual specification of the properties of the wire end accessory is done by the referenced &lt;i&gt;WireReceptionSpecification&lt;/i&gt; since this is the &lt;i&gt;Specification&lt;/i&gt; to describe joining properties of a part with a wire end.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481540109945_141315_2970'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1481540122320_506105_2990' general='EAID_6AB9AD42_9295_4771_B673_98FDF80C9A65'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481540128950_661784_2996' name='wireReceptionSpecification' visibility='public' type='EAID_667A59DB_C6EB_417d_B96F_9F12C28DC687' association='_17_0_2_4_854026d_1481540128950_460690_2995'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481540149804_228655_3019'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481540149805_871620_3020' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1481557795285_418054_2862' name='CavityAccessorySpecification'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481557846374_446507_2884' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;CavityAccessory&lt;/i&gt; is a non-electrical part used in a cavity with no sealing properties (e.g. a wire fixation).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481557795285_418054_2862'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1481557841372_728919_2882' general='_17_0_2_4_854026d_1481207239760_854280_2609'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481557922979_675835_2885' name='wireElementOutsideDiameter' visibility='public' type='EAID_CAF23CB7_00D0_48de_9B42_ADB340B9B4A8'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481557922981_241490_2888' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a range of valid wire diameters to which the cavity accessory fits.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481557922979_675835_2885'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481557922981_623948_2889'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481557922981_303891_2887' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481557922980_404743_2886' name='wireReceptionType' visibility='public' type='_17_0_2_4_854026d_1481118863653_216817_3517'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481557922982_525584_2891' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the wireReceptionType to which the cavity accessory fits. &#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481557922980_404743_2886'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481557922982_173261_2892'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481557922982_421494_2890' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1481559251941_959328_3131' name='PotentialDistributorSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481559339622_685469_3155' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the properties of a potential distributor (e.g. a joint connector).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481559251941_959328_3131'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1481559257532_196732_3151' general='EAID_03AF63D5_DC1E_4745_9B0B_184938A1D41E'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481559458038_556406_3156' name='screwable' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481559475924_956649_3160' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines if the &lt;i&gt;PotentialDistributor&lt;/i&gt; can be screwed by itself to be fixed. This fixation is a non-electrical connection. If the &lt;i&gt;PotentialDistributor&lt;/i&gt; can be fixated electrical (like a ring terminal) it shall have one &lt;i&gt;PinComponent&lt;/i&gt; with a &lt;i&gt;RingTerminalSpecification&lt;/i&gt;. &#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481559458038_556406_3156'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481559471744_707004_3158'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
