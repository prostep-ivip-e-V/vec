					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1425915949480_279564_3057' name='dimensionValueRange' visibility='public' type='EAID_CAF23CB7_00D0_48de_9B42_ADB340B9B4A8'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1425916334337_323747_3129' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;dimensionValueRange defines the magnitude of measurements for which the tolerance applies (e.g. length from 500mm - 1500mm).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1425915949480_279564_3057'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1425916004598_911106_3059' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1425916004598_277023_3060' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1425916013496_840770_3061' name='dimensionType' visibility='public' type='_19_0_2_854026d_1637077029725_730957_5496'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1425916384433_51881_3130' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;dimensionType&lt;/i&gt; defines to which measurements this &lt;i&gt;DefaultDimension&lt;/i&gt; applies.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1425916013496_840770_3061'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1425916048235_353255_3063' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1425916048235_135102_3064' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1425916067061_209028_3070' name='toleranceIndication' visibility='public' aggregation='composite' type='EAID_7457DD90_7E8E_4045_9E17_882CA3FA1A36' association='_17_0_2_4_854026d_1425916067061_629583_3069'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1425916072522_977030_3093' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1425916072522_820919_3094' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1425915854452_792845_2987' name='DefaultDimensionSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1425916240423_637636_3127' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;DefaultDimensionSpecification&lt;/i&gt; defines tolerances that shall be applied to a part, if no explicit tolerance value has been defined.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1425915854452_792845_2987'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1425915854472_566930_2988' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1425915889428_345696_2995' name='defaultDimension' visibility='public' aggregation='composite' type='_17_0_2_4_854026d_1425915889398_681136_2993' association='_17_0_2_4_854026d_1425915889428_353828_2994'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1661417112008_655936_5583'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1661417112008_541303_5584' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_19_0_2_854026d_1637077029725_730957_5496' name='DefaultDimensionType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637077288089_788177_5519' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;dimensionType&lt;/i&gt; defines to which measurements this &lt;i&gt;DefaultDimension&lt;/i&gt; applies.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637077029725_730957_5496'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1637077080698_841978_5516' name='MeasurementChains'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637077114564_405957_5518' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Applies to all measurements without specific tolerance definitions or a more specific DefaultDimensionType. Sums of individual dimensions must also not exceed these tolerances.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1637077080698_841978_5516'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1664702819260_404871_5543' name='SegmentLengths'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1664702888789_903413_5549' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Applies to length values for segments.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1664702819260_404871_5543'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1664702827252_581472_5545' name='FixingDistances'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1664703130579_108667_5550' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Applies to the measurements between individual fixings.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1664702827252_581472_5545'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1664702843343_241585_5547' name='WireLengths'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1664707829449_898342_5551' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Applies to length values for &lt;i&gt;WireElementReferences&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1664702843343_241585_5547'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1637573662244_959053_6394'>
					<memberEnd xmi:idref='_19_0_2_854026d_1637573662244_845763_6395'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1637573662244_680668_6396'/>
