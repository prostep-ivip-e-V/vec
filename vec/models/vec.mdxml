				<packagedElement xmi:type='uml:Association' xmi:id='EAID_F3252E64_9761_4c5f_BA8C_AF700680BE42'>
					<memberEnd xmi:idref='EAID_dst252E64_9761_4c5f_BA8C_AF700680BE42'/>
					<memberEnd xmi:idref='EAID_src252E64_9761_4c5f_BA8C_AF700680BE42'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F3252E64_9761_4c5f_BA8C_AF700680BE42Documentation' body='Specifies an ordered list of PathSegments that describe the appearance of the GeometrySegment2D. The appearance is described by the concatenation of the PathSegments beginning at the startNode of the GeometrySegment2D.&#10;'>
						<annotatedElement xmi:idref='EAID_F3252E64_9761_4c5f_BA8C_AF700680BE42'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src252E64_9761_4c5f_BA8C_AF700680BE42' visibility='public' type='EAID_570FF9D1_ADCA_4ece_AB24_C21C4928DC26' association='EAID_F3252E64_9761_4c5f_BA8C_AF700680BE42'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
