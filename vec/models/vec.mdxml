						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703759537315_970606_4489' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A&amp;#160;&lt;i&gt;ConnectorHousingCoverRole&lt;/i&gt; defines the instance-specific properties of a cover for a connector.&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;The association to the &lt;i&gt;ConnectorHousing&lt;/i&gt; is established with the &lt;i&gt;OccurrenceOrUsage.ReferenceElement&lt;/i&gt; association.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_2022x_1_854026d_1703759341995_896830_4442'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1703759423565_435420_4465' general='EAID_B4BA9927_24FD_4a91_8D98_944B8F392F1E'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1703759459423_449995_4471' name='connectorHousingCoverSpecification' visibility='public' type='_2022x_1_854026d_1703758572568_305213_4347' association='_2022x_1_854026d_1703759459423_992277_4470'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1703759467915_606085_4483' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1703759467916_525250_4484' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1703759632406_853788_4537' name='transportOnly' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703759662831_922817_4541' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Specifies if the cover is only used during transportation of the harness. Conversely, &lt;i&gt;transportOnly=false&lt;/i&gt; means that the cover might remain in the vehicle, depending on the specific circumstances (e.g. the variant configuration of the vehicle).&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1703759632406_853788_4537'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1703759653576_8222_4539'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1703759653576_815831_4540' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
