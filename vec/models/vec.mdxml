				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1676478858467_137724_6210' name='ComponentNodeViewItem'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1676479281315_833234_6249' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;ComponentNodeViewItem &lt;/i&gt;represents a &lt;i&gt;ComponentNode&lt;/i&gt; within a &lt;i&gt;ConnectionViewSpecification&lt;/i&gt; and defines its position within the layout.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1676478858467_137724_6210'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1690456859522_922102_3084' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1676479353397_465926_6250' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1676479353399_279312_6253' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the &lt;i&gt;ComponentNodeViewItem&lt;/i&gt;. The identification is guaranteed to be unique within the &lt;i&gt;ConnectionViewSpecification&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1676479353397_465926_6250'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1676479353400_366508_6254' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1676479353399_660964_6252' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1676479353399_75370_6251' name='gridSquare' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1676479353400_712993_6256' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the grid square in which the &lt;i&gt;ComponentNodeViewIt&lt;/i&gt;&lt;i&gt;em&lt;/i&gt; is placed (e.g. E/40).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1676479353399_75370_6251'/>
