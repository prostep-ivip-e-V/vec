				<packagedElement xmi:type='uml:Class' xmi:id='EAID_7E29FD06_9E00_4fef_B794_54B3BBECF441' name='Cavity'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7E29FD06_9E00_4fef_B794_54B3BBECF441Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A cavity is a defined space in a connector housing for location of an electrical terminal or cavity plug or seal. A cavity may also be empty.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_7E29FD06_9E00_4fef_B794_54B3BBECF441'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_DDE6AA61_0254_42f1_8C65_F335E5BAB6E9' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_F6FCC82C_985E_4539_BE1A_C1B3708FF6EF' name='available' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F6FCC82C_985E_4539_BE1A_C1B3708FF6EFDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines whether the cavity is available for contacting. If the cavity is not available, it means that it is completely closed.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_F6FCC82C_985E_4539_BE1A_C1B3708FF6EF'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000289_985E_4539_BE1A_C1B3708FF6EF'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000290_985E_4539_BE1A_C1B3708FF6EF' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_8E74A978_B55A_4749_B973_D51570EECEFA' name='cavityNumber' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_8E74A978_B55A_4749_B973_D51570EECEFADocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Provides an identifier for the cavity. The cavity number needs to be unique within a &lt;i&gt;Slot&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_8E74A978_B55A_4749_B973_D51570EECEFA'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000291_B55A_4749_B973_D51570EECEFA'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000292_B55A_4749_B973_D51570EECEFA' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstF9E595_4EB9_45b2_9686_118AE5CEE46F' name='cavitySpecification' visibility='public' type='EAID_917F4E6E_2925_42b5_AF27_837F3351C949' association='EAID_BAF9E595_4EB9_45b2_9686_118AE5CEE46F'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000295__4EB9_45b2_9686_118AE5CEE46F'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000296__4EB9_45b2_9686_118AE5CEE46F' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481277112587_33014_3052' name='hasIntegratedTerminal' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481277140610_546571_3058' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines whether the cavity has an integrated terminal (for example an IDC cavity)&amp;#160;or if an additional terminal is required. &#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;If this attribute is &amp;quot;true&amp;quot;, the cavity can reference a &lt;i&gt;TerminalSpecification&lt;/i&gt; as &lt;i&gt;integratedTerminalSpecification&lt;/i&gt; in order to specify the integrated terminal. &#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481277112587_33014_3052'/>
						</ownedComment>
