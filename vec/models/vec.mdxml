				<packagedElement xmi:type='uml:Class' xmi:id='EAID_917F4E6E_2925_42b5_AF27_837F3351C949' name='CavitySpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_917F4E6E_2925_42b5_AF27_837F3351C949Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the definition of cavities.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_917F4E6E_2925_42b5_AF27_837F3351C949'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_5091FF53_2CEA_44d7_95E1_B6AFC44F7192' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_35620967_2A0B_4762_9C82_DB49FDAA5E72' name='angle' visibility='public' isOrdered='true' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_35620967_2A0B_4762_9C82_DB49FDAA5E72Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the angle against two planes of the connector housing a terminal used in this cavity can be buckled.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_35620967_2A0B_4762_9C82_DB49FDAA5E72'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000337_2A0B_4762_9C82_DB49FDAA5E72'/>
						<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000338_2A0B_4762_9C82_DB49FDAA5E72' value='2'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_E43BAB9E_A4D5_4285_9C3E_43768C28A758' name='cavityDesign' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E43BAB9E_A4D5_4285_9C3E_43768C28A758Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_E43BAB9E_A4D5_4285_9C3E_43768C28A758'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000339_A4D5_4285_9C3E_43768C28A758'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000340_A4D5_4285_9C3E_43768C28A758' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1573061737063_842059_5661' name='geometry' visibility='public' type='_19_0_2_854026d_1573061349973_463007_5634'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1573061791523_112346_5665' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the geometry of a cavity in the sealing area (crimp end).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1573061737063_842059_5661'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1573061767859_167950_5663'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1573061767859_400543_5664' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_BB7AEDA5_9BF1_41a1_9FD0_F0D4B866B102' name='cavityDimension' visibility='public' type='EAID_B1908A48_B6CF_477c_8CA7_E6AA9A584B07'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_BB7AEDA5_9BF1_41a1_9FD0_F0D4B866B102Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the dimension of the cavity in the sealing area of the cavity (crimp end), not in the contacting area (box end).&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;The &lt;i&gt;Height&lt;/i&gt; of a cavity is defined as the dimension of cavity in the direction of the primary locking. The &lt;i&gt;Width &lt;/i&gt;is the dimension orthogonal to the &lt;i&gt;Height.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;For cavities with &lt;i&gt;Geometry = Circular &lt;/i&gt;the &lt;i&gt;Size.Width &lt;/i&gt;shall be equal to &lt;i&gt;Size.Height.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_BB7AEDA5_9BF1_41a1_9FD0_F0D4B866B102'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000341_9BF1_41a1_9FD0_F0D4B866B102'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1573061075104_885850_5631' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1437127240759_486247_2550' name='minWireElementOutsideDiameter' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1437127240759_809478_2552' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the minimum diameter a wire is allowed to have to fit into the cavity. This definition is necessary, since wires that are too small might cause movements and in acceptable torsion forces on terminals.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1437127240759_486247_2550'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1437127240759_412898_2553'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1437127240759_432548_2551' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_5104B41B_FFBA_4e66_90FE_FBCFB3660979' name='maxWireElementOutsideDiameter' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_5104B41B_FFBA_4e66_90FE_FBCFB3660979Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the maximum diameter a wire is allowed to have to fit into the cavity. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_5104B41B_FFBA_4e66_90FE_FBCFB3660979'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000343_FFBA_4e66_90FE_FBCFB3660979'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000344_FFBA_4e66_90FE_FBCFB3660979' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_748CB3B0_3F0B_4a0c_8B51_DC59F6F66F16' name='primaryLockingType' visibility='public' type='_17_0_2_4_854026d_1481282124809_543496_3294'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_748CB3B0_3F0B_4a0c_8B51_DC59F6F66F16Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies if the cavity has a primary locking and of what type it is.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_748CB3B0_3F0B_4a0c_8B51_DC59F6F66F16'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000345_3F0B_4a0c_8B51_DC59F6F66F16'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000346_3F0B_4a0c_8B51_DC59F6F66F16' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_333C44CF_6B06_4337_878A_8F2DA3C10A2E' name='sealable' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_333C44CF_6B06_4337_878A_8F2DA3C10A2EDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies if the cavity is sealable. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_333C44CF_6B06_4337_878A_8F2DA3C10A2E'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000347_6B06_4337_878A_8F2DA3C10A2E'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000348_6B06_4337_878A_8F2DA3C10A2E' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_4255774C_4CFA_47ce_B0A9_7770B95721FB' name='compatibleTerminalType' visibility='public' type='EAID_A632D277_1F80_40e0_83B7_2FDEC62DAA16'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_4255774C_4CFA_47ce_B0A9_7770B95721FBDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines a list of terminal types that are compatible to this CavitySpecification.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_4255774C_4CFA_47ce_B0A9_7770B95721FB'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000349_4CFA_47ce_B0A9_7770B95721FB'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000350_4CFA_47ce_B0A9_7770B95721FB' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1623074937781_353714_5427' name='cavitySealingLength' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1623074971900_466562_5431' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Defines the length of the sealing area in the cavity. &lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1623074937781_353714_5427'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1623074960881_275019_5429'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1623074960881_389481_5430' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_6995F87B_1447_44e5_8600_942447061CC2' name='Coding'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6995F87B_1447_44e5_8600_942447061CC2Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the coding of a slot or a connector housing.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_6995F87B_1447_44e5_8600_942447061CC2'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_A4C2317F_7C46_4adb_A4B0_B440A811050A' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_9A2CD41D_B13C_48e4_A778_E58DD1D565A3' name='coding' visibility='public' type='_18_5_2_854026d_1570000104195_138039_5790'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9A2CD41D_B13C_48e4_A778_E58DD1D565A3Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the name of the coding.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_9A2CD41D_B13C_48e4_A778_E58DD1D565A3'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000355_B13C_48e4_A778_E58DD1D565A3' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1569938756155_801598_6051' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_BF5D9ED3_357E_49ef_9620_8CAC80DA1DAD'>
					<memberEnd xmi:idref='EAID_dst5D9ED3_357E_49ef_9620_8CAC80DA1DAD'/>
					<memberEnd xmi:idref='EAID_src5D9ED3_357E_49ef_9620_8CAC80DA1DAD'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_BF5D9ED3_357E_49ef_9620_8CAC80DA1DADDocumentation' body='Defines coding of the connector housing that is satisfied by the connector housing. &#10;'>
						<annotatedElement xmi:idref='EAID_BF5D9ED3_357E_49ef_9620_8CAC80DA1DAD'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src5D9ED3_357E_49ef_9620_8CAC80DA1DAD' visibility='public' type='EAID_2BBB9BFE_2644_42af_B3A8_A83C66A15F28' association='EAID_BF5D9ED3_357E_49ef_9620_8CAC80DA1DAD'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000359__357E_49ef_9620_8CAC80DA1DAD'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000360__357E_49ef_9620_8CAC80DA1DAD' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_0DAC50A4_2F6C_4aff_AB54_67FD7FF72852' name='ConductorCurrentInformation'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_0DAC50A4_2F6C_4aff_AB54_67FD7FF72852Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;ConductorCurrentInformation&lt;/i&gt; specifies the maximum current for which a conductor is approved. As the maximum current is dependent from the voltage and the environment temperature it is modelled as a class and not only as an attribute.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_0DAC50A4_2F6C_4aff_AB54_67FD7FF72852'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1690456906797_125504_3140' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_0DF84A74_FEEA_466c_AE25_053DF1866308' name='maxCurrent' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_0DF84A74_FEEA_466c_AE25_053DF1866308Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;The maximum current value. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_0DF84A74_FEEA_466c_AE25_053DF1866308'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000361_FEEA_466c_AE25_053DF1866308' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000362_FEEA_466c_AE25_053DF1866308' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_34F093AF_4109_4ae2_A881_655B8C6257E3' name='environmentTemperature' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_34F093AF_4109_4ae2_A881_655B8C6257E3Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;The environment temperature for which this maximum current value is applicable. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_34F093AF_4109_4ae2_A881_655B8C6257E3'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000363_4109_4ae2_A881_655B8C6257E3' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000364_4109_4ae2_A881_655B8C6257E3' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_D170894A_975E_4104_B617_3590D8CD848B' name='voltage' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_D170894A_975E_4104_B617_3590D8CD848BDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The voltage for which this maximum current value is applicable.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_D170894A_975E_4104_B617_3590D8CD848B'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000365_975E_4104_B617_3590D8CD848B' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000366_975E_4104_B617_3590D8CD848B' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_58B1BEDB_9393_4275_87CB_E943E3F5D823' name='ConductorSpecification' isAbstract='true'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_58B1BEDB_9393_4275_87CB_E943E3F5D823Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the definition of conducting properties of a WireElement.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_58B1BEDB_9393_4275_87CB_E943E3F5D823'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_25B24605_6022_4463_9E3A_CE458EE32D55' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1695907074687_359863_3599' name='wireType' visibility='public' type='EAID_ACBE4C96_FE6E_46d2_96BB_0E9237996505'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1695907476354_714520_3606' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the type of the conductor. A &lt;i&gt;WireType&lt;/i&gt; is a key in a reference system for the definition of wires. Some reference system define independent type fragment for insulations and conductors and the &lt;i&gt;WireType&lt;/i&gt; of a &lt;i&gt;WireElement&lt;/i&gt; is the combination of both.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;An conductor must not have more than one type. This attribute allows more than one value for the reason, that the same type can be expressed in multiple reference systems.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1695907074687_359863_3599'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1695907106948_118877_3603'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1695907106948_438780_3604' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_13EFD847_1BEA_4cd4_9E52_435160B35CD0' name='crossSectionArea' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_13EFD847_1BEA_4cd4_9E52_435160B35CD0Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the cross-section area of the conductor (e.g. 0,5 mm²). The cross-section area is a nominal value, which refers to the conducting properties of the conductor normalized to the properties of a full material core.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_13EFD847_1BEA_4cd4_9E52_435160B35CD0'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000367_1BEA_4cd4_9E52_435160B35CD0'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000368_1BEA_4cd4_9E52_435160B35CD0' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_5C26AA9A_1EC2_44c0_BD18_89FC9B6BABAE' name='massInformation' visibility='public' type='EAID_C4E8A576_BF44_44be_992A_ED6604D2BB2C'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_5C26AA9A_1EC2_44c0_BD18_89FC9B6BABAEDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the mass information of the conductor. In most cases this mass information is known as copper weight and is normally specified as mass per length (e.g. gram per meter). &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_5C26AA9A_1EC2_44c0_BD18_89FC9B6BABAE'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000369_1EC2_44c0_BD18_89FC9B6BABAE'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000370_1EC2_44c0_BD18_89FC9B6BABAE' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_371A5FCB_C224_4bd6_9583_D7F67E23CD42' name='material' visibility='public' type='EAID_349A4B4C_CCF4_4206_8013_AD19345723A4'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_371A5FCB_C224_4bd6_9583_D7F67E23CD42Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the material of the conductor.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_371A5FCB_C224_4bd6_9583_D7F67E23CD42'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000371_C224_4bd6_9583_D7F67E23CD42'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000372_C224_4bd6_9583_D7F67E23CD42' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_E7C325A3_A781_4984_BD0E_AFA68FE4FED6' name='resistance' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E7C325A3_A781_4984_BD0E_AFA68FE4FED6Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the electrical resistance of the conductor. In most cases this is specified as resistance per length (e.g. Ohm per meter). &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_E7C325A3_A781_4984_BD0E_AFA68FE4FED6'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000373_A781_4984_BD0E_AFA68FE4FED6'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000374_A781_4984_BD0E_AFA68FE4FED6' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_09772092_6D31_4a6a_81B8_F36A2BD11631' name='structure' visibility='public' type='_19_0_2_854026d_1633613777508_3920_5618'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_09772092_6D31_4a6a_81B8_F36A2BD11631Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the structure of the conductor according to ISO 6722-1 for ConductorSpecifications with Type = Stranded.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&lt;i&gt;Should only be used for ConductorSpecifications with type=Stranded.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_09772092_6D31_4a6a_81B8_F36A2BD11631'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000375_6D31_4a6a_81B8_F36A2BD11631'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1633613835076_171449_5655' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_F625189E_C4C3_42be_900E_F1A3EF51BAE0' name='type' visibility='public' type='_19_0_2_854026d_1633613159997_282589_5566'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F625189E_C4C3_42be_900E_F1A3EF51BAE0Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the type of the conductor, e.g. if it is rigid or stranded.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_F625189E_C4C3_42be_900E_F1A3EF51BAE0'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000377_C4C3_42be_900E_F1A3EF51BAE0'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1633613215983_153396_5586' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_B1B40F48_D925_4f9f_A05B_8672BBB6E02C' name='currentInformation' visibility='public' aggregation='composite' type='EAID_0DAC50A4_2F6C_4aff_AB54_67FD7FF72852' association='_17_0_2_4_854026d_1383130354156_818826_3010'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B1B40F48_D925_4f9f_A05B_8672BBB6E02CDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the approved maximum currents for the conductor.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_B1B40F48_D925_4f9f_A05B_8672BBB6E02C'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000379_D925_4f9f_A05B_8672BBB6E02C'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000380_D925_4f9f_A05B_8672BBB6E02C' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_2BAF2234_0400_4f07_82D9_E6CDF62136A4' name='numberOfStrands' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_2BAF2234_0400_4f07_82D9_E6CDF62136A4Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the number of individual strands used to construct the conductor. If the conductor is solid than the number of strands would be one.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;This value indicates the total number of strands forming the conductor. While typically an integer, this attribute is intentionally modeled as a &lt;i&gt;NumericalValue&lt;/i&gt; to support &lt;b&gt;tolerances&lt;/b&gt;, as found in technical data sheets — especially for high-voltage /&amp;#160;large cross-section cables, where manufacturers may specify strand count as a range or with a deviation (e.g., 1.070 ± 5%).&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&lt;b&gt;Usage&amp;#160;Notes:&lt;/b&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;ul&gt;&#10;      &lt;li&gt;&#10;If a precise strand count is known and no variation applies, a &lt;i&gt;NumericalValue&lt;/i&gt; without tolerance (e.g., 19) should be used.&#10;&#10;      &lt;/li&gt;&#10;      &lt;li&gt;&#10;If the strand count includes a tolerance, the tolerance properties of &lt;i&gt;NumericalValue&lt;/i&gt; should be utilized.&#10;&#10;      &lt;/li&gt;&#10;      &lt;li&gt;&#10;The &lt;i&gt;Unit&lt;/i&gt; used should be set to &lt;i&gt;Piece&lt;/i&gt;.&#10;&#10;      &lt;/li&gt;&#10;    &lt;/ul&gt;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_2BAF2234_0400_4f07_82D9_E6CDF62136A4'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000381_0400_4f07_82D9_E6CDF62136A4'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000382_0400_4f07_82D9_E6CDF62136A4' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_B3ED621D_390F_41a6_B9F1_1668836709A2' name='platingMaterial' visibility='public' type='EAID_349A4B4C_CCF4_4206_8013_AD19345723A4'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B3ED621D_390F_41a6_B9F1_1668836709A2Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the plating material of the conductor. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_B3ED621D_390F_41a6_B9F1_1668836709A2'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000383_390F_41a6_B9F1_1668836709A2'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000384_390F_41a6_B9F1_1668836709A2' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_33D48F4E_04DF_493a_911B_04B87726DC22' name='strandDiameter' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_33D48F4E_04DF_493a_911B_04B87726DC22Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the diameter of a single strand in the conductor. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_33D48F4E_04DF_493a_911B_04B87726DC22'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000385_04DF_493a_911B_04B87726DC22'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000386_04DF_493a_911B_04B87726DC22' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_822D7C1F_F834_47b8_8320_8EC0A2FC1339' name='voltageRange' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_822D7C1F_F834_47b8_8320_8EC0A2FC1339Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the voltageRange for which the conductor is approved.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_822D7C1F_F834_47b8_8320_8EC0A2FC1339'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000387_F834_47b8_8320_8EC0A2FC1339'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000388_F834_47b8_8320_8EC0A2FC1339' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1728472722395_482910_2063' name='transmissionMedium' visibility='public' type='_17_0_2_4_854026d_1391778887202_973520_2575'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1728472757717_192051_2067' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the type of the transmission medium for the conductor.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1728472722395_482910_2063'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1728472743124_778501_2065'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1728472743124_741373_2066' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_2874BCBA_5B8C_4e89_9632_FC20268E8145'>
					<memberEnd xmi:idref='EAID_dst74BCBA_5B8C_4e89_9632_FC20268E8145'/>
					<memberEnd xmi:idref='EAID_src74BCBA_5B8C_4e89_9632_FC20268E8145'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_2874BCBA_5B8C_4e89_9632_FC20268E8145Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines a recommended Specification for the cores that implement this signal.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_2874BCBA_5B8C_4e89_9632_FC20268E8145'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src74BCBA_5B8C_4e89_9632_FC20268E8145' visibility='public' type='EAID_B9A2403E_EE6C_48cb_96D3_D6C4F52CDFD0' association='EAID_2874BCBA_5B8C_4e89_9632_FC20268E8145'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_BA65A1CD_F893_49a9_BA3A_880201E4DD3E'>
					<memberEnd xmi:idref='EAID_dst65A1CD_F893_49a9_BA3A_880201E4DD3E'/>
					<memberEnd xmi:idref='EAID_src65A1CD_F893_49a9_BA3A_880201E4DD3E'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_BA65A1CD_F893_49a9_BA3A_880201E4DD3EDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;If the &lt;i&gt;WireElement&lt;/i&gt; has a core then the specification of the core is referenced here.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_BA65A1CD_F893_49a9_BA3A_880201E4DD3E'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src65A1CD_F893_49a9_BA3A_880201E4DD3E' visibility='public' type='EAID_6391ADC0_2FF5_43d5_8C0D_FEFA1B61062B' association='EAID_BA65A1CD_F893_49a9_BA3A_880201E4DD3E'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000391__F893_49a9_BA3A_880201E4DD3E'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000392__F893_49a9_BA3A_880201E4DD3E' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_2BBB9BFE_2644_42af_B3A8_A83C66A15F28' name='ConnectorHousingSpecification'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_2BBB9BFE_2644_42af_B3A8_A83C66A15F28Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the definition of connector housings. A connector housing consists of a one or more slots. In the means of the VEC, a connector housing can be a conventional connector housing, a contact module or a connector shell.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_2BBB9BFE_2644_42af_B3A8_A83C66A15F28'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_67EFE76B_D916_44f2_89B9_928F0CBC7CA0' isSubstitutable='false' general='EAID_6AB9AD42_9295_4771_B673_98FDF80C9A65'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_82E48263_BE0B_417a_84C6_BFFC2505030D' name='averageWireLengthAddOn' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_82E48263_BE0B_417a_84C6_BFFC2505030DDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the average wire length add on for this connector.&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_82E48263_BE0B_417a_84C6_BFFC2505030D'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000393_BE0B_417a_84C6_BFFC2505030D'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000394_BE0B_417a_84C6_BFFC2505030D' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_B703065F_33BB_4c73_BBA6_138998135C78' name='voltageRange' visibility='public' type='EAID_CAF23CB7_00D0_48de_9B42_ADB340B9B4A8'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B703065F_33BB_4c73_BBA6_138998135C78Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the allowed voltage range for the connector housing.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_B703065F_33BB_4c73_BBA6_138998135C78'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000395_33BB_4c73_BBA6_138998135C78'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000396_33BB_4c73_BBA6_138998135C78' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_E329B2C4_FD59_4af3_9164_72716C42C92A' name='coupleable' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E329B2C4_FD59_4af3_9164_72716C42C92ADocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines whether the connector is coupleable or not. Connectors that are coupleable can be used in an inline position. Connectors that are not coupleable can be connected only to an ECU or something similar.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_E329B2C4_FD59_4af3_9164_72716C42C92A'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000397_FD59_4af3_9164_72716C42C92A'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000398_FD59_4af3_9164_72716C42C92A' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst5D9ED3_357E_49ef_9620_8CAC80DA1DAD' name='coding' visibility='public' aggregation='composite' type='EAID_6995F87B_1447_44e5_8600_942447061CC2' association='EAID_BF5D9ED3_357E_49ef_9620_8CAC80DA1DAD'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000401__357E_49ef_9620_8CAC80DA1DAD'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000402__357E_49ef_9620_8CAC80DA1DAD' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst047482_B41F_4d87_A0C1_C8CAA71E653D' name='slot' visibility='public' aggregation='composite' type='EAID_C11EF09C_60BA_4ce7_A080_7795CD7CDEC3' association='EAID_CE047482_B41F_4d87_A0C1_C8CAA71E653D'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000403__B41F_4d87_A0C1_C8CAA71E653D'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000404__B41F_4d87_A0C1_C8CAA71E653D' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_srcCC009A_4DD1_46e9_BCE1_587D0F405006' name='segmentConnectionPoint' visibility='public' aggregation='composite' type='EAID_FDA76D70_46D7_491d_88B6_A011D40E4721' association='EAID_A8CC009A_4DD1_46e9_BCE1_587D0F405006'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000411__4DD1_46e9_BCE1_587D0F405006'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000412__4DD1_46e9_BCE1_587D0F405006' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481191037520_310345_3704' name='connectorPositionAssurance' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481191140215_459070_3711' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;If &lt;i&gt;true&lt;/i&gt; the &lt;i&gt;ConnectorHousing&lt;/i&gt; has a connector position assurance (CPA).&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;A CPA is some sort of feature of a connector, that ensures that the connector in its correctly assembled position with its mating part.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481191037520_310345_3704'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481191124608_236442_3709'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481191124608_872003_3710' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1703148196769_86250_3030' name='connectorPositionAssuranceType' visibility='public' type='_2022x_1_854026d_1703147641695_960851_2856'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703148239048_499223_3034' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Defines the type of the connector position assurance. This is only valid of &lt;i&gt;connectorPositionAssurance =&amp;#160;true.&lt;/i&gt;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1703148196769_86250_3030'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1703148227944_841515_3032'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1703148227944_437564_3033' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
