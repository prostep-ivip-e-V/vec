						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001388_51B9_42b8_86BC_0BFC59B6314C' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_A7F994FD_A30C_4600_9713_A198032A524E' name='holeDiameter' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A7F994FD_A30C_4600_9713_A198032A524EDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the valid diameter of a hole into which the grommet fits. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_A7F994FD_A30C_4600_9713_A198032A524E'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001389_A30C_4600_9713_A198032A524E'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001390_A30C_4600_9713_A198032A524E' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_A3F76371_7D85_4952_8F2A_E6B69797C4E3' name='plateThickness' visibility='public' type='EAID_CAF23CB7_00D0_48de_9B42_ADB340B9B4A8'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A3F76371_7D85_4952_8F2A_E6B69797C4E3Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies valid the plate thickness at the hole into which the grommet fits. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
