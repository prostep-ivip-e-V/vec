				<packagedElement xmi:type='uml:Class' xmi:id='EAID_0958CE37_2D47_4de5_A271_FBA12B648821' name='ComponentPort'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_0958CE37_2D47_4de5_A271_FBA12B648821Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines a port of ComponentNode. A ComponentPort is usually the realization of a NetworkPort. Electrological connections are defined between two or more ComponentPorts.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_0958CE37_2D47_4de5_A271_FBA12B648821'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_8F701460_47EA_4436_B4B5_481E78BE855F' isSubstitutable='false' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_0A51DD79_AF98_446b_B0EF_249235BB18A3' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension/>
						</xmi:Extension>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_0A51DD79_AF98_446b_B0EF_249235BB18A3Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the ComponentPort. The identification is guaranteed to be unique within the ComponentConnector.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_0A51DD79_AF98_446b_B0EF_249235BB18A3'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
