					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_E08E7B34_37AE_4477_8AE0_950EFA67D623' name='outsideDiameter' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
