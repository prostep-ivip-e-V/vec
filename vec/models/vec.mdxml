				<packagedElement xmi:type='uml:Class' xmi:id='EAID_B04ED7DE_108B_4853_B5AC_8CBB500C9F2A' name='VariantCodeSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B04ED7DE_108B_4853_B5AC_8CBB500C9F2ADocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specification for the definition of variant codes.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_B04ED7DE_108B_4853_B5AC_8CBB500C9F2A'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_636E5BA6_6043_4a86_A93A_6EFFBBD06E1B' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
