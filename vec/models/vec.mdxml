					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1676479370391_898341_6267' visibility='private' type='_19_0_2_854026d_1676478858467_137724_6210' association='_19_0_2_854026d_1676479370391_212493_6265'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1676479415403_939594_6282' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1676479415403_843195_6283' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
