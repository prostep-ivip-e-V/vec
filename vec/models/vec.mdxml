				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1443690054982_371332_2691' name='PartSubstitutionSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1443690213214_259044_2779' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;PartSubstitutionSpecification&lt;/i&gt; defines a set of &lt;i&gt;PartVersions&lt;/i&gt; that can be used alternatively, due to an incomplete specification for the 150% product description. For a concrete wiring harness only on valid &lt;i&gt;PartVersion&lt;/i&gt; remains. The selection logic for valid &lt;i&gt;PartVersions&lt;/i&gt; is not included in the VEC. &#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;A &lt;i&gt;PartSubstitutionSpecification &lt;/i&gt;can be used for example tubes or ring terminals, where a part of the specification is known at design time, but not yet the complete specification. For tubes for example the tube diameter is not known at design time, since it depends on the bundle diameter of a specific configuration. &#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1443690054982_371332_2691'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1443690124874_258727_2711' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1443690174035_866285_2750' name='alternativePartVersions' visibility='public' type='EAID_A784D820_0381_42ed_8168_0F1AE554D91B' association='_17_0_2_4_854026d_1443690174035_715905_2749'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1443690181933_797698_2767'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1443690181933_492379_2768' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1443690174035_715905_2749'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1443690174035_866285_2750'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1443690174035_439674_2751'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1443690174035_439674_2751' visibility='private' type='_17_0_2_4_854026d_1443690054982_371332_2691' association='_17_0_2_4_854026d_1443690174035_715905_2749'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1481103424089_292157_3006' name='PartNature'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481103547541_74739_3115' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;OpenEnumeration&lt;/i&gt; that defines the nature of a &lt;i&gt;PartVersion&lt;/i&gt;. The nature specifies how the &lt;i&gt;PartVersion &lt;/i&gt;can be used in the different processes or the significance of the &lt;i&gt;PartVersion&lt;/i&gt; in the process. &#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481103424089_292157_3006'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481104095068_290803_3124' name='Preliminary'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481104160674_876718_3130' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;Preliminary&lt;/i&gt; &lt;i&gt;PartVersion&lt;/i&gt; represent part numbers which are used as place holders for parts that are not yet developed, or which are representing prototype parts that are not allowed in serial production.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481104095068_290803_3124'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481104145262_714840_3126' name='Productive'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481104396721_785273_3131' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;Productive&lt;/i&gt; &lt;i&gt;PartVersions&lt;/i&gt; represent regular part numbers that are used in serial production.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481104145262_714840_3126'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481104150785_141885_3128' name='CustomerOrder'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481104441632_687387_3132' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;CustomerOrder&lt;/i&gt; &lt;i&gt;PartVersions&lt;/i&gt; represent part numbers that are &lt;u&gt;not &lt;/u&gt;regularly used in serial production. They are only used to fulfil special customer orders (e.g. an adapter connector for equipment of a special purpose vehicle).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481104150785_141885_3128'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1481105278524_518103_3180'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1481105278525_974662_3181'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1481105278525_13546_3182'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481105318721_951386_3214' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;CopyrightInformation&lt;/i&gt; that is in effect for the complete content of this &lt;i&gt;VecContent&lt;/i&gt;. It is applied to all &lt;i&gt;ItemVersions&lt;/i&gt; that do not references their own individual &lt;i&gt;CopyrightInformation.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481105278524_518103_3180'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481105278525_13546_3182' visibility='private' type='EAID_3295EA5F_664B_4c33_B427_B10B02F14455' association='_17_0_2_4_854026d_1481105278524_518103_3180'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481105496949_880654_3217'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481105496949_463445_3218' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1481110273680_709456_3262' name='DocumentType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481110630811_122714_3309' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the predefined &lt;i&gt;DocumentTypes&lt;/i&gt; of a &lt;i&gt;PartVersion.&lt;/i&gt; A certain &lt;i&gt;DocumentType &lt;/i&gt;has normally a typical set of information that is defined within its scope. E.g. a part master document contains &lt;i&gt;Specifications&lt;/i&gt; that are used for the description of a defined &lt;i&gt;PartVersion.&lt;/i&gt;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&lt;i&gt;The content and the degree of information a DocumentType&lt;/i&gt; may vary in the different processes. &#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481110273680_709456_3262'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1574772671415_89308_6152' name='BaselineDefinition'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1574950917959_280850_5353' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;DocumentVersion &lt;/i&gt;represents the definition of a baseline (see &lt;i&gt;BaselineSpecification&lt;/i&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1574772671415_89308_6152'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481110796506_242003_3310' name='PartMaster'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481111024363_768553_3336' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Documents of this type describe the master data of a part / component (e.g. a &lt;i&gt;ConnectorHousing&lt;/i&gt;, a&amp;#160;&lt;i&gt;Terminal&lt;/i&gt;, a &lt;i&gt;Wire&lt;/i&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481110796506_242003_3310'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1730300930012_336377_2775' name='PartMasterTemplate'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1730300953840_646571_2777' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Documents of this type describe reusable snippets of component master data (e.g. a standard cavities or wire receptions, wires without color or interface definition for E/E&amp;#160;components).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1730300930012_336377_2775'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481110807217_264296_3312' name='NetworkArchitecture'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481111092113_515187_3337' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481110807217_264296_3312'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481110818051_810865_3314' name='SystemSchematic'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481111100266_43254_3338' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481110818051_810865_3314'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1703756946823_168792_3840' name='SchematicProject'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703756973818_842496_3842' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;SchematicProject&lt;/i&gt; is a bracket around multiple &lt;i&gt;SystemSchematics&lt;/i&gt; which are by itself often versioned documents. &#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1703756946823_168792_3840'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481110891967_718877_3316' name='WiringDescription'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481111104594_966148_3339' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481110891967_718877_3316'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481110899401_802900_3318' name='HarnessDescription'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481111108257_479148_3340' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Documents of this type contain the description of a &lt;i&gt;Harness&amp;#160;&lt;/i&gt;(which is for example the scope of the KBL).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481110899401_802900_3318'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481110913600_957326_3320' name='InstallationDescription'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481111112007_604493_3341' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481110913600_957326_3320'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481110923938_583468_3322' name='ManufacturingDescription'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481111115881_939871_3342' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481110923938_583468_3322'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481110960771_863816_3326' name='RequirementsDescription'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481111119483_66402_3343' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A requirements description is some kind of document that contains requirements for a certain part or a group of parts, their design or their properties. A requirements description can be a requirements specification (e.g. REQ-IF) or any other document containing requirements (e.g. a norm).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481110960771_863816_3326'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481110966802_633510_3328' name='ChangeDescription'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481111123390_325131_3344' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481110966802_633510_3328'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481110974913_678189_3330' name='GraphicsSymbol'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481111126866_135576_3345' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Documents of this type represent a graphical symbol (2D), which is normally an external file (e.g. an SVG, PNG). The use case for this document type are symbols that are used in 2D&amp;#160;harness and form board drawings.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481110974913_678189_3330'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481110986664_774608_3332' name='GeometryModel'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481111131350_517890_3346' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Documents of this type represent a geometry model (3D) of a component or part, normally as a reference to an external file (e.g. a JT&amp;#160;File or some native file of a 3D modelling tool). &lt;i&gt;GeometryModels&lt;/i&gt; are original CAD Models and not simplified. Typical use cases are for example the models of components (e.g. connectors) used in a 3D model or the 3D visualization of a Harness.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481110986664_774608_3332'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1664783818410_315200_5601' name='GeometryModelSimplified'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1664783835744_436553_5603' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Documents of this type represent a geometry model (3D) of a component or part, normally as a reference to an external file (e.g. a JT&amp;#160;File or some native file of a 3D modelling tool). Simplified means, that those models contain only details necessary for representation in wiring harness and not every detail (e.g. for production of the component itsself). For example a simplified connector model might not contain cavity details.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;However, a simplified model could contain additional (meta-)information necessary in the harness development process (e.g. segment connection points).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1664783818410_315200_5601'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1664784293928_529890_5604' name='GeometryModelOccurrence'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1664784311421_265334_5606' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Documents of this type represent a geometry model (3D) of a component or part, normally as a reference to an external file (e.g. a JT&amp;#160;File or some native file of a 3D modelling tool). &amp;quot;Occurrence&amp;quot; means, that the model represents the component in a specific usage situation, meaning in a specific shape and position&amp;#160;(e.g. a deformed grommet).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1664784293928_529890_5604'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1664784496003_72015_5607' name='GeometryTemplate'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1664784507751_239131_5609' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;A &lt;i&gt;GeometryTemplate&lt;/i&gt; is a &lt;i&gt;GeometryModelSimplified&lt;/i&gt; whose actual appearence can be modified with a set of parameters, e.g. a tube can have a variable length, diameter and deformation. A specific set of parameters is defined in &lt;i&gt;GeometryParameters.&lt;/i&gt;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1664784496003_72015_5607'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1664784792638_314373_5610' name='GeometryParameters'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1664784808378_914269_5612' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;An actual set of parameters for a &lt;i&gt;GeometryTemplate.&lt;/i&gt;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1664784792638_314373_5610'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481110993040_331650_3334' name='MasterDataDefinition'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481111135311_513792_3347' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Documents of this type master data definition e.g. list valid &lt;i&gt;UsageNodes&lt;/i&gt; or list valid &lt;i&gt;Signals&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481110993040_331650_3334'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1491481527066_786170_2893' name='HarnessCoupling'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1491481545699_89109_2895' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;DocumentVersions &lt;/i&gt;of this type define the coupling information of wiring harnesses in a vehicle network. The &lt;i&gt;DocumentVersion &lt;/i&gt;contains the necessary &lt;i&gt;CouplingSpecifications &lt;/i&gt;and the &lt;i&gt;PartUsages &lt;/i&gt;for the coupling devices.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1491481527066_786170_2893'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1491481978677_263119_2926' name='SchematicSymbol'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1491482014713_787447_2932' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Documents of this type represent a graphical symbol (2D), which is normally an external file (e.g. an SVG, PNG). The use case for this document type are symbols that are used in schematic diagrams.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1491481978677_263119_2926'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1491481986850_835449_2928' name='NetworkSymbol'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1491482054559_583967_2933' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Documents of this type represent a graphical symbol (2D), which is normally an external file (e.g. an SVG, PNG). The use case for this document type are symbols that are used in network /&amp;#160;architecture diagrams.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1491481986850_835449_2928'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1522920157675_164211_7533' name='DeviationTable'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1522920169403_671661_7535' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Documents that define allowed deviations from specified part numbers.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1522920157675_164211_7533'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1506414945971_493751_2602' name='ComponentDrawing'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1506415117708_87142_2604' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;DocumentVersion &lt;/i&gt;of this type represent the drawing of a component (Deutsch: Einzelteilezeichnung). Those &lt;i&gt;DocumentVersion &lt;/i&gt;are normally used as external reference to the document containing the graphical representation of the component and do not contain &lt;i&gt;Specifications&lt;/i&gt;. &lt;i&gt;DocumentVersion&lt;/i&gt; describing a component in terms of the VEC&amp;#160;(with &lt;i&gt;Specifications&lt;/i&gt;) shall have the &lt;i&gt;DocumentType&lt;/i&gt; &lt;i&gt;PartMaster.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1506414945971_493751_2602'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1690442189539_710353_1924' name='ProcessingInstruction'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690442210660_167124_1926' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Documents of this type specify the processing /&amp;#160;handling of a part during production (e.g. a crimp specification for terminals).&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1690442189539_710353_1924'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1690458326045_134469_3551' name='MatingInterface'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690458349009_675480_3553' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Documents of this type are a specification of the geometrical interface for a connector family. All connectors satisfying this interface are plugging compatible with the corresponding component connector, provided that a matching coding is selected.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1690458326045_134469_3551'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_18_5_2_854026d_1528363075437_527110_6509'>
					<memberEnd xmi:idref='_18_5_2_854026d_1528363075439_507037_6510'/>
					<memberEnd xmi:idref='_18_5_2_854026d_1528363075441_639188_6511'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528363142061_745158_6544' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;This association allows all &lt;i&gt;ExtendableElements&lt;/i&gt; in the VEC&amp;#160;to reference &lt;i&gt;DocumentVersions &lt;/i&gt;as &amp;quot;external reference&amp;quot;.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;This association shall be used for the extension of elements in the VEC&amp;#160;with information that cannot be represented in the VEC&amp;#160;in an appropriate way but can be expressed in some external format (e.g. a specific symbol for a &lt;i&gt;ComponentNode&lt;/i&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;D&lt;i&gt;ocumentVersions&lt;/i&gt; referenced by this association shall not contain any &lt;i&gt;Specifications.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;This association is no replacement for associations with a more precise semantic like the &lt;i&gt;DocumentBasedInstruction&lt;/i&gt; or the associations between &lt;i&gt;PartVersion &lt;/i&gt;and &lt;i&gt;DocumentVersion.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1528363075437_527110_6509'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1528363075441_639188_6511' visibility='private' type='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665' association='_18_5_2_854026d_1528363075437_527110_6509'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1528363087113_581896_6526'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1528363087114_126044_6527' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_18_5_2_854026d_1564735612747_936598_5958'>
					<memberEnd xmi:idref='_18_5_2_854026d_1564735612747_660578_5959'/>
					<memberEnd xmi:idref='_18_5_2_854026d_1564735612747_8784_5960'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1571139427242_208573_6873' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the application constraints that apply to the ConfigurableElement.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1564735612747_936598_5958'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1564735612747_8784_5960' visibility='private' type='EAID_D2981BF7_2899_4491_A699_D434817A0FC2' association='_18_5_2_854026d_1564735612747_936598_5958'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_19_0_2_854026d_1572971307197_661901_5332' name='AliasIdentificationType'>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1572971467050_609914_5355' name='UUID'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1572971476233_628826_5357' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines that this AliasIdentification represents a &amp;quot;Universally Unique Identifier&amp;quot;. Although a UUID&amp;#160;is technical definition of a 128-Bit number, the primary relevance of this type is not its technical representation, but it&#39;s other properties. An&amp;#160;AliasIdentification with the type &amp;quot;UUID&amp;quot; of an element is its unique identifier, that is constant over time, never changes and is never reused for other elements. Such an AliasIdentification can be used to trace elements through different systems, companies and processes.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1572971467050_609914_5355'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1703757771515_599284_4101' name='DiagnosticAddress'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703757815883_134037_4105' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;DiagnosticAddress &lt;/i&gt;identifies a vehicle network participant during diagnosis. This is normally used on &lt;i&gt;NetworkPorts, ComponentPorts &lt;/i&gt;and &lt;i&gt;PinComponentBehaviours.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1703757771515_599284_4101'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1703757799235_466624_4103' name='SoftwareAddress'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703758028647_592695_4153' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;SoftwareAddress&lt;/i&gt;&lt;i&gt; &lt;/i&gt;identifies a vehicle network participant during regular operation. This is normally used on &lt;i&gt;NetworkPorts, ComponentPorts &lt;/i&gt;and &lt;i&gt;PinComponentBehaviours.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1703757799235_466624_4103'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_19_0_2_854026d_1573056716868_68238_5590' name='LocalizedTypedStringType'>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1573056809390_624847_5610' name='Title'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1573056890647_780522_5614' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The LocalizedTypedString represents a Title in accordance to ISO 7200.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1573056809390_624847_5610'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1573056816182_86907_5612' name='SupplementaryTitle'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1573056930608_521083_5615' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The LocalizedTypedString represents a SupplementaryTitle in accordance to ISO 7200.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1573056816182_86907_5612'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1607527056437_720660_5407' name='MainDescription'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1607527079442_917648_5411' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The primary description of an element, possibly inherited from a parent element (e.g. a &lt;i&gt;ComponentNode&lt;/i&gt; might inherit its description from the assigned &lt;i&gt;UsageNode&lt;/i&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1607527056437_720660_5407'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1607527068272_123196_5409' name='AdditionalDescription'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1607527353993_724610_5412' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An additional description that is an extension or a detailing of the &lt;i&gt;MainDescription&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1607527068272_123196_5409'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_18_5_2_854026d_1552321196066_846865_7841' name='BaselineSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1574772852988_716384_6156' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;BaselineSpecification&lt;/i&gt; defines a set of &lt;i&gt;ItemVersion&lt;/i&gt;s (&lt;i&gt;Document-&lt;/i&gt; and &lt;i&gt;PartVersions&lt;/i&gt;) that relate to each other in a certain way e.g. all parts and documents in their specific versions that contributed to a specific manufactured result.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;Baselines are a standard mechanism to support change, release and configuration management.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1552321196066_846865_7841'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_18_5_2_854026d_1552321199941_396574_7865' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1552321229598_705257_7871' name='validVersions' visibility='public' type='EAID_32C19FD5_E9AC_4356_94A9_0A621DB4874C' association='_18_5_2_854026d_1552321229598_71045_7870'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1552321246296_228870_7887'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1552321246296_754369_7888' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1552321378150_72495_7954' name='state' visibility='public' type='_18_5_2_854026d_1552321351943_631899_7930'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1574935583257_826574_5337' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the state of the baseline itself (e.g. if it is finalized or work in progress).&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1552321378150_72495_7954'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1552321470059_356105_8008'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1552321470059_260831_8009' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1552321448066_693354_8003' name='content' visibility='public' type='_18_5_2_854026d_1552321426874_726065_7979'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1574935202967_747805_5333' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the state of the content of the baseline in regard of its defined scope.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1552321448066_693354_8003'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1552321466693_598049_8006'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1552321466694_800380_8007' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_18_5_2_854026d_1552321351943_631899_7930' name='BaselineState'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1574935630910_566687_5338' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Enumeration the define the valid states of a baseline.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1552321351943_631899_7930'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1552321362142_867934_7950' name='Draft'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1574935668526_385964_5339' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Draft means that the baseline is not finalized yet and new ItemVersions can be added without the necessity to create a new version of the baseline itself.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1552321362142_867934_7950'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1552321370863_263102_7952' name='Frozen'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1574935747667_747586_5340' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Frozen means that the baseline is finalized and new ItemVersions &lt;u&gt;must not&lt;/u&gt; be added without creating a new version of the baseline itself.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1552321370863_263102_7952'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_18_5_2_854026d_1552321426874_726065_7979' name='BaselineContent'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1574935387219_527484_5334' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Enumeration to define the state of the content of the baseline in regard of its defined scope.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1552321426874_726065_7979'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1552321430523_383942_7999' name='Partial'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1574935419579_991941_5335' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A partial baseline does not contain all elements of the final scope of the baseline (e.g. it is a baseline created during the development process).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1552321430523_383942_7999'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1552321440316_679436_8001' name='Complete'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1574935533976_805857_5336' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A complete baseline contains &lt;u&gt;all&lt;/u&gt; elements of the final scope of the baseline.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1552321440316_679436_8001'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_18_5_2_854026d_1552321229598_71045_7870'>
					<memberEnd xmi:idref='_18_5_2_854026d_1552321229598_705257_7871'/>
					<memberEnd xmi:idref='_18_5_2_854026d_1552321229599_291076_7872'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1574935820733_715147_5341' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;ItemVersions &lt;/i&gt;that are the content of the baseline.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1552321229598_71045_7870'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1552321229599_291076_7872' visibility='private' type='_18_5_2_854026d_1552321196066_846865_7841' association='_18_5_2_854026d_1552321229598_71045_7870'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1552321249142_274998_7893'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1552321249142_275622_7894' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1576163107475_63409_5564'>
					<memberEnd xmi:idref='_19_0_2_854026d_1576163107475_813822_5565'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1576163107476_386573_5566'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576163107476_386573_5566' visibility='private' type='EAID_D2981BF7_2899_4491_A699_D434817A0FC2' association='_19_0_2_854026d_1576163107475_63409_5564'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576163129055_128228_5577'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576163129055_30169_5578' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1637586314349_333919_6434' name='ConfigurationConstraint'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637587430147_807009_6547' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Represents a &lt;i&gt;ConfigurationContraint &lt;/i&gt;(&amp;quot;When does this element exist?&amp;quot;) for a specific application (&lt;i&gt;ApplicationConstraint)&lt;/i&gt; and a &amp;quot;configuration universe&amp;quot;&amp;#160;(&lt;i&gt;VariantConfiguration.configurationType&lt;/i&gt;)&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637586314349_333919_6434'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_2_854026d_1638205115168_2246_6085' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637587187212_325864_6511' name='configInfo' visibility='public' type='EAID_B9672B89_1709_467a_97EC_731DBF20CA19' association='_19_0_2_854026d_1637587187212_873356_6510'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637587198437_164796_6521'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637587198437_269619_6522' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637587206612_459708_6530' name='applicationConstraint' visibility='public' type='_18_5_2_854026d_1564735319213_812643_5745' association='_19_0_2_854026d_1637587206612_866167_6529'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637587216070_576638_6540'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637587216070_446329_6541' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1638205050172_693544_6056' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1638205075441_127756_6060' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the &lt;i&gt;ConfigurationConstraint&lt;/i&gt;. The identification is guaranteed to be unique within the &lt;i&gt;ConfigurableElement&lt;/i&gt; and does not change over the time.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1638205050172_693544_6056'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1638205065911_829695_6058'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1638205065911_476271_6059' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1676537387662_411027_5592' name='constrainedElements' visibility='public' type='EAID_D2981BF7_2899_4491_A699_D434817A0FC2' association='_19_0_2_854026d_1676537387662_155853_5591'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1676537394574_875627_5600' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1676537394576_294658_5601' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1637586347877_114570_6459'>
					<memberEnd xmi:idref='_19_0_2_854026d_1637586347877_231884_6460'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1637586347877_907536_6461'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637587272796_401257_6546' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Contains or more &lt;i&gt;ConfigurationContraints&lt;/i&gt; that apply to this &lt;i&gt;ConfigurableElement.&lt;/i&gt; This is explained in more details in the recommendation chapter / model diagram &amp;quot;Variants&amp;quot;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637586347877_114570_6459'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637586347877_907536_6461' visibility='private' type='EAID_D2981BF7_2899_4491_A699_D434817A0FC2' association='_19_0_2_854026d_1637586347877_114570_6459'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637586363214_531511_6474'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637586363215_940333_6475' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1637587187212_873356_6510'>
					<memberEnd xmi:idref='_19_0_2_854026d_1637587187212_325864_6511'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1637587187212_198827_6512'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637587241226_934575_6544' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the configuration information that applies to the ConfigurationConstraint.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637587187212_873356_6510'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637587187212_198827_6512' visibility='private' type='_19_0_2_854026d_1637586314349_333919_6434' association='_19_0_2_854026d_1637587187212_873356_6510'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1637587206612_866167_6529'>
					<memberEnd xmi:idref='_19_0_2_854026d_1637587206612_459708_6530'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1637587206612_144580_6531'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637587256030_942056_6545' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the application constraint that applies to the ConfigurationConstraint.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637587206612_866167_6529'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637587206612_144580_6531' visibility='private' type='_19_0_2_854026d_1637586314349_333919_6434' association='_19_0_2_854026d_1637587206612_866167_6529'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1676537387662_155853_5591'>
					<memberEnd xmi:idref='_19_0_2_854026d_1676537387662_411027_5592'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1676537387662_538477_5593'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1676537779740_564412_5684' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Introduced with VEC V2.0.2. References the &lt;i&gt;ConfigurableElement&lt;/i&gt;s that are constrained by this &lt;i&gt;ConfigurationConstraint.&lt;/i&gt; This association shall only be used in combination with a containment in a &lt;i&gt;ConfigurationConstraintSpecification.&lt;/i&gt; When using the deprecated containment in the &lt;i&gt;ConfigurableElement &lt;/i&gt;it shall not be used.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1676537387662_155853_5591'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1676537387662_538477_5593' visibility='private' type='_19_0_2_854026d_1637586314349_333919_6434' association='_19_0_2_854026d_1676537387662_155853_5591'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1676537420863_736102_5606'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1676537420863_589564_5607' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1676537440452_236915_5611' name='ConfigurationConstraintSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1676537598143_686046_5682' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification container for the definition of &lt;i&gt;ConfigurationConstraints&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1676537440452_236915_5611'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_2_854026d_1676537543844_756276_5681' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1676537476731_100943_5637' name='configurationConstraint' visibility='public' aggregation='composite' type='_19_0_2_854026d_1637586314349_333919_6434' association='_19_0_2_854026d_1676537476731_312455_5636'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1676537514026_892115_5647' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1676537514028_398357_5648' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1676537476731_312455_5636'>
					<memberEnd xmi:idref='_19_0_2_854026d_1676537476731_100943_5637'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1676537476731_915296_5638'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1676537723065_364505_5683' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the individual &lt;i&gt;ConfigurationConstraint&lt;/i&gt; defined in the &lt;i&gt;ConfigurationConstraintSpecification&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1676537476731_312455_5636'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1676537476731_915296_5638' visibility='private' type='_19_0_2_854026d_1676537440452_236915_5611' association='_19_0_2_854026d_1676537476731_312455_5636'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1676537518573_590983_5651'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1676537518574_143807_5652' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_2022x_1_854026d_1690985673465_553932_1957' name='DocumentClassification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690986041323_19384_2103' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;A &lt;i&gt;DocumentClassification&lt;/i&gt; is used to categorize and classify a document in the context of a document management system. It helps to maintain consistency and compliance by ensuring that documents are appropriately handled according to their classification. Classifications can be used for example to define retention periods or disposal dates. A classification is defined by a &lt;i&gt;Key&lt;/i&gt; in a corresponding &lt;i&gt;ReferenceSystem&lt;/i&gt;.&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_2022x_1_854026d_1690985673465_553932_1957'/>
					</ownedComment>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1690985753830_92779_1980' name='key' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690985753832_293683_1988' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;Key&lt;/i&gt; of the &lt;i&gt;DocumentClassification&lt;/i&gt; in the corresponding classification reference system.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1690985753830_92779_1980'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1690985753832_156304_1989' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1690985753832_108200_1987' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1690985753829_527240_1979' name='referenceSystem' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690985753831_728965_1985' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The identification of the classification reference system, which is defining possible values and the semantic of &lt;i&gt;DocumentClassification&lt;/i&gt; keys.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1690985753829_527240_1979'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1690985753831_389209_1986' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1690985753831_897893_1984' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1690985753824_179664_1978' name='description' visibility='public' type='EAID_6E33CD1B_63D7_4da8_BED4_828037944989'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690985753831_132493_1982' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;On optional human readable description of the classification (e.g. the name or clear text, for example &amp;quot;max. 99 Years&amp;quot;).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1690985753824_179664_1978'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1690985753831_157978_1983'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1690985753830_577902_1981' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_2022x_1_854026d_1690986929542_648996_2112' name='ConfidentialityLevel'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690987053568_296100_2145' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines different levels of confidentiality for &lt;i&gt;DocumentVersions.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_2022x_1_854026d_1690986929542_648996_2112'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1690987026132_475028_2137' name='Public'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1690987031027_474986_2139' name='Internal'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1690987036055_325497_2141' name='Confidential'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1690987043611_356888_2143' name='Secret'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_2022x_1_854026d_1695898919674_979452_2452' name='ResourceVersion'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1695901408231_299852_2844' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;ResourceVersion&lt;/i&gt; is unique identifier for a resource in a company context. Resources are elements used to produce, handle or service a harness, e.g. tools or machines, that do not end up in the product (see &lt;i&gt;PartVersion&lt;/i&gt;). The &lt;i&gt;ResourceVersion&lt;/i&gt; is one of the three anchors for PDM information in the VEC. &#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_2022x_1_854026d_1695898919674_979452_2452'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1695899000768_199041_2479' general='EAID_32C19FD5_E9AC_4356_94A9_0A621DB4874C'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1695898980248_208247_2473' name='resourceNumber' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1695900944124_24434_2740' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;ResourceNumber&lt;/i&gt; is the major identifier of a &lt;i&gt;ResourceVersion&lt;/i&gt;. The format is user defined and respectively company specific. For all VEC-documents a &lt;i&gt;ResourceVersion-instance&lt;/i&gt; can be trusted to be identical if the combination of &lt;i&gt;ResourceNumber&lt;/i&gt;, &lt;i&gt;ResourceVersion&lt;/i&gt; and &lt;i&gt;CompanyName&lt;/i&gt; is identical.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1695898980248_208247_2473'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1695898995824_302456_2475' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1695898995825_64566_2476' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1695899007604_333483_2480' name='resourceVersion' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1695900954078_397986_2741' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;ResourceVersion&lt;/i&gt; specifies the version index of a resource (see also &lt;i&gt;ResourceNumber&lt;/i&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1695899007604_333483_2480'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1695899023489_988750_2482' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1695899023490_155828_2483' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1695899474172_699982_2581' name='primaryResourceType' visibility='public' type='_2022x_1_854026d_1695899284001_642006_2506'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1695900924241_780863_2688' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The primary type of the resource defines the type of the resource. In a future version of the VEC the &lt;i&gt;PrimaryResourceType &lt;/i&gt;might correspond to &lt;i&gt;Specifications &lt;/i&gt;describing the &lt;i&gt;ResourceVersion&lt;/i&gt; (see &lt;i&gt;PrimaryPartType&lt;/i&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1695899474172_699982_2581'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1695899493253_295929_2583' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1695899493254_28865_2584' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_2022x_1_854026d_1695899284001_642006_2506' name='PrimaryResourceType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1695900784375_986281_2636' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The primary type of the resource defines the type of the resource. In a future version of the VEC the &lt;i&gt;PrimaryResourceType &lt;/i&gt;might correspond to &lt;i&gt;Specifications &lt;/i&gt;describing the &lt;i&gt;ResourceVersion&lt;/i&gt; (see &lt;i&gt;PrimaryPartType&lt;/i&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_2022x_1_854026d_1695899284001_642006_2506'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1695899319673_848003_2525' name='CrimpTool'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1695899325236_500835_2527' name='ExtractionTool'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1695899335729_610961_2529' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A tool for safely extracting a terminal from a cavity without causing any damage.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1695899325236_500835_2527'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_2022x_1_854026d_1695903097507_419220_3087'>
					<memberEnd xmi:idref='_2022x_1_854026d_1695903097507_616712_3088'/>
					<memberEnd xmi:idref='_2022x_1_854026d_1695903097508_440378_3089'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1695903097508_440378_3089' visibility='private' type='EAID_3295EA5F_664B_4c33_B427_B10B02F14455' association='_2022x_1_854026d_1695903097507_419220_3087'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1695903121719_506028_3102' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1695903121719_520464_3103' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_2022x_1_854026d_1750072710684_76376_1795' name='PartNumberType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1750073410840_322994_1820' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Specifies the classification of a part number associated, indicating its semantic role within the BOM&amp;#160;methodology of the issuing process. This enables the distinction between different types of part numbers, such as those referencing actual physical parts and those used to represent virtual constructs or implementation logic. In some cases, positions in the bill of material are created to express specific aspects of the product structure, even though they do not (directly) refer to a concrete part.&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_2022x_1_854026d_1750072710684_76376_1795'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1750073688122_806235_1868' name='RealPart'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1750073715579_838953_1876' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The part number identifies a physically existing part. It uniquely refers to a concrete, realizable item in the finished product.&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1750073688122_806235_1868'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1750073693963_60576_1870' name='VirtualPart'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1750073780835_896182_1924' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;The part number identifies a virtual part, which is used for structuring or modeling purposes. It does not refer to a physically existing component in the final product.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1750073693963_60576_1870'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1750073698973_95591_1872' name='TablePart'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1750073810825_101454_1925' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;The part number identifies a table or list of possible part numbers. A specific real part must be selected from this table during subsequent steps of the development or configuration process (e.g. an &lt;span class=&quot;Y2IQFc&quot; lang=&quot;en&quot;&gt;appropriate ring terminal for a specific configuration of a harness). &lt;/span&gt;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1750073698973_95591_1872'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1750073703135_559971_1874' name='ImplementationRegulation'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1750073878090_922075_1926' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;The part number refers to a rule or instruction that governs how a part or system must be implemented. It does not directly identify a physical or virtual part but rather describes a processing step, constraints or requirements (e.g. a ultra sonic splice).&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1750073703135_559971_1874'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
			</packagedElement>
			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_8B85B34C_7328_42dd_BF5D_88F36AE80977' name='custom_properties'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_67F1CAA8_11FC_4898_8B80_9418376B91D9' name='CustomProperty' isAbstract='true'>
