					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1633942942654_892327_5763' name='Plain'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1633943055608_341773_5769' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A plain bolt without an special features.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1633942942654_892327_5763'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1633942948423_140561_5765' name='Snappable'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1633943154309_567709_5770' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;A bolt with a groove or similiar that allows the counter part to snap on. &lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1633942948423_140561_5765'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_19_0_2_854026d_1633944896127_543014_5775' name='TerminalBoltNominalSize'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1633945018552_508587_5795' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the nominal sizes for threaded bolts as &amp;quot;ISO metric screw thread&amp;quot; or as &amp;quot;Unified Thread Standard&amp;quot; (Imperial).&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;See also &lt;i&gt;TerminalBoltType.MetricThread /&amp;#160;ImperialThread. &lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&lt;i&gt;&amp;#160;&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;For the definition of the values see &lt;a href=&quot;https://en.wikipedia.org/wiki/ISO_metric_screw_thread&quot;&gt;https://en.wikipedia.org/wiki/ISO_metric_screw_thread&lt;/a&gt; and &lt;a href=&quot;https://de.wikipedia.org/wiki/Unified_Thread_Standard&quot;&gt;https://de.wikipedia.org/wiki/Unified_Thread_Standard&lt;/a&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1633944896127_543014_5775'/>
					</ownedComment>
