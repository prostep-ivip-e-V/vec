							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstDFACD8_C77F_48b4_B4DA_113287E28D8B' name='variantCode' visibility='public' type='EAID_924B935F_5A05_424d_966F_2833D391619B' association='EAID_93DFACD8_C77F_48b4_B4DA_113287E28D8B'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002161__C77F_48b4_B4DA_113287E28D8B'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002162__C77F_48b4_B4DA_113287E28D8B' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_DE922378_67A0_4dca_8455_9F76CC8C06EA' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_DE922378_67A0_4dca_8455_9F76CC8C06EADocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;On optional human readable description of the variant group.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_DE922378_67A0_4dca_8455_9F76CC8C06EA'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002157_67A0_4dca_8455_9F76CC8C06EA'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_854026d_1382705323962_519972_2809' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_A4727A9E_9AC3_46b2_8515_8DFF80CD48A4' name='groupType' visibility='public' type='_19_0_2_854026d_1572947445549_313272_5327'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A4727A9E_9AC3_46b2_8515_8DFF80CD48A4Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Allows the classification of a VariantGroups into different types. For example: - composition (e.g. winter package) - choice (e.g. right hand / left hand driving). Agreed literals for this attribute are defined in the OpenEnumeration &lt;i&gt;VariantGroupType.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_A4727A9E_9AC3_46b2_8515_8DFF80CD48A4'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002159_9AC3_46b2_8515_8DFF80CD48A4'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1572947481935_605403_5348' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_8A866223_D847_4434_BC3E_A9771F792F62'>
					<memberEnd xmi:idref='EAID_dst866223_D847_4434_BC3E_A9771F792F62'/>
					<memberEnd xmi:idref='EAID_src866223_D847_4434_BC3E_A9771F792F62'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_8A866223_D847_4434_BC3E_A9771F792F62Documentation' body='Specifies the individual VariantGroups defined in the VariantGroupSpecification.&#10;'>
						<annotatedElement xmi:idref='EAID_8A866223_D847_4434_BC3E_A9771F792F62'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src866223_D847_4434_BC3E_A9771F792F62' visibility='public' type='EAID_C1989297_7C15_427f_B4BB_8292A676745B' association='EAID_8A866223_D847_4434_BC3E_A9771F792F62'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002163__D847_4434_BC3E_A9771F792F62' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002164__D847_4434_BC3E_A9771F792F62' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_C1989297_7C15_427f_B4BB_8292A676745B' name='VariantGroupSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_C1989297_7C15_427f_B4BB_8292A676745BDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the definition of variant groups.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_C1989297_7C15_427f_B4BB_8292A676745B'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_28011C29_1962_4852_BD7C_68BE8F3ADD27' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst866223_D847_4434_BC3E_A9771F792F62' name='variantGroup' visibility='public' aggregation='composite' type='EAID_10FF171C_71F5_4b17_9B2D_4A82E6EA3289' association='EAID_8A866223_D847_4434_BC3E_A9771F792F62'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002165__D847_4434_BC3E_A9771F792F62'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI002166__D847_4434_BC3E_A9771F792F62' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_18_5_2_854026d_1552385794321_221515_8659'>
					<memberEnd xmi:idref='_18_5_2_854026d_1552385794322_992389_8660'/>
					<memberEnd xmi:idref='_18_5_2_854026d_1552385794322_578374_8661'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1571139175689_574636_6870' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;VariantConfiguration &lt;/i&gt;can only be satisfied if its &lt;i&gt;baseInclusion &lt;/i&gt;is satisfied as well.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1552385794321_221515_8659'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1552385794322_578374_8661' visibility='private' type='EAID_B9672B89_1709_467a_97EC_731DBF20CA19' association='_18_5_2_854026d_1552385794321_221515_8659'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_18_5_2_854026d_1564735319216_764812_5746' name='ApplicationConstraintSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1564735319225_276952_5759' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the definition of application constraints. The associated ApplicationConstraints are restricting the possible usages of the associated &lt;i&gt;ConfigurableElements&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1564735319216_764812_5746'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_18_5_2_854026d_1564735319225_705818_5762' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1564735319225_287285_5760' name='applicationConstraint' visibility='public' aggregation='composite' type='_18_5_2_854026d_1564735319213_812643_5745' association='_18_5_2_854026d_1564735319217_565830_5747'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735319233_585425_5790' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1564735319232_94432_5789' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_18_5_2_854026d_1564735319213_812643_5745' name='ApplicationConstraint'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1564735319218_575131_5748' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An &lt;i&gt;ApplicationConstraint&lt;/i&gt; defines a condition with which it is possible to express the inclusion or exclusion of ConfigurableElements in different variants of a product. The &lt;i&gt;ApplicationConstraint &lt;/i&gt;is focused to express validity rules based on time periods or elements of the product hierarchy in a concise way (attributes and relationships). It is complementary to the &lt;i&gt;VariantConfiguration&lt;/i&gt; which expresses validity rules based on control strings.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;An &lt;i&gt;ApplicationConstraint &lt;/i&gt;can reference another &lt;i&gt;ApplicationConstraint&lt;/i&gt; as &lt;i&gt;baseInclusion&lt;/i&gt;. In this case, an &lt;i&gt;ApplicationConstraint&lt;/i&gt; can only be satisfied if its &lt;i&gt;baseInclusion &lt;/i&gt;is also satisfied.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1564735319213_812643_5745'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_18_5_2_854026d_1564735319224_716633_5758' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1564735319218_736969_5749' name='type' visibility='public' type='_18_5_2_854026d_1564735451792_848681_5883'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1564735319227_567699_5766' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines if the application constraint is positive (allowance) or negative (denial). If the &lt;i&gt;ApplicationConstraint &lt;/i&gt;has a &lt;i&gt;baseInclusion&lt;/i&gt; that &lt;i&gt;baseInclusion&lt;/i&gt; shall define the same type.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1564735319218_736969_5749'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735319227_256406_5767' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735319226_297524_5765' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1564735319222_350756_5750' name='fromDate' visibility='public' type='EAJava_Date'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1564735319227_300744_5769' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the lower bound of the time period to which the application constraint applies.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1564735319222_350756_5750'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735319228_971428_5770'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735319227_30571_5768' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1564735319222_622746_5751' name='toDate' visibility='public' type='EAJava_Date'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1564735319228_255813_5772' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the upper bound of the time period to which the application constraint applies.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1564735319222_622746_5751'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735319228_266336_5773'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735319228_329275_5771' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1564735319222_197391_5752' name='fromSerialNumber' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1564735319228_304560_5775' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the lower bound of a serial number range to which the application constraint applies.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1564735319222_197391_5752'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735319229_42030_5776'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735319228_796222_5774' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1564735319223_857575_5753' name='toSerialNumber' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1564735319229_972702_5778' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the upper bound of a serial number range to which the application constraint applies.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1564735319223_857575_5753'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735319229_90922_5779'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735319229_350920_5777' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1564735319223_809039_5754' name='projectPhase' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1564735319230_413929_5781' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the project phases to which the application constraint applies.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1564735319223_809039_5754'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735319230_160730_5782'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1564735319229_543740_5780' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1564735773947_258601_6000' name='baseInclusion' visibility='public' type='_18_5_2_854026d_1564735319213_812643_5745' association='_18_5_2_854026d_1564735773947_228332_5999'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735796460_952768_6036'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1564735796460_900236_6037' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1564735319224_274403_5757' name='project' visibility='public' type='EAID_71EA4408_1F82_434c_B15C_B85E191B99B7' association='_18_5_2_854026d_1564735512357_559417_5890'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735319232_58187_5788'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1564735319232_547275_5787' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1623331488667_589124_5457' name='fromEffectivityControlKey' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1623331488683_548120_5460' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;In the production logistics of complex products (like vehicles), the control of operation and cancellation dates of changes, features, components or the like is usually not carried out via concrete dates but via &amp;quot;date keys&amp;quot;. These keys are then mapped in planning systems with concrete time specifications for certain plants or production steps. In the VEC&amp;#160;these keys are called &lt;i&gt;EffectivityControlKey.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;With the &lt;i&gt;FromEffectivityControlKey&lt;/i&gt; and &lt;i&gt;To&lt;/i&gt;&lt;i&gt;EffectivityControlKey &lt;/i&gt;a validity interval can be defined. If one of the two values is defined and the other is omitted, the meaning shall be &amp;quot;unbounded&amp;quot;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1623331488667_589124_5457'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1623331488683_956079_5461'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1623331488683_477103_5459' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1623331488683_94456_5458' name='toEffectivityControlKey' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1623331488685_796103_5463' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;See &lt;i&gt;FromEffectivityControlKey.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1623331488683_94456_5458'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1623331488685_414631_5464'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1623331488685_576622_5462' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_18_5_2_854026d_1564735451792_848681_5883' name='ApplicationConstraintType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1564735451793_903270_5886' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Enumeration for the definition of the type of an ApplicationConstraints. Valid values are allow and deny.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1564735451792_848681_5883'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1564735451793_357351_5884' name='Allow'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1564735451793_915756_5885' name='Deny'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_18_5_2_854026d_1564735512357_559417_5890'>
					<memberEnd xmi:idref='_18_5_2_854026d_1564735512357_445456_5891'/>
					<memberEnd xmi:idref='_18_5_2_854026d_1564735319224_274403_5757'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1571139375069_14203_6872' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&amp;#160;Defines the projects for which the application constraint applies.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1564735512357_559417_5890'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1564735512357_445456_5891' visibility='private' type='_18_5_2_854026d_1564735319213_812643_5745' association='_18_5_2_854026d_1564735512357_559417_5890'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_18_5_2_854026d_1564735773947_228332_5999'>
					<memberEnd xmi:idref='_18_5_2_854026d_1564735773947_258601_6000'/>
					<memberEnd xmi:idref='_18_5_2_854026d_1564735773948_568420_6001'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1571139227169_293335_6871' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An &lt;i&gt;ApplicationConstraint &lt;/i&gt;can only be satisfied if its &lt;i&gt;baseInclusion &lt;/i&gt;is satisfied as well.&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1564735773947_228332_5999'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1564735773948_568420_6001' visibility='private' type='_18_5_2_854026d_1564735319213_812643_5745' association='_18_5_2_854026d_1564735773947_228332_5999'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735800499_639286_6042'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1564735800499_629930_6043' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_18_5_2_854026d_1564735319217_565830_5747'>
					<memberEnd xmi:idref='_18_5_2_854026d_1564735319225_287285_5760'/>
					<memberEnd xmi:idref='_18_5_2_854026d_1564735319226_66527_5763'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1564735319226_159616_5764' body='Specifies the ApplicationConstraints.&#10;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1564735319217_565830_5747'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1564735319226_66527_5763' visibility='public' type='_18_5_2_854026d_1564735319216_764812_5746' association='_18_5_2_854026d_1564735319217_565830_5747'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735319233_364691_5794' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1564735319233_497740_5793' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_19_0_2_854026d_1572947445549_313272_5327' name='VariantGroupType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1572947756256_838744_5353' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines valid values for the type of VariantGroups.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1572947445549_313272_5327'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1572947499306_362243_5350' name='Family'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1572947635882_783611_5352' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A group with the type &amp;quot;Family&amp;quot; defines a set of variant codes that are mutually exclusive, and a valid configuration &lt;u&gt;must&lt;/u&gt; contain one variant code from the group.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1572947499306_362243_5350'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1636112356938_102120_5465' name='OptionalFamily'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1636112404528_390275_5467' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A group with the type &amp;quot;OptionalFamily&amp;quot; defines a set of variant codes that are mutually exclusive, and a valid configuration can, but does not have to contain one variant code from the group.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1636112356938_102120_5465'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1636112463802_729498_5468' name='LogicalGroup'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1636117922470_547674_5470' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Defines a logical grouping on variant codes. However, no semantic constraint is implied.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1636112463802_729498_5468'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1572949927611_148939_5375' name='VariantStructureSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1572963519568_386444_5317' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification to define any hierarchical structure on variant groups (e.g. by the means of a functional organization).&amp;#160;The hierarchy starts with a single root node.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1572949927611_148939_5375'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_2_854026d_1572949999610_892507_5398' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1572950134907_442219_5426' name='rootNode' visibility='public' aggregation='composite' type='_19_0_2_854026d_1572950079339_931163_5400' association='_19_0_2_854026d_1572950134907_192664_5425'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1572950153914_873268_5436' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1572950153914_463669_5437' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1572950079339_931163_5400' name='VariantStructureNode'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1572963605451_855816_5318' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;VariantStructureNodes&lt;/i&gt; can be used to define a hierarchical structure on &lt;i&gt;VariantGroups&lt;/i&gt;. Every &lt;i&gt;VariantStructureNodes&lt;/i&gt; can reference &lt;i&gt;VariantGroups&lt;/i&gt; and &lt;i&gt;VariantStructureNodes&lt;/i&gt; as children.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1572950079339_931163_5400'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_2_854026d_1572952408241_986225_5566' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1572950169502_375440_5449' name='childNodes' visibility='public' aggregation='composite' type='_19_0_2_854026d_1572950079339_931163_5400' association='_19_0_2_854026d_1572950169502_622725_5448'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1572950185132_705419_5459'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1572950185132_89808_5460' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1572952022211_928625_5488' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1572952022212_251133_5492' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the &lt;i&gt;VariantStructureNode&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1572952022211_928625_5488'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1572952022213_87630_5493' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1572952022212_94169_5491' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1572952174929_793708_5514' name='aliasId' visibility='public' type='EAID_0BE66F11_D6D4_4aef_B63F_2D85865F9B68'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1572952174929_552622_5516' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Room to specify additional identifiers for the &lt;i&gt;VariantStructureNode&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1572952174929_793708_5514'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1572952174929_458750_5517'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1572952174929_918286_5515' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1572952022212_78925_5489' name='abbreviation' visibility='public' type='EAID_6E33CD1B_63D7_4da8_BED4_828037944989'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1572952022213_20075_5495' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Room for a human readable short name, title etc. of the &lt;i&gt;VariantStructureNode&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1572952022212_78925_5489'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1572952022213_570751_5496'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1572952022213_173271_5494' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1572952022212_571969_5490' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
