								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1734943891314_288271_1986' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1734943891314_314520_1987' value='1'/>
							</modelExtension>
