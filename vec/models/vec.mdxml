				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_B1908A48_B6CF_477c_8CA7_E6AA9A584B07' name='Size'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B1908A48_B6CF_477c_8CA7_E6AA9A584B07Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the size of an element by width &amp;amp; height. Per definition is width &amp;gt; height.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_B1908A48_B6CF_477c_8CA7_E6AA9A584B07'/>
					</ownedComment>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_653B78F4_FED7_49ce_B116_787E746A97DB' name='width' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_653B78F4_FED7_49ce_B116_787E746A97DBDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The width of the element.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_653B78F4_FED7_49ce_B116_787E746A97DB'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001667_FED7_49ce_B116_787E746A97DB' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001668_FED7_49ce_B116_787E746A97DB' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_B89E2F6E_0D82_461b_91A9_0CEAA4E756E7' name='height' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B89E2F6E_0D82_461b_91A9_0CEAA4E756E7Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;The height of the element.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_B89E2F6E_0D82_461b_91A9_0CEAA4E756E7'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001669_0D82_461b_91A9_0CEAA4E756E7' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001670_0D82_461b_91A9_0CEAA4E756E7' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_3743B0EB_6605_4676_AEF6_0B3BA250DA91' name='SoundDampingClass'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_3743B0EB_6605_4676_AEF6_0B3BA250DA91Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Allows the definition of a sound damping class. The sound damping class of a component is specified as a level of sound damping. The level is specified by the &lt;i&gt;classKey&lt;/i&gt;. Valid keys are specified by the &lt;i&gt;referenceSystem&lt;/i&gt;. Attributes of the type &lt;i&gt;SoundDampingClass&lt;/i&gt; normally have the multiplicity [0..*]. This means that such an attribute can have &lt;i&gt;SoundDampingClass&lt;/i&gt; entries for different &lt;i&gt;referenceSystems&lt;/i&gt;. It must not have multiple entries for the same &lt;i&gt;referenceSystem&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_3743B0EB_6605_4676_AEF6_0B3BA250DA91'/>
					</ownedComment>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_6BDA74B9_B2C2_4e76_992B_34707E0CFC1F' name='classKey' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6BDA74B9_B2C2_4e76_992B_34707E0CFC1FDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a key for the level defined in the sound damping class (e.g. A, B, C).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_6BDA74B9_B2C2_4e76_992B_34707E0CFC1F'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001671_B2C2_4e76_992B_34707E0CFC1F' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001672_B2C2_4e76_992B_34707E0CFC1F' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_F5B0BF37_C3D1_4971_A777_8B167DFCC692' name='referenceSystem' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F5B0BF37_C3D1_4971_A777_8B167DFCC692Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The identification of the sound damping class reference system, which is defining possible values and the semantic of sound damping keys.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_F5B0BF37_C3D1_4971_A777_8B167DFCC692'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001673_C3D1_4971_A777_8B167DFCC692' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001674_C3D1_4971_A777_8B167DFCC692' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_4F6487F1_26BD_4c01_9D1B_0657A585F66C' name='TemperatureInformation'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_4F6487F1_26BD_4c01_9D1B_0657A585F66CDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines valid temperature ranges for a general technical part. A part can have different valid temperature ranges in different scenarios e.g. operating temperature, storage temperature, processing temperature, environment temperature. A class can own multiple TemperatureInformations but must not have more than one TemperatureInformations of the same temperatureType.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_4F6487F1_26BD_4c01_9D1B_0657A585F66C'/>
					</ownedComment>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_FA3F6536_2F73_40ad_B066_36676ADB79A1' name='temperatureRange' visibility='public' type='EAID_CAF23CB7_00D0_48de_9B42_ADB340B9B4A8'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_FA3F6536_2F73_40ad_B066_36676ADB79A1Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the allowed temperature range for this type of temperature. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_FA3F6536_2F73_40ad_B066_36676ADB79A1'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001675_2F73_40ad_B066_36676ADB79A1'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001676_2F73_40ad_B066_36676ADB79A1' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_9F064B84_0D1A_43b8_9983_5CC28E0557D8' name='temperatureType' visibility='public' type='_19_0_2_854026d_1633609797676_809371_5476'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9F064B84_0D1A_43b8_9983_5CC28E0557D8Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The type of a TemperatureInformation.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_9F064B84_0D1A_43b8_9983_5CC28E0557D8'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001677_0D1A_43b8_9983_5CC28E0557D8'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1633609844268_891863_5496' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_7457DD90_7E8E_4045_9E17_882CA3FA1A36' name='Tolerance'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7457DD90_7E8E_4045_9E17_882CA3FA1A36Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;Tolerance&lt;/i&gt; defines the permissible limit or limits of variation for defined values (e.g. a &lt;i&gt;NumericalValue&lt;/i&gt;). The tolerated value is defined by the context in which the &lt;i&gt;Tolerance&lt;/i&gt; is contained /&amp;#160;used.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;The values of the limits of the &lt;i&gt;Tolerance&lt;/i&gt;, &lt;i&gt;LowerBoundary &lt;/i&gt;and&lt;i&gt; UpperBoundary&lt;/i&gt;, shall be interpreted as &amp;quot;modifiers&amp;quot;&amp;#160;to the actual value.  To obtain an absolute range of valid values, the values of boundaries shall be added to the actual value, regardless of the &lt;i&gt;Upper&lt;/i&gt; or &lt;i&gt;Lower&lt;/i&gt; prefix. For example, to define a value of 100mm with a tolerated variation between 95mm and 105mm, the definition would be &lt;i&gt;Value&lt;/i&gt; = 100 mm, &lt;i&gt;LowerBoundary=-5, UpperBoundary=+5&lt;/i&gt;. The &lt;i&gt;Unit&lt;/i&gt; of the &lt;i&gt;Tolerance&lt;/i&gt; boundaries is always the same as in the defining context.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_7457DD90_7E8E_4045_9E17_882CA3FA1A36'/>
					</ownedComment>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_EB693EC7_FA16_4038_A826_0743F2A6DD21' name='lowerBoundary' visibility='public' type='EAJava_double'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_EB693EC7_FA16_4038_A826_0743F2A6DD21Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the lower boundary for the tolerance.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_EB693EC7_FA16_4038_A826_0743F2A6DD21'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001679_FA16_4038_A826_0743F2A6DD21' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001680_FA16_4038_A826_0743F2A6DD21' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_0EF3FEBE_CA71_4cc4_8C5E_D0D040C564ED' name='upperBoundary' visibility='public' type='EAJava_double'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_0EF3FEBE_CA71_4cc4_8C5E_D0D040C564EDDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the upper boundary for the tolerance.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_0EF3FEBE_CA71_4cc4_8C5E_D0D040C564ED'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001681_CA71_4cc4_8C5E_D0D040C564ED' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001682_CA71_4cc4_8C5E_D0D040C564ED' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_E9E6E5D1_05CC_427c_9FD0_4C45AAAA1066' name='Unit' isAbstract='true'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E9E6E5D1_05CC_427c_9FD0_4C45AAAA1066Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;A precisely specified quantity in terms of which the magnitudes of other quantities of the same kind can be stated.&#10;The different systems to define units are represented by the subclasses of this class (e.g. SIUnit, ImperialUnit).&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_E9E6E5D1_05CC_427c_9FD0_4C45AAAA1066'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1750159603873_448614_2368' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_C0FE8345_9117_405a_9021_CCA65438379E' name='exponent' visibility='public' type='_17_0_2_854026d_1382698667677_845864_2388'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_C0FE8345_9117_405a_9021_CCA65438379EDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the exponent with which this unit instance should be used. In order to define square meters for example, the SIUnit &amp;quot;metre&amp;quot; with an exponent of 2 will be used. If no exponent is defined it is equivalent to the value 1.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_C0FE8345_9117_405a_9021_CCA65438379E'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001685_9117_405a_9021_CCA65438379E'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001686_9117_405a_9021_CCA65438379E' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1690877663573_859158_1800' name='unEceCode' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690877720488_406653_1805' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The UNECE&amp;#160;provides a list of &amp;quot;&lt;a href=&quot;https://unece.org/trade/cefact/UNLOCODE-Download&quot;&gt;Codes for Units of Measurement used in the International Trade&lt;/a&gt;&amp;quot;. This attribute shall be used for traceability of&amp;#160;&lt;i&gt;Units &lt;/i&gt;defined in the VEC&amp;#160;into the UNECE&amp;#160;system only. It provides &lt;u&gt;additional&lt;/u&gt; meta information about the unit, but shall not be used as the only definition of a &lt;i&gt;Unit.&lt;/i&gt; Specifying a UNECE code does not exempt the creating system from generating a correct VEC mapping of the corresponding unit. In case of doubt, the VEC&amp;#160;mapping has priority.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1690877663573_859158_1800'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1690877713543_522053_1803'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1690877713544_726841_1804' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_A97A45C6_9DFE_4bb6_B360_086FC9D992FE'>
					<memberEnd xmi:idref='EAID_dst7A45C6_9DFE_4bb6_B360_086FC9D992FE'/>
					<memberEnd xmi:idref='EAID_src7A45C6_9DFE_4bb6_B360_086FC9D992FE'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A97A45C6_9DFE_4bb6_B360_086FC9D992FEDocumentation' body='References the unit of the value. &#10;'>
						<annotatedElement xmi:idref='EAID_A97A45C6_9DFE_4bb6_B360_086FC9D992FE'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src7A45C6_9DFE_4bb6_B360_086FC9D992FE' visibility='public' type='EAID_4E6FCE2B_DBD2_4b6b_BD65_C0AB3380EA4E' association='EAID_A97A45C6_9DFE_4bb6_B360_086FC9D992FE'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001693__9DFE_4bb6_B360_086FC9D992FE'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001694__9DFE_4bb6_B360_086FC9D992FE' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='EAID_87C860E0_5BCB_46d3_90AC_4E109661D5D6' name='ValueDetermination'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_87C860E0_5BCB_46d3_90AC_4E109661D5D6Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Enumeration for the definition of a value determination.&#10;(see KBLFRM-316)&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_87C860E0_5BCB_46d3_90AC_4E109661D5D6'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_D94ACA0F_F4C1_4679_9A72_DFC855F337DC' name='Calculated'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_D94ACA0F_F4C1_4679_9A72_DFC855F337DCDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The value is determined by a calculation algorithm.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_D94ACA0F_F4C1_4679_9A72_DFC855F337DC'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_4AE7D09A_B5C8_41f5_AEB8_9040E20ECA33' name='Measured'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_4AE7D09A_B5C8_41f5_AEB8_9040E20ECA33Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;The value is determined by an exact measurement.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_4AE7D09A_B5C8_41f5_AEB8_9040E20ECA33'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_9D5200F1_22FA_4c2d_94D8_DB5406DAFC35' name='Estimated'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9D5200F1_22FA_4c2d_94D8_DB5406DAFC35Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;The value is estimated by a person. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_9D5200F1_22FA_4c2d_94D8_DB5406DAFC35'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_CAF23CB7_00D0_48de_9B42_ADB340B9B4A8' name='ValueRange'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_CAF23CB7_00D0_48de_9B42_ADB340B9B4A8Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;A pair of numerical values representing a value range.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_CAF23CB7_00D0_48de_9B42_ADB340B9B4A8'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_EC75A67F_7A64_4e65_8BB2_15E1210098F7' isSubstitutable='false' general='EAID_4E6FCE2B_DBD2_4b6b_BD65_C0AB3380EA4E'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_3C4B76AA_8C0E_4593_A380_CE7150067CA3' name='minimum' visibility='public' type='EAJava_double'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_3C4B76AA_8C0E_4593_A380_CE7150067CA3Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Lower bound of the value range.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_3C4B76AA_8C0E_4593_A380_CE7150067CA3'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001695_8C0E_4593_A380_CE7150067CA3' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001696_8C0E_4593_A380_CE7150067CA3' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_7973DD12_5629_49f1_AE9A_ED979D261C71' name='maximum' visibility='public' type='EAJava_double'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7973DD12_5629_49f1_AE9A_ED979D261C71Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Upper bound of the value range.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_7973DD12_5629_49f1_AE9A_ED979D261C71'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001697_5629_49f1_AE9A_ED979D261C71' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001698_5629_49f1_AE9A_ED979D261C71' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_4E6FCE2B_DBD2_4b6b_BD65_C0AB3380EA4E' name='ValueWithUnit' isAbstract='true'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_4E6FCE2B_DBD2_4b6b_BD65_C0AB3380EA4EDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Abstract class either for a single numerical measure or a range of numerical measures with upper, lower, or upper and lower bounds.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_4E6FCE2B_DBD2_4b6b_BD65_C0AB3380EA4E'/>
					</ownedComment>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst7A45C6_9DFE_4bb6_B360_086FC9D992FE' name='unitComponent' visibility='public' type='EAID_E9E6E5D1_05CC_427c_9FD0_4C45AAAA1066' association='EAID_A97A45C6_9DFE_4bb6_B360_086FC9D992FE'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001699__9DFE_4bb6_B360_086FC9D992FE' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001700__9DFE_4bb6_B360_086FC9D992FE' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1385739715811_379750_3136' name='USUnit'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385739715811_864512_3137' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The USUnit class can define quantities in the terms of the US-Unit-System by specifying the corresponding US unit name. The US Unit System is quite similar to the imperial unit system; however, some units are defined slightly different.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1385739715811_379750_3136'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1385739715811_182248_3139' isSubstitutable='false' general='EAID_E9E6E5D1_05CC_427c_9FD0_4C45AAAA1066'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1385739715811_265556_3138' name='usUnitName' visibility='public' type='_17_0_2_4_854026d_1385739730781_618297_3143'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385739715811_11517_3141' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the name of the &lt;i&gt;USUnit&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1385739715811_265556_3138'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1385739715827_941712_3142' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1385739715811_693512_3140' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1385739730781_618297_3143' name='USUnitName'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385739730815_559414_3169' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Enumeration for the definition of US unit names.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1385739730781_618297_3143'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730784_516868_3144' name='Thou'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730786_809403_3145' name='Inch'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730787_571748_3146' name='Foot'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730788_299290_3147' name='Yard'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730789_900946_3148' name='Chain'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730791_895405_3149' name='Furlong'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730792_759363_3150' name='Mile'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730793_328822_3151' name='League'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730794_160107_3152' name='FluidOunce'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730795_326454_3153' name='Gill'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730796_363454_3154' name='Pint'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730798_924189_3155' name='Quart'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730799_232646_3156' name='Gallon'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730800_549755_3157' name='Grain'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730801_288022_3158' name='Drachm'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730802_193990_3159' name='Ounce'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730802_185851_3160' name='Pound'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730803_63720_3161' name='Stone'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730804_46076_3162' name='Quarter'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730812_633806_3163' name='HundredWeight'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730813_382770_3164' name='Ton'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730814_545640_3165' name='Perch'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730814_197424_3166' name='Rood'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730815_530897_3167' name='Acre'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1385739730815_188414_3168' name='AWG'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385739730816_946406_3171' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;American wire gauge (AWG), also known as the Brown &amp;amp; Sharpe wire gauge, is a standardized wire gauge system used in the United States and Canada.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1385739730815_188414_3168'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1481113512191_524849_3422' name='BoundingBox'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481114031266_54079_3446' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The bounding box is defined for the processed state of the component, as it appears in the finished product. Therefore, it is valid to use the bounding box as simplified geometry of the component for viewing or simple DMU&amp;#160;operations. For correct 3D positioning, the bounding might require a transformation in the coordinate system of the component (see &lt;i&gt;LocalGeometrySpecification.BoundingBoxPositioning&lt;/i&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;The bounding box defines the smallest cuboid&amp;#160;(box) that can contain a described part completely. If a component has multiple variants, the bounding box is the smallest cuboid that can contain every variant, while maintaining the spatial orientation of the bounding box and component variants.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;It is valid to use the &lt;i&gt;BoundingBox&lt;/i&gt; to describe the dimensions of a component, even if not all dimensions are known (e.g. only length and width). However, it must be possible to transform such a partial bounding box into a complete bounding box by adding the missing dimensions.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481113512191_524849_3422'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1690456643282_86071_2840' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481114768156_576969_3447' name='x' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481114799172_621338_3453' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the extent of the bounding box in the direction of x&lt;i&gt; &lt;/i&gt;(length).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481114768156_576969_3447'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481114909571_153953_3456'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481114909572_932911_3457' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481114779485_149433_3449' name='y' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481114857212_800769_3454' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the extent of the bounding box in the direction of y&lt;i&gt; &lt;/i&gt;(width).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481114779485_149433_3449'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481114913329_86775_3458'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481114913329_111335_3459' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481114788706_879717_3451' name='z' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481114873567_973922_3455' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the extent of the bounding box in the direction of &lt;i&gt;z &lt;/i&gt;(height).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481114788706_879717_3451'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481114917800_544013_3460'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481114917800_820970_3461' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1481188821773_574731_3582' name='MassInformationSource'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481188950869_967586_3604' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines possible sources for &lt;i&gt;MassInformations&lt;/i&gt;. &#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1481188821773_574731_3582'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481189155311_862349_3607' name='Prototype'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481189372358_751842_3640' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;MassInformation&lt;/i&gt; with this &lt;i&gt;valueSource&lt;/i&gt; has been determined based on a preproduction part.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481189155311_862349_3607'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481189160979_651762_3609' name='Series'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481189588210_994477_3641' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;MassInformation&lt;/i&gt; with this &lt;i&gt;valueSource&lt;/i&gt; has been determined based on a serial production part.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481189160979_651762_3609'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1481189167769_976473_3611' name='IMDS'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481189761731_964714_3643' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;MassInformation&lt;/i&gt; with this &lt;i&gt;valueSource&lt;/i&gt; has been retrieved from the &lt;i&gt;IMDS&lt;/i&gt; (see &lt;a href=&quot;http://www.mdsystem.com&quot;&gt;http://www.mdsystem.com&lt;/a&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481189167769_976473_3611'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1493022004800_957339_2623' name='RobustnessClass'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1493023145319_202075_2920' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the literals that shall be used for specific robustness classes.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1493022004800_957339_2623'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1493022086997_785953_2642' name='AmbientTemperature'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1493022109466_953487_2644' name='SolidParticleProtection'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1493022128841_397880_2646' name='LiquidIngressProtection'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1571829673584_249198_5335' name='ImpactProtection'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1621416302891_178859_5407' name='AbrasionResistance'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1493021954130_593955_2603' name='RobustnessClassReferenceSystem'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1493023077441_858899_2919' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the literals that shall be used for specific robustness class reference systems.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1493021954130_593955_2603'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1493022181719_93592_2652' name='ISO 20653'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1493023225630_3024_2921' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The literal that shall be used for the ISO 20653 &amp;quot;Road vehicles - Degrees of protection&amp;#160;(IP code) - Protection of electrical equipment against foreign objects, water and access&amp;quot;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1493022181719_93592_2652'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1493022150079_829779_2648' name='ISO 6722'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1493023318531_89204_2922' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The literal that shall be used for the ISO 6722 &amp;quot;Road vehicles -- 60 V and 600 V single-core cables&amp;quot;. &#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&lt;i&gt;Note: ISO 6722-1 &amp;amp;&amp;#160;6722-2 define the same temperature classes, except that 6722-1 defines two additional (G&amp;#160;&amp;amp;&amp;#160;H). Therefore 6722-1 &amp;amp;&amp;#160;6722-2 are not differentiated here.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1493022150079_829779_2648'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1493022176763_199025_2650' name='LV 112'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1493023569672_851248_2923' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The literal that shall be used for the LV 112.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1493022176763_199025_2650'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1511874527111_687988_2918' name='LV 214'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1511874541680_977245_2920' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;OEM&amp;#160;Connector Test Specification&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1511874527111_687988_2918'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1571829611468_970989_5332' name='LV 215'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1571829623720_635860_5334' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;OEM&amp;#160;Specification for High Voltage contacting.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1571829611468_970989_5332'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1571829384073_525478_5329' name='LV 312'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1571829518635_71212_5331' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Protective systems for wiring harnesses in motor vehicles Hoses&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1571829384073_525478_5329'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_18_5_2_854026d_1523259880830_813386_5693' name='ColorReferenceSystem'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1523260080933_562768_5719' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the literals that shall be used for specific color reference systems.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1523259880830_813386_5693'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1523259924323_491425_5713' name='IEC 60757'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1523260353380_805206_5720' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The literal shall be used for the IEC&amp;#160;60757 &amp;quot;Electrotechnical engineering; code for designation of colours&amp;quot;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1523259924323_491425_5713'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1523260051649_693191_5715' name='RAL'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1523260058619_705199_5717' name='RGB'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_19_0_2_854026d_1633609797676_809371_5476' name='TemperatureType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1633609872670_175271_5497' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Defines the type (scenario)&amp;#160;for which a TemperatureInformation applies.&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1633609797676_809371_5476'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1633609914220_389275_5498' name='AmbientTemperature'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1633609924406_860913_5500' name='OperatingTemperature'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1633609941295_160169_5502' name='StorageTemperature'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1633609954930_465301_5504' name='ProcessingTemperature'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_2022x_1_854026d_1690370789474_998927_1671' name='MaterialComposition'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690441395670_446816_1770' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Parts and components are often composed from a material-mix. The &lt;i&gt;MaterialComposition &lt;/i&gt;allows the definition of the various &lt;i&gt;Material&lt;/i&gt;s in a part and their mass.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_2022x_1_854026d_1690370789474_998927_1671'/>
					</ownedComment>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1690440990148_786071_1668' name='material' visibility='public' type='EAID_349A4B4C_CCF4_4206_8013_AD19345723A4'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690441106511_224725_1676' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the material of a this composition entry with the syntax and nomenclature of a arbitrary reference system.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1690440990148_786071_1668'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1690441008178_214380_1670'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1690441008179_96163_1671' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1690441081408_75700_1672' name='massInformation' visibility='public' type='EAID_C4E8A576_BF44_44be_992A_ED6604D2BB2C'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690441274041_451014_1769' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the mass of this corresponding &lt;i&gt;Material&lt;/i&gt; in a part per Unit of quantity (e.g. g/piece or g/meter...) of the part. &#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1690441081408_75700_1672'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1690441100005_842543_1674'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1690441100005_910288_1675' value='*'/>
					</ownedAttribute>
				</packagedElement>
			</packagedElement>
			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_26F79A15_23AD_4390_9F5C_B06B09E9335B' name='placeable_element'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_BF8655EA_51BB_4cee_A4CC_260F6B53DE76' name='MeasurementPoint'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_BF8655EA_51BB_4cee_A4CC_260F6B53DE76Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines a reference point on a component that can be used to apply a Dimension. This is normally a significant point of the component e.g. an edge, a hole, a bolt or something similar.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_BF8655EA_51BB_4cee_A4CC_260F6B53DE76'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_482EC2FC_E0E0_4977_A4A6_C1CADD78E0E2' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_DFED0AF1_74CF_4231_9C81_1A3A3B9229FD' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_DFED0AF1_74CF_4231_9C81_1A3A3B9229FDDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the MeasurementPoint. The identification is guaranteed to be unique within a component.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_DFED0AF1_74CF_4231_9C81_1A3A3B9229FD'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001701_74CF_4231_9C81_1A3A3B9229FD' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001702_74CF_4231_9C81_1A3A3B9229FD' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_1E1CC9E9_DE34_416d_B1A4_53164AED787D'>
					<memberEnd xmi:idref='EAID_dst1CC9E9_DE34_416d_B1A4_53164AED787D'/>
					<memberEnd xmi:idref='EAID_src1CC9E9_DE34_416d_B1A4_53164AED787D'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_1E1CC9E9_DE34_416d_B1A4_53164AED787DDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;MeasurementPoint&lt;/i&gt; that is instanced by this &lt;i&gt;MeasurementPointReference.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_1E1CC9E9_DE34_416d_B1A4_53164AED787D'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src1CC9E9_DE34_416d_B1A4_53164AED787D' visibility='public' type='EAID_E5D349C3_720C_414c_9042_F255A66B116D' association='EAID_1E1CC9E9_DE34_416d_B1A4_53164AED787D'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001703__DE34_416d_B1A4_53164AED787D'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001704__DE34_416d_B1A4_53164AED787D' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_743509D6_227E_4fc6_B845_330865916F3F'>
					<memberEnd xmi:idref='EAID_dst3509D6_227E_4fc6_B845_330865916F3F'/>
					<memberEnd xmi:idref='EAID_src3509D6_227E_4fc6_B845_330865916F3F'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_743509D6_227E_4fc6_B845_330865916F3FDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the &lt;i&gt;MeasurementPoints&lt;/i&gt; of a &lt;i&gt;PlaceableElement&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_743509D6_227E_4fc6_B845_330865916F3F'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src3509D6_227E_4fc6_B845_330865916F3F' visibility='public' type='EAID_75439A8A_42CA_402f_AD39_CD0FCDEDA89D' association='EAID_743509D6_227E_4fc6_B845_330865916F3F'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001705__227E_4fc6_B845_330865916F3F' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001706__227E_4fc6_B845_330865916F3F' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_75439A8A_42CA_402f_AD39_CD0FCDEDA89D' name='PlaceableElementSpecification'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_75439A8A_42CA_402f_AD39_CD0FCDEDA89DDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the general aspects of a component that are enabling the component to be placed in a topology. All components that should have the ability to be placed on a certain position in the topology must have a PlaceableElementSpecification&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_75439A8A_42CA_402f_AD39_CD0FCDEDA89D'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_A095C82E_8FB9_4ba9_901D_BAEDD9A27F51' isSubstitutable='false' general='EAID_6AB9AD42_9295_4771_B673_98FDF80C9A65'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstAE1AB3_FBF4_4eba_9B62_7A7B34186DB2' name='placementPoint' visibility='public' aggregation='composite' type='EAID_1C710815_9E4A_4f20_A982_B2B4373EC80C' association='EAID_05AE1AB3_FBF4_4eba_9B62_7A7B34186DB2'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001707__FBF4_4eba_9B62_7A7B34186DB2'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001708__FBF4_4eba_9B62_7A7B34186DB2' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst3509D6_227E_4fc6_B845_330865916F3F' name='measurementPoint' visibility='public' aggregation='composite' type='EAID_BF8655EA_51BB_4cee_A4CC_260F6B53DE76' association='EAID_743509D6_227E_4fc6_B845_330865916F3F'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001709__227E_4fc6_B845_330865916F3F'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001710__227E_4fc6_B845_330865916F3F' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1383059754896_83741_2752' name='validPlacementTypes' visibility='public' type='_17_0_2_4_854026d_1383059781500_206657_2755'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1384789283452_274297_2851' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the &lt;i&gt;PlacementTypes&lt;/i&gt; that are valid for this element.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1383059754896_83741_2752'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1383059897738_663823_2778' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1383059897739_960513_2779' value='2'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_05AE1AB3_FBF4_4eba_9B62_7A7B34186DB2'>
					<memberEnd xmi:idref='EAID_dstAE1AB3_FBF4_4eba_9B62_7A7B34186DB2'/>
					<memberEnd xmi:idref='EAID_srcAE1AB3_FBF4_4eba_9B62_7A7B34186DB2'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_05AE1AB3_FBF4_4eba_9B62_7A7B34186DB2Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the &lt;i&gt;PlacementPoints&lt;/i&gt; of a &lt;i&gt;PlaceableElementSpecification&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_05AE1AB3_FBF4_4eba_9B62_7A7B34186DB2'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcAE1AB3_FBF4_4eba_9B62_7A7B34186DB2' visibility='public' type='EAID_75439A8A_42CA_402f_AD39_CD0FCDEDA89D' association='EAID_05AE1AB3_FBF4_4eba_9B62_7A7B34186DB2'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001717__FBF4_4eba_9B62_7A7B34186DB2' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001718__FBF4_4eba_9B62_7A7B34186DB2' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_F7CDEC0E_4467_4d53_AC93_E859A6528D3E'>
					<memberEnd xmi:idref='EAID_dstCDEC0E_4467_4d53_AC93_E859A6528D3E'/>
					<memberEnd xmi:idref='EAID_srcCDEC0E_4467_4d53_AC93_E859A6528D3E'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F7CDEC0E_4467_4d53_AC93_E859A6528D3EDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;PlaceableElementSpecification&lt;/i&gt; that is instanced by this &lt;i&gt;PlaceableElementRole.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_F7CDEC0E_4467_4d53_AC93_E859A6528D3E'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcCDEC0E_4467_4d53_AC93_E859A6528D3E' visibility='public' type='EAID_DFF509EF_B636_4821_BC20_CF90D081A94E' association='EAID_F7CDEC0E_4467_4d53_AC93_E859A6528D3E'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001711__4467_4d53_AC93_E859A6528D3E'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001712__4467_4d53_AC93_E859A6528D3E' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_1C710815_9E4A_4f20_A982_B2B4373EC80C' name='PlacementPoint'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_1C710815_9E4A_4f20_A982_B2B4373EC80CDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Defines a point on the component which can be placed explicitly in the topology (e.g. opening in a grommet, the entry point of a connector housing). &#10;If a PlacementPoint requires further specification for a certain component type (e.g. the entry point of a connector housing), this is done by an element specific for the component type, which related to the placement point. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_1C710815_9E4A_4f20_A982_B2B4373EC80C'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_89CDBAF9_6DD1_4ca9_84D1_B0895C5C1C38' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_023AD26D_EB95_46be_959D_E8BE63EDECDD' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_023AD26D_EB95_46be_959D_E8BE63EDECDDDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the PlacementPoint. The identification is guaranteed to be unique within a component.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_023AD26D_EB95_46be_959D_E8BE63EDECDD'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001713_EB95_46be_959D_E8BE63EDECDD' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001714_EB95_46be_959D_E8BE63EDECDD' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_DEAE0E21_19B6_426d_A8BF_0061427EB119' name='segmentDiameter' visibility='public' type='EAID_CAF23CB7_00D0_48de_9B42_ADB340B9B4A8'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_DEAE0E21_19B6_426d_A8BF_0061427EB119Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the valid segment diameter range for which this &lt;i&gt;PlacementPoint&lt;/i&gt; is suitable.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_DEAE0E21_19B6_426d_A8BF_0061427EB119'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001715_19B6_426d_A8BF_0061427EB119'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001716_19B6_426d_A8BF_0061427EB119' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637573452104_632338_6325' name='supplementaryParts' visibility='public' type='EAID_F81D9D7E_52AA_41a9_9133_E16D3AE25095' association='_19_0_2_854026d_1637573452104_513148_6324'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637573459633_887593_6333'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637573459634_530456_6334' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_8A7FA59F_9AD1_45e6_82B1_DF330E7B3A0C'>
					<memberEnd xmi:idref='EAID_dst7FA59F_9AD1_45e6_82B1_DF330E7B3A0C'/>
					<memberEnd xmi:idref='EAID_src7FA59F_9AD1_45e6_82B1_DF330E7B3A0C'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_8A7FA59F_9AD1_45e6_82B1_DF330E7B3A0CDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;PlacementPoint&lt;/i&gt; that is instanced by this &lt;i&gt;PlacementPointReference.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_8A7FA59F_9AD1_45e6_82B1_DF330E7B3A0C'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src7FA59F_9AD1_45e6_82B1_DF330E7B3A0C' visibility='public' type='EAID_BF7FB2AC_B9C1_4494_AFC3_EE88D84C2E8C' association='EAID_8A7FA59F_9AD1_45e6_82B1_DF330E7B3A0C'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001725__9AD1_45e6_82B1_DF330E7B3A0C'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001726__9AD1_45e6_82B1_DF330E7B3A0C' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1383059781500_206657_2755' name='PlacementType'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1384789331577_40137_2852' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the type for which a &lt;i&gt;PlaceableElement&lt;/i&gt; can be used. &#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1383059781500_206657_2755'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1383059825766_52424_2774' name='OnWay'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1384789365132_170248_2853' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;OnWay &lt;/i&gt;refers to an &lt;i&gt;OnWayPlacement&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1383059825766_52424_2774'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1383059833757_643518_2776' name='OnPoint'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1384789399782_232470_2854' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;OnPoint&lt;/i&gt; refers to an &lt;i&gt;OnPointPlacement&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1383059833757_643518_2776'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1425915889428_353828_2994'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1425915889428_864989_2996'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1425915889428_345696_2995'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1425915889428_864989_2996' visibility='private' type='_17_0_2_4_854026d_1425915854452_792845_2987' association='_17_0_2_4_854026d_1425915889428_353828_2994'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1637573452104_513148_6324'>
					<memberEnd xmi:idref='_19_0_2_854026d_1637573452104_632338_6325'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1637573452104_517838_6326'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637573489235_593885_6339' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;PartRelations&lt;/i&gt; that specify supplementary parts for this &lt;i&gt;PlacementPoint&lt;/i&gt;, e.g. cable ties for attaching the component on the harness.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637573452104_513148_6324'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637573452104_517838_6326' visibility='private' type='EAID_1C710815_9E4A_4f20_A982_B2B4373EC80C' association='_19_0_2_854026d_1637573452104_513148_6324'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_2022x_1_854026d_1704706496758_368594_2288' name='Legend'>
					<ownedRule xmi:type='uml:Constraint' xmi:id='_2022x_1_854026d_1704706516528_11454_2300' name='PlaceableElementSpecification'>
						<constrainedElement xmi:idref='EAID_75439A8A_42CA_402f_AD39_CD0FCDEDA89D'/>
						<constrainedElement xmi:idref='EAID_BF8655EA_51BB_4cee_A4CC_260F6B53DE76'/>
						<constrainedElement xmi:idref='_17_0_2_4_854026d_1383059781500_206657_2755'/>
						<constrainedElement xmi:idref='EAID_1C710815_9E4A_4f20_A982_B2B4373EC80C'/>
						<specification xmi:type='uml:OpaqueExpression' xmi:id='_2022x_1_854026d_1704706516528_8088_2301'>
							<language>English</language>
						</specification>
					</ownedRule>
					<ownedRule xmi:type='uml:Constraint' xmi:id='_2022x_1_854026d_1704706531241_806524_2305' name='Elements representing PlacementPoints'>
						<constrainedElement xmi:idref='EAID_59DFC2E7_24C3_4094_A51B_18DA570A6F6A'/>
						<constrainedElement xmi:idref='EAID_EDAD526C_99BC_4ff7_9CEA_82D6DAC2816C'/>
						<constrainedElement xmi:idref='_19_0_2_854026d_1637844703261_922745_6562'/>
						<constrainedElement xmi:idref='EAID_8FAC45EE_C74E_430c_BEC6_44F16C3C3104'/>
						<constrainedElement xmi:idref='EAID_FDA76D70_46D7_491d_88B6_A011D40E4721'/>
						<constrainedElement xmi:idref='_19_0_2_854026d_1637327565788_326075_5873'/>
						<specification xmi:type='uml:OpaqueExpression' xmi:id='_2022x_1_854026d_1704706531241_117197_2306'>
							<language>English</language>
						</specification>
					</ownedRule>
				</packagedElement>
			</packagedElement>
			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_E429E4C9_13A4_47dc_A9FE_B4CA48B18954' name='placement'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_B8E0D545_ED84_48ae_AC28_35CDA2D2E8E2' name='Dimension'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B8E0D545_ED84_48ae_AC28_35CDA2D2E8E2Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A Dimension defines a measurement for the distance between two Locations. An acceptable tolerance can be specified additionally. If the Locations are not located on adjacent topology-elements it is possible to specify a Path for the dimension along which the measurement must be taken.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;The value for the Dimension is not specified as NumericalValue (which can define a Tolerance as well). This is because the &amp;quot;valueComponent&amp;quot; of the NumericalValue is mandatory. For Dimensions it shall be optional since there are scenarios where the dimension only specifies a Tolerance for a distance defined by the topology (segment length + placement information).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_B8E0D545_ED84_48ae_AC28_35CDA2D2E8E2'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_2CC3D25B_3156_4822_B5D2_DE738C1A02B0' isSubstitutable='false' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_3E3B7DF3_E3FD_4081_81C3_FBC1BE15B0DF' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_3E3B7DF3_E3FD_4081_81C3_FBC1BE15B0DFDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the Dimension. The identification is guaranteed to be unique within the containing PlacementSpecification.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_3E3B7DF3_E3FD_4081_81C3_FBC1BE15B0DF'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001729_E3FD_4081_81C3_FBC1BE15B0DF' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001730_E3FD_4081_81C3_FBC1BE15B0DF' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst8DF6A5_8D2B_4e8f_A24C_DE9B02ACA524' name='definedLocations' visibility='public' aggregation='composite' type='EAID_1F2FCC66_9C3D_45ca_96DF_6158D08B3A75' association='EAID_7C8DF6A5_8D2B_4e8f_A24C_DE9B02ACA524'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001733__8D2B_4e8f_A24C_DE9B02ACA524'/>
						<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001734__8D2B_4e8f_A24C_DE9B02ACA524' value='2'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst0BAC4E_140A_4bbe_A103_FA49B8B5D726' name='referenceAnchor' visibility='public' type='EAID_E9F62F83_46DB_441f_8646_40DF71DF0A54' association='EAID_AB0BAC4E_140A_4bbe_A103_FA49B8B5D726'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001735__140A_4bbe_A103_FA49B8B5D726' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001736__140A_4bbe_A103_FA49B8B5D726' value='1'/>
							</modelExtension>
