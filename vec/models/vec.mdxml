					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_EAEF02BA_6EF8_4a6b_B07D_EC61205B6C85' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension/>
						</xmi:Extension>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_EAEF02BA_6EF8_4a6b_B07D_EC61205B6C85Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Room for additional, human readable information about the ComponentNode.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_EAEF02BA_6EF8_4a6b_B07D_EC61205B6C85'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001843_6EF8_4a6b_B07D_EC61205B6C85'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001844_6EF8_4a6b_B07D_EC61205B6C85' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1571402660909_101959_6158' name='subType' visibility='public' type='_18_5_2_854026d_1571402630146_160334_6137'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension/>
						</xmi:Extension>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1571404150806_307406_6455' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the sub type of a ComponentNode. The sub type allows a differentiation within a specific type. E.g. an actuator can be differentiated into lamps, speakers, motors.&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
