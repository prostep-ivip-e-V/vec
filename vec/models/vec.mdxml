							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000997_999D_4cd2_8D19_0381C37472AC' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000998_999D_4cd2_8D19_0381C37472AC' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst33927E_6BC2_47b8_B63F_32F80D1DB4A3' name='specification' visibility='public' type='EAID_6AB9AD42_9295_4771_B673_98FDF80C9A65' association='EAID_0633927E_6BC2_47b8_B63F_32F80D1DB4A3'>
