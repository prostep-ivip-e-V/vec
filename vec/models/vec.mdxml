					<memberEnd xmi:idref='EAID_src22B3EC_EE76_4e80_8EEE_6E6DA7B60E7F'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E622B3EC_EE76_4e80_8EEE_6E6DA7B60E7FDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Reference to the &lt;i&gt;DocumentVersion&lt;/i&gt; that represents the external data source that connected to the VEC content by the &lt;i&gt;ExternalMappingSpecification&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
