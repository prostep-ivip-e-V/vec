				<packagedElement xmi:type='uml:Class' xmi:id='EAID_10FF171C_71F5_4b17_9B2D_4A82E6EA3289' name='VariantGroup'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_10FF171C_71F5_4b17_9B2D_4A82E6EA3289Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;With a VariantGroup it is possible to group VariantCodes. The semantic of this grouping should be defined with the groupType (e.g. composition, choice, etc.).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_10FF171C_71F5_4b17_9B2D_4A82E6EA3289'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_91423708_A1AB_4eaf_BBF2_D7A2AD52120E' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_A6C1A2B9_2582_4828_BB08_3439484533E2' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A6C1A2B9_2582_4828_BB08_3439484533E2Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies a unique identification of the variant code.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_A6C1A2B9_2582_4828_BB08_3439484533E2'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI002155_2582_4828_BB08_3439484533E2' value='1'/>
							</modelExtension>
						</xmi:Extension>
