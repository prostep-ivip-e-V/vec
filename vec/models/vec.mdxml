				<packagedElement xmi:type='uml:Association' xmi:id='EAID_75012ADE_694B_4d24_9234_9B21655B8933'>
					<memberEnd xmi:idref='EAID_dst012ADE_694B_4d24_9234_9B21655B8933'/>
