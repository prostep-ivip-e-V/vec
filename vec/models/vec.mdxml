				<packagedElement xmi:type='uml:Class' xmi:id='EAID_D71D1DEA_69BD_425d_9ECF_967CA7AE269A' name='CouplingSpecification'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_D71D1DEA_69BD_425d_9ECF_967CA7AE269ADocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the description of a Coupling. A coupling allows the mapping between independent harness sections or EEComponents of the electrical system. This is done by the mapping of either-or both, ConnectorHousingRoles &amp;amp;&amp;#160;TerminalRoles of one side to the other.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_D71D1DEA_69BD_425d_9ECF_967CA7AE269A'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_BC6272CB_6C0C_4e60_AEA0_21EBB5A0C693' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1434105915032_130758_3209' name='couplingPoint' visibility='public' aggregation='composite' type='_17_0_2_4_854026d_1434105778046_688852_3172' association='_17_0_2_4_854026d_1434105915032_885729_3208'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1434105918579_69585_3226'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1434105918579_475418_3227' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1434105778046_688852_3172' name='CouplingPoint'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1434105952751_834683_3238' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;CouplingPoint&lt;/i&gt; defines a single coupling. If a coupling takes place, all sub elements are connected. If the coupling is disconnected, all subelements are disconnected.&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;If a coupling occurs between two connectors, and not just between two terminals, the &lt;i&gt;CouplingPoint&lt;/i&gt; references the respective &lt;i&gt;ConnectorHousingRoles&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1434105778046_688852_3172'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1434108926283_441657_4003' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1434105850484_141633_3201' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1434105868500_636117_3203'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1434105868500_103095_3204' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1434106082320_833377_3264' name='firstConnector' visibility='public' type='EAID_DA77A4A8_A449_48b9_9A17_764C0AB099A8' association='_17_0_2_4_854026d_1434106082320_602990_3263'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1434106086570_754201_3281'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
