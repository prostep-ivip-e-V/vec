				<packagedElement xmi:type='uml:Association' xmi:id='EAID_2CDAC9B6_2A38_41f6_A403_AAAC2F7EC344'>
					<memberEnd xmi:idref='EAID_dstDAC9B6_2A38_41f6_A403_AAAC2F7EC344'/>
					<memberEnd xmi:idref='EAID_srcDAC9B6_2A38_41f6_A403_AAAC2F7EC344'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_2CDAC9B6_2A38_41f6_A403_AAAC2F7EC344Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the wire ends that are used for the wire mounting. The minimum cardinality is one, because a wire mounting without wire end makes no sense.&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;The maximum cardinality is * in order to support multi crimps.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_2CDAC9B6_2A38_41f6_A403_AAAC2F7EC344'/>
