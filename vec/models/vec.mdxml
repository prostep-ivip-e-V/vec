						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1465909330641_560684_2638' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1465909297118_541125_2633' name='thickness' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
