						<annotatedElement xmi:idref='EAID_EEDCF23A_0C82_4d1d_B9C5_A26901B94092'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcDCF23A_0C82_4d1d_B9C5_A26901B94092' visibility='public' type='EAID_0958CE37_2D47_4de5_A271_FBA12B648821' association='EAID_EEDCF23A_0C82_4d1d_B9C5_A26901B94092'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001337__0C82_4d1d_B9C5_A26901B94092'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001338__0C82_4d1d_B9C5_A26901B94092' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='EAID_D1B0ADD5_D992_48b1_BEF5_A6BF23446F1D' name='SignalDirection'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_D1B0ADD5_D992_48b1_BEF5_A6BF23446F1DDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Enumeration for the definition of SignalDirections. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_D1B0ADD5_D992_48b1_BEF5_A6BF23446F1D'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_B0A07625_F377_4068_ADDA_C2036FD873D2' name='In'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_2FF349C0_EAAC_4905_BCEA_3F543CFB8376' name='Out'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_3F04F7F8_C930_4cf2_ADEA_03BD7DECE68B' name='InOut'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1474963661358_199920_3229' name='NetworkNodeType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1474963745357_519363_3248' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the common agreed values for the Types of a NetworkNode.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1474963661358_199920_3229'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474963795614_771949_3249' name='ECU'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583767779733_407306_5407' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Electronic Control Unit. An electronic control unit (ECU) is any embedded system in automotive electronics that controls one or more of the electrical systems or subsystems in a vehicle.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474963795614_771949_3249'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474963818833_275956_3251' name='Sensor'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583767925665_866830_5408' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A sensor is a device that detects changes to the environment and sends them as information to other devices (e.g. an ECU).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474963818833_275956_3251'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474963824417_464230_3253' name='Actuator'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583768142445_122263_5409' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An actuator is a device that is responsible for controlling or moving a mechanism.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474963824417_464230_3253'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474963846621_947069_3255' name='CouplingDevice'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583768255711_912932_5410' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A CouplingDevice is the (virtual)&amp;#160;device that separates / connects two or more wiring harnesses. &amp;quot;Virtual&amp;quot; because it can be interpreted as a device /&amp;#160;interface definition between the harnesses, where one harness behaves like an E/E&amp;#160;component form the point of view of the other harness.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474963846621_947069_3255'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474963862327_758435_3257' name='EnergyStorage'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583768543094_325363_5411' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A&amp;#160;device that stores energy in some kind of way (e.g. a battery).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474963862327_758435_3257'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965101969_274471_3261' name='Generator'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583768569988_584940_5412' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A device that can generate energy.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965101969_274471_3261'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965111754_212462_3263' name='PowerDistribution'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583769649242_296721_5413' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A device that distributes power to other devices (e.g. a fuse box).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965111754_212462_3263'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1474965119193_209927_3265' name='Switch'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1583769700199_558151_5414' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &amp;quot;Switch&amp;quot; is a device that can change its internal connectivity in reaction to some external action (e.g. connect /&amp;#160;disconnect&amp;#160;some pins). A switch has no &amp;quot;active&amp;quot; logic (in contrast to an ECU).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474965119193_209927_3265'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1571402898964_479534_6401' name='OpenEnd'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1571402898965_371925_6403' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines that this NetworkNode is the end point for some unconnected nets that require wires and routings in the resulting harness (e.g. an antenna). A NetworkNode of this type is used whenever nets shall not be connected (on one side).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1571402898964_479534_6401'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1571402898965_556040_6402' name='Ground'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1571402898965_546197_6404' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines that this NetworkNode is a grounding point.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1571402898965_556040_6402'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1474966638160_426761_3393'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1474966638160_73931_3394'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1474966638160_810191_3395'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1474966638160_810191_3395' visibility='private' type='EAID_15E10797_B998_4e89_8B20_80F970E5041D' association='_17_0_2_4_854026d_1474966638160_426761_3393'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1474966845133_695936_3475'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1474966845133_318980_3476'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1474966845133_932784_3477'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1474966845133_932784_3477' visibility='private' type='EAID_165BD20F_CFCB_4c72_A6F8_242172D08BA2' association='_17_0_2_4_854026d_1474966845133_695936_3475'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1474966864822_899674_3505' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1474966864822_935230_3506' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1474966874841_71777_3514'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1474966874841_86319_3515'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1474966874841_501844_3516'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1474966874841_501844_3516' visibility='private' type='EAID_756250C5_ECB7_4b3b_B7A7_A73EC97EF517' association='_17_0_2_4_854026d_1474966874841_71777_3514'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1474966885473_656909_3538'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1474966885473_935243_3539' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1474966527558_14590_3371' name='NetType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1474967689512_22252_3643' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;NetType&lt;/i&gt; defines the different types of Nets used in the &lt;i&gt;NetSpecification&lt;/i&gt;. The level of detail of the &lt;i&gt;NetTypes&lt;/i&gt; for the can be process dependent.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;A NetType could be just used to differentiate between conventional (analogue) communication and bus communication (digital), it can also already define the different types of digital communication (e.g. CAN, MOST, Ethernet).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1474966527558_14590_3371'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1690457089226_557655_3311' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1474966912263_57328_3552' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1474968272836_344828_3644' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the NetType. The identification is guaranteed to be unique within the NetSpecification.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1474966912263_57328_3552'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1661416993529_459881_5565' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1661416993530_901270_5566' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1474968329216_693748_3677' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
