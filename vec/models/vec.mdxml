						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637571647893_463996_6257' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;High Speed Data Connectors&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1637571618513_385811_6255'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1637571688793_227170_6258' name='AMEC'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_19_0_2_854026d_1637571726259_967635_6260' name='HMTD'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637571731601_314187_6262' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;High-Speed Modular Twisted-Pair Data&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1637571726259_967635_6260'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1637848930056_451261_6843'>
					<memberEnd xmi:idref='_19_0_2_854026d_1637848930056_834693_6844'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1637848930056_62739_6845'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637848980967_162212_6862' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;Unit&lt;/i&gt; in which all coordinates (e.g. cartesian points) of this &lt;i&gt;CavityPositionDetail&amp;#160;&lt;/i&gt;are defined. Shall be a unit of length&amp;#160;(e.g. millimetre).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637848930056_451261_6843'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637848930056_62739_6845' visibility='private' type='_19_0_2_854026d_1622624585823_730833_5954' association='_19_0_2_854026d_1637848930056_451261_6843'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637848949691_521275_6858'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637848949691_256759_6859' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1637849021969_615937_6868'>
					<memberEnd xmi:idref='_19_0_2_854026d_1637849021969_422967_6869'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1637849021969_951981_6870'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637850171328_424048_6887' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;A unit vector that points in the direction in which a terminal is inserted from the &lt;i&gt;InsertionPosition&lt;/i&gt; into the connector.&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637849021969_615937_6868'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637849021969_951981_6870' visibility='private' type='_19_0_2_854026d_1622624585823_730833_5954' association='_19_0_2_854026d_1637849021969_615937_6868'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1637931645433_144180_6948' name='WireTupleSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637932021640_719665_7035' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;Specification&lt;/i&gt; to define requirements for the handling of wire / wire element tuples (pairs, triple,...) with the focus on twisting. More precisely, the allowed untwisting at the wire ends and required measures against it.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;This definition is made independent from the &lt;i&gt;WireGroup&lt;/i&gt;, as the might be defined for the part master data (the wire on the roller). The specifications for untwisting are based on the concrete usage.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637931645433_144180_6948'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_19_0_2_854026d_1637931679325_236735_6971' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637931716466_93520_7001' name='fixationAccessory' visibility='public' aggregation='composite' type='EAID_F81D9D7E_52AA_41a9_9133_E16D3AE25095' association='_19_0_2_854026d_1637931716466_230320_7000'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637931732898_701959_7011'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637931732898_761664_7012' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637931761203_277588_7019' name='fixationRequired' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637932423846_887921_7037' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Specifies if an implementation of this specification in a concrete harness required to define a fixation against untwisting of the wire ends.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1637931761203_277588_7019'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637931785415_329707_7021'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637931785415_879766_7022' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637931788075_285945_7023' name='fixationOffset' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637932453596_584977_7038' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;The offset from the wire end, at which the fixation has to be placed.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1637931788075_285945_7023'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637931804284_511007_7025'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637931804284_781896_7026' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637931812840_921901_7027' name='maximumUntwistSingleSided' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637932477090_991899_7039' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Specifies the maximum untwist for one side. &lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1637931812840_921901_7027'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637931834089_546512_7029'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637931834089_964488_7030' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637931836322_574097_7031' name='maximumUntwistDualSided' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637932492379_109669_7040' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Specifies the maximum untwist for both sides together (A+B).&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1637931836322_574097_7031'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637931854761_867850_7033'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637931854761_739339_7034' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_19_0_2_854026d_1637931716466_230320_7000'>
					<memberEnd xmi:idref='_19_0_2_854026d_1637931716466_93520_7001'/>
					<memberEnd xmi:idref='_19_0_2_854026d_1637931716466_704291_7002'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637932514159_353096_7041' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Specifies &lt;i&gt;PartRelations&lt;/i&gt; that can / have to be used for the fixation.&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637931716466_230320_7000'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637931716466_704291_7002' visibility='private' type='_19_0_2_854026d_1637931645433_144180_6948' association='_19_0_2_854026d_1637931716466_230320_7000'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637931739243_398122_7015' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
