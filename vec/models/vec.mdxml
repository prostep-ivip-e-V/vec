				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_1EBCF541_EDA1_40ea_8842_7520037DC4D2' name='FittingSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_1EBCF541_EDA1_40ea_8842_7520037DC4D2Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specification for the definition of fittings. A fitting is a part that is used to connect pipes or tube. A fitting has a specific form (e.g. Y,T)&#10;&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_1EBCF541_EDA1_40ea_8842_7520037DC4D2'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_1313F8B7_C5A8_4a55_88D3_5087759786F5' isSubstitutable='false' general='EAID_9ADC67AC_C0ED_4f82_8B79_3349DFDB9275'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_7F87892B_87B1_4e32_A529_6FECA42E8C6F' name='form' visibility='public' type='_19_0_2_854026d_1634023676865_499792_6068'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7F87892B_87B1_4e32_A529_6FECA42E8C6FDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the form of the fitting (e.g. Y, T).&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_7F87892B_87B1_4e32_A529_6FECA42E8C6F'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001379_87B1_4e32_A529_6FECA42E8C6F'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1634025410107_719890_6123' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst3F5071_CB04_4621_8AD8_51AFEF9662C8' name='outlet' visibility='public' aggregation='composite' type='EAID_EDAD526C_99BC_4ff7_9CEA_82D6DAC2816C' association='EAID_D13F5071_CB04_4621_8AD8_51AFEF9662C8'>
