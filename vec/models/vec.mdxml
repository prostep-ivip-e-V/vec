				<packagedElement xmi:type='uml:Class' xmi:id='_19_0_2_854026d_1637841797592_585914_6010' name='ComponentPortViewItem'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637841797594_61326_6023' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;A &lt;i&gt;ComponentPortViewItem&lt;/i&gt;&lt;i&gt; &lt;/i&gt;represents a &lt;i&gt;ComponentPort&lt;/i&gt; within a &lt;i&gt;ComponentNodeViewItem&lt;/i&gt; and defines its position on the node.&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_19_0_2_854026d_1637841797592_585914_6010'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1690456877490_339485_3085' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637841797594_948589_6024' name='side' visibility='public' type='_19_0_2_854026d_1637841797592_473171_6009'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1637841797596_421445_6041' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Specifies the side of the &lt;i&gt;ComponentNodeViewItem&lt;/i&gt; on which the port should be displayed.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1637841797594_948589_6024'/>
						</ownedComment>
