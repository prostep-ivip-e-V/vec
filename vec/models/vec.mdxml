					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_FFD1AA95_301C_4c9f_BFDC_10B2781572D1' name='Path'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_FFD1AA95_301C_4c9f_BFDC_10B2781572D1Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Describes a path in the topology. A &lt;i&gt;Path&lt;/i&gt; is a continuous way through a topology without interruptions, defined by an ordered list of &lt;i&gt;TopologySegments&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_FFD1AA95_301C_4c9f_BFDC_10B2781572D1'/>
