					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_28FEB0C5_88B1_4630_9152_0866B836B9C4Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A NetworkNode is a representative for an actor in the electric system, e.g. an actuator, a sensor, an ECU&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_28FEB0C5_88B1_4630_9152_0866B836B9C4'/>
