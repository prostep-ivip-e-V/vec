				<packagedElement xmi:type='uml:Association' xmi:id='EAID_705B8C38_BE02_412b_BF66_BCCC31C47C2A'>
					<memberEnd xmi:idref='EAID_dst5B8C38_BE02_412b_BF66_BCCC31C47C2A'/>
					<memberEnd xmi:idref='EAID_src5B8C38_BE02_412b_BF66_BCCC31C47C2A'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_705B8C38_BE02_412b_BF66_BCCC31C47C2ADocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the PartVersion that is instantiated by this PartOccurrence.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
