					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1384789582801_552552_2867' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;PlacementPointReference&lt;/i&gt; is the instance of a &lt;i&gt;PlacementPoint&lt;/i&gt; in the context of an &lt;i&gt;OccurrenceOrUsage&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_BF7FB2AC_B9C1_4494_AFC3_EE88D84C2E8C'/>
					</ownedComment>
