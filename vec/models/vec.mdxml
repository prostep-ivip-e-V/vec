			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_7A27D1B6_7DC9_48c9_8C30_155514D39F2F' name='net'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_15E10797_B998_4e89_8B20_80F970E5041D' name='Net'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_15E10797_B998_4e89_8B20_80F970E5041DDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A Net is an undirected link between &lt;i&gt;NetworkPorts&lt;/i&gt;.&amp;#160;It defines that the &lt;i&gt;NetworkPorts&lt;/i&gt; are related to each other with the &lt;i&gt;Net&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;A &lt;i&gt;Net&lt;/i&gt; is normally an instance of a &lt;i&gt;NetType.&lt;/i&gt;&amp;#160;E.g. if &amp;quot;CAN-BUS&amp;quot; is defined as a &lt;i&gt;NetType&lt;/i&gt; typical &lt;i&gt;Nets&lt;/i&gt; would be &amp;quot;BODY-CAN&amp;quot;, &amp;quot;AUDIO-CAN&amp;quot;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_15E10797_B998_4e89_8B20_80F970E5041D'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_394126A4_1F51_4d7a_BE03_57244ADA5E15' isSubstitutable='false' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_3F88B25A_DBD0_4611_8585_195291233653' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_3F88B25A_DBD0_4611_8585_195291233653Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the Net. The identification is guaranteed to be unique within the NetSpecification.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_3F88B25A_DBD0_4611_8585_195291233653'/>
