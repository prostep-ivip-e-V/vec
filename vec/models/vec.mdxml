						<annotatedElement xmi:idref='EAID_9878F9EF_3E9F_4e40_A897_B9E755BFA2C0'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_11279663_4CF3_4a1b_8385_996864C26029' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstE5EE61_84E5_43df_B074_2CCF3802CF9E' name='routing' visibility='public' aggregation='composite' type='EAID_D82EA93F_B330_4d26_9C4A_9DB4B173CDAC' association='EAID_47E5EE61_84E5_43df_B074_2CCF3802CF9E'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001835__84E5_43df_B074_2CCF3802CF9E'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001836__84E5_43df_B074_2CCF3802CF9E' value='*'/>
					</ownedAttribute>
				</packagedElement>
			</packagedElement>
			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_A83F1030_D24B_4187_B4C2_784052629926' name='schematic'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_2366C143_0118_4513_A322_B90CA1259619' name='ComponentNode'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_2366C143_0118_4513_A322_B90CA1259619Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A ComponentNode is a node where an electrological component is located. It is a representative for an element in the electric system, e.g. an actuator, a sensor, an ECU. In this way it is quite similar to a NetworkNode and may even reference the corresponding NetworkNode in this case. However, a ComponentNode is more likely to be used as a representative of an inliner or a splice. Moreover, a ComponentNode can define childNodes in order to describe its internal structure.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_2366C143_0118_4513_A322_B90CA1259619'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_16B77A08_4294_42e0_A010_B277EA60EFA3' isSubstitutable='false' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_94EA4562_4DDF_4034_9B23_F07A48668D30' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension/>
						</xmi:Extension>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_94EA4562_4DDF_4034_9B23_F07A48668D30Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the ComponentNode. The identification is guaranteed to be unique within the ConnectionSpecification.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_94EA4562_4DDF_4034_9B23_F07A48668D30'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001837_4DDF_4034_9B23_F07A48668D30' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001838_4DDF_4034_9B23_F07A48668D30' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_7A5F0A7C_78D8_4186_BC05_C86A774C56E4' name='abbreviation' visibility='public' type='EAID_6E33CD1B_63D7_4da8_BED4_828037944989'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension/>
						</xmi:Extension>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7A5F0A7C_78D8_4186_BC05_C86A774C56E4Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Room for a short name of the ComponentNode.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
