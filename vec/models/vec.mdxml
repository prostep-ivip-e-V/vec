					</ownedEnd>
				</packagedElement>
			</packagedElement>
			<packagedElement xmi:type='uml:Package' xmi:id='EAPK_A244F804_05A6_4fe8_B802_433F3FD0F22C' name='routing'>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_D82EA93F_B330_4d26_9C4A_9DB4B173CDAC' name='Routing'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_D82EA93F_B330_4d26_9C4A_9DB4B173CDACDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;A Routing is the assignment of a RoutableElement (Connection or WireElementReference) to a path in the topology. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_D82EA93F_B330_4d26_9C4A_9DB4B173CDAC'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_C4BDD959_CD75_4d6f_B06C_0F9776A60C5B' isSubstitutable='false' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_F6C460DD_63A9_44a8_BA44_42E937D20A57' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F6C460DD_63A9_44a8_BA44_42E937D20A57Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the Routing. The identification is guaranteed to be unique within the RoutingSpecification.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_F6C460DD_63A9_44a8_BA44_42E937D20A57'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001821_63A9_44a8_BA44_42E937D20A57'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001822_63A9_44a8_BA44_42E937D20A57' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_47EE0609_1371_4446_AB72_9FBE283BB171' name='specialRoutedComment' visibility='public' type='EAID_6E33CD1B_63D7_4da8_BED4_828037944989'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_47EE0609_1371_4446_AB72_9FBE283BB171Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Allows the specification of an explanation why this routing has been routed in a special way. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_47EE0609_1371_4446_AB72_9FBE283BB171'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001823_1371_4446_AB72_9FBE283BB171'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001824_1371_4446_AB72_9FBE283BB171' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_7ACAE1D8_5BF8_4592_AB76_AE21E02F9DFB' name='specialRouted' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7ACAE1D8_5BF8_4592_AB76_AE21E02F9DFBDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies that routing has been created in a special way. This means it has not been calculated in the standard way, because for some reason the result of the standard calculation has been inconvenient.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_7ACAE1D8_5BF8_4592_AB76_AE21E02F9DFB'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001825_5BF8_4592_AB76_AE21E02F9DFB'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001826_5BF8_4592_AB76_AE21E02F9DFB' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
