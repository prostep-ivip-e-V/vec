						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481280388803_216589_3192' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1562587162154_876925_7136' name='supplementaryParts' visibility='public' type='EAID_F81D9D7E_52AA_41a9_9133_E16D3AE25095' association='_18_5_2_854026d_1562587162154_215345_7135'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1562587204573_64246_7164'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1562587204574_291297_7165' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_820DD5A1_6B3E_4b9b_BF59_1A353CC1E1B1' name='SlotLayout'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_820DD5A1_6B3E_4b9b_BF59_1A353CC1E1B1Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;For regularly laid out slots the slot layout describes the positions of the cavities&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
