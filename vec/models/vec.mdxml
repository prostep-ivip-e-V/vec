							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1638192243678_673592_5538' name='labelPosition' visibility='public' type='_19_0_2_854026d_1638192145148_954775_5514'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1638192304102_660102_5542' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Specifies the position of label, if this &lt;i&gt;WireElementReference&lt;/i&gt; is labled.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1638192243678_673592_5538'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1638192292131_111277_5540'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
