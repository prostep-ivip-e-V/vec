				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_13B6470B_162F_4a27_B2BA_E2D0A8D715E2' name='GeneralTechnicalPartSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_13B6470B_162F_4a27_B2BA_E2D0A8D715E2Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specification for the definition of common properties for technical parts. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_13B6470B_162F_4a27_B2BA_E2D0A8D715E2'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_D609752D_E930_4c07_B205_CDCD09770E18' isSubstitutable='false' general='EAID_6AB9AD42_9295_4771_B673_98FDF80C9A65'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_6746C46F_F541_40f1_8D64_184098AA5E06' name='colorInformation' visibility='public' type='EAID_21218238_B9C5_4c0d_9C0B_9FD8562E8CB4'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6746C46F_F541_40f1_8D64_184098AA5E06Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the color of the part.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_6746C46F_F541_40f1_8D64_184098AA5E06'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000431_F541_40f1_8D64_184098AA5E06'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000432_F541_40f1_8D64_184098AA5E06' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_733E1ADD_0D6D_4b37_979E_582A20729038' name='massInformation' visibility='public' type='EAID_C4E8A576_BF44_44be_992A_ED6604D2BB2C'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_733E1ADD_0D6D_4b37_979E_582A20729038Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the overall mass of the part per Unit of quantity (e.g. g/piece or g/meter...)&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_733E1ADD_0D6D_4b37_979E_582A20729038'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000433_0D6D_4b37_979E_582A20729038'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000434_0D6D_4b37_979E_582A20729038' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_CD5E5A98_2C20_4836_B457_C631EEA03161' name='materialInformation' visibility='public' type='EAID_349A4B4C_CCF4_4206_8013_AD19345723A4'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_CD5E5A98_2C20_4836_B457_C631EEA03161Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the material of a part with the syntax and nomenclature of a arbitrary reference system. Multiple &lt;i&gt;Material&lt;/i&gt; entries in this attribute are only allowed to express the same value in the different reference systems.  For parts that are composed of different materials, e.g. wiring harness modules, these materials and their weight proportions can be defined via the &lt;i&gt;MaterialComposition&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_CD5E5A98_2C20_4836_B457_C631EEA03161'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000435_2C20_4836_B457_C631EEA03161'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000436_2C20_4836_B457_C631EEA03161' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1690441635743_428769_1817' name='materialComposition' visibility='public' type='_2022x_1_854026d_1690370789474_998927_1671'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690441680456_198927_1821' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Parts and components are often composed from a material-mix. The &lt;i&gt;MaterialComposition &lt;/i&gt;allows the definition of the various &lt;i&gt;Material&lt;/i&gt;s in a part and their mass. For example, the proportion of copper or other precious metals in a component. It is permissible to list only individual relevant components. A complete listing of all components is not required. &#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1690441635743_428769_1817'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1690441655502_213716_1819'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1690441655502_619431_1820' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_2259E681_8443_4eaa_91E2_2DD3AAAE7B2D' name='robustnessProperties' visibility='public' type='EAID_EB5FB7F3_67F4_4812_A5C6_267D4CE8F6F7'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_2259E681_8443_4eaa_91E2_2DD3AAAE7B2DDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the robustness of a part. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_2259E681_8443_4eaa_91E2_2DD3AAAE7B2D'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000437_8443_4eaa_91E2_2DD3AAAE7B2D'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000438_8443_4eaa_91E2_2DD3AAAE7B2D' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_CC3EAB37_C4EC_4a38_ADDD_F2B8AF6B487E' name='temperatureInformation' visibility='public' type='EAID_4F6487F1_26BD_4c01_9D1B_0657A585F66C'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_CC3EAB37_C4EC_4a38_ADDD_F2B8AF6B487EDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies valid temperatures for a part. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_CC3EAB37_C4EC_4a38_ADDD_F2B8AF6B487E'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000439_C4EC_4a38_ADDD_F2B8AF6B487E'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000440_C4EC_4a38_ADDD_F2B8AF6B487E' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst2227D9_60FF_4a8f_A532_911B4DB584C7' name='partRelation' visibility='public' aggregation='composite' type='EAID_F81D9D7E_52AA_41a9_9133_E16D3AE25095' association='EAID_4E2227D9_60FF_4a8f_A532_911B4DB584C7'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000441__60FF_4a8f_A532_911B4DB584C7'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000442__60FF_4a8f_A532_911B4DB584C7' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481117292598_525579_3466' name='boundingBox' visibility='public' aggregation='composite' type='_17_0_2_4_854026d_1481113512191_524849_3422' association='_17_0_2_4_854026d_1481117292598_866937_3465'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481117295931_505306_3483'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481117295931_958760_3484' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1571404593776_220317_6717' name='fitRate' visibility='public' type='EAJava_double'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1571404620057_529116_6721' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The Failures In Time (FIT) rate of a device is the number of failures that can be expected in one billion (109) device-hours of operation.[14]&amp;#160;(E.g. 1000 devices for 1 million hours, or 1 million devices for 1000 hours each, or some other combination.) (see &lt;a href=&quot;https://en.wikipedia.org/wiki/Failure_rate#Units&quot;&gt;https://en.wikipedia.org/wiki/Failure_rate#Units&lt;/a&gt;)&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1571404593776_220317_6717'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1571404614908_108621_6719'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1571404614908_478535_6720' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1576157748426_691923_5371' name='unspecifiedAccessoryPermitted' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1576158065699_143878_5377' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines whether accessories which are not explicitly defined by a &lt;i&gt;PartRelation&lt;/i&gt; may be used with instances of this part. If this attribute is not specified the default value is &lt;i&gt;true.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1576157748426_691923_5371'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1576157992156_179396_5373'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1576157992158_663498_5374' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<defaultValue xmi:type='uml:LiteralBoolean' xmi:id='_19_0_2_854026d_1576158052329_487546_5376' value='true'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1728386665774_359767_2078' name='voltageRating' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1728386665782_901321_2080' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;The &lt;i&gt;voltageRating&lt;/i&gt; of an component indicates the maximum voltage for which the component (e.g. a fuse, connector housing,...)&amp;#160;is designed to operate safely.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1728386665774_359767_2078'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1728386665783_791306_2081'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1728386665777_956855_2079' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1728387083878_741514_2268' name='voltageLevelCompliance' visibility='public' type='_17_0_2_4_854026d_1416993302234_197079_2612'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1728387111307_702225_2272' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Defines the voltage levels (in terms of &lt;i&gt;NominalVoltage)&lt;/i&gt; for which the part is approved.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1728387083878_741514_2268'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1728387104999_870491_2270'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1728387104999_329961_2271' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1728470263244_186386_1904' name='applicationType' visibility='public' type='_2022x_1_854026d_1728456448329_308225_1708'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1728470286581_457926_1908' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the valid application types (or fields of application) for the &lt;i&gt;PartVersion&lt;/i&gt; described by this &lt;i&gt;GeneralTechnicalPartSpecification.&lt;/i&gt;&amp;#160;An application type usually implies a wide variety of aspects, such as process requirements, specifications, applicable standards, procedures to be followed etc.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&lt;u&gt;Differentiation from &lt;i&gt;VoltageComplianceLevel&lt;/i&gt;:&lt;/u&gt; Although there is an overlap between the literals of the &lt;i&gt;NominalVoltage&lt;/i&gt; and the &lt;i&gt;ApplicationType&lt;/i&gt; the statements expressed with the &lt;i&gt;applicationType&lt;/i&gt; and the &lt;i&gt;voltageComplianceLevel&lt;/i&gt; are different. The &lt;i&gt;voltageComplianceLevel&lt;/i&gt; only refers to a statement about the voltage compatibility of a part, but does not include the other aspects, e.g. process requirements. For example, a connector or cable might withstand high voltage levels (&lt;i&gt;voltageLevelCompliance&lt;/i&gt;), but might not be allowed for high voltage applications in a vehicle due to an insufficient color coding. &#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1728470263244_186386_1904'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1728470279414_918746_1906'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1728470279415_690340_1907' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_4E2227D9_60FF_4a8f_A532_911B4DB584C7'>
					<memberEnd xmi:idref='EAID_dst2227D9_60FF_4a8f_A532_911B4DB584C7'/>
					<memberEnd xmi:idref='EAID_src2227D9_60FF_4a8f_A532_911B4DB584C7'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_4E2227D9_60FF_4a8f_A532_911B4DB584C7Documentation' body='Specifies possible relations (accessories) of the specified part with other PartVersion (e.g. caps, clips). '>
						<annotatedElement xmi:idref='EAID_4E2227D9_60FF_4a8f_A532_911B4DB584C7'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src2227D9_60FF_4a8f_A532_911B4DB584C7' visibility='public' type='EAID_13B6470B_162F_4a27_B2BA_E2D0A8D715E2' association='EAID_4E2227D9_60FF_4a8f_A532_911B4DB584C7'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000493__60FF_4a8f_A532_911B4DB584C7' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000494__60FF_4a8f_A532_911B4DB584C7' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_C26B3FD7_361C_485f_97C6_49E8216952D8' name='HousingComponent'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_C26B3FD7_361C_485f_97C6_49E8216952D8Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A HousingComponent describes the interface of an EEComponent with which it can be connected to another EEComponent or a harness. The characteristics of the interface can be described with a referenced ConnectorHousingSpecification. (see KBLFRM-300)&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_C26B3FD7_361C_485f_97C6_49E8216952D8'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1481111806375_211209_3376' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_2AB886D0_EE75_4a90_81A7_F4F2ABA26817' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_2AB886D0_EE75_4a90_81A7_F4F2ABA26817Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Identification of the HousingComponent, which must be distinct for all HousingComponents of an EEComponent. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_2AB886D0_EE75_4a90_81A7_F4F2ABA26817'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000443_EE75_4a90_81A7_F4F2ABA26817' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000444_EE75_4a90_81A7_F4F2ABA26817' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst21E2C1_2D39_4598_8A97_3D2F1E08E6F3' name='pinComponent' visibility='public' aggregation='composite' type='EAID_A424651D_D460_4a66_B4C6_08A912220F63' association='EAID_2B21E2C1_2D39_4598_8A97_3D2F1E08E6F3'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000445__2D39_4598_8A97_3D2F1E08E6F3'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000446__2D39_4598_8A97_3D2F1E08E6F3' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst424818_8208_405e_AA89_CBFC17A79C1A' name='housingSpecification' visibility='public' type='EAID_2BBB9BFE_2644_42af_B3A8_A83C66A15F28' association='EAID_65424818_8208_405e_AA89_CBFC17A79C1A'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000447__8208_405e_AA89_CBFC17A79C1A'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000448__8208_405e_AA89_CBFC17A79C1A' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1385737285163_909146_3049' name='description' visibility='public' type='_17_0_2_854026d_1382703731024_96357_2253'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1385737285167_606357_3051' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies additional, human readable information about the &lt;i&gt;HousingComponent&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1385737285163_909146_3049'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1385737285167_327004_3052'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1385737285166_761974_3050' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1499267483235_79801_2885' name='compatibleTypes' visibility='public' type='_17_0_2_4_854026d_1499267412613_784172_2866'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1499267821327_91342_2902' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The values of this attribute define the &lt;i&gt;HousingComponentTypes&lt;/i&gt; that are valid to be associated with this &lt;i&gt;HousingComponent.&lt;/i&gt; In other word, if this &lt;i&gt;HousingComponent &lt;/i&gt;can&lt;i&gt; &lt;/i&gt;be associated with a relay, a fuse, a connector housing of a harness. The values are matching the &lt;i&gt;PrimaryPartType&lt;/i&gt; of the &lt;i&gt;PartVersion&lt;/i&gt; of the component that should be associated (plugged) into this housing component.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1499267483235_79801_2885'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1499267504528_960532_2887'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1499267504528_936345_2888' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1637327565797_312020_5875' name='segmentConnectionPoint' visibility='public' aggregation='composite' type='_19_0_2_854026d_1637327565788_326075_5873' association='_19_0_2_854026d_1637327565797_862580_5874'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1637327623084_298172_5886'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637327623084_558892_5887' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_2B21E2C1_2D39_4598_8A97_3D2F1E08E6F3'>
					<memberEnd xmi:idref='EAID_dst21E2C1_2D39_4598_8A97_3D2F1E08E6F3'/>
					<memberEnd xmi:idref='EAID_src21E2C1_2D39_4598_8A97_3D2F1E08E6F3'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_2B21E2C1_2D39_4598_8A97_3D2F1E08E6F3Documentation' body='Specifies the PinComponents of HousingComponent. &#10;&#10;(see KBLFRM-300)&#10;'>
						<annotatedElement xmi:idref='EAID_2B21E2C1_2D39_4598_8A97_3D2F1E08E6F3'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src21E2C1_2D39_4598_8A97_3D2F1E08E6F3' visibility='public' type='EAID_C26B3FD7_361C_485f_97C6_49E8216952D8' association='EAID_2B21E2C1_2D39_4598_8A97_3D2F1E08E6F3'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000515__2D39_4598_8A97_3D2F1E08E6F3' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000516__2D39_4598_8A97_3D2F1E08E6F3' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_CC0F938E_73FC_432a_8884_27E877155382'>
					<memberEnd xmi:idref='EAID_dst0F938E_73FC_432a_8884_27E877155382'/>
					<memberEnd xmi:idref='EAID_src0F938E_73FC_432a_8884_27E877155382'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_CC0F938E_73FC_432a_8884_27E877155382Documentation' body='Points to the HousingComponent referenced by the HousingComponent reference. &#10;(KBLFRM-401)&#10;'>
						<annotatedElement xmi:idref='EAID_CC0F938E_73FC_432a_8884_27E877155382'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src0F938E_73FC_432a_8884_27E877155382' visibility='public' type='EAID_F8A7F8AC_85EE_4f86_8F28_E4930FBD5B42' association='EAID_CC0F938E_73FC_432a_8884_27E877155382'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000451__73FC_432a_8884_27E877155382'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000452__73FC_432a_8884_27E877155382' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_9132061B_4CC3_4b54_BF57_9A46912CCF77' name='InsulationSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9132061B_4CC3_4b54_BF57_9A46912CCF77Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specification for the definition of insulation properties of a WireElement. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_9132061B_4CC3_4b54_BF57_9A46912CCF77'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_07D830D7_EF93_4dbc_A6E1_326ABE8E8A32' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1695907007775_188202_3594' name='wireType' visibility='public' type='EAID_ACBE4C96_FE6E_46d2_96BB_0E9237996505'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1695907308832_530062_3605' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the type of the insulation. A &lt;i&gt;WireType&lt;/i&gt; is a key in a reference system for the definition of wires. Some reference system define independent type fragment for insulations and conductors and the &lt;i&gt;WireType&lt;/i&gt; of a &lt;i&gt;WireElement&lt;/i&gt; is the combination of both.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;An insulation must not have more than one type. This attribute allows more than one value for the reason, that the same type can be expressed in multiple reference systems.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1695907007775_188202_3594'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1695907026406_422299_3597'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1695907026407_10759_3598' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_E4F1430D_2601_4ce9_963D_58FEA0C5734C' name='baseColor' visibility='public' type='EAID_21218238_B9C5_4c0d_9C0B_9FD8562E8CB4'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E4F1430D_2601_4ce9_963D_58FEA0C5734CDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the base color of the insulation.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_E4F1430D_2601_4ce9_963D_58FEA0C5734C'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000453_2601_4ce9_963D_58FEA0C5734C'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000454_2601_4ce9_963D_58FEA0C5734C' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_7242D213_8CF6_4686_9E24_FBB5A84B1E2F' name='firstIdentificationColor' visibility='public' type='EAID_21218238_B9C5_4c0d_9C0B_9FD8562E8CB4'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7242D213_8CF6_4686_9E24_FBB5A84B1E2FDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the first identification color of the insulation.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_7242D213_8CF6_4686_9E24_FBB5A84B1E2F'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000455_8CF6_4686_9E24_FBB5A84B1E2F'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000456_8CF6_4686_9E24_FBB5A84B1E2F' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_06E1EC8F_4A1D_4dba_BBB7_E1C39CD22F0E' name='secondIdentificationColor' visibility='public' type='EAID_21218238_B9C5_4c0d_9C0B_9FD8562E8CB4'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_06E1EC8F_4A1D_4dba_BBB7_E1C39CD22F0EDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the second identification color of the insulation.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_06E1EC8F_4A1D_4dba_BBB7_E1C39CD22F0E'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000457_4A1D_4dba_BBB7_E1C39CD22F0E'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000458_4A1D_4dba_BBB7_E1C39CD22F0E' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_74C8088E_2743_472c_A47F_0D7336180D03' name='labelIdentificationColor' visibility='public' type='EAID_21218238_B9C5_4c0d_9C0B_9FD8562E8CB4'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_74C8088E_2743_472c_A47F_0D7336180D03Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the color of a label printed on the insulation of the wire.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_74C8088E_2743_472c_A47F_0D7336180D03'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000459_2743_472c_A47F_0D7336180D03'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000460_2743_472c_A47F_0D7336180D03' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_AC965207_C996_4c80_96AC_18117414AD59' name='labelIdentificationType' visibility='public' type='_19_0_2_854026d_1634218915438_445212_5461'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_AC965207_C996_4c80_96AC_18117414AD59Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the type of a label printed, stamped or integrated on or in the insulation of the wire (e.g. alpha numerical, bar code).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_AC965207_C996_4c80_96AC_18117414AD59'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000461_C996_4c80_96AC_18117414AD59'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1634219131955_491084_5489' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_AC3EE9B0_404E_4ab5_B37C_BD099683CBF2' name='labelIdentificationValue' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_AC3EE9B0_404E_4ab5_B37C_BD099683CBF2Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the value of a label printed on the insulation of the wire. This value applies to all wire elements that satisfy this specification, so all instances share the same label value (e.g. a wire type or a core number in a multi core wire). &#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;If instances of a wire require individual labeling it has to be defined on the &lt;i&gt;WireElementReference&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_AC3EE9B0_404E_4ab5_B37C_BD099683CBF2'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000463_404E_4ab5_B37C_BD099683CBF2'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000464_404E_4ab5_B37C_BD099683CBF2' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_BC6311B3_751F_424c_AE27_BA6DD92AF463' name='material' visibility='public' type='EAID_349A4B4C_CCF4_4206_8013_AD19345723A4'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_BC6311B3_751F_424c_AE27_BA6DD92AF463Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the material of the insulation.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
