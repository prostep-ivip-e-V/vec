						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001854__BF63_4ebc_9A8B_1B5A0D56034B' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_A12CE016_8724_41a4_B90C_CD86378AF959'>
					<memberEnd xmi:idref='EAID_dst2CE016_8724_41a4_B90C_CD86378AF959'/>
					<memberEnd xmi:idref='EAID_src2CE016_8724_41a4_B90C_CD86378AF959'/>
