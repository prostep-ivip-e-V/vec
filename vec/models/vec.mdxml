						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1638197796383_151087_5975' name='connectionALength' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
