					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_B01ABECE_D10B_4f09_BB4C_BA82FECF8D66Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the definition of cavity seals. A cavity plug is a watertight non-electrical object to fill an empty cavity.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_B01ABECE_D10B_4f09_BB4C_BA82FECF8D66'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_928F052B_C846_469b_B419_44B67B84482A' isSubstitutable='false' general='_17_0_2_4_854026d_1481207239760_854280_2609'/>
