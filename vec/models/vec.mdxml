				<packagedElement xmi:type='uml:Association' xmi:id='EAID_1C78871A_101E_477b_98AB_7693824F13C0'>
					<memberEnd xmi:idref='EAID_dst78871A_101E_477b_98AB_7693824F13C0'/>
					<memberEnd xmi:idref='EAID_src78871A_101E_477b_98AB_7693824F13C0'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_1C78871A_101E_477b_98AB_7693824F13C0Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the concrete wire elements (&lt;i&gt;WireElementReference&lt;/i&gt;) that are grouped by the WireGrouping.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_1C78871A_101E_477b_98AB_7693824F13C0'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src78871A_101E_477b_98AB_7693824F13C0' visibility='public' type='EAID_6B9233F7_B7DB_436c_84CF_8C46FCF122D6' association='EAID_1C78871A_101E_477b_98AB_7693824F13C0'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001141__101E_477b_98AB_7693824F13C0'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001142__101E_477b_98AB_7693824F13C0' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_BD7D79FA_2E37_459b_A042_B4305490E73C'>
					<memberEnd xmi:idref='EAID_dst7D79FA_2E37_459b_A042_B4305490E73C'/>
					<memberEnd xmi:idref='EAID_src7D79FA_2E37_459b_A042_B4305490E73C'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_BD7D79FA_2E37_459b_A042_B4305490E73CDocumentation' body='Specifies the WireElementReferences used in the WireRole. For multi core wires more than one WireElementReference is needed. &#10;'>
						<annotatedElement xmi:idref='EAID_BD7D79FA_2E37_459b_A042_B4305490E73C'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src7D79FA_2E37_459b_A042_B4305490E73C' visibility='public' type='EAID_11D97B0F_C11F_457d_B732_CB76FE2694A6' association='EAID_BD7D79FA_2E37_459b_A042_B4305490E73C'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001143__2E37_459b_A042_B4305490E73C' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001144__2E37_459b_A042_B4305490E73C' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_E5D37E57_875D_41ee_A6F3_8188E226E11A'>
					<memberEnd xmi:idref='EAID_dstD37E57_875D_41ee_A6F3_8188E226E11A'/>
					<memberEnd xmi:idref='EAID_srcD37E57_875D_41ee_A6F3_8188E226E11A'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E5D37E57_875D_41ee_A6F3_8188E226E11ADocumentation' body='Specifies the different length of a wire. &#10;'>
						<annotatedElement xmi:idref='EAID_E5D37E57_875D_41ee_A6F3_8188E226E11A'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_dstD37E57_875D_41ee_A6F3_8188E226E11A' visibility='public' type='EAID_D461D8CC_28EC_41c5_82DE_148EA9C7C468' association='EAID_E5D37E57_875D_41ee_A6F3_8188E226E11A'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001171__875D_41ee_A6F3_8188E226E11A' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001172__875D_41ee_A6F3_8188E226E11A' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_9DF96CEB_901A_43e8_9D2E_CDFF8A9F5664' name='WireEnd'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9DF96CEB_901A_43e8_9D2E_CDFF8A9F5664Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A WireEnd is the end of a wire. This class mainly needed for the definition of a contacting. As a wire can be contacted on more than two ends (e.g. IDC) the WireEnd has a position on the wire.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_9DF96CEB_901A_43e8_9D2E_CDFF8A9F5664'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_CFB2E59A_8603_47f8_8627_30F88DFBDDD4' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_CF81D2E6_9E54_4129_9598_753B0C917791' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_CF81D2E6_9E54_4129_9598_753B0C917791Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the WireEnd. The identification is guaranteed to be unique within the WireElementReference.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_CF81D2E6_9E54_4129_9598_753B0C917791'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001147_9E54_4129_9598_753B0C917791'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001148_9E54_4129_9598_753B0C917791' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_FCBABBDF_CBE3_454b_AF46_150372E0CEBF' name='positionOnWire' visibility='public' type='EAJava_double'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_FCBABBDF_CBE3_454b_AF46_150372E0CEBFDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the order of the &lt;i&gt;WireEnds&lt;/i&gt; on the &lt;i&gt;WireElementReference&lt;/i&gt;. This must be a value between 0 and 1.&amp;#160;The &lt;i&gt;PositionOnWire&lt;/i&gt; is defined as a floating point number, to allow the ordering of an arbitrary number of &lt;i&gt;WireEnds&lt;/i&gt; while having constant known values for the first and last &lt;i&gt;WireEnd&lt;/i&gt; (&amp;quot;0.0&amp;quot; &amp;amp;&amp;#160;&amp;quot;1.0&amp;quot;). The &lt;i&gt;PositionOnWire&lt;/i&gt; is &lt;u&gt;not&lt;/u&gt; defined as a relative factor with respect to the &lt;i&gt;WireLength&lt;/i&gt; to determine an exact position of the &lt;i&gt;WireEnd &lt;/i&gt;on the wire. This would not be defined unambiguously, since a &lt;i&gt;WireElementReference&lt;/i&gt; can define multiple lengths of different &lt;i&gt;WireLengthTypes&lt;/i&gt;. If such an interpretation can be made, it is tool or process specific definition.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;In case of &lt;i&gt;WireRole&lt;/i&gt; with multiple &lt;i&gt;WireElementReferences &lt;/i&gt;the ordering of the &lt;i&gt;WireEnds&lt;/i&gt; shall be consistent for all &lt;i&gt;WireElementReferences.&lt;/i&gt; That means that all &lt;i&gt;WireEnds&lt;/i&gt; with &lt;i&gt;PositionOnWire =&amp;#160;0.0 &lt;/i&gt;are on the same side of the &lt;i&gt;WireRole.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_FCBABBDF_CBE3_454b_AF46_150372E0CEBF'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001149_CBE3_454b_AF46_150372E0CEBF' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001150_CBE3_454b_AF46_150372E0CEBF' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1446648376368_696364_2976' name='connectionEnd' visibility='public' type='EAID_6D616324_02B3_4814_BF75_A25A2F766889' association='_17_0_2_4_854026d_1446648376367_583763_2975'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1446648378967_14859_2993'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1446648378968_669069_2994' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1696861807681_347381_2284' name='cutBackLength' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1696861849047_309566_2289' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the length, by which this &lt;i&gt;WireEnd&lt;/i&gt; is cut back relative to the cut length of the outer most &lt;i&gt;WireElementReference &lt;/i&gt;(see&lt;i&gt; &lt;/i&gt;&lt;i&gt;strippingLength&lt;/i&gt; for an example).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1696861807681_347381_2284'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1696861836771_196594_2287'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1696861836771_567796_2288' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1696861997392_295856_2290' name='strippingLength' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1696862022422_455627_2295' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the length by which an insulation on this stripped relative to this &lt;i&gt;WireEnd,&lt;/i&gt; defined by the &lt;i&gt;cutBackLength&lt;/i&gt;. E.g. a &lt;i&gt;cutBackLength&lt;/i&gt; of 20mm and a &lt;i&gt;strippingLength&lt;/i&gt; of 10mm means, that this &lt;i&gt;WireElementReference&lt;/i&gt; is cutback by 20mm relative to length of whole wire, on the side of the defining &lt;i&gt;WireEnd. &lt;/i&gt;Form the remaining &lt;i&gt;WireElementReference&lt;/i&gt; are then 10mm insulation removed.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1696861997392_295856_2290'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1696862015423_439115_2293'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1696862015424_692292_2294' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1729258851594_5448_1864' name='insulationPullbackLength' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1729258875843_759276_1868' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Defines a partial stripping process in which the insulation is pulled back by the &lt;i&gt;insulationPullbackLength&lt;/i&gt; after being cut at the &lt;i&gt;strippingLength,&lt;/i&gt; and is left on the &lt;i&gt;WireEnd&lt;/i&gt; e.g. for logistic reasons. The &lt;i&gt;insulationPullbackLength&lt;/i&gt; must be shorter than the strippingLength; otherwise, it would not qualify as partial stripping.&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1729258851594_5448_1864'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1729258872543_219127_1866'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1729258872543_440489_1867' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_6B9233F7_B7DB_436c_84CF_8C46FCF122D6' name='WireGrouping'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6B9233F7_B7DB_436c_84CF_8C46FCF122D6Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;WireGrouping&lt;/i&gt; is the definition of a multi core wire in its usage.&amp;#160;The elements of a &lt;i&gt;WireGrouping &lt;/i&gt;are well defined wires (e.g. with a part number). The grouping itself is only created in its concrete usage. The most common use case is the individual definition of unshielded twisted pair wires without creating the full combinatorics of every possible core / insulation / twist combination in a part master data system (and by this creating part numbers for all of them). However, there are other use cases as well.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;A &lt;i&gt;WireGrouping &lt;/i&gt;groups the &lt;i&gt;relatedWireElementReferences&lt;/i&gt; on an equal level containedWireGroupings are on a lower level. So, in order to create something like a shielded twisted pair, one &lt;i&gt;WireGrouping &lt;/i&gt;&amp;quot;A&amp;quot; that references two &lt;i&gt;WireElementReferences &lt;/i&gt;is required to represent the twisted pair and another &lt;i&gt;WireGrouping &amp;quot;&lt;/i&gt;B&amp;quot; that contains &lt;i&gt;WireGrouping &lt;/i&gt;&amp;quot;A&amp;quot; and references the &amp;quot;shield wire element&amp;quot;.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;The referenced &lt;i&gt;WireGroupSpecification&lt;/i&gt; defines the handling of the &lt;i&gt;WireGrouping&lt;/i&gt; during its assembly (e.g. twist).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_6B9233F7_B7DB_436c_84CF_8C46FCF122D6'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_97CB673C_6961_40ef_B27F_7E53E356E853' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_485EE031_4C24_4cbb_BFEA_31A1F55524CD' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_485EE031_4C24_4cbb_BFEA_31A1F55524CDDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a unique identification of the WireGrouping. The identification is guaranteed to be unique within the WireGroupingSpecification.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_485EE031_4C24_4cbb_BFEA_31A1F55524CD'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001157_4C24_4cbb_BFEA_31A1F55524CD' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001158_4C24_4cbb_BFEA_31A1F55524CD' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst78871A_101E_477b_98AB_7693824F13C0' name='relatedWireElementReference' visibility='public' type='EAID_D461D8CC_28EC_41c5_82DE_148EA9C7C468' association='EAID_1C78871A_101E_477b_98AB_7693824F13C0'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001159__101E_477b_98AB_7693824F13C0'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001160__101E_477b_98AB_7693824F13C0' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstF2F06E_1DAC_49b9_A0B3_03E499FB2E91' name='wireGroupSpecification' visibility='public' type='EAID_6528301E_F639_4d76_8051_8DA894BC8329' association='EAID_9CF2F06E_1DAC_49b9_A0B3_03E499FB2E91'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001161__1DAC_49b9_A0B3_03E499FB2E91'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1575914882831_665228_5388' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1559921611875_901616_7700' name='connectionGroup' visibility='public' type='EAID_AB4FE7A9_D417_43b4_8D6D_EC1070903C34' association='_18_5_2_854026d_1559921611875_628243_7699'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1559921628296_771715_7722'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1559921628296_632599_7723' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1575914838363_702761_5366' name='containedWireGroupings' visibility='public' aggregation='composite' type='EAID_6B9233F7_B7DB_436c_84CF_8C46FCF122D6' association='_19_0_2_854026d_1575914838363_1962_5365'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1575914847125_811803_5374'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1575914847127_279756_5375' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_E3E8B244_601E_4168_9422_12791E1B16C2'>
					<memberEnd xmi:idref='EAID_dstE8B244_601E_4168_9422_12791E1B16C2'/>
					<memberEnd xmi:idref='EAID_srcE8B244_601E_4168_9422_12791E1B16C2'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_E3E8B244_601E_4168_9422_12791E1B16C2Documentation' body='Specifies the WireGroupings described by the WireGroupingSpecification.&#10;'>
						<annotatedElement xmi:idref='EAID_E3E8B244_601E_4168_9422_12791E1B16C2'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcE8B244_601E_4168_9422_12791E1B16C2' visibility='public' type='EAID_27105B66_D3D3_4e8e_9EBD_72B05EB2C321' association='EAID_E3E8B244_601E_4168_9422_12791E1B16C2'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001163__601E_4168_9422_12791E1B16C2'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1575914880254_695329_5387' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_27105B66_D3D3_4e8e_9EBD_72B05EB2C321' name='WireGroupingSpecification'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_27105B66_D3D3_4e8e_9EBD_72B05EB2C321Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the description of WireGroupings.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_27105B66_D3D3_4e8e_9EBD_72B05EB2C321'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_451BC614_AC00_4568_A516_1F86D42244E6' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstE8B244_601E_4168_9422_12791E1B16C2' name='wireGrouping' visibility='public' aggregation='composite' type='EAID_6B9233F7_B7DB_436c_84CF_8C46FCF122D6' association='EAID_E3E8B244_601E_4168_9422_12791E1B16C2'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001165__601E_4168_9422_12791E1B16C2' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001166__601E_4168_9422_12791E1B16C2' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_1E5BE029_047C_43c9_81F5_2792A35CE54D' name='WireLength'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_1E5BE029_047C_43c9_81F5_2792A35CE54DDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the length of a WireElementReference. A WireElementReference can have multiple lengths of different types but must not have more than one length of the same type.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_1E5BE029_047C_43c9_81F5_2792A35CE54D'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_8B9C38E5_3E8D_41a6_A318_503B2776694A' isSubstitutable='false' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_BFD84214_2F29_42ed_8B06_742F33B108CA' name='lengthType' visibility='public' type='_18_5_2_854026d_1528108108340_111530_6192'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_BFD84214_2F29_42ed_8B06_742F33B108CADocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The type of the length.&amp;#160;Possible values are defined in an open enumeration (see WireLengthType).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_BFD84214_2F29_42ed_8B06_742F33B108CA'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001167_2F29_42ed_8B06_742F33B108CA' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001168_2F29_42ed_8B06_742F33B108CA' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_3B56CAEC_A785_4b01_9D98_EC1635266D77' name='lengthValue' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_3B56CAEC_A785_4b01_9D98_EC1635266D77Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;The length value for the type. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_3B56CAEC_A785_4b01_9D98_EC1635266D77'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001169_A785_4b01_9D98_EC1635266D77' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001170_A785_4b01_9D98_EC1635266D77' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_11D97B0F_C11F_457d_B732_CB76FE2694A6' name='WireRole'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_11D97B0F_C11F_457d_B732_CB76FE2694A6Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A WireRole defines the instance specific properties and relationships of a wire.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_11D97B0F_C11F_457d_B732_CB76FE2694A6'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_FD20E303_00A0_4847_9116_A1D56A1D0106' isSubstitutable='false' general='EAID_B4BA9927_24FD_4a91_8D98_944B8F392F1E'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstEEE7D4_B882_4284_8597_64855C1B612E' name='wireSpecification' visibility='public' type='EAID_CE3C9D13_8E62_4ef8_A553_37D7F6E1CA0C' association='EAID_99EEE7D4_B882_4284_8597_64855C1B612E'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001173__B882_4284_8597_64855C1B612E' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001174__B882_4284_8597_64855C1B612E' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst7D79FA_2E37_459b_A042_B4305490E73C' name='wireElementReference' visibility='public' aggregation='composite' type='EAID_D461D8CC_28EC_41c5_82DE_148EA9C7C468' association='EAID_BD7D79FA_2E37_459b_A042_B4305490E73C'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001175__2E37_459b_A042_B4305490E73C'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001176__2E37_459b_A042_B4305490E73C' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_EA68DAC2_F465_4d3e_9580_B7E2E595B2B8' name='WireReceptionReference'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
