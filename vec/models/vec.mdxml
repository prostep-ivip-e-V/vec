					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst1E3295_0F2C_4fbd_9142_1A588E224049' name='endLocation' visibility='public' aggregation='composite' type='EAID_1F2FCC66_9C3D_45ca_96DF_6158D08B3A75' association='EAID_D01E3295_0F2C_4fbd_9142_1A588E224049'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
