				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='EAID_5C445750_7C2A_4c96_9FCF_896E8E433302' name='SiUnitName'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_5C445750_7C2A_4c96_9FCF_896E8E433302Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Enumeration for the definition of SI unit names. In difference to the SI-System gram is used as literal for the measurement of mass, instead of kilogram. Since a unit is formed with prefix and unit name gram would have to be defined as milli kilogram otherwise.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_5C445750_7C2A_4c96_9FCF_896E8E433302'/>
