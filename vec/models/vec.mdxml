							<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481553228786_4137_2851' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;WireEndAccessorySpecifications &lt;/i&gt;are describing parts that are used for a treatment of a wire end before the actual terminal is attached to the &lt;i&gt;WireEnd&lt;/i&gt; (e.g. a ferrule). In contrast to this a &lt;i&gt;TerminalProtection&lt;/i&gt; is something that is applied after the joining process.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
								<annotatedElement xmi:idref='_17_0_2_4_854026d_1481540015631_86467_2584'/>
							</ownedComment>
