					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_4048A2BA_C732_4224_B778_0F573B025C3F' name='iMax' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_4048A2BA_C732_4224_B778_0F573B025C3FDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the maximum electric current tolerated by the fuse. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
