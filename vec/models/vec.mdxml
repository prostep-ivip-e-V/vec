											<usedObjects href='PROJECT-195e27c6-e36a-4b96-9301-e34bebde338f?resource=com.nomagic.magicdraw.uml_umodel.shared_umodel#EAID_A27FCD0C_3FE4_4820_901E_D7F43A5B0875'/>
											<usedObjects href='PROJECT-195e27c6-e36a-4b96-9301-e34bebde338f?resource=com.nomagic.magicdraw.uml_umodel.shared_umodel#EAID_BFD84214_2F29_42ed_8B06_742F33B108CA'/>
											<usedObjects href='PROJECT-195e27c6-e36a-4b96-9301-e34bebde338f?resource=com.nomagic.magicdraw.uml_umodel.shared_umodel#EAID_F23ED184_97C4_492b_AE53_8C50559BAB91'/>
