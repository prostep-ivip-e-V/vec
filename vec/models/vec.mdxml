				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_FF215AFA_024F_4cfd_9086_0E80FF91A9E8'>
					<memberEnd xmi:idref='EAID_dst215AFA_024F_4cfd_9086_0E80FF91A9E8'/>
					<memberEnd xmi:idref='EAID_src215AFA_024F_4cfd_9086_0E80FF91A9E8'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_FF215AFA_024F_4cfd_9086_0E80FF91A9E8Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;WireProtectionSpecification&lt;/i&gt; that is instanced by this &lt;i&gt;WireProtectionRole.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_FF215AFA_024F_4cfd_9086_0E80FF91A9E8'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src215AFA_024F_4cfd_9086_0E80FF91A9E8' visibility='public' type='EAID_7E61D75A_7184_449a_804F_FCB0314553E3' association='EAID_FF215AFA_024F_4cfd_9086_0E80FF91A9E8'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001449__024F_4cfd_9086_0E80FF91A9E8'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001450__024F_4cfd_9086_0E80FF91A9E8' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1383650917999_584368_6113' name='CableDuctRole'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1383650932233_444409_6135' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;CableDuctRole&lt;/i&gt; defines the instance specific properties and relationships of a cable duct.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1383650917999_584368_6113'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1383650927941_293147_6133' general='EAID_B4BA9927_24FD_4a91_8D98_944B8F392F1E'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1383650979316_595648_6182' name='cableDuctSpecification' visibility='public' type='EAID_C7B5CCE0_66B3_434e_B3CF_C6750D791F57' association='_17_0_2_4_854026d_1383650979316_735365_6181'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1383650982486_857011_6199' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1383650982487_387288_6200' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1465909449145_294565_2671' name='CableTieRole'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1465909536760_456420_2734' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;CableTieRole&lt;/i&gt; defines the instance specific properties and relationships of a cable tie.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1465909449145_294565_2671'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1465909457667_684109_2691' general='EAID_B4BA9927_24FD_4a91_8D98_944B8F392F1E'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1465909474362_103166_2697' name='cableTieSpecification' visibility='public' type='_17_0_2_4_854026d_1465909233440_339432_2605' association='_17_0_2_4_854026d_1465909474362_672877_2696'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1465909478698_622719_2714' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1465909478698_237376_2715' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1465909474362_672877_2696'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1465909474362_103166_2697'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1465909474362_92661_2698'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1465909474362_92661_2698' visibility='private' type='_17_0_2_4_854026d_1465909449145_294565_2671' association='_17_0_2_4_854026d_1465909474362_672877_2696'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1465909481317_621920_2720'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1465909481317_263056_2721' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_18_5_2_854026d_1528099115681_968314_5861' name='WindingFirmness'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528099196388_572878_5885' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the firmness with which a tape is applied to a segment.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1528099115681_968314_5861'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1528099180861_296608_5881' name='Limp'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528099255091_607775_5888' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&amp;#160;The taping is applied limp (loose taping).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1528099180861_296608_5881'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1528099186764_904272_5883' name='Tight'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528099295043_984102_5889' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The taping is applied tight.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1528099186764_904272_5883'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_18_5_2_854026d_1528099109092_273672_5840' name='WindingType'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528099443367_911772_5900' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&amp;#160;Defines the type of taping. &#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1528099109092_273672_5840'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1528099386682_594484_5890' name='OnSpace'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528099480923_297629_5901' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;OnSpace&lt;/i&gt; describes a taping with gaps between the rounds (German: Luecke)&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1528099386682_594484_5890'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1528099397399_302497_5892' name='Spare'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528099542982_972066_5902' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;Spare&lt;/i&gt; describes a taping with larger gaps between the rounds (German: Spar)&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1528099397399_302497_5892'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1528099403015_956957_5894' name='Overlap'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528099604309_726077_5903' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;Overlap&lt;/i&gt; describes a taping where each round overlaps the preceeding round.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1528099403015_956957_5894'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1528099662382_459106_5904' name='DoubleOverlap'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528099682782_371101_5906' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;DoubleOverlap&lt;/i&gt; describes a taping where each round overlaps the preceeding round and the taping is done twice (forward and backwards).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1528099662382_459106_5904'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1528099416528_380027_5896' name='Spiral'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528107171959_787670_5435' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;Spiral&lt;/i&gt; defines a taping with the least overlapping (German: Spiral). &#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1528099416528_380027_5896'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_18_5_2_854026d_1528099428846_397674_5898' name='Longitudinal'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528107300162_238143_5436' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;Longitudinal &lt;/i&gt;defines a taping with where the tape is folded around a segment.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1528099428846_397674_5898'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1690524978526_941227_3610' name='Spot'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690525004671_48868_3612' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;Spot&lt;/i&gt; defines a taping where all rounds are placed at the same location (SpotTape).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1690524978526_941227_3610'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1690525128648_560303_3613' name='Cross'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690525155075_217933_3615' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;Cross&lt;/i&gt; describes a special taping method at intersections where the rounds around the segment form a cross (German: Kreuzwickel)&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1690525128648_560303_3613'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_18_5_2_854026d_1539688198955_782687_10915' name='TapeRole'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1539692865060_607955_10964' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specific &lt;i&gt;WireProtectionRole &lt;/i&gt;for instances of &lt;i&gt;TapeSpecification. &lt;/i&gt;This &lt;i&gt;Role&lt;/i&gt; is used for a all kinds of taping and the &lt;i&gt;WindingType&lt;/i&gt; defines the actual type of execution. Not all attributes in the &lt;i&gt;TapeRole&lt;/i&gt; are relevant for all &lt;i&gt;WingingTypes&lt;/i&gt;. Generating processes and systems are responsible to fill only attributes relevant for the selected &lt;i&gt;WindingType&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&amp;#160;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_18_5_2_854026d_1539688198955_782687_10915'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_18_5_2_854026d_1539688256375_800067_10939' general='EAID_7E61D75A_7184_449a_804F_FCB0314553E3'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_6F2F9D74_E24F_4463_A05D_A36766B3EE56' name='tapeOverlap' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6F2F9D74_E24F_4463_A05D_A36766B3EE56Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the amount of overlap two rounds of taping around a segment have, as an absolute value. A negative value means, that there is a gap between two rounds.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_6F2F9D74_E24F_4463_A05D_A36766B3EE56'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001183_E24F_4463_A05D_A36766B3EE56'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001184_E24F_4463_A05D_A36766B3EE56' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1528098608820_224637_5834' name='tapeOverlapRelative' visibility='public' type='EAJava_double'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528098663986_49584_5838' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the amount of overlap two rounds of taping around a segment have, as a relative value. A negative value means, that there is a gap between two rounds. Values are defined as a factor, not as a percentage. Values can be between 1.0 and negative &amp;quot;infinity&amp;quot;.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;&lt;b&gt;Examples:&lt;/b&gt; An overlap of 1.0 defines that the second round is placed exactly on top of the first one. An overlap of 0.5 specifies that one half of the second round is on top of the first round (50% overlapping), a value of 0 specifies, that there is no overlap, but also no gap. A value of -2.0 specifies that there is a gap twice the width of the tape between two rounds.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1528098608820_224637_5834'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1528098636747_495689_5836'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_18_5_2_854026d_1528098636747_795728_5837' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
