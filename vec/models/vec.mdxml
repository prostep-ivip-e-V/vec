				<packagedElement xmi:type='uml:Class' xmi:id='EAID_0A28AF5D_CB4B_4401_8F80_774E9CC4F9F5' name='Permission'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_0A28AF5D_CB4B_4401_8F80_774E9CC4F9F5Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Describes an act of acceptance together with information about the responsible person, department and company who directly provoked the approval level and status as described in the referenced Approval-instance. (see KBLFRM-229)&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_0A28AF5D_CB4B_4401_8F80_774E9CC4F9F5'/>
