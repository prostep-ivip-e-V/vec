					<ownedEnd xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1695891402890_998020_2292' visibility='private' type='_2022x_1_854026d_1695891095279_818910_2151' association='_2022x_1_854026d_1695891402890_845731_2290'/>
