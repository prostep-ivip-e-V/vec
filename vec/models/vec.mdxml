					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_580DD564_46A6_4e7f_AB0D_306671576E00' name='Yo'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_F1BF77F9_B906_4470_AC0E_85AA1C6ADF9A' name='Za'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_3B873869_5AEF_4983_8EAE_A6A2D93EA4CE' name='Zh'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_3B873869_5AEF_4983_8EAE_A6A2D93EA4CEDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Chinese&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_3B873869_5AEF_4983_8EAE_A6A2D93EA4CE'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_7972C417_7918_4065_9BF1_5B69F759C907' name='Zu'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_7972C417_7918_4065_9BF1_5B69F759C907Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Zulu&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_7972C417_7918_4065_9BF1_5B69F759C907'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_6E33CD1B_63D7_4da8_BED4_828037944989' name='LocalizedString'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6E33CD1B_63D7_4da8_BED4_828037944989Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Allows the internationalization of text contents. Attributes of the type LocalizedString normally have the multiplicity [0..*]. This means that such an attribute can have multiple values for different locales. It must not have multiple values for the same locale.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_6E33CD1B_63D7_4da8_BED4_828037944989'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_854026d_1382703731040_591441_2254' general='_17_0_2_854026d_1382703731024_96357_2253'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_6AB9AD42_9295_4771_B673_98FDF80C9A65' name='PartOrUsageRelatedSpecification'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_6AB9AD42_9295_4771_B673_98FDF80C9A65Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Base class for all specifications which are describing a &lt;i&gt;PartVersion&lt;/i&gt; or a &lt;i&gt;PartUsage&lt;/i&gt;. A &lt;i&gt;PartOrUsageRelatedSpecification&lt;/i&gt; specifies a certain aspect of the described part or usage (e.g. general technical part information, connector housing aspects or wire aspects).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_6AB9AD42_9295_4771_B673_98FDF80C9A65'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_E86E98BF_C29E_4a5b_A45A_F1C7E7104FFF' isSubstitutable='false' general='EAID_C8ED2BA6_456A_4d22_A483_85886F6FE29F'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_A83A7910_1382_45fa_8EFA_B96163E142A6' name='specialPartType' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A83A7910_1382_45fa_8EFA_B96163E142A6Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;The specialPartType allows the specification of subclassifications for a PartOrUsageRelatedSpecification (e.g. different types of connector housings). &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_A83A7910_1382_45fa_8EFA_B96163E142A6'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000163_1382_45fa_8EFA_B96163E142A6'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000164_1382_45fa_8EFA_B96163E142A6' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst2C263F_C0D1_4786_A784_E97D3FF794B6' name='describedPart' visibility='public' type='EAID_A784D820_0381_42ed_8168_0F1AE554D91B' association='EAID_9C2C263F_C0D1_4786_A784_E97D3FF794B6'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000165__C0D1_4786_A784_E97D3FF794B6'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000166__C0D1_4786_A784_E97D3FF794B6' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_9C2C263F_C0D1_4786_A784_E97D3FF794B6'>
					<memberEnd xmi:idref='EAID_dst2C263F_C0D1_4786_A784_E97D3FF794B6'/>
					<memberEnd xmi:idref='EAID_src2C263F_C0D1_4786_A784_E97D3FF794B6'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_9C2C263F_C0D1_4786_A784_E97D3FF794B6Documentation' body='References the PartVersion(s) to which the information defined in this specification applies.&#10;Example: If the PartOrUsageRelatedSpecification is a GeneralTechnicalPartSpecifcation and it defines that the color is &quot;green&quot; then all PartVersion referenced by this association are &quot;green&quot;.&#10;'>
						<annotatedElement xmi:idref='EAID_9C2C263F_C0D1_4786_A784_E97D3FF794B6'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src2C263F_C0D1_4786_A784_E97D3FF794B6' visibility='public' type='EAID_6AB9AD42_9295_4771_B673_98FDF80C9A65' association='EAID_9C2C263F_C0D1_4786_A784_E97D3FF794B6'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000197__C0D1_4786_A784_E97D3FF794B6'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000198__C0D1_4786_A784_E97D3FF794B6' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_0633927E_6BC2_47b8_B63F_32F80D1DB4A3'>
					<memberEnd xmi:idref='EAID_dst33927E_6BC2_47b8_B63F_32F80D1DB4A3'/>
					<memberEnd xmi:idref='EAID_src33927E_6BC2_47b8_B63F_32F80D1DB4A3'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_0633927E_6BC2_47b8_B63F_32F80D1DB4A3Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;PartOrUsageRelatedSpecification &lt;/i&gt;that is instantiated by this &lt;i&gt;SpecificRole.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_0633927E_6BC2_47b8_B63F_32F80D1DB4A3'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src33927E_6BC2_47b8_B63F_32F80D1DB4A3' visibility='public' type='EAID_DD988C0F_CB88_4006_8203_D3B8AC2F10B3' association='EAID_0633927E_6BC2_47b8_B63F_32F80D1DB4A3'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000167__6BC2_47b8_B63F_32F80D1DB4A3'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000168__6BC2_47b8_B63F_32F80D1DB4A3' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_4C205C02_CFFE_4ec5_8B7E_85A5315EC8CE'>
					<memberEnd xmi:idref='EAID_dst205C02_CFFE_4ec5_8B7E_85A5315EC8CE'/>
					<memberEnd xmi:idref='EAID_src205C02_CFFE_4ec5_8B7E_85A5315EC8CE'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_4C205C02_CFFE_4ec5_8B7E_85A5315EC8CEDocumentation' body='References the PartOrUsageRelatedSpecification(s) that describe the PartOrUsageRelatedSpecification. &#10;KBLFRM-399&#10;'>
						<annotatedElement xmi:idref='EAID_4C205C02_CFFE_4ec5_8B7E_85A5315EC8CE'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_src205C02_CFFE_4ec5_8B7E_85A5315EC8CE' visibility='public' type='EAID_EC964F6C_2381_4cc0_BCB0_BA106C57F4E3' association='EAID_4C205C02_CFFE_4ec5_8B7E_85A5315EC8CE'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000169__CFFE_4ec5_8B7E_85A5315EC8CE'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000170__CFFE_4ec5_8B7E_85A5315EC8CE' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_A784D820_0381_42ed_8168_0F1AE554D91B' name='PartVersion'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A784D820_0381_42ed_8168_0F1AE554D91BDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;PartVersion&lt;/i&gt; is unique identifier for a part in a company context. A part can be any components within a vehicle. The PartVersion is one of the three anchors for PDM information in the VEC. All technical information about a PartVersion is contained in one or more documents. These describing elements are normally referencing to the PartVersion.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_A784D820_0381_42ed_8168_0F1AE554D91B'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_C7779036_E57B_48a4_9710_AF9775A41AE3' isSubstitutable='false' general='EAID_32C19FD5_E9AC_4356_94A9_0A621DB4874C'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_C611F880_99CA_4352_8476_A6244FA0EA17' name='partNumber' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_C611F880_99CA_4352_8476_A6244FA0EA17Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The partNumber is the major identifier of a PartVersion. The format is user defined and respectively company specific. For all VEC-documents a PartVersion-instance can be trusted to be identical if the combination of partNumber, partVersion and companyName is identical.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_C611F880_99CA_4352_8476_A6244FA0EA17'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000171_99CA_4352_8476_A6244FA0EA17' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000172_99CA_4352_8476_A6244FA0EA17' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_AAA4641E_9B77_4173_B6F8_81CDCF962ECA' name='partVersion' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_AAA4641E_9B77_4173_B6F8_81CDCF962ECADocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The partVersion specifies the version index of a part (see also partNumber).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='EAID_AAA4641E_9B77_4173_B6F8_81CDCF962ECA'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000173_9B77_4173_B6F8_81CDCF962ECA' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000174_9B77_4173_B6F8_81CDCF962ECA' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_FA1097F3_51E5_410a_A410_F721FED5A360' name='primaryPartType' visibility='public' type='EAID_95EFB873_9AFB_4577_9F2A_D19BD7B1EA6A'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_FA1097F3_51E5_410a_A410_F721FED5A360Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The primary type of the part defines the type of the part (e.g. &lt;i&gt;ConnectorHousing&lt;/i&gt;, &lt;i&gt;Fixing&lt;/i&gt;, etc.) Since the VEC supports dual use parts (e.g. &lt;i&gt;Fixing&lt;/i&gt; &amp;amp; &lt;i&gt;WireProtection&lt;/i&gt;) the primary part type is necessary to define which specification associated to part is the primary character of the part. Therefore, all primary part types correspond to a &lt;i&gt;PartOrUsageRelatedSpecification&lt;/i&gt; and a &lt;i&gt;Role&lt;/i&gt; (e.g. &lt;i&gt;ConnectorHousing&lt;/i&gt; --&amp;gt; &lt;i&gt;ConnectorHousingSpecification --&amp;gt; ConnectorHousingRole&lt;/i&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_FA1097F3_51E5_410a_A410_F721FED5A360'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000175_51E5_410a_A410_F721FED5A360' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000176_51E5_410a_A410_F721FED5A360' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_494CF7E0_AB30_40f7_9B70_097D29FE5927' name='isPreferredPart' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_494CF7E0_AB30_40f7_9B70_097D29FE5927Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Flags a part as &amp;quot;preferred&amp;quot; by the means of being a preferred part out of a group of parts with identical technical properties. The preferred part should be used, if the other properties of a couple of parts do not allow a distinct decision.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;Even though the name suggests a boolean value, this attribute has the type &amp;quot;string&amp;quot;. The way in which preference is expressed varies greatly between the  process and usually it is a multi-value flag and not just a yes/no answer.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_494CF7E0_AB30_40f7_9B70_097D29FE5927'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000177_AB30_40f7_9B70_097D29FE5927'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000178_AB30_40f7_9B70_097D29FE5927' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_ADAB9976_9296_490f_BF87_30E71BBB7D43' name='preferredUseCase' visibility='public' type='EAID_6E33CD1B_63D7_4da8_BED4_828037944989'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_ADAB9976_9296_490f_BF87_30E71BBB7D43Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Contains a part description from the point of view of the preferred use case. Defines the function for which the part was initially designed. (e.g. &amp;quot;Grommet for Hatch&amp;quot;, &amp;quot;...passenger compartment&amp;quot;). This can be an important information for searching and selecting parts.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_ADAB9976_9296_490f_BF87_30E71BBB7D43'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000179_9296_490f_BF87_30E71BBB7D43'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1637912865208_927233_6898' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_55619151_E698_46b7_9DB8_8624A66D6B67' name='aliasId' visibility='public' type='EAID_0BE66F11_D6D4_4aef_B63F_2D85865F9B68'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_55619151_E698_46b7_9DB8_8624A66D6B67Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Room to specify additional identifiers for the PartVersion. This field must not be used for alternative PartNumbers. It is intended for identifiers others than PartNumbers, such as human readable identifiers printed on the part e.g. a number of fuse or a relay. Therefore, it does not have to be strictly unique.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_55619151_E698_46b7_9DB8_8624A66D6B67'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000181_E698_46b7_9DB8_8624A66D6B67'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000182_E698_46b7_9DB8_8624A66D6B67' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstD65499_56DD_40f1_AED0_9836F75A3984' name='project' visibility='public' type='EAID_71EA4408_1F82_434c_B15C_B85E191B99B7' association='EAID_FBD65499_56DD_40f1_AED0_9836F75A3984'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000185__56DD_40f1_AED0_9836F75A3984'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000186__56DD_40f1_AED0_9836F75A3984' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1481103733666_732367_3116' name='nature' visibility='public' type='_17_0_2_4_854026d_1481103424089_292157_3006'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1481103751166_642256_3123' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;nature&lt;/i&gt; specifies how the &lt;i&gt;PartVersion &lt;/i&gt;can be used in the different processes or the significance of the &lt;i&gt;PartVersion&lt;/i&gt; in the process.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;The &lt;i&gt;nature&lt;/i&gt; of a &lt;i&gt;PartVersion&lt;/i&gt; is normally inherent and does not change. If the &lt;i&gt;nature&lt;/i&gt; the underlying part changes a new (other) &lt;i&gt;partNumber&lt;/i&gt; is assigned to the part and respectively a new &lt;i&gt;PartVersion&lt;/i&gt; is created.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;It used to differentiate for example normal (productive) part numbers from preliminary (prototypic) part numbers.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1481103733666_732367_3116'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1481103746412_854344_3121'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1481103746412_12906_3122' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1750072812383_765585_1814' name='partNumberType' visibility='public' type='_2022x_1_854026d_1750072710684_76376_1795'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1750072838917_168836_1819' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;Specifies the classification of the part number associated with this &lt;i&gt;PartVersion&lt;/i&gt;, indicating its semantic role within the BOM&amp;#160;methodology of the issuing process (see &lt;i&gt;PartNumberType&lt;/i&gt; for more details).&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1750072812383_765585_1814'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1750072830092_934264_1817'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1750072830094_555098_1818' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_FBD65499_56DD_40f1_AED0_9836F75A3984'>
					<memberEnd xmi:idref='EAID_dstD65499_56DD_40f1_AED0_9836F75A3984'/>
					<memberEnd xmi:idref='EAID_srcD65499_56DD_40f1_AED0_9836F75A3984'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_FBD65499_56DD_40f1_AED0_9836F75A3984Documentation' body='References the project that develops the PartVersion. &#10;'>
						<annotatedElement xmi:idref='EAID_FBD65499_56DD_40f1_AED0_9836F75A3984'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcD65499_56DD_40f1_AED0_9836F75A3984' visibility='public' type='EAID_A784D820_0381_42ed_8168_0F1AE554D91B' association='EAID_FBD65499_56DD_40f1_AED0_9836F75A3984'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001605__56DD_40f1_AED0_9836F75A3984'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI001606__56DD_40f1_AED0_9836F75A3984' value='*'/>
					</ownedEnd>
