				<packagedElement xmi:type='uml:Class' xmi:id='EAID_16AEC893_A325_4551_9EE2_DB64B30B87DF' name='WireMounting'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_16AEC893_A325_4551_9EE2_DB64B30B87DFDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;WireMounting&lt;/i&gt; defines the mounting of a wire end to terminal. If the contacting is required to be waterproof a cavity seal can be mounted additionally.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
