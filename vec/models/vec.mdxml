						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444988261369_20902_3107' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An &lt;i&gt;InternalComponentConnection&lt;/i&gt; defines a conductive connection between &lt;i&gt;PinComponents &lt;/i&gt;within an &lt;i&gt;EEComponent&lt;/i&gt;. Such a connection can be statically permanent or dynamically switch (e.g. by a relais). This behaviour can be defined with a &lt;i&gt;SwitchingState&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;The electrical behaviour of an &lt;i&gt;InternalComponentConnection &lt;/i&gt;can be further specified by a referenced &lt;i&gt;ConductorSpecification.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1434108801485_353034_3926'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1434108843938_185356_3980' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1434109277148_596646_4136' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444989788813_886500_3108' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Identification of the &lt;i&gt;InternalComponentConnection&lt;/i&gt;, which must be distinct for all &lt;i&gt;InternalComponentConnection&lt;/i&gt; of an &lt;i&gt;EEComponent&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1434109277148_596646_4136'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1434109301054_953590_4138' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1434109301054_674307_4139' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1436441115377_841059_2544' name='conductorSpecification' visibility='public' type='EAID_58B1BEDB_9393_4275_87CB_E943E3F5D823' association='_17_0_2_4_854026d_1436441115377_396577_2543'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1436441120205_223665_2561'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1436441120205_657191_2562' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1436441372488_771954_2544' name='pins' visibility='public' type='EAID_A424651D_D460_4a66_B4C6_08A912220F63' association='_17_0_2_4_854026d_1436441372488_722693_2543'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1436441377816_274624_2561' value='2'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1436441377816_427435_2562' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1434110897032_215544_4163'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1434110897032_405618_4164'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1434110897032_362418_4165'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444987876120_685940_3105' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the available &lt;i&gt;SwitchingStates&lt;/i&gt; of the EEComponent.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1434110897032_215544_4163'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1434110897032_362418_4165' visibility='private' type='EAID_03AF63D5_DC1E_4745_9B0B_184938A1D41E' association='_17_0_2_4_854026d_1434110897032_215544_4163'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1434110902266_284407_4181' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1434110902266_428791_4182' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1434110885610_593923_4141' name='SwitchingState'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444986965727_391208_3102' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;SwitchingState&lt;/i&gt; defines a certain static state of an &lt;i&gt;EEComponent&lt;/i&gt;. Under which conditions or when such a state applies, should be described in an external description model.&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;A &lt;i&gt;SwitchingState&lt;/i&gt; references a collection of &lt;i&gt;InternalComponentConnections&lt;/i&gt;, with the semantic that these connections exist (and only these connections) when the switching state is active.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1434110885610_593923_4141'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1434110965236_866336_4218' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1434110908751_777229_4193' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444987838070_544217_3103' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Identification of the SwitchingState, which must be distinct for all SwitchingStates of an EEComponent.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1434110908751_777229_4193'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1434110929454_980115_4195' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1434110929454_56779_4196' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1434110997315_528827_4230' name='switchedConnections' visibility='public' type='_17_0_2_4_854026d_1434108801485_353034_3926' association='_17_0_2_4_854026d_1434110997315_593274_4229'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1434111024862_187836_4253'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1434111024862_790101_4254' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1434112271002_365115_4279'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1434112271002_39544_4280'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1434112271002_366279_4281'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444986308896_108289_2888' body='Specifies the available ExtensionSlots of the EEComponent. '>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1434112271002_365115_4279'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1434112271002_366279_4281' visibility='private' type='EAID_03AF63D5_DC1E_4745_9B0B_184938A1D41E' association='_17_0_2_4_854026d_1434112271002_365115_4279'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1434112296361_101018_4303' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1434112296361_199035_4304' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1434112270971_425238_4278' name='ExtensionSlot'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444986131458_518878_2886' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An &lt;i&gt;ExtensionSlot &lt;/i&gt;defines a slot within an EE-Component where other EE-Components can be plugged into (modular extension). This is necessary for example for modular power distributions.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1434112270971_425238_4278'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1434112393597_604517_4347' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1434112343549_727747_4322' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444986271436_320422_2887' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Identification of the ExtensionSlot, which must be distinct for all ExtensionSlots of an EEComponent.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1434112343549_727747_4322'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1434112364972_610096_4324' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1434112364972_759831_4325' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1434112404425_105472_4353' name='allowedInserts' visibility='public' type='EAID_F81D9D7E_52AA_41a9_9133_E16D3AE25095' association='_17_0_2_4_854026d_1434112404425_946238_4352'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1434112772383_43841_4370'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1434112772383_609450_4371' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1434112404425_946238_4352'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1434112404425_105472_4353'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1434112404441_850968_4354'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444986314241_73376_2889' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;PartRelations&lt;/i&gt; that are valid inserts for this &lt;i&gt;ExtensionSlot.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;This reference points to &lt;i&gt;PartRelations&lt;/i&gt; in order to allow referencing indirectly a &lt;i&gt;PartVersion &lt;/i&gt;if the description of individual &lt;i&gt;PartVersions&lt;/i&gt; is done with one physical VEC file per &lt;i&gt;PartVersion &lt;/i&gt;and to allow the expression of optional inserts, choices etc. However, inserts for an &lt;i&gt;ExtensionSlot&lt;/i&gt; are always &lt;i&gt;EEComponents&lt;/i&gt; by itself. Therefore, the referenced &lt;i&gt;PartVersion&lt;/i&gt; shall have a &lt;i&gt;PrimaryPartType =&amp;#160;EEComponent.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1434112404425_946238_4352'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1434112404441_850968_4354' visibility='private' type='_17_0_2_4_854026d_1434112270971_425238_4278' association='_17_0_2_4_854026d_1434112404425_946238_4352'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1434112774930_482199_4376'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1434112774930_496584_4377' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1436441115377_396577_2543'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1436441115377_841059_2544'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1436441115377_975987_2545'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1436441115377_975987_2545' visibility='private' type='_17_0_2_4_854026d_1434108801485_353034_3926' association='_17_0_2_4_854026d_1436441115377_396577_2543'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1436441138253_785860_2573'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1436441138253_770495_2574' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='_17_0_2_4_854026d_1436441372488_722693_2543'>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1436441372488_771954_2544'/>
					<memberEnd xmi:idref='_17_0_2_4_854026d_1436441372488_720795_2545'/>
					<ownedEnd xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1436441372488_720795_2545' visibility='private' type='_17_0_2_4_854026d_1434108801485_353034_3926' association='_17_0_2_4_854026d_1436441372488_722693_2543'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1436441380457_337663_2567'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1436441380457_534681_2568' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1436269670117_230322_2829' name='PinComponentType'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444992119393_390003_3188' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the type of a &lt;i&gt;PinComponent&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1436269670117_230322_2829'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1436269701001_344029_2848' name='Switch'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1436269705428_999740_2850' name='Coil'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1436269708250_493691_2852' name='Ground'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1436269774447_727868_2866' name='PowerSupply'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1491479536814_776312_2604' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;PowerSupply&lt;/i&gt; defines a &lt;i&gt;PinComponent &lt;/i&gt;that is used to supply the component itself with power (in contrast to &lt;i&gt;PowerDistribution&lt;/i&gt;). &lt;i&gt;PinComponentBehaviours&lt;/i&gt; of &lt;i&gt;PinComponents&lt;/i&gt; with this type always have the &lt;i&gt;SignalDirection&lt;/i&gt; &lt;i&gt;&amp;quot;In&lt;/i&gt;&amp;quot;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1436269774447_727868_2866'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1491479719308_282167_2605' name='PowerDistribution'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1491480921751_841016_2882' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;PowerDistribution&lt;/i&gt; defines a &lt;i&gt;PinComponent &lt;/i&gt;that is used to distribute power to other components (in contrast to &lt;i&gt;PowerSupply&lt;/i&gt;). The semantic of this type depends on the &lt;i&gt;SignalDirection&lt;/i&gt;. &lt;i&gt;In&lt;/i&gt; means, that this &lt;i&gt;PinComponent&lt;/i&gt; is used to supply power to the EEComponent for further distribution to other components. &lt;i&gt;Out&lt;/i&gt; means that the &lt;i&gt;PinComponent&lt;/i&gt; is a source of power for other EEComponents. It is undefined whether the pin is fused/limited or not.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1491479719308_282167_2605'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_2022x_1_854026d_1690356972559_331476_1723' name='PowerDistributionLimited'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690357353301_549970_1815' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;&lt;i&gt;PowerDistributionLimited&lt;/i&gt; has the same meaning as &lt;i&gt;PowerDistribution&lt;/i&gt;, except that &lt;i&gt;PowerDistributionLimited&lt;/i&gt; defines a pin that is limited &lt;u&gt;by an electronic measure&lt;/u&gt; within the parent component (eFuse). Limitation with a conventional fuse is &lt;u&gt;&lt;b&gt;not&lt;/b&gt;&lt;/u&gt; within the semantic of &lt;i&gt;PowerDistributionLimited&lt;/i&gt; since conventional fusing can be recognized with the internal connectivity.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1690356972559_331476_1723'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1436269833919_345842_2868' name='Signal'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1436270177605_656393_2874' name='NotConnected'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1437128987960_378342_2892' name='RelaisApplianceType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1444992180343_522860_3190' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the appliance type of a relais.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1437128987960_378342_2892'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1437130479260_547306_2944' name='Soldered'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1437130484229_732393_2946' name='Screwed'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1437130487260_819694_2948' name='Plugged'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_4_854026d_1437131081316_308196_2952' name='RelaisType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1437131271886_137207_3006' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the type of a relais (switching behaviour).&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1437131081316_308196_2952'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1437131236510_602713_2998' name='Normally open'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1437131316261_260318_3007' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1437131236510_602713_2998'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1437131240354_21054_3000' name='Normally closed'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1437131344749_429_3008' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines a relais that is &lt;i&gt;closed&lt;/i&gt; in its normal state.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1437131240354_21054_3000'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1437131244432_148068_3002' name='Switch'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1437131358279_834849_3009' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines a relais that is a switch.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1437131244432_148068_3002'/>
						</ownedComment>
					</ownedLiteral>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_4_854026d_1437131257604_824622_3004' name='Bistable'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1437131369951_503126_3010' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines a relais that is &lt;i&gt;bistable&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1437131257604_824622_3004'/>
						</ownedComment>
					</ownedLiteral>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1443699620188_69016_2551' name='ModularSlotAddOn'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1443700333769_777042_2775' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the wire addon needed to reach a &lt;i&gt;ModularSlot&lt;/i&gt; from a specific &lt;i&gt;SegmentConnectionPoint&lt;/i&gt;. The addon needed to reach the cavities of the insert(s) from this point is defined by the &lt;i&gt;ConnectorHousingSpecification &lt;/i&gt;of the insert.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1443699620188_69016_2551'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1690457072400_270014_3310' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1443699684814_519518_2591' name='wireAddOn' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1443699980368_992983_2764' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the wire length add on needed for the modular slot.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1443699684814_519518_2591'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1443699719762_934118_2595' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1443699719762_597739_2596' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1443699802034_874606_2681' name='slot' visibility='public' type='EAID_F80F9FA7_58FF_4066_BE65_9A9D5120715D' association='_17_0_2_4_854026d_1443699802034_347290_2680'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1443699804510_985554_2698' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1443699804510_275162_2699' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1443699628850_997509_2572' name='CavityAddOn'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1443700498531_9972_2776' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the wire addon needed to reach a &lt;i&gt;Cavity&lt;/i&gt; from a specific &lt;i&gt;SegmentConnectionPoint&lt;/i&gt;. More specifically, it is the addon required to calculate the cutting length of a wire. It is not a measured distance between the segment connection point and the insertion point of the cavity. For each &lt;i&gt;SegmentConnectionPoint&lt;/i&gt; there shall be no more than one add-on value per cavity and type.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1443699628850_997509_2572'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1690456787814_415516_3027' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1443699699357_364335_2593' name='wireAddOn' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1443699972050_498118_2763' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the wire length add on needed for the cavity.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1443699699357_364335_2593'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1443699726140_393580_2597' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1443699726140_559034_2598' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1443699813604_897549_2714' name='cavity' visibility='public' type='EAID_7E29FD06_9E00_4fef_B794_54B3BBECF441' association='_17_0_2_4_854026d_1443699813603_254997_2713'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1443699816256_537680_2731' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1443699816256_395133_2732' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_18_5_2_854026d_1528112698093_938612_6262' name='type' visibility='public' type='_18_5_2_854026d_1528112470240_243840_6225'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_18_5_2_854026d_1528112840622_539528_6266' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the type of the add-on (see &lt;i&gt;CavityAddOn&lt;/i&gt;).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_18_5_2_854026d_1528112698093_938612_6262'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_18_5_2_854026d_1528112724534_592293_6264' value='1'/>
							</modelExtension>
						</xmi:Extension>
