						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1434106115274_88997_3321' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1434106222307_892728_3448' name='slotCoupling' visibility='public' aggregation='composite' type='_17_0_2_4_854026d_1434106222276_897831_3446' association='_17_0_2_4_854026d_1434106222307_412278_3447'>
