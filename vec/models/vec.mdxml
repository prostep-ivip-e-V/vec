					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_7C3D9BDC_34BB_4c9b_9843_BD245C445268' name='Uk'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_E67F26BD_9DD3_4108_B4C2_F23CB0790D43' name='Ur'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_427F9862_AE9E_493a_BC84_E7279222A870' name='Uz'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='EAID_16477270_5DCF_4be5_A5C5_19695D2706AB' name='Vi'/>
