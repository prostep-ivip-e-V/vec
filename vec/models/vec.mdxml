					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_B2BD7BFE_8E5C_439a_B43A_79B081713E7E' name='generatingSystemVersion' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
