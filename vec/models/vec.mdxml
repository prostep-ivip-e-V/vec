						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001374_5FD9_4d2d_A4B3_20337F6496EB' value='1'/>
							</modelExtension>
