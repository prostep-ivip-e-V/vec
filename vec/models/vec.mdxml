					<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690822158540_475845_1703' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specific &lt;i&gt;WireProtectionRole &lt;/i&gt;for instances of &lt;i&gt;TubeSpecification.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_2022x_1_854026d_1690822062622_352786_1670'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1690822062642_294859_1671' general='EAID_7E61D75A_7184_449a_804F_FCB0314553E3'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1690822148800_86299_1693' name='slitStyle' visibility='public' type='_17_0_2_4_854026d_1481194740393_896553_3812'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690822148807_962140_1696' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the style of the slitting of the tube. If a &lt;i&gt;slitStyle&lt;/i&gt; is defined, it implies that &lt;i&gt;isSlit=true&lt;/i&gt;.&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;This attribute is defined as an &lt;i&gt;OpenEnumeration.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1690822148800_86299_1693'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1690822148807_777496_1697'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1690822148806_682496_1695' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1690822148805_940579_1694' name='isSlit' visibility='public' type='_17_0_2_854026d_1382698654806_5864_2387'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1690822148808_813289_1699' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies whether the tube is slit or not. The style of the slitting can be defined with the &lt;i&gt;slitStyle.&lt;/i&gt; If a &lt;i&gt;slitStyle&lt;/i&gt; is defined, it implies that &lt;i&gt;isSlit=true&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1690822148805_940579_1694'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1690822148808_653058_1700'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1690822148808_730343_1698' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_2022x_1_854026d_1691053793098_650764_3249' name='HoleMountedFixingRole'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1691053952481_829982_3339' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;An &lt;i&gt;HoleMountedFixingRole&lt;/i&gt; defines the instance specific properties and relationships of a hole mounted fixing.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
