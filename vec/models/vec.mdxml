								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI001750_3E1F_4799_AE43_82EC3E90A6A5' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1383653159551_121832_6780' name='placedPlacementPoints' visibility='public' type='EAID_BF7FB2AC_B9C1_4494_AFC3_EE88D84C2E8C' association='_17_0_2_4_854026d_1383653159551_93186_6779'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1383653166071_618214_6803'/>
