				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1443699906120_416287_2756' name='ConnectorHousingCapSpecification'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1443700140135_91624_2774' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the definition of caps (backshells) of connectors. Different caps can add additional wire length addons to a connector housing.&#10;&#10;    &lt;/p&gt;&#10;&#10;    &lt;p&gt;&#10;A &#39;cap&#39; which already defines the number of cavities, coding etc. is in the&amp;#160;VEC&amp;#160;defined by &lt;i&gt;ConnectorHousingSpecification&lt;/i&gt; with &lt;i&gt;ModularSlots&lt;/i&gt; and not by a &lt;i&gt;ConnectorHousingCapSpecification&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1443699906120_416287_2756'/>
					</ownedComment>
