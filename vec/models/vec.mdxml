						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_19_0_2_854026d_1638201368085_708240_6021' name='connectionBLength' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_19_0_2_854026d_1638201391403_581228_6026' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the length of the connection between the conductor and the insulation crimp (wire reception, see diagram &amp;quot;Terminal Dimensions&amp;quot;).&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_19_0_2_854026d_1638201368085_708240_6021'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_19_0_2_854026d_1638201388117_412901_6024'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_19_0_2_854026d_1638201388117_141521_6025' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1695891137182_267399_2177' name='coreCrimpDetails' visibility='public' aggregation='composite' type='_2022x_1_854026d_1695891082734_125310_2129' association='_2022x_1_854026d_1695891137181_690959_2176'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1695891150901_491165_2198'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1695891150902_809948_2199' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1696853450722_536764_1702' name='sheetThickness' visibility='public' type='EAID_A946F935_0D85_4b01_92B9_625ED311C568'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1696853593343_571430_1706' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The thickness of the material of terminal (metal sheet)&amp;#160;in the crimp area.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1696853450722_536764_1702'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1696853475861_148444_1704'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1696853475862_875135_1705' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1696854998162_144499_1861' name='wireTipProtrusion' visibility='public' type='EAID_CAF23CB7_00D0_48de_9B42_ADB340B9B4A8'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1696855071300_964924_1866' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the valid length range in which the protrusion of the conductor from the conductor crimp must be located.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1696854998162_144499_1861'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1696855023960_481597_1864'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1696855023960_265963_1865' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1734533079621_568619_1823' name='crimpBarrelType' visibility='public' type='_2022x_1_854026d_1734532880024_90823_1799'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1734533107360_9136_1827' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The &lt;i&gt;CrimpBarrelType&lt;/i&gt; defines the shape of the crimp barrel in its unprocessed state. When the crimp barrel is open the wire can be laid into the terminal from above. If the crimp barrel is closed the wire must be fed in from the front.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1734533079621_568619_1823'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1734533095660_119993_1825'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1734533095661_91479_1826' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_CE3C9D13_8E62_4ef8_A553_37D7F6E1CA0C' name='WireSpecification'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
						<modelExtension/>
					</xmi:Extension>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_CE3C9D13_8E62_4ef8_A553_37D7F6E1CA0CDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specification for the definition of a wire. This can either be a complex multicore wire or a normal single core. In the VEC a wire is defined by one WireElement, which may be composed from other WireElements.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_CE3C9D13_8E62_4ef8_A553_37D7F6E1CA0C'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='EAID_B7601623_38FE_487f_969B_F3671A619696' isSubstitutable='false' general='EAID_6AB9AD42_9295_4771_B673_98FDF80C9A65'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstC472FC_3250_421d_9064_6E9CD90CD730' name='wireElement' visibility='public' aggregation='composite' type='EAID_B96A595D_1A89_45c6_B78D_5D307E761194' association='EAID_85C472FC_3250_421d_9064_6E9CD90CD730'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000739__3250_421d_9064_6E9CD90CD730' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000740__3250_421d_9064_6E9CD90CD730' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dst78EDCD_E254_4e46_A58A_A2B1C8862B3A' name='wireElementSpecification' visibility='public' type='EAID_6391ADC0_2FF5_43d5_8C0D_FEFA1B61062B' association='EAID_AB78EDCD_E254_4e46_A58A_A2B1C8862B3A'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000741__E254_4e46_A58A_A2B1C8862B3A'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1750168267076_707294_3259' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_99EEE7D4_B882_4284_8597_64855C1B612E'>
					<memberEnd xmi:idref='EAID_dstEEE7D4_B882_4284_8597_64855C1B612E'/>
					<memberEnd xmi:idref='EAID_srcEEE7D4_B882_4284_8597_64855C1B612E'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_99EEE7D4_B882_4284_8597_64855C1B612EDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the &lt;i&gt;WireSpecification&lt;/i&gt; that is instanced by this &lt;i&gt;WireRole.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_99EEE7D4_B882_4284_8597_64855C1B612E'/>
					</ownedComment>
					<ownedEnd xmi:type='uml:Property' xmi:id='EAID_srcEEE7D4_B882_4284_8597_64855C1B612E' visibility='public' type='EAID_11D97B0F_C11F_457d_B732_CB76FE2694A6' association='EAID_99EEE7D4_B882_4284_8597_64855C1B612E'>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000745__B882_4284_8597_64855C1B612E'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000746__B882_4284_8597_64855C1B612E' value='*'/>
					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_ACBE4C96_FE6E_46d2_96BB_0E9237996505' name='WireType'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_ACBE4C96_FE6E_46d2_96BB_0E9237996505Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies a wire type. A wire type is always defined by a key value. What wire type is meant by this key value is defined by a standard reference system.&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_ACBE4C96_FE6E_46d2_96BB_0E9237996505'/>
					</ownedComment>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_253779BD_2A16_4fc1_AF5A_6D4CD29A4FB7' name='type' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_253779BD_2A16_4fc1_AF5A_6D4CD29A4FB7Documentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the type of the wire (e.g. FLRY, NYFAZw). Valid values are defined by the wireTypeReferenceSystem. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_253779BD_2A16_4fc1_AF5A_6D4CD29A4FB7'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000747_2A16_4fc1_AF5A_6D4CD29A4FB7' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000748_2A16_4fc1_AF5A_6D4CD29A4FB7' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_AB47DD72_BEA0_42d8_9988_B27C54158D8A' name='referenceSystem' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_AB47DD72_BEA0_42d8_9988_B27C54158D8ADocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;Specifies the reference system for the wire type. &#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_AB47DD72_BEA0_42d8_9988_B27C54158D8A'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000749_BEA0_42d8_9988_B27C54158D8A' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000750_BEA0_42d8_9988_B27C54158D8A' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Enumeration' xmi:id='_17_0_2_854026d_1382705528386_885213_2825' name='SlotGender'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1384772813040_708368_2747' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Defines the gender of a slot.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='_17_0_2_854026d_1382705528386_885213_2825'/>
					</ownedComment>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_854026d_1382705594113_787957_2844' name='Male'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_854026d_1382705597020_262122_2846' name='Female'/>
					<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_17_0_2_854026d_1382705599023_870680_2848' name='Unspecified'/>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='_17_0_2_4_854026d_1383052235680_223463_2351' name='PinComponentBehavior'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1384426315509_778945_2752' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;PinComponentBehavior&lt;/i&gt; specifies the electrical behavior of a &lt;i&gt;PinComponent.&lt;/i&gt; Since the behavior of a pin is configuration dependent (e.g. the software deployed on an ECU) the &lt;i&gt;PinComponentBehavior &lt;/i&gt;inherits from &lt;i&gt;ConfigurableElement.&lt;/i&gt; Therefore, a &lt;i&gt;PinComponent&lt;/i&gt; can specify multiple &lt;i&gt;PinComponentBehavior.&lt;/i&gt;&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='_17_0_2_4_854026d_1383052235680_223463_2351'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_17_0_2_4_854026d_1383052570465_109778_2533' general='EAID_D2981BF7_2899_4491_A699_D434817A0FC2'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_4_854026d_1473945047652_356217_2872' name='identification' visibility='public' type='_17_0_2_854026d_1382698645142_784454_2386'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_17_0_2_4_854026d_1473945071807_554864_2876' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Identification of the PinComponentBehavior which identifies it from a user perspective, and which must be distinct for all PinComponentBehaviors of a PinComponent.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_17_0_2_4_854026d_1473945047652_356217_2872'/>
						</ownedComment>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_17_0_2_4_854026d_1473945064919_308697_2874' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_17_0_2_4_854026d_1473945064919_689747_2875' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1703757716161_8080_4033' name='aliasId' visibility='public' type='EAID_0BE66F11_D6D4_4aef_B63F_2D85865F9B68'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703757716162_666773_4035' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies additional identifiers for the element.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1703757716161_8080_4033'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1703757716162_56450_4036'/>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1703757716162_306020_4034' value='*'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_A50492EE_0719_4d30_A5E2_EB0BD8285D6B' name='signalDirection' visibility='public' type='EAID_D1B0ADD5_D992_48b1_BEF5_A6BF23446F1D'>
						<ownedComment xmi:type='uml:Comment' xmi:id='EAID_A50492EE_0719_4d30_A5E2_EB0BD8285D6BDocumentation' body='&lt;html&gt;&lt;body&gt;&lt;p&gt;The direction of the signal on this pin.&#10;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;'>
							<annotatedElement xmi:idref='EAID_A50492EE_0719_4d30_A5E2_EB0BD8285D6B'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000497_0719_4d30_A5E2_EB0BD8285D6B'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000498_0719_4d30_A5E2_EB0BD8285D6B' value='1'/>
							</modelExtension>
