					</ownedEnd>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_F8D52733_402A_4222_B2F3_A83FAB2D2869'>
					<memberEnd xmi:idref='EAID_dstD52733_402A_4222_B2F3_A83FAB2D2869'/>
					<memberEnd xmi:idref='EAID_srcD52733_402A_4222_B2F3_A83FAB2D2869'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_F8D52733_402A_4222_B2F3_A83FAB2D2869Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;Specifies the WireMoutingDetails, if a detailed description of the relationships between WireEnds and WireReceptions is needed.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_F8D52733_402A_4222_B2F3_A83FAB2D2869'/>
