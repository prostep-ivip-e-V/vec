					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1703233985266_178369_3463' name='cpaState' visibility='public' type='_2022x_1_854026d_1703149145856_549548_3263'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703234122080_431946_3473' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The state of the connector position assurance (CPA), if applicable. This is the state of the connector in the integration level described by the model to which the &lt;i&gt;ConnectorHousingRole&lt;/i&gt; belongs. For example, if the &lt;i&gt;ConnectorHousingRole&lt;/i&gt; is part of a harness specification from the OEM to the Tier1, it is the state the OEM&amp;#160;expects for the delivered product, not the final state in the vehicle.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1703233985266_178369_3463'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1703234021281_643383_3465'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1703234021281_646064_3466' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_2022x_1_854026d_1703234026408_478724_3467' name='lockingState' visibility='public' type='_2022x_1_854026d_1703149136195_433374_3243'>
						<ownedComment xmi:type='uml:Comment' xmi:id='_2022x_1_854026d_1703234270056_134583_3566' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;The state of the primary locking mechanism of the connector, if applicable. This is the state of the connector in the integration level described by the model to which the &lt;i&gt;ConnectorHousingRole&lt;/i&gt; belongs. For example, if the &lt;i&gt;ConnectorHousingRole&lt;/i&gt; is part of a harness specification from the OEM to the Tier1, it is the state the OEM&amp;#160;expects for the delivered product, not the final state in the vehicle.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
							<annotatedElement xmi:idref='_2022x_1_854026d_1703234026408_478724_3467'/>
						</ownedComment>
						<lowerValue xmi:type='uml:LiteralInteger' xmi:id='_2022x_1_854026d_1703234041747_792689_3469'/>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='_2022x_1_854026d_1703234041747_206983_3470' value='1'/>
							</modelExtension>
						</xmi:Extension>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Association' xmi:id='EAID_296AE015_BF63_4ebc_9A8B_1B5A0D56034B'>
					<memberEnd xmi:idref='EAID_dst6AE015_BF63_4ebc_9A8B_1B5A0D56034B'/>
					<memberEnd xmi:idref='EAID_src6AE015_BF63_4ebc_9A8B_1B5A0D56034B'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_296AE015_BF63_4ebc_9A8B_1B5A0D56034BDocumentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;References the ComponentConnector that is realized by the referenced ConnectorHousing (OccurrenceOrUsage with ConnectorHousingRole). This can especially be relevant for inliners. KBLFRM-341.&#10;&#10;    &lt;/p&gt;&#10;&#10;&lt;/body&gt;&#10;&lt;/html&gt;'>
						<annotatedElement xmi:idref='EAID_296AE015_BF63_4ebc_9A8B_1B5A0D56034B'/>
