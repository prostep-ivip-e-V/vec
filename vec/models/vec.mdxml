				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_AD70F28D_689B_4b09_B618_D5BC3047CDF9' name='SealedCavitiesAssignment'>
					<ownedComment xmi:type='uml:Comment' xmi:id='EAID_AD70F28D_689B_4b09_B618_D5BC3047CDF9Documentation' body='&lt;html&gt;&#10;  &lt;head&gt;&#10;&#9;&#9;&lt;style&gt;&#10;&#9;&#9;&#9;p {padding:0px; margin:0px;}&#10;&#9;&#9;&lt;/style&gt;&#10;&#9;&lt;/head&gt;&#10;  &lt;body&gt;&#10;    &lt;p&gt;&#10;A &lt;i&gt;SealedCavitiesAssignment&lt;/i&gt; groups the cavities of ONE connector that are sealed by a MultiCavityPlug. If a MultiCavityPlug fits into more than one connector, than there are as many &lt;i&gt;SealedCavitiesAssignments&lt;/i&gt;.&#10;&#10;    &lt;/p&gt;&#10;&#10;  &lt;/body&gt;&#10;&lt;/html&gt;&#10;'>
						<annotatedElement xmi:idref='EAID_AD70F28D_689B_4b09_B618_D5BC3047CDF9'/>
					</ownedComment>
					<generalization xmi:type='uml:Generalization' xmi:id='_2022x_1_854026d_1690457557971_553822_3380' general='EAID_F89D215A_BDE4_4335_841E_9CDDF0672665'/>
					<ownedAttribute xmi:type='uml:Property' xmi:id='EAID_dstCC84B1_8D6F_4def_9441_AC068A5A92FD' name='sealedCavities' visibility='public' type='EAID_7E29FD06_9E00_4fef_B794_54B3BBECF441' association='EAID_D0CC84B1_8D6F_4def_9441_AC068A5A92FD'>
						<xmi:Extension extender='MagicDraw UML 2022x'>
							<modelExtension>
								<lowerValue xmi:type='uml:LiteralInteger' xmi:id='EAID_LI000569__8D6F_4def_9441_AC068A5A92FD' value='1'/>
							</modelExtension>
						</xmi:Extension>
						<upperValue xmi:type='uml:LiteralUnlimitedNatural' xmi:id='EAID_LI000570__8D6F_4def_9441_AC068A5A92FD' value='*'/>
					</ownedAttribute>
				</packagedElement>
				<packagedElement xmi:type='uml:Class' xmi:id='EAID_FDA76D70_46D7_491d_88B6_A011D40E4721' name='SegmentConnectionPoint'>
					<xmi:Extension extender='MagicDraw UML 2022x'>
